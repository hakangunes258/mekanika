@page "/interference-fit"
@inject MaterialService MaterialService
@inject AnalyticsService Analytics
@inject SeoService Seo
@inject ModuleMetadataService Metadata
@inject FeedbackService Feedback
@inject IJSRuntime JSRuntime
@using MechanicalCalculatorWeb.Services

<PageTitle>Interference Fit Calculator - Mekanika</PageTitle>

<div class="page-header">
    <h1>
        <ModuleIcon Type="interference-fit" Size="large" Style="transparent" CustomStyle="margin-right: 12px;" />
        Interference Fit Calculator
    </h1>
    <p>Press fit and shrink fit calculations according to DIN 7190, with temperature and rotation effects.</p>
</div>

<SharedCalculationLoader Module="interference-fit" OnRestore="ApplyShareState" />

@if (!showResults)
{
    <!-- INPUT FORM -->
    <div class="form-grid">
        <!-- Geometry Card -->
        <div class="card">
            <div class="card-header"><ModuleIcon Type="geometry" Size="medium" Style="solid" /><h2>Geometry</h2></div>
            <div class="form-group">
                <label>Nominal Diameter (d)</label>
                <div class="input-group">
                    <input type="number" step="0.001" @bind="engine.NominalDiameter" @bind:after="UpdateTolerances" placeholder="e.g. 50" />
                    <span class="unit">mm</span>
                </div>
            </div>
            <div class="form-group">
                <label>Fit Length (L)</label>
                <div class="input-group">
                    <input type="number" step="0.001" @bind="engine.FitLength" placeholder="e.g. 40" />
                    <span class="unit">mm</span>
                </div>
            </div>
            <div class="form-group">
                <label>Shaft Inner Diameter (di)</label>
                <div class="input-group">
                    <input type="number" step="0.001" @bind="engine.ShaftInnerDiameter" placeholder="0 for solid" />
                    <span class="unit">mm</span>
                </div>
            </div>
            <div class="form-group">
                <label>Hub Outer Diameter (Da)</label>
                <div class="input-group">
                    <input type="number" step="0.001" @bind="engine.HubOuterDiameter" placeholder="e.g. 80" />
                    <span class="unit">mm</span>
                </div>
            </div>
        </div>

        <!-- Tolerances Card -->
        <div class="card">
            <div class="card-header"><ModuleIcon Type="tolerance" Size="medium" Style="solid" /><h2>Tolerances (ISO 286)</h2></div>
            @if (toleranceWarning != null)
            {
                <div class="alert alert-warning" style="margin-bottom: 12px;">
                    <ModuleIcon Type="warning" Size="small" Style="default" />
                    <div>@toleranceWarning</div>
                </div>
            }
            <div class="form-group">
                <label>Shaft Fit</label>
                <select @bind="selectedShaftFit" @bind:after="UpdateTolerances">
                    <option value="n6">n6</option>
                    <option value="p6">p6</option>
                    <option value="r6">r6</option>
                    <option value="s6">s6</option>
                    <option value="t6">t6</option>
                    <option value="u6">u6</option>
                    <option value="custom">Custom</option>
                </select>
            </div>
            <div class="form-group">
                <label>Shaft Upper Deviation (es)</label>
                <div class="input-group"><input type="number" step="0.1" @bind="engine.ShaftUpperDeviation" disabled="@(!isCustomShaft)" /><span class="unit">μm</span></div>
            </div>
            <div class="form-group">
                <label>Shaft Lower Deviation (ei)</label>
                <div class="input-group"><input type="number" step="0.1" @bind="engine.ShaftLowerDeviation" disabled="@(!isCustomShaft)" /><span class="unit">μm</span></div>
            </div>
            <hr />
            <div class="form-group">
                <label>Hub Fit</label>
                <select @bind="selectedHubFit" @bind:after="UpdateTolerances">
                    <option value="H7">H7</option>
                    <option value="H6">H6</option>
                    <option value="custom">Custom</option>
                </select>
            </div>
            <div class="form-group">
                <label>Hub Upper Deviation (ES)</label>
                <div class="input-group"><input type="number" step="0.1" @bind="engine.HubUpperDeviation" disabled="@(!isCustomHub)" /><span class="unit">μm</span></div>
            </div>
            <div class="form-group">
                <label>Hub Lower Deviation (EI)</label>
                <div class="input-group"><input type="number" step="0.1" @bind="engine.HubLowerDeviation" disabled="@(!isCustomHub)" /><span class="unit">μm</span></div>
            </div>
        </div>

        <!-- Operating Conditions Card -->
        <div class="card">
            <div class="card-header"><ModuleIcon Type="gear" Size="medium" Style="solid" /><h2>Operating Conditions</h2></div>
            <div class="form-group">
                <label>Rotational Speed</label>
                <div class="input-group"><input type="number" step="100" @bind="engine.RotationalSpeed" /><span class="unit">rpm</span></div>
            </div>
            <div class="form-group">
                <label>Shaft Service Temperature</label>
                <div class="input-group"><input type="number" step="5" @bind="engine.ShaftServiceTemperature" /><span class="unit">°C</span></div>
            </div>
            <div class="form-group">
                <label>Hub Service Temperature</label>
                <div class="input-group"><input type="number" step="5" @bind="engine.HubServiceTemperature" /><span class="unit">°C</span></div>
            </div>
            <hr/>
            <div class="form-group">
                <label>Applied Torque</label>
                <div class="input-group"><input type="number" step="1" @bind="engine.AppliedTorque" placeholder="Optional" /><span class="unit">Nm</span></div>
            </div>
            <div class="form-group">
                <label>Applied Axial Force</label>
                <div class="input-group"><input type="number" step="10" @bind="engine.AppliedAxialForce" placeholder="Optional" /><span class="unit">N</span></div>
            </div>
            <div class="form-group">
                <label>Application Factor (φ)</label>
                <select @bind="selectedLoadFactor" @bind:after="OnLoadFactorChanged">
                    <option value="1.0">1.0 - Static load</option>
                    <option value="1.25">1.25 - Light shock</option>
                    <option value="1.5">1.5 - Moderate shock</option>
                    <option value="1.75">1.75 - Heavy shock</option>
                    <option value="2.0">2.0 - Impact load</option>
                </select>
            </div>
        </div>

        <!-- Physical Properties Card -->
        <div class="card">
            <div class="card-header"><ModuleIcon Type="surface" Size="medium" Style="solid" /><h2>Physical Properties</h2></div>
            <div class="form-group">
                <label>Shaft Surface Roughness (Rz)</label>
                <div class="input-group"><input type="number" step="0.1" @bind="engine.ShaftRoughness" /><span class="unit">μm</span></div>
                <small style="color: #6c757d; font-size: 12px;">Peak-to-valley height</small>
            </div>
            <div class="form-group">
                <label>Hub Surface Roughness (Rz)</label>
                <div class="input-group"><input type="number" step="0.1" @bind="engine.HubRoughness" /><span class="unit">μm</span></div>
                <small style="color: #6c757d; font-size: 12px;">Peak-to-valley height</small>
            </div>
            <hr/>
            <div class="form-group">
                <label>Friction Coefficient (Rotation/Torque)</label>
                <div class="input-group"><input type="number" step="0.01" @bind="engine.FrictionCoefficientTorque" /><span class="unit">-</span></div>
                <small style="color: #6c757d; font-size: 12px;">For torque transmission</small>
            </div>
            <div class="form-group">
                <label>Friction Coefficient (Axial/Assembly)</label>
                <div class="input-group"><input type="number" step="0.01" @bind="engine.FrictionCoefficientAssembly" /><span class="unit">-</span></div>
                <small style="color: #6c757d; font-size: 12px;">For assembly and axial force</small>
            </div>
        </div>
        
        <!-- Materials Card -->
        <div class="card">
            <div class="card-header"><ModuleIcon Type="material" Size="medium" Style="solid" /><h2>Materials</h2></div>
            <div class="form-group">
                <label>Shaft Material</label>
                <select @bind="selectedShaftMaterialIndex">
                    @for (int i = 0; i < materials.Count; i++) { <option value="@i">@materials[i].ToString()</option> }
                </select>
                @if (materials.Any())
                {
                    <div class="material-info">
                        Re = @materials[selectedShaftMaterialIndex].YieldStrength MPa | Rm = @materials[selectedShaftMaterialIndex].TensileStrength MPa
                    </div>
                }
            </div>
            <div class="form-group">
                <label>Hub Material</label>
                <select @bind="selectedHubMaterialIndex">
                    @for (int i = 0; i < materials.Count; i++) { <option value="@i">@materials[i].ToString()</option> }
                </select>
                @if (materials.Any())
                {
                    <div class="material-info">
                        Re = @materials[selectedHubMaterialIndex].YieldStrength MPa | Rm = @materials[selectedHubMaterialIndex].TensileStrength MPa
                    </div>
                }
            </div>
        </div>
    </div>

    <ValidationAlert Messages="validationMessages" />

    <div class="button-group">
        <button class="btn btn-success btn-lg @(isCalculating ? "btn-calculating" : "")" @onclick="Calculate" disabled="@isCalculating">
            @if (isCalculating)
            {
                <span class="spinner"></span>
                <span>Calculating...</span>
            }
            else
            {
                <ModuleIcon Type="calculate" Size="button" Style="default" />
                <span>Calculate</span>
            }
        </button>
        <button class="btn btn-secondary" @onclick="ClearForm" disabled="@isCalculating"><ModuleIcon Type="clear" Size="button" Style="default" /> Clear</button>
    </div>
}
else
{
    <!-- ============ RESULTS SECTION ============ -->
    <div class="button-group" style="margin-bottom: 24px;">
        <button class="btn btn-secondary" @onclick="BackToInput"><ModuleIcon Type="back" Size="button" Style="default" /> Back to Input</button>
        <button class="btn btn-secondary" @onclick="ClearForm"><ModuleIcon Type="new" Size="button" Style="default" /> New Calculation</button>
        <button class="btn btn-info @(isSavingPdf ? "btn-saving" : "")" @onclick="SaveAsPdf" disabled="@isSavingPdf">
            @if (isSavingPdf)
            {
                <span class="spinner"></span>
                <span>Generating PDF...</span>
            }
            else
            {
                <ModuleIcon Type="pdf" Size="button" Style="default" />
                <span>Save as PDF</span>
            }
        </button>
        <Viewer3D Module="interference-fit" Parameters="@Build3dParameters()" />
        <ShareCalculation Module="interference-fit" State="@BuildShareState()" />
        <SaveCalculation Module="interference-fit" State="@BuildShareState()" />
    </div>

    @if (openedFromSharedLink)
    {
        <div class="alert alert-info" style="margin-bottom: 24px;">
            <ModuleIcon Type="info" Size="small" Style="default" />
            <div>
                <strong>Opened from a shared link.</strong>
                The inputs below came from the link and were recalculated with the current engine.
            </div>
        </div>
    }

    <div id="results-content">
        <!-- Calculation Summary -->
        <div class="card">
            <div class="card-header"><ModuleIcon Type="info" Size="medium" Style="solid" /><h2>Calculation Summary</h2></div>
            <table class="results-table">
                <thead><tr><th>Description</th><th>Symbol</th><th>Value</th><th>Unit</th></tr></thead>
                <tbody>
                    <tr><td>Nominal Diameter</td><td><i>d</i></td><td>@engine.NominalDiameter.ToString("F2")</td><td>mm</td></tr>
                    <tr><td>Fit Length</td><td><i>L</i></td><td>@engine.FitLength.ToString("F2")</td><td>mm</td></tr>
                    <tr><td>Shaft Inner Diameter</td><td><i>d<sub>i</sub></i></td><td>@engine.ShaftInnerDiameter.ToString("F2")</td><td>mm</td></tr>
                    <tr><td>Hub Outer Diameter</td><td><i>D<sub>a</sub></i></td><td>@engine.HubOuterDiameter.ToString("F2")</td><td>mm</td></tr>
                    <tr class="table-section-header"><td colspan="4">Actual Dimensions</td></tr>
                    <tr><td>Shaft Actual Diameter (min)</td><td><i>d</i><sub>min</sub></td><td>@((engine.NominalDiameter + engine.ShaftLowerDeviation / 1000).ToString("F3"))</td><td>mm</td></tr>
                    <tr><td>Shaft Actual Diameter (max)</td><td><i>d</i><sub>max</sub></td><td>@((engine.NominalDiameter + engine.ShaftUpperDeviation / 1000).ToString("F3"))</td><td>mm</td></tr>
                    <tr><td>Hub Actual Diameter (min)</td><td><i>D</i><sub>min</sub></td><td>@((engine.NominalDiameter + engine.HubLowerDeviation / 1000).ToString("F3"))</td><td>mm</td></tr>
                    <tr><td>Hub Actual Diameter (max)</td><td><i>D</i><sub>max</sub></td><td>@((engine.NominalDiameter + engine.HubUpperDeviation / 1000).ToString("F3"))</td><td>mm</td></tr>
                </tbody>
            </table>
        </div>

        <!-- Interference & Pressure -->
        <div class="card">
            <div class="card-header"><ModuleIcon Type="info" Size="medium" Style="solid" /><h2>Interference & Pressure</h2></div>
            <table class="results-table">
                <thead><tr><th>Description</th><th>Symbol</th><th>Value</th><th>Unit</th></tr></thead>
                <tbody>
                    <tr class="highlight"><td>Max Geometric Interference</td><td>U<sub>max,g</sub></td><td>@engine.MaxInterference.ToString("F1")</td><td>μm</td></tr>
                    <tr><td>Min Geometric Interference</td><td>U<sub>min,g</sub></td><td>@engine.MinInterference.ToString("F1")</td><td>μm</td></tr>
                    <tr><td>Roughness Loss</td><td>R<sub>z</sub></td><td>@engine.RoughnessLoss.ToString("F1")</td><td>μm</td></tr>
                    <tr><td>Thermal Interference Change</td><td>ΔU<sub>th</sub></td><td>@engine.ThermalInterferenceChange.ToString("F1")</td><td>μm</td></tr>
                    <tr class="highlight"><td>Effective Max Interference (Operating)</td><td>U<sub>eff,max</sub></td><td>@engine.EffectiveMaxInterference.ToString("F1")</td><td>μm</td></tr>
                    <tr><td>Effective Min Interference (Operating)</td><td>U<sub>eff,min</sub></td><td>@engine.EffectiveMinInterference.ToString("F1")</td><td>μm</td></tr>
                    <tr class="highlight danger"><td>Pressure Loss from Rotation</td><td>p<sub>loss,rot</sub></td><td>@engine.RotationalPressureLoss.ToString("F2")</td><td>MPa</td></tr>
                    <tr class="highlight"><td>Maximum Contact Pressure (Operating)</td><td>p<sub>max</sub></td><td>@engine.MaxContactPressure.ToString("F2")</td><td>MPa</td></tr>
                    <tr><td>Minimum Contact Pressure (Operating)</td><td>p<sub>min</sub></td><td>@engine.MinContactPressure.ToString("F2")</td><td>MPa</td></tr>
                </tbody>
            </table>

            @if (engine.InterferenceLossReasons.Count > 0)
            {
                <div class="alert alert-danger" style="margin-top: 16px;">
                    <ModuleIcon Type="warning" Size="small" Style="default" />
                    <div>
                        <strong>No interference is left at the loose limit, so the joint transmits nothing.</strong>
                        <ul style="margin: 8px 0 0 0; padding-left: 20px;">
                            @foreach (var reason in engine.InterferenceLossReasons)
                            {
                                <li>@reason</li>
                            }
                        </ul>
                    </div>
                </div>
            }
            else if (engine.IsTransitionFit)
            {
                <div class="alert alert-warning" style="margin-top: 16px;">
                    <ModuleIcon Type="warning" Size="small" Style="default" />
                    <div>
                        <strong>This is a transition fit.</strong>
                        At its loose limit the tolerance pair gives @Math.Abs(engine.MinInterference).ToString("F1") μm of
                        clearance, not interference. The minimum capacities below are therefore zero by construction.
                    </div>
                </div>
            }
        </div>

        <!-- Stresses -->
        <div class="card">
            <div class="card-header"><ModuleIcon Type="force" Size="medium" Style="solid" /><h2>Stresses at Max Interference</h2></div>
            <table class="results-table">
                <thead><tr><th>Description</th><th>Symbol</th><th>Value</th><th>Unit</th></tr></thead>
                <tbody>
                    <tr><td colspan="4" class="table-section-header">Shaft Stresses — @engine.ShaftGoverningState, at the @engine.ShaftStressPoint</td></tr>
                    <tr><td>Tangential Stress</td><td>σ<sub>t,shaft</sub></td><td>@engine.ShaftTangentialStress.ToString("F1")</td><td>MPa</td></tr>
                    <tr><td>Radial Stress</td><td>σ<sub>r,shaft</sub></td><td>@engine.ShaftRadialStress.ToString("F1")</td><td>MPa</td></tr>
                    <tr class="@(engine.ShaftVonMisesStress > engine.ShaftMaterial.YieldStrength * 0.8 ? "warning" : "")"><td>Von Mises Stress</td><td>σ<sub>v,shaft</sub></td><td>@engine.ShaftVonMisesStress.ToString("F1")</td><td>MPa</td></tr>
                    <tr><td colspan="4" class="table-section-header">Hub Stresses — @engine.HubGoverningState, at the @engine.HubStressPoint</td></tr>
                    <tr><td>Tangential Stress</td><td>σ<sub>t,hub</sub></td><td>@engine.HubTangentialStress.ToString("F1")</td><td>MPa</td></tr>
                    <tr><td>Radial Stress</td><td>σ<sub>r,hub</sub></td><td>@engine.HubRadialStress.ToString("F1")</td><td>MPa</td></tr>
                    <tr class="@(engine.HubVonMisesStress > engine.HubMaterial.YieldStrength * 0.8 ? "warning" : "")"><td>Von Mises Stress</td><td>σ<sub>v,hub</sub></td><td>@engine.HubVonMisesStress.ToString("F1")</td><td>MPa</td></tr>
                </tbody>
            </table>

            @if (engine.StressCases.Count > 1)
            {
                <h3 style="margin: 20px 0 8px 0; font-size: 15px; color: #2c3e50;">Operating states compared</h3>
                <table class="results-table">
                    <thead><tr><th>State</th><th>p</th><th>σ<sub>v,shaft</sub></th><th>σ<sub>v,hub</sub></th></tr></thead>
                    <tbody>
                        @foreach (var c in engine.StressCases)
                        {
                            <tr class="@(c.State == engine.ShaftGoverningState || c.State == engine.HubGoverningState ? "highlight" : "")">
                                <td>@c.State</td>
                                <td>@c.Pressure.ToString("F2")</td>
                                <td>@c.ShaftVonMises.ToString("F1") <span style="color:#6c757d">(@c.ShaftPoint)</span></td>
                                <td>@c.HubVonMises.ToString("F1") <span style="color:#6c757d">(@c.HubPoint)</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            <p style="margin: 12px 0 0 0; font-size: 13px; color: #6c757d;">
                Each member is evaluated at every candidate point and the largest value is reported.
                In a <strong>hollow shaft the peak stress is at the bore</strong>, where σ<sub>r</sub> has
                relaxed to zero and σ<sub>t</sub> = −2p/(1−Q<sub>i</sub>²) — reading the fit surface alone
                understates it. Yield is checked against the <strong>worst</strong> operating state, because
                rotation and a hotter hub both relieve the interference: the parts can be at their tightest
                the moment the machine stops or cools.
                Von Mises is taken under plane stress, σ<sub>v</sub> = √(σ<sub>t</sub>² − σ<sub>t</sub>σ<sub>r</sub> + σ<sub>r</sub>²).
            </p>
        </div>

        <!-- Load Capacities -->
        <div class="card">
            <div class="card-header"><ModuleIcon Type="force" Size="medium" Style="solid" /><h2>Load Capacities (Operating)</h2></div>
            <table class="results-table">
                <thead><tr><th>Description</th><th>Symbol</th><th>Value</th><th>Unit</th></tr></thead>
                <tbody>
                    <tr><td>Application Factor</td><td>φ</td><td>@engine.LoadFactor.ToString("F2")</td><td>-</td></tr>
                    <tr><td>Applied Torque (with factor)</td><td>T<sub>app</sub></td><td>@((engine.AppliedTorque * engine.LoadFactor).ToString("F1"))</td><td>Nm</td></tr>
                    <tr><td>Applied Axial Force (with factor)</td><td>F<sub>app</sub></td><td>@((engine.AppliedAxialForce * engine.LoadFactor).ToString("F1"))</td><td>N</td></tr>
                    <tr class="highlight"><td>Minimum Torque Capacity</td><td>T<sub>min</sub></td><td>@engine.MinTorqueCapacity.ToString("F1")</td><td>Nm</td></tr>
                    <tr><td>Maximum Torque Capacity</td><td>T<sub>max</sub></td><td>@engine.MaxTorqueCapacity.ToString("F1")</td><td>Nm</td></tr>
                    <tr class="highlight"><td>Minimum Axial Force Capacity</td><td>F<sub>a,min</sub></td><td>@((engine.MinAxialForceCapacity/1000).ToString("F2"))</td><td>kN</td></tr>
                    <tr><td>Maximum Axial Force Capacity</td><td>F<sub>a,max</sub></td><td>@((engine.MaxAxialForceCapacity/1000).ToString("F2"))</td><td>kN</td></tr>
                    <tr><td colspan="4" class="table-section-header">Combined Loading (one friction interface)</td></tr>
                    <tr><td>Tangential Force from Torque</td><td>F<sub>t</sub></td><td>@((engine.TangentialForce/1000).ToString("F2"))</td><td>kN</td></tr>
                    <tr class="highlight"><td>Resultant of Torque and Axial Force</td><td>F<sub>res</sub></td><td>@((engine.ResultantForce/1000).ToString("F2"))</td><td>kN</td></tr>
                    <tr><td>Minimum Resultant Capacity (μ = @engine.FrictionCoefficientCombined.ToString("F2"))</td><td>F<sub>res,cap</sub></td><td>@((engine.MinResultantCapacity/1000).ToString("F2"))</td><td>kN</td></tr>
                </tbody>
            </table>
            <p style="margin: 12px 0 0 0; font-size: 13px; color: #6c757d;">
                Torque and axial force are carried by the <strong>same</strong> friction interface, so their
                components share one capacity: F<sub>res</sub> = √(F<sub>t</sub>² + F<sub>a</sub>²) against
                μ·p<sub>min</sub>·π·d·L, with F<sub>t</sub> = 2000·T·φ/d. Checking the two separately passes
                joints that slip — the resultant safety is never higher than either of them, and is strictly
                lower when both loads act.
                The lower of the two friction coefficients entered is used, since the resultant slides in
                whichever direction is weaker.
            </p>
        </div>

        <!-- Assembly -->
        <div class="card">
            <div class="card-header"><ModuleIcon Type="settings" Size="medium" Style="solid" /><h2>Assembly Parameters</h2></div>
            <table class="results-table">
                <thead><tr><th>Description</th><th>Symbol</th><th>Value</th><th>Unit</th></tr></thead>
                <tbody>
                    <tr class="highlight"><td>Max Press-Fit Assembly Force</td><td>F<sub>asm</sub></td><td>@((engine.AssemblyForce / 1000).ToString("F2"))</td><td>kN</td></tr>
                    <tr><td>Assembly Clearance Assumed</td><td>Δ<sub>asm</sub></td><td>@((engine.AssemblyClearance * 1000).ToString("F0"))</td><td>μm</td></tr>
                    <tr><td>Hub Heating Temp (for Shrink Fit)</td><td>T<sub>heat</sub></td><td>@engine.HeatingTemperature.ToString("F0")</td><td>°C</td></tr>
                    <tr><td>Shaft Cooling Temp (for Shrink Fit)</td><td>T<sub>cool</sub></td><td>@engine.CoolingTemperature.ToString("F0")</td><td>°C</td></tr>
                </tbody>
            </table>
        </div>

        <!-- Safety Factors -->
        <div class="card">
             <div class="card-header"><ModuleIcon Type="safety" Size="medium" Style="solid" /><h2>Safety Factors</h2></div>
            <table class="results-table">
                <thead><tr><th>Description</th><th>Symbol</th><th>Value</th><th>Status</th></tr></thead>
                <tbody>
                    <tr><td colspan="4" class="table-section-header">Against Sliding (based on min capacity)</td></tr>
                    <tr class="@GetSafetyRowClass(engine.SafetyFactorSliding)"><td>Torque (vs Applied)</td><td>SF<sub>T</sub></td><td>@FormatSafetyFactor(engine.SafetyFactorSliding)</td><td>@GetSafetyStatus(engine.SafetyFactorSliding)</td></tr>
                    <tr class="@GetSafetyRowClass(engine.SafetyFactorAxial)"><td>Axial Force (vs Applied)</td><td>SF<sub>F</sub></td><td>@FormatSafetyFactor(engine.SafetyFactorAxial)</td><td>@GetSafetyStatus(engine.SafetyFactorAxial)</td></tr>
                    <tr class="@GetSafetyRowClass(engine.SafetyFactorCombined)"><td><strong>Resultant of Both (governing)</strong></td><td>SF<sub>res</sub></td><td>@FormatSafetyFactor(engine.SafetyFactorCombined)</td><td>@GetSafetyStatus(engine.SafetyFactorCombined)</td></tr>
                    <tr><td colspan="4" class="table-section-header">Against Yielding (worst operating state)</td></tr>
                    <tr class="@GetSafetyRowClass(engine.SafetyFactorShaftStress)"><td>Shaft — @engine.ShaftGoverningState, at the @engine.ShaftStressPoint</td><td>SF<sub>shaft</sub></td><td>@FormatSafetyFactor(engine.SafetyFactorShaftStress)</td><td>@GetSafetyStatus(engine.SafetyFactorShaftStress)</td></tr>
                    <tr class="@GetSafetyRowClass(engine.SafetyFactorHubStress)"><td>Hub — @engine.HubGoverningState, at the @engine.HubStressPoint</td><td>SF<sub>hub</sub></td><td>@FormatSafetyFactor(engine.SafetyFactorHubStress)</td><td>@GetSafetyStatus(engine.SafetyFactorHubStress)</td></tr>
                </tbody>
            </table>
        </div>
    </div>

}


<ModuleContent Module="interference-fit" />

@code {
    private InterferenceFitEngine engine = new();
    /// <summary>Why Calculate refused, shown by <see cref="ValidationAlert"/>.</summary>
    private List<string> validationMessages = new();
    private List<Material> materials = new();
    private ModuleInfo moduleInfo = new();
    private bool showResults = false;
    private bool isCalculating = false;
    private bool isSavingPdf = false;

    private string selectedShaftFit = "p6";
    private string selectedHubFit = "H7";
    private bool isCustomShaft = false;
    private bool isCustomHub = false;
    private string selectedLoadFactor = "1.0";
    private string? toleranceWarning = null;

    private int selectedShaftMaterialIndex = 2; // C45
    private int selectedHubMaterialIndex = 2;   // C45
    private bool openedFromSharedLink = false;

    /// <summary>Load factors offered by the dropdown. A shared link carrying anything else falls back to 1.0.</summary>
    private static readonly string[] LoadFactorOptions = { "1.0", "1.25", "1.5", "1.75", "2.0" };

    protected override async Task OnInitializedAsync()
    {
        // Load materials
        materials = MaterialService.GetMaterials();

        // Load module metadata
        moduleInfo = Metadata.GetModule("interference-fit");

        // Set SEO metadata
        await SetSeoMetadata();

        // Set structured data
        await SetStructuredData();

        // Track page view
        await Analytics.TrackPageView("/interference-fit", moduleInfo.Name);
    }

    private async Task SetSeoMetadata()
    {
        var baseUrl = "https://mekanika.org";
        var seo = new SeoMetadata
        {
            Title = $"{moduleInfo.Name} - Free Online Tool | Mekanika",
            Description = moduleInfo.Description,
            Keywords = moduleInfo.Keywords,
            CanonicalUrl = $"{baseUrl}{moduleInfo.Route}",
            OgTitle = moduleInfo.Name,
            OgDescription = moduleInfo.Description,
            OgImage = $"{baseUrl}/brand/og.png",
            OgUrl = $"{baseUrl}{moduleInfo.Route}",
            TwitterCard = "summary",
            TwitterTitle = moduleInfo.Name,
            TwitterDescription = moduleInfo.Description,
            TwitterImage = $"{baseUrl}/brand/og.png"
        };

        await Seo.SetMetaTags(seo);
    }

    private async Task SetStructuredData()
    {
        var structuredData = new
        {
            context = "https://schema.org",
            type = "SoftwareApplication",
            name = moduleInfo.Name,
            description = moduleInfo.Description,
            applicationCategory = "EngineeringApplication",
            operatingSystem = "Web Browser",
            browserRequirements = "Requires JavaScript, WebAssembly support",
            offers = new
            {
                type = "Offer",
                price = "0",
                priceCurrency = "USD"
            },
            author = new
            {
                type = "Organization",
                name = "Mekanika",
                url = "https://mekanika.org"
            },
            featureList = new[]
            {
                "Standards-based calculations (DIN 7190)",
                "PDF export",
                "No registration required",
                "Privacy-focused (client-side calculation)"
            }
        };

        await Seo.SetStructuredData(structuredData);
    }

    private void OnLoadFactorChanged()
    {
        if (double.TryParse(selectedLoadFactor, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out double factor))
            engine.LoadFactor = factor;
    }

    private void SetDefaultValues()
    {
        // This is now only called from ClearForm, to reset to a default state
        engine.NominalDiameter = 50;
        engine.FitLength = 40;
        engine.ShaftInnerDiameter = 0;
        engine.HubOuterDiameter = 80;
        engine.ShaftRoughness = 4.0;
        engine.HubRoughness = 6.0;
        engine.RotationalSpeed = 0;
        engine.ShaftServiceTemperature = 20;
        engine.HubServiceTemperature = 20;
        engine.AmbientTemperature = 20;
        engine.LoadFactor = 1.0;
        engine.FrictionCoefficientTorque = 0.12;
        engine.FrictionCoefficientAssembly = 0.15;
        UpdateTolerances();
    }

    /// <summary>
    /// Geometry handed to the 3D viewer. Keys must match the "interference-fit"
    /// builder in wwwroot/js/viewer3d.js.
    /// </summary>
    private object Build3dParameters() => new
    {
        d = engine.NominalDiameter,
        L = engine.FitLength,
        di = engine.ShaftInnerDiameter,
        Da = engine.HubOuterDiameter,
        pressure = engine.MaxContactPressure
    };

    private void UpdateTolerances()
    {
        isCustomShaft = selectedShaftFit == "custom";
        isCustomHub = selectedHubFit == "custom";

        var unsupported = new List<string>();

        // Update shaft tolerances if not in custom mode
        if (!isCustomShaft && !string.IsNullOrEmpty(selectedShaftFit))
        {
            var dev = Iso286.TryGetDeviations(selectedShaftFit, engine.NominalDiameter);
            if (dev != null)
            {
                engine.ShaftUpperDeviation = dev.Value.upper;
                engine.ShaftLowerDeviation = dev.Value.lower;
            }
            else
            {
                engine.ShaftUpperDeviation = 0;
                engine.ShaftLowerDeviation = 0;
                unsupported.Add(selectedShaftFit);
            }
        }

        // Update hub tolerances if not in custom mode
        if (!isCustomHub && !string.IsNullOrEmpty(selectedHubFit))
        {
            var dev = Iso286.TryGetDeviations(selectedHubFit, engine.NominalDiameter);
            if (dev != null)
            {
                engine.HubUpperDeviation = dev.Value.upper;
                engine.HubLowerDeviation = dev.Value.lower;
            }
            else
            {
                engine.HubUpperDeviation = 0;
                engine.HubLowerDeviation = 0;
                unsupported.Add(selectedHubFit);
            }
        }

        // Say whose limit this is. ISO 286-2 itself defines these fields up to
        // 3150 mm; the table built into this calculator stops at 500 mm, and
        // claiming the standard does not define them was simply wrong.
        toleranceWarning = unsupported.Count == 0
            ? null
            : $"{string.Join(" and ", unsupported)} at a {engine.NominalDiameter:F1} mm nominal size is outside " +
              "the ISO 286 table built into this calculator, which covers 1 mm to 500 mm. " +
              "ISO 286-2 does define these fields above 500 mm — switch to Custom and enter the deviations from it.";
    }

    private async Task Calculate()
    {
        isCalculating = true;
        StateHasChanged();
        await Task.Delay(350);
        try
        {
            // Validation - name what is missing rather than returning in silence.
            validationMessages.Clear();
            if (engine.NominalDiameter <= 0) validationMessages.Add("Nominal diameter (d) must be greater than 0.");
            if (engine.FitLength <= 0) validationMessages.Add("Fit length (L) must be greater than 0.");
            if (engine.HubOuterDiameter <= engine.NominalDiameter)
                validationMessages.Add($"Hub outer diameter (Da) must be larger than the nominal diameter ({engine.NominalDiameter:F1} mm).");
            if (engine.ShaftInnerDiameter < 0)
                validationMessages.Add("Shaft inner diameter (di) cannot be negative. Enter 0 for a solid shaft.");
            else if (engine.NominalDiameter > 0 && engine.ShaftInnerDiameter >= engine.NominalDiameter)
                validationMessages.Add($"Shaft inner diameter (di) must be smaller than the nominal diameter ({engine.NominalDiameter:F1} mm) — the shaft needs a wall to be pressed on.");
            if (engine.ShaftRoughness < 0 || engine.HubRoughness < 0)
                validationMessages.Add("Surface roughness (Rz) cannot be negative.");
            if (engine.RotationalSpeed < 0)
                validationMessages.Add("Rotational speed cannot be negative.");
            if (toleranceWarning != null)
                validationMessages.Add("The selected fit has no ISO 286 deviations at this diameter, so the deviations are all zero. Pick another fit or switch to Custom.");

            if (validationMessages.Count > 0)
            {
                await Analytics.TrackCalculationError("interference-fit", "validation_failed", string.Join("; ", validationMessages));
                return;
            }

            // Perform calculation
            engine.ShaftMaterial = materials[selectedShaftMaterialIndex];
            engine.HubMaterial = materials[selectedHubMaterialIndex];

            engine.Calculate();
            showResults = true;

            // Track successful calculation
            await Analytics.TrackCalculationCompleted("interference-fit", new Dictionary<string, object>
            {
                { "nominal_diameter", engine.NominalDiameter },
                { "fit_length", engine.FitLength },
                { "max_contact_pressure", engine.MaxContactPressure },
                { "safety_factor_sliding", engine.SafetyFactorSliding }
            });
        }
        catch (Exception ex)
        {
            await Analytics.TrackCalculationError("interference-fit", "calculation_failed", ex.Message);
            throw;
        }
        finally
        {
            isCalculating = false;
        }
    }

    private void BackToInput() => showResults = false;

    private void ClearForm()
    {
        engine = new();
        validationMessages.Clear();
        selectedShaftFit = "p6";
        selectedHubFit = "H7";
        selectedLoadFactor = "1.0";
        SetDefaultValues();
        showResults = false;
        openedFromSharedLink = false;
    }

    /// <summary>
    /// The module's inputs in the neutral form used by shareable links (and, later,
    /// cloud-saved calculations). Inputs only — results are recomputed on restore.
    ///
    /// Materials go in by name rather than by their index in MaterialService, so
    /// adding a material to that list cannot repoint existing links at the wrong
    /// steel. Keys are kept short because the whole state rides in a URL.
    /// </summary>
    private CalculationState BuildShareState() => new CalculationState("interference-fit")
        .Set("D", engine.NominalDiameter)
        .Set("L", engine.FitLength)
        .Set("di", engine.ShaftInnerDiameter)
        .Set("Da", engine.HubOuterDiameter)
        .Set("sf", selectedShaftFit)
        .Set("hf", selectedHubFit)
        .Set("sup", engine.ShaftUpperDeviation)
        .Set("slo", engine.ShaftLowerDeviation)
        .Set("hup", engine.HubUpperDeviation)
        .Set("hlo", engine.HubLowerDeviation)
        .Set("n", engine.RotationalSpeed)
        .Set("ts", engine.ShaftServiceTemperature)
        .Set("th", engine.HubServiceTemperature)
        .Set("T", engine.AppliedTorque)
        .Set("Fa", engine.AppliedAxialForce)
        .Set("phi", selectedLoadFactor)
        .Set("rzs", engine.ShaftRoughness)
        .Set("rzh", engine.HubRoughness)
        .Set("mut", engine.FrictionCoefficientTorque)
        .Set("mua", engine.FrictionCoefficientAssembly)
        .Set("ms", MaterialNameAt(selectedShaftMaterialIndex))
        .Set("mh", MaterialNameAt(selectedHubMaterialIndex));

    /// <summary>
    /// Restores state produced by <see cref="BuildShareState"/>, then recalculates so
    /// the recipient lands straight on the results.
    ///
    /// Every read supplies the current value as its fallback, so a link written by an
    /// older build that lacked a field leaves that field at its default instead of
    /// zeroing it.
    /// </summary>
    private async Task ApplyShareState(CalculationState state)
    {
        // Nominal diameter first: UpdateTolerances looks up the ISO 286 deviations
        // for the fit designation *at that diameter*.
        engine.NominalDiameter = state.GetDouble("D", engine.NominalDiameter);
        engine.FitLength = state.GetDouble("L", engine.FitLength);
        engine.ShaftInnerDiameter = state.GetDouble("di", engine.ShaftInnerDiameter);
        engine.HubOuterDiameter = state.GetDouble("Da", engine.HubOuterDiameter);

        selectedShaftFit = state.GetString("sf", selectedShaftFit);
        selectedHubFit = state.GetString("hf", selectedHubFit);
        UpdateTolerances();

        // UpdateTolerances overwrites the deviations for a standard fit, so the
        // stored values are only reapplied where the user was in custom mode.
        if (isCustomShaft)
        {
            engine.ShaftUpperDeviation = state.GetDouble("sup", engine.ShaftUpperDeviation);
            engine.ShaftLowerDeviation = state.GetDouble("slo", engine.ShaftLowerDeviation);
        }
        if (isCustomHub)
        {
            engine.HubUpperDeviation = state.GetDouble("hup", engine.HubUpperDeviation);
            engine.HubLowerDeviation = state.GetDouble("hlo", engine.HubLowerDeviation);
        }

        engine.RotationalSpeed = state.GetDouble("n", engine.RotationalSpeed);
        engine.ShaftServiceTemperature = state.GetDouble("ts", engine.ShaftServiceTemperature);
        engine.HubServiceTemperature = state.GetDouble("th", engine.HubServiceTemperature);
        engine.AppliedTorque = state.GetDouble("T", engine.AppliedTorque);
        engine.AppliedAxialForce = state.GetDouble("Fa", engine.AppliedAxialForce);
        engine.ShaftRoughness = state.GetDouble("rzs", engine.ShaftRoughness);
        engine.HubRoughness = state.GetDouble("rzh", engine.HubRoughness);
        engine.FrictionCoefficientTorque = state.GetDouble("mut", engine.FrictionCoefficientTorque);
        engine.FrictionCoefficientAssembly = state.GetDouble("mua", engine.FrictionCoefficientAssembly);

        var phi = state.GetString("phi", selectedLoadFactor);
        selectedLoadFactor = LoadFactorOptions.Contains(phi) ? phi : "1.0";
        OnLoadFactorChanged();

        selectedShaftMaterialIndex = MaterialIndexByName(state.GetString("ms"), selectedShaftMaterialIndex);
        selectedHubMaterialIndex = MaterialIndexByName(state.GetString("mh"), selectedHubMaterialIndex);

        openedFromSharedLink = true;

        // Calculate() validates, so a damaged link just leaves the user on the form.
        await Calculate();
    }

    private string MaterialNameAt(int index)
        => index >= 0 && index < materials.Count ? materials[index].Name : "";

    /// <summary>Resolves a material name to its current index, falling back when it is unknown.</summary>
    private int MaterialIndexByName(string name, int fallback)
    {
        if (string.IsNullOrEmpty(name)) return fallback;

        var index = materials.FindIndex(m => string.Equals(m.Name, name, StringComparison.OrdinalIgnoreCase));
        return index >= 0 ? index : fallback;
    }

    // --- Helper methods for styling and formatting ---
    private string GetSafetyRowClass(double sf) => sf < 1.0 ? "danger" : sf < 1.5 ? "warning" : sf >= 900 ? "" : "success";
    private string GetSafetyStatus(double sf) => sf < 1.0 ? "❌ FAIL" : sf < 1.5 ? "⚠️ Marginal" : "✓ OK";
    private string FormatSafetyFactor(double sf) => sf >= 900 ? "N/A" : sf.ToString("F2");

    private async Task SaveAsPdf()
    {
        isSavingPdf = true;
        StateHasChanged();
        try
        {
            var fileName = $"InterferenceFit-Report-{DateTime.Now:yyyyMMdd_HHmmss}.pdf";
            await JSRuntime.InvokeVoidAsync("generatePdf", "results-content", fileName);

            // Track PDF download
            await Analytics.TrackPdfDownload("interference-fit", fileName);
        }
        catch (Exception ex)
        {
            await Analytics.TrackCalculationError("interference-fit", "pdf_generation_failed", ex.Message);
            await JSRuntime.InvokeVoidAsync("console.error", $"PDF generation error: {ex.Message}");
        }
        finally
        {
            isSavingPdf = false;
        }
    }
}

