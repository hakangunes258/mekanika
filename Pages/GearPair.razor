    /// <summary>
    /// Typical roughness left by each finishing route, in micrometres Rz.
    ///
    /// These are workshop-representative values, NOT tabulated by any standard - which is
    /// why the fields they fill stay editable and the dialog says so. The one anchored
    /// number is the root fillet reference: ISO 6336-3 defines Y_RrelT = 1.0 at Rz = 10 um,
    /// so the hobbed row is the standard's own test gear.
    /// </summary>
    private static readonly (string Key, string Label, double Flank, double Root)[] FinishingRoutes =
    {
        ("hobbed",  "Hobbed / shaped",        10.0, 20.0),
        ("shaved",  "Hobbed and shaved",       4.0, 12.0),
        ("ground",  "Ground",                  3.0, 10.0),
        ("honed",   "Ground and honed",        1.6,  8.0),
        ("custom",  "Custom - enter Rz below", 0.0,  0.0)
    };

    private string finishingRoute1 = "custom", finishingRoute2 = "custom";

    private static readonly string[] FinishingRouteOptions =
        FinishingRoutes.Select(r => r.Key).ToArray();

    /// <summary>
    /// Writes the representative roughness of the chosen route into that gear's fields. The
    /// values stay editable afterwards - the route is a starting point, not a lock.
    /// </summary>
    private void OnFinishingRouteChanged(int gear)
    {
        string key = gear == 1 ? finishingRoute1 : finishingRoute2;
        var route = FinishingRoutes.FirstOrDefault(r => r.Key == key);
        if (route.Flank <= 0) return;               // "custom" leaves the fields alone

        if (gear == 1)
        {
            engine.FlankRoughnessRz1 = route.Flank;
            engine.RootRoughnessRz1 = route.Root;
        }
        else
        {
            engine.FlankRoughnessRz2 = route.Flank;
            engine.RootRoughnessRz2 = route.Root;
        }
    }

