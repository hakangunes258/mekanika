@page "/gear-pair"
@using MechanicalCalculatorWeb.Services
@inject AnalyticsService Analytics
@inject SeoService Seo
@inject ModuleMetadataService Metadata
@inject IJSRuntime JSRuntime

<PageTitle>Cylindrical Gear Pair Calculator - Mekanika</PageTitle>

<div class="page-header">
    <h1><ModuleIcon Type="gear-pair" Size="large" Style="transparent" CustomStyle="margin-right: 12px;" /> Cylindrical Gear Pair Calculator</h1>
    <p>Spur and helical gear pair design according to ISO 6336 / DIN 3990</p>
</div>

<SharedCalculationLoader Module="gear-pair" OnRestore="ApplyShareState" />

@if (!showResults)
{
    <!-- INPUT FORM -->
    <div class="form-grid">
        <!-- Basic Geometry Card -->
        <div class="card">
            <div class="card-header">
                <ModuleIcon Type="geometry" Size="medium" Style="solid" />
                <h2>Basic Geometry</h2>
            </div>

            <div class="form-group">
                <label>Normal Module (m<sub>n</sub>)</label>
                <div class="input-group">
                    <input type="number" step="0.1" @bind="engine.NormalModule" @bind:after="OnGeometryChanged" placeholder="e.g. 1.5" />
                    <span class="unit">mm</span>
                </div>
            </div>

            <div class="form-group">
                <label>Pressure Angle (&#945;<sub>n</sub>)</label>
                <div class="input-group">
                    <input type="number" step="0.5" @bind="engine.PressureAngle" @bind:after="OnGeometryChanged" placeholder="e.g. 20" />
                    <span class="unit">&#176;</span>
                </div>
            </div>

            <div class="form-group">
                <label>Helix Angle (&#946;)</label>
                <div class="input-group">
                    <input type="number" step="1" @bind="engine.HelixAngle" @bind:after="OnGeometryChanged" placeholder="e.g. 0 or 25" />
                    <span class="unit">&#176;</span>
                </div>
                <small style="color: #6c757d; font-size: 12px;">0&#176; for spur gear, 15-30&#176; for helical</small>
            </div>

            <div class="form-group">
                <label>Center Distance (a)</label>
                <div class="input-group">
                    <input type="number" step="0.1" @bind="engine.CenterDistance" @bind:after="OnGeometryChanged" placeholder="e.g. 48.9" />
                    <span class="unit">mm</span>
                </div>
                @if (engine.ReferenceCentreDistance() > 0)
                {
                    <small style="color: #6c757d; font-size: 12px;">
                        Reference (&#931;x = 0): @engine.ReferenceCentreDistance().ToString("F3") mm
                        <button type="button" class="btn btn-secondary" style="margin-left: 8px; padding: 2px 10px; font-size: 11px;" @onclick="UseReferenceCentreDistance">Use</button>
                    </small>
                }
            </div>
        </div>

        <!-- Gear 1 (Pinion) Card -->
        <div class="card">
            <div class="card-header">
                <ModuleIcon Type="gear" Size="medium" Style="solid" />
                <h2>Gear 1 (Pinion)</h2>
                @GearAdvancedDialog(1)
            </div>

            <div class="form-group">
                <label>Number of Teeth (z<sub>1</sub>)</label>
                <div class="input-group">
                    <input type="number" step="1" @bind="engine.NumberOfTeeth1" @bind:after="OnGeometryChanged" placeholder="e.g. 16" />
                    <span class="unit">-</span>
                </div>
            </div>

            <div class="form-group">
                <label>Face Width (b<sub>1</sub>)</label>
                <div class="input-group">
                    <input type="number" step="0.5" @bind="engine.FaceWidth1" placeholder="e.g. 14" />
                    <span class="unit">mm</span>
                </div>
            </div>

            <div class="form-group">
                <label>Profile Shift Coefficient (x<sub>1</sub>)</label>
                <div class="input-group">
                    <input type="number" step="0.01" @bind="engine.ProfileShiftCoeff1" @bind:after="OnGeometryChanged" placeholder="e.g. 0.3" />
                    <span class="unit">-</span>
                </div>
            </div>

            <div class="form-group">
                <div class="label-row">
                    <label>Quality Grade (ISO 1328)</label>
                    @QualityPicker(1)
                </div>
                <select @bind="engine.QualityGrade1">
                    @foreach (var (grade, label) in QualityGradeChoices)
                    {
                        <option value="@grade">@label</option>
                    }
                </select>
            </div>

        </div>

        <!-- Gear 2 (Wheel) Card -->
        <div class="card">
            <div class="card-header">
                <ModuleIcon Type="gear" Size="medium" Style="solid" />
                <h2>Gear 2 (Wheel)</h2>
                @GearAdvancedDialog(2)
            </div>

            <div class="form-group">
                <label>Number of Teeth (z<sub>2</sub>)</label>
                <div class="input-group">
                    <input type="number" step="1" @bind="engine.NumberOfTeeth2" @bind:after="OnGeometryChanged" placeholder="e.g. 43" />
                    <span class="unit">-</span>
                </div>
            </div>

            <div class="form-group">
                <label>Face Width (b<sub>2</sub>)</label>
                <div class="input-group">
                    <input type="number" step="0.5" @bind="engine.FaceWidth2" placeholder="e.g. 14.5" />
                    <span class="unit">mm</span>
                </div>
            </div>

            <div class="form-group">
                <label>Profile Shift Coefficient (x<sub>2</sub>)</label>
                <div class="input-group">
                    @* Not @bind: two-way binding round-trips the full double and printed
                       -0,2709082744758868 in a read-only box. *@
                    <input type="number" step="0.01" readonly
                           value="@engine.ProfileShiftCoeff2.ToString("F4", Inv)" />
                    <span class="unit">-</span>
                </div>
                <small style="color: #6c757d; font-size: 12px;">Auto-calculated from center distance</small>
            </div>

            <div class="form-group">
                <div class="label-row">
                    <label>Quality Grade (ISO 1328)</label>
                    @QualityPicker(2)
                </div>
                <select @bind="engine.QualityGrade2">
                    @foreach (var (grade, label) in QualityGradeChoices)
                    {
                        <option value="@grade">@label</option>
                    }
                </select>
            </div>

        </div>

        <!-- Materials & Lubrication Card -->
        <div class="card">
            <div class="card-header">
                <ModuleIcon Type="material" Size="medium" Style="solid" />
                <h2>Materials</h2>
            </div>

            <div class="form-group">
                <label>Pinion Material</label>
                <select @bind="selectedMaterial1Index">
                    @for (int i = 0; i < gearMaterials.Count; i++)
                    {
                        <option value="@i">@gearMaterials[i].Label@(gearMaterials[i].IsCustom ? " · mine" : "")</option>
                    }
                </select>
                @if (gearMaterials.Any())
                {
                    <div class="material-info">
                        &#963;<sub>Flim</sub> = @gearMaterials[selectedMaterial1Index].BendingFatigueLimit.ToString("F0") MPa |
                        &#963;<sub>Hlim</sub> = @gearMaterials[selectedMaterial1Index].ContactFatigueLimit.ToString("F0") MPa
                        (ISO 6336-5 @gearMaterials[selectedMaterial1Index].Quality, @gearMaterials[selectedMaterial1Index].SurfaceHardnessIso.ToString("F0") HV/HBW)
                    </div>
                }
            </div>

            <div class="form-group">
                <label>Wheel Material</label>
                <select @bind="selectedMaterial2Index">
                    @for (int i = 0; i < gearMaterials.Count; i++)
                    {
                        <option value="@i">@gearMaterials[i].Label@(gearMaterials[i].IsCustom ? " · mine" : "")</option>
                    }
                </select>
                @if (gearMaterials.Any())
                {
                    <div class="material-info">
                        &#963;<sub>Flim</sub> = @gearMaterials[selectedMaterial2Index].BendingFatigueLimit.ToString("F0") MPa |
                        &#963;<sub>Hlim</sub> = @gearMaterials[selectedMaterial2Index].ContactFatigueLimit.ToString("F0") MPa
                        (ISO 6336-5 @gearMaterials[selectedMaterial2Index].Quality, @gearMaterials[selectedMaterial2Index].SurfaceHardnessIso.ToString("F0") HV/HBW)
                    </div>
                }
                <small style="color: #6c757d; font-size: 12px;">
                    Grades, their ISO 6336-5 classification and your own additions live in the
                    <a href="materials">material database</a>.
                </small>
            </div>

        </div>

        <!-- Lubrication Card -->
        <div class="card">
            @* The dialog trigger sits in the header rather than beside the select: everything
               it holds describes the lubricant as a whole, not that one field. *@
            <div class="card-header">
                <ModuleIcon Type="lubrication" Size="medium" Style="solid" />
                <h2>Lubrication</h2>
                @LubricantDataDialog()
            </div>

            @* One product select, and every number behind it in a dialog. It used to be six
               fields on the card - viscosity grade, nu40, nu100, density, base oil type, FZG
               stage - which is more than the lubricant deserves next to the geometry, and it
               made "Grease" look like an alternative to "Mineral" rather than something with a
               mineral base oil of its own. *@
            <div class="form-group">
                <label>Lubricant</label>
                @* Filtered by the lubrication method: greases when the mesh is grease-packed,
                   oils otherwise. Offering both at once is what made "Grease" read as an
                   alternative to a base oil type rather than a state the lubricant is in. *@
                <select @bind="selectedLubricant" @bind:after="OnLubricantChanged">
                    @foreach (var l in LubricantPreset.For(engine.LubricationMethod))
                    {
                        <option value="@l.Name">@l.Name</option>
                    }
                    <option value="@LubricantPreset.CustomName">Custom &#8212; enter data</option>
                </select>
                <small style="color: #6c757d; font-size: 12px;">
                    &#957;<sub>40</sub> = @engine.LubricantViscosity40.ToString("F0") &#183;
                    &#957;<sub>100</sub> = @(engine.LubricantViscosity100 > 0 ? engine.LubricantViscosity100.ToString("F1") : "est.") &#183;
                    &#961; = @engine.OilDensity.ToString("F3") &#183; @OilTypeLabel(engine.OilType) &#183;
                    FZG @engine.FzgLoadStage.ToString("F0")
                    @if (LubricantPreset.Find(selectedLubricant)?.FzgStageA8390 is null)
                    {
                        <text>&#8202;<strong>(not from this product &#8212; check it)</strong></text>
                    }.
                    Open the panel for these and for a custom lubricant.
                </small>
            </div>

            <div class="form-group">
                <div class="label-row">
                    <label>Lubrication Method</label>
                    <DialogButton Title="Lubrication Method &#8212; ISO/TR 13989-1 Eq. (22)" MaxWidth="620">
                        <Intro>
                            The method does not change the flash temperature, which is set by the
                            contact itself. It changes how well the heat leaves the teeth, and so
                            how hot the <em>bulk</em> runs &#8212; and the contact temperature is the
                            sum of the two.
                        </Intro>
                        <ChildContent>
                            <table class="info-table">
                                <thead>
                                    <tr><th>Method</th><th class="num">X<sub>S</sub></th><th>Effect</th></tr>
                                </thead>
                                <tbody>
                                    <tr class="@(engine.LubricationMethod == LubricationMethod.Spray ? "is-current" : null)">
                                        <td>Injected spray</td><td class="num">1.2</td>
                                        <td>Heat transfer into the oil is impeded; the bulk runs hottest</td>
                                    </tr>
                                    <tr class="@(engine.LubricationMethod == LubricationMethod.Dip ? "is-current" : null)">
                                        <td>Dip (splash)</td><td class="num">1.0</td>
                                        <td>The reference case; also a mesh with an additional cooling spray</td>
                                    </tr>
                                    <tr class="@(engine.LubricationMethod == LubricationMethod.Submerged ? "is-current" : null)">
                                        <td>Submerged in oil</td><td class="num">0.2</td>
                                        <td>Only with sufficient cooling</td>
                                    </tr>
                                    <tr class="@(engine.LubricationMethod == LubricationMethod.Grease ? "is-current" : null)">
                                        <td>Grease</td><td class="num">1.2</td>
                                        <td>
                                            Outside the standard's scope; taken as a spray because
                                            grease does not circulate. Use the base oil's viscosity
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </ChildContent>
                        <Footer>
                            &#920;<sub>M</sub> = &#920;<sub>oil</sub> +
                            0.47&#183;X<sub>S</sub>&#183;X<sub>mp</sub>&#183;&#920;<sub>flm</sub>.
                            Scuffing is the only check in this module that the method reaches.
                        </Footer>
                    </DialogButton>
                </div>
                <select @bind="engine.LubricationMethod" @bind:after="OnLubricationMethodChanged">
                    <option value="@LubricationMethod.Spray">Injected spray</option>
                    <option value="@LubricationMethod.Dip">Dip (splash)</option>
                    <option value="@LubricationMethod.Submerged">Submerged in oil</option>
                    <option value="@LubricationMethod.Grease">Grease</option>
                </select>
                @if (engine.LubricationMethod == LubricationMethod.Grease)
                {
                    <small style="color: #8a6d3b; font-size: 12px;">
                        Grease is taken at X<sub>S</sub> = 1.2, as for a spray &#8212; it does not
                        circulate, so it carries heat away no better. In the lubricant panel, give
                        the <strong>base oil's</strong> viscosities and density, not the NLGI
                        consistency, and <strong>still set a base oil type</strong>: a grease is a
                        base oil plus a thickener, so it has one. ISO/TR 13989 and ISO/TR 15144 are
                        written for oils, so the scuffing and micropitting results are a guide
                        rather than a rating.
                    </small>
                }
            </div>

            <div class="form-group">
                <label>Oil Temperature (&#920;<sub>oil</sub>)</label>
                <select @bind="OilTemperatureSource">
                    <option value="ambient">From ambient + rise</option>
                    <option value="direct">Entered directly</option>
                </select>
            </div>

            @if (engine.OilTemperatureFromAmbient)
            {
                <div class="form-group">
                    <div class="dual-field">
                        <div class="dual-box">
                            <span class="dual-cap">Ambient (&#176;C)</span>
                            <input type="number" step="1" @bind="engine.AmbientTemperature" />
                        </div>
                        <div class="dual-box">
                            <span class="dual-cap">Rise (K)</span>
                            <input type="number" step="1" min="0" @bind="engine.OilTemperatureRise" />
                        </div>
                    </div>
                    <small style="color: #6c757d; font-size: 12px;">
                        &#920;<sub>oil</sub> =
                        <strong>@((engine.AmbientTemperature + engine.OilTemperatureRise).ToString("F0")) &#176;C</strong>.
                        The rise is your own figure &#8212; this module does not model a thermal
                        network, and a guessed one would be worse than asking.
                    </small>
                </div>
            }
            else
            {
                <div class="form-group">
                    <div class="input-group">
                        <input type="number" step="1" @bind="engine.OilTemperatureDirect" />
                        <span class="unit">&#176;C</span>
                    </div>
                </div>
            }

        </div>

        <!-- Reference Profile Card -->
        <div class="card">
            <div class="card-header">
                <ModuleIcon Type="dimensions" Size="medium" Style="solid" />
                <h2>Reference Profile (ISO 53)</h2>
            </div>

            <div class="form-group">
                <label>Addendum Coefficient (h*<sub>aP</sub>)</label>
                <div class="input-group">
                    <input type="number" step="0.05" @bind="engine.AddendumCoeff" />
                    <span class="unit">-</span>
                </div>
            </div>

            <div class="form-group">
                <label>Dedendum Coefficient (h*<sub>fP</sub>)</label>
                <div class="input-group">
                    <input type="number" step="0.05" @bind="engine.DedendumCoeff" />
                    <span class="unit">-</span>
                </div>
            </div>

            <div class="form-group">
                <label>Root Radius Coefficient (&#961;*<sub>fP</sub>)</label>
                <div class="input-group">
                    <input type="number" step="0.05" @bind="engine.RootRadiusCoeff" />
                    <span class="unit">-</span>
                </div>
                <small style="color: #6c757d; font-size: 12px;">ISO 53 profile A: 0.38, profile B: 0.30</small>
            </div>

            <div class="form-group">
                <label>Tip Alteration (k)</label>
                <select @bind="engine.TipAlterationMode" @bind:after="OnGeometryChanged">
                    <option value="@TipAlterationSource.None">None &#8212; full depth, k = 0</option>
                    <option value="@TipAlterationSource.Calculated">Calculated &#8212; k = y &#8722; &#931;x, keeps the tip clearance</option>
                    <option value="@TipAlterationSource.Manual">Manual &#8212; enter k</option>
                </select>
            </div>

            @if (engine.TipAlterationMode == TipAlterationSource.Manual)
            {
                <div class="form-group">
                    <label>k</label>
                    <div class="input-group">
                        <input type="number" step="0.01" @bind="engine.TipAlterationCoeff" />
                        <span class="unit">-</span>
                    </div>
                    <small style="color: #6c757d; font-size: 12px;">Negative shortens the teeth.</small>
                </div>
            }
            else if (engine.TipAlterationMode == TipAlterationSource.Calculated && PreviewTipAlteration() is { } kPreview)
            {
                <div class="alert alert-success" style="margin: 12px 0;">
                    <span>&#8730;</span>
                    <div>k = @kPreview.ToString("F4") for the geometry entered above.</div>
                </div>
            }
        </div>
        <!-- Tooth Thickness & Backlash Card -->
        <div class="card">
            <div class="card-header">
                <ModuleIcon Type="depth" Size="medium" Style="solid" />
                <h2>Tooth Thickness &amp; Backlash</h2>
            </div>

            <div class="form-group">
                <div class="label-row">
                    <label>Tooth Thickness Tolerance</label>
                    @if (ToleranceSource == "manual")
                    {
                        @ToleranceDialog()
                    }
                </div>
                <select @bind="ToleranceSource">
                    <option value="auto">Automatic &#8212; ISO/TR 10064-2 minimum backlash</option>
                    <option value="din3967">DIN 3967 tolerance zone (e.g. 27cd)</option>
                    <option value="manual">From a measurement or a required backlash&#8230;</option>
                </select>
                <small style="color: #6c757d; font-size: 12px;">
                    @if (ToleranceSource == "manual")
                    {
                        <text>
                            Currently: <strong>@ManualToleranceSummary</strong>. Open the dialog beside
                            the label to change what you are specifying and enter it.
                        </text>
                    }
                    else
                    {
                        <text>
                            Whatever you choose ends up as the allowances
                            A<sub>sne</sub> / A<sub>sni</sub>. The first two come straight from a
                            standard; the third is for when you have a measured W<sub>k</sub> or
                            M<sub>d</sub>, or a backlash the drive has to meet.
                        </text>
                    }
                </small>
            </div>

            @if (engine.AllowanceMode == ToothThicknessAllowanceMode.Din3967)
            {
                <div class="form-group">
                    <div class="label-row">
                        <label>Allowance Series (A<sub>sne</sub>)</label>
                        <DialogButton Title="DIN 3967 Allowance Series &#8212; Table 1"
                                      MaxWidth="700"
                                      Disabled="@Din3967PickerBlocked()"
                                      ButtonTitle="@(Din3967PickerBlocked()
                                          ? "Enter the module and tooth counts first"
                                          : "Allowances for every series, both gears")">
                            <Intro>
                                Micrometres, for d<sub>1</sub> = @ReferenceDiameterOf(1).ToString("F2") mm and
                                d<sub>2</sub> = @ReferenceDiameterOf(2).ToString("F2") mm, with the tolerance
                                series set below (@engine.Din3967ToleranceSeries1 /
                                @engine.Din3967ToleranceSeries2). Series a is the coarsest, h is zero
                                allowance; Clause 3.1 takes one letter for both gears as the rule.
                            </Intro>
                            <ChildContent>
                                <div class="dialog-scroll">
                                    <table class="info-table">
                                        <thead>
                                            <tr>
                                                <th rowspan="2">Series</th>
                                                <th colspan="2" class="num" style="text-align: center;">Gear 1</th>
                                                <th colspan="2" class="num" style="text-align: center;">Gear 2</th>
                                            </tr>
                                            <tr>
                                                <th class="num">A<sub>sne</sub></th>
                                                <th class="num">A<sub>sni</sub></th>
                                                <th class="num">A<sub>sne</sub></th>
                                                <th class="num">A<sub>sni</sub></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var r in Din3967SeriesRows())
                                            {
                                                var letter = SeriesLetterOf(r.Designation);
                                                var second = Din3967SecondGear(letter);
                                                <tr class="@(letter == engine.Din3967AllowanceSeries ? "is-current" : null)">
                                                    <td><strong>@letter</strong></td>
                                                    <td class="num">@r.AsneMicron.ToString("F0")</td>
                                                    <td class="num">@r.AsniMicron.ToString("F0")</td>
                                                    <td class="num">@(second?.AsneMicron.ToString("F0") ?? "—")</td>
                                                    <td class="num">@(second?.AsniMicron.ToString("F0") ?? "—")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </ChildContent>
                            <Footer>
                                DIN 3967 (August 1978), Tables 1 and 2. The allowances are tabulated; the
                                backlash that follows is the <em>theoretical</em> one. Clause A.1.2 lists the
                                effects that sit between the two &#8212; temperature, housing tolerance, bore
                                parallelism, tooth deviations and elasticity.
                            </Footer>
                        </DialogButton>
                    </div>
                    <select @bind="engine.Din3967AllowanceSeries">
                        @foreach (var letter in Din3967.AllowanceSeries)
                        {
                            <option value="@letter">@letter</option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label>Tolerance Series T<sub>sn</sub> (gear 1 / gear 2)</label>
                    <div class="input-group">
                        <select @bind="engine.Din3967ToleranceSeries1">
                            @foreach (var s in Din3967.ToleranceSeries)
                            {
                                <option value="@s">@s@(Din3967.IsPreferredToleranceSeries(s) ? " (preferred)" : "")</option>
                            }
                        </select>
                        <select @bind="engine.Din3967ToleranceSeries2" style="margin-left:8px;">
                            @foreach (var s in Din3967.ToleranceSeries)
                            {
                                <option value="@s">@s@(Din3967.IsPreferredToleranceSeries(s) ? " (preferred)" : "")</option>
                            }
                        </select>
                    </div>
                    <small style="color: #6c757d; font-size: 12px;">
                        Drawing designation = series number + letter, e.g.
                        <strong>@engine.Din3967ToleranceSeries1@engine.Din3967AllowanceSeries</strong> and
                        <strong>@engine.Din3967ToleranceSeries2@engine.Din3967AllowanceSeries</strong>.
                        A<sub>sni</sub> = A<sub>sne</sub> &#8722; T<sub>sn</sub>.
                    </small>
                </div>
            }

            <div class="form-group">
                <div class="label-row">
                    <label>Center Distance Tolerance</label>
                    <DialogButton Title="Centre Distance Tolerance &#8212; ISO 286"
                                  MaxWidth="640"
                                  Disabled="@(engine.CenterDistance <= 0)"
                                  ButtonTitle="@(engine.CenterDistance <= 0
                                      ? "Enter the centre distance first"
                                      : "Deviations for each ISO 286 field")">
                        <Intro>
                            Deviations at a = @engine.CenterDistance.ToString("F3") mm, in micrometres.
                            A<sub>a</sub> opens the backlash by
                            2&#183;A<sub>a</sub>&#183;sin&#945;<sub>wt</sub>&#183;cos&#946;<sub>b</sub>, so a
                            loose housing costs backlash as directly as thin teeth do.
                        </Intro>
                        <ChildContent>
                            <table class="info-table">
                                <thead>
                                    <tr>
                                        <th>Field</th>
                                        <th class="num">Upper</th>
                                        <th class="num">Lower</th>
                                        <th class="num">Total</th>
                                        <th>Typical housing</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var r in CentreDistanceFieldRows())
                                    {
                                        <tr class="@(r.Field == engine.CentreDistanceToleranceField ? "is-current" : null)">
                                            <td><strong>@r.Field</strong></td>
                                            <td class="num @(r.Supported ? null : "na")">@(r.Supported ? r.Upper.ToString("F0") : "—")</td>
                                            <td class="num @(r.Supported ? null : "na")">@(r.Supported ? r.Lower.ToString("F0") : "—")</td>
                                            <td class="num @(r.Supported ? null : "na")">@(r.Supported ? (r.Upper - r.Lower).ToString("F0") : "—")</td>
                                            <td>@r.Use</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </ChildContent>
                        <Footer>
                            js is symmetrical about the nominal centre distance
                            (es = &#8722;ei = IT/2). Entering deviations below overrides this choice
                            &#8212; use that for a housing drawing that is not a plain ISO field.
                        </Footer>
                    </DialogButton>
                </div>
                <select @bind="engine.CentreDistanceToleranceField" @bind:after="OnCentreDistanceFieldChanged">
                    @foreach (var field in CentreDistanceFieldOptions)
                    {
                        <option value="@field">@field</option>
                    }
                    <option value="custom">Custom &#8212; enter the deviations</option>
                </select>
            </div>

            <div class="form-group">
                <label>Center Distance Deviation (A<sub>a</sub>)</label>
                <div class="dual-field">
                    <div class="dual-box">
                        <span class="dual-cap">Upper</span>
                        <input type="number" step="1" @bind="aaUpperMicron"
                               readonly="@(engine.CentreDistanceToleranceField != "custom")" />
                    </div>
                    <div class="dual-box">
                        <span class="dual-cap">Lower</span>
                        <input type="number" step="1" @bind="aaLowerMicron"
                               readonly="@(engine.CentreDistanceToleranceField != "custom")" />
                    </div>
                    <span class="unit">&#956;m</span>
                </div>
                <small style="color: #6c757d; font-size: 12px;">
                    @if (engine.CentreDistanceToleranceField == "custom")
                    {
                        <text>Entered directly &#8212; for a housing drawing that is not a plain ISO field.</text>
                    }
                    else
                    {
                        <text>Filled from ISO 286 @engine.CentreDistanceToleranceField at the centre
                              distance above. Choose <em>Custom</em> to type your own.</text>
                    }
                </small>
            </div>

            <div class="form-group">
                <label>Tip Diameter Deviation (d<sub>a</sub>)</label>
                <div class="dual-field">
                    <div class="dual-box">
                        <span class="dual-cap">Upper</span>
                        <input type="number" step="1" @bind="daUpperMicron" />
                    </div>
                    <div class="dual-box">
                        <span class="dual-cap">Lower</span>
                        <input type="number" step="1" @bind="daLowerMicron" />
                    </div>
                    <span class="unit">&#956;m</span>
                </div>
            </div>

            <div class="form-group">
                <label>Root Diameter Deviation (d<sub>f</sub>)</label>
                <div class="dual-field">
                    <div class="dual-box">
                        <span class="dual-cap">Upper</span>
                        <input type="number" step="1" @bind="dfUpperMicron" />
                    </div>
                    <div class="dual-box">
                        <span class="dual-cap">Lower</span>
                        <input type="number" step="1" @bind="dfLowerMicron" />
                    </div>
                    <span class="unit">&#956;m</span>
                </div>
                <small style="color: #6c757d; font-size: 12px;">
                    Blank-turning tolerances, nominal 0/0. They are carried onto the drawing
                    dimensions in the results; ISO 6336 has no term for them, so they do not move
                    a safety factor.
                </small>
            </div>

        </div>
        <!-- Load Factors Card -->
        <div class="card">
            <div class="card-header">
                <ModuleIcon Type="loading" Size="medium" Style="solid" />
                <h2>Load Factors</h2>
            </div>

            <div class="form-group">
                <div class="label-row">
                    <label>Dynamic Factor (K<sub>V</sub>)</label>
                    @DynamicFactorDialog()
                </div>
                <div class="input-group">
                    <input type="number" step="0.01" min="1" @bind="KvShown" />
                    <span class="unit">-</span>
                </div>
                <small style="color: #6c757d; font-size: 12px;">
                    @if (engine.UseDirectDynamicFactor)
                    {
                        <text>
                            Entered directly. Open the dialog to calculate it from the tooth
                            deviations instead (ISO 6336-1 Clause 6, Method B).
                        </text>
                    }
                    else if (engine.DynamicResult is { Valid: true } kvr)
                    {
                        <text>
                            Calculated from the deviations: K<sub>V</sub> =
                            <strong>@kvr.KV.ToString("F3")</strong>.
                        </text>
                    }
                    else
                    {
                        <text>Calculated from the deviations after the next calculation.</text>
                    }
                </small>
            </div>

            <div class="form-group">
                <div class="label-row">
                    <label>Face Load Factor (K<sub>H&#946;</sub>)</label>
                    @FaceLoadFactorDialog()
                </div>
                <div class="input-group">
                    <input type="number" step="0.01" min="1" @bind="KhbShown" />
                    <span class="unit">-</span>
                </div>
                <small style="color: #6c757d; font-size: 12px;">
                    @if (engine.UseDirectFaceLoadFactor)
                    {
                        <text>
                            Entered directly; K<sub>F&#946;</sub> follows from it per ISO 6336-1
                            Eq. (69). Open the dialog to calculate it from the mesh misalignment
                            and shaft deflection instead.
                        </text>
                    }
                    else
                    {
                        @if (engine.FaceLoadFactorFlank > 0)
                        {
                            <text>
                                Calculated per ISO 6336-1 Clause 7.5, Method C:
                                K<sub>H&#946;</sub> = <strong>@engine.FaceLoadFactorFlank.ToString("F3")</strong>
                                after the last calculation.
                            </text>
                        }
                        else
                        {
                            <text>
                                Calculated per ISO 6336-1 Clause 7.5, Method C, from the shaft and
                                the flank tolerances &#8212; the value appears after the next
                                calculation.
                            </text>
                        }
                    }
                </small>
            </div>

            <div class="form-group">
                <label>Transverse Load Factor (K<sub>H&#945;</sub>)</label>
                <div class="input-group">
                    <input type="number" value="@engine.TransverseLoadFactorFlank.ToString("F3")" readonly />
                    <span class="unit">-</span>
                </div>
                <small style="color: #6c757d; font-size: 12px;">
                    Always from ISO 6336-1 Clause 8 &#8212; it follows from the mesh stiffness,
                    the tolerance class and the load, with no free choice to make.
                </small>
            </div>
        </div>

        <!-- Power Data Card -->
        <div class="card">
            <div class="card-header">
                <ModuleIcon Type="force" Size="medium" Style="solid" />
                <h2>Power Data</h2>
            </div>

            <div class="form-group">
                <label>Power (P)</label>
                <div class="input-group">
                    <input type="number" step="0.1" @bind="engine.Power" placeholder="e.g. 3.5" />
                    <span class="unit">kW</span>
                </div>
            </div>

            <div class="form-group">
                <label>Pinion Speed (n<sub>1</sub>)</label>
                <div class="input-group">
                    <input type="number" step="1" @bind="engine.Speed1" placeholder="e.g. 2500" />
                    <span class="unit">rpm</span>
                </div>
            </div>

            <div class="form-group">
                <div class="label-row">
                    <label>Application Factor (K<sub>A</sub>)</label>
                    @* Title is rendered as escaped text and Unicode has no subscript A, so the
                       heading says K_A rather than an entity that would show up verbatim.
                       Keep Razor comments OUT of a component's attribute list: one placed
                       between two attributes here compiled cleanly and then rendered nothing
                       at all - no button, no dialog. *@
                    <DialogButton Title="Application Factor K_A &#8212; ISO 6336-1 Table A.1" MaxWidth="720">
                        <Intro>
                            K<sub>A</sub> covers the load increase from the working characteristics of the
                            driving and the driven machine. Read the value off the row and column that
                            describe your drive, then select it in the field.
                        </Intro>
                        <ChildContent>
                            <div class="dialog-scroll">
                                <table class="info-table">
                                    <thead>
                                        <tr>
                                            <th rowspan="2">Driving machine</th>
                                            <th colspan="4" class="num" style="text-align: center;">Driven machine</th>
                                        </tr>
                                        <tr>
                                            @foreach (var driven in ApplicationFactorHeadings)
                                            {
                                                <th class="num">@driven</th>
                                            }
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @for (int i = 0; i < ApplicationFactorHeadings.Length; i++)
                                        {
                                            <tr>
                                                <td><strong>@ApplicationFactorHeadings[i]</strong></td>
                                                @for (int j = 0; j < ApplicationFactorHeadings.Length; j++)
                                                {
                                                    var cell = ApplicationFactorMatrix[i, j];
                                                    <td class="num @(IsSelectedKa(cell) ? "is-current" : null)">@cell.ToString("F2")</td>
                                                }
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <table class="info-table" style="margin-top: 18px;">
                                <thead>
                                    <tr><th>Working characteristic</th><th>Typical machine</th></tr>
                                </thead>
                                <tbody>
                                    <tr><td>Uniform</td><td>Electric motor, steady steam or gas turbine</td></tr>
                                    <tr><td>Light shocks</td><td>Steam or gas turbine with varying load; large, frequently started electric motor</td></tr>
                                    <tr><td>Moderate shocks</td><td>Multi-cylinder combustion engine</td></tr>
                                    <tr><td>Heavy shocks</td><td>Single-cylinder combustion engine</td></tr>
                                </tbody>
                            </table>
                        </ChildContent>
                        <Footer>
                            Values apply to gears working away from a resonant speed and under reasonably
                            uniform load. Where the driven machine can stall or the drive reverses,
                            ISO 6336-1 requires the peak torque to be checked separately &#8212;
                            K<sub>A</sub> does not cover it. The bottom-right case may need more than 2.25.
                        </Footer>
                    </DialogButton>
                </div>
                <select @bind="selectedApplicationFactor" @bind:after="OnApplicationFactorChanged">
                    @foreach (var (value, label) in ApplicationFactorChoices)
                    {
                        <option value="@value">@label</option>
                    }
                </select>
                <small style="color: #6c757d; font-size: 12px;">
                    The named cases are the row for a uniform prime mover.
                </small>
            </div>

            <div class="form-group">
                <label>Driving Gear</label>
                <select @bind="DrivingGear">
                    <option value="pinion">Gear 1 (pinion) drives &#8212; speed reducing</option>
                    <option value="wheel">Gear 2 (wheel) drives &#8212; speed increasing</option>
                </select>
            </div>

            <div class="form-group">
                <label>Required Service Life (H)</label>
                <div class="input-group">
                    <input type="number" step="100" @bind="engine.RequiredServiceLife" placeholder="e.g. 10000" />
                    <span class="unit">h</span>
                </div>
            </div>

            @* Both sit with the service life rather than with the load factors: they are
               statements about the S-N curve, not about how the load is shared. *@
            <div class="form-group">
                <div class="label-row">
                    <label>Life Curve Assumptions</label>
                    <DialogButton Title="Y_NT and Z_NT &#8212; what the two switches change"
                                  MaxWidth="680" ConfirmLabel="OK"
                                  ButtonTitle="What the two life-curve switches change">
                        <Intro>
                            Both change the life factors Y<sub>NT</sub> (tooth root) and
                            Z<sub>NT</sub> (flank), and nothing else. They move the permissible
                            stress, not the applied stress.
                        </Intro>
                        <ChildContent>
                            <table class="info-table">
                                <thead>
                                    <tr><th>Switch</th><th>Effect</th><th>Leave it off when</th></tr>
                                </thead>
                                <tbody>
                                    <tr class="@(engine.OptimumLifeConditions ? "is-current" : null)">
                                        <td>Optimum conditions</td>
                                        <td>Holds Y<sub>NT</sub> and Z<sub>NT</sub> at 1.0 in the long-life range instead of letting them fall to 0.85</td>
                                        <td>You cannot point to material, manufacturing and lubrication all being optimum, backed by experience &#8212; ISO 6336 asks for that, not for optimism</td>
                                    </tr>
                                    <tr class="@(engine.LimitedPittingPermissible ? "is-current" : null)">
                                        <td>Pitting permissible</td>
                                        <td>Moves the knee of Z<sub>NT</sub> from 5&#183;10<sup>7</sup> to 10<sup>9</sup> cycles, raising the permissible contact stress</td>
                                        <td>The gear is not allowed to pit &#8212; the usual case. It is the second row of ISO 6336-2 Table 2, for gears where some flank pitting is accepted in service</td>
                                    </tr>
                                </tbody>
                            </table>
                        </ChildContent>
                        <Footer>
                            Both default to off, which is the conservative reading. Turning either
                            on raises the safety factors without changing the gear.
                        </Footer>
                    </DialogButton>
                </div>
                <label class="checkbox-label">
                    <input type="checkbox" @bind="engine.OptimumLifeConditions" />
                    <span>Optimum conditions for the long-life range (Y<sub>NT</sub> = Z<sub>NT</sub> = 1.0)</span>
                </label>
                <small style="color: #6c757d; font-size: 12px;">
                    ISO 6336 allows this only with optimum material, manufacturing and lubrication
                    backed by experience. Leave unchecked for the conservative descending curve.
                </small>
            </div>

            <div class="form-group">
                <label class="checkbox-label">
                    <input type="checkbox" @bind="engine.LimitedPittingPermissible" />
                    <span>A certain amount of pitting is permissible on the flank</span>
                </label>
                <small style="color: #6c757d; font-size: 12px;">
                    Selects the second row of the ISO 6336-2 Table 2 life curve for through- and
                    surface-hardened steels: the knee of Z<sub>NT</sub> moves from 5&#183;10<sup>7</sup>
                    to 10<sup>9</sup> cycles, raising the permissible contact stress in the long-life
                    range. Leave unchecked unless the application really tolerates pitting.
                </small>
            </div>
        </div>

    </div>

    <ValidationAlert Messages="validationMessages" />

    <div class="button-group">
        <button class="btn btn-success btn-lg @(isCalculating ? "btn-calculating" : "")" @onclick="Calculate" disabled="@isCalculating">
            @if (isCalculating)
            {
                <span class="spinner"></span>
                <span>Calculating...</span>
            }
            else
            {
                <ModuleIcon Type="calculate" Size="button" Style="default" />
                <span>Calculate</span>
            }
        </button>
        <button class="btn btn-secondary" @onclick="ClearForm" disabled="@isCalculating">
            <ModuleIcon Type="clear" Size="button" Style="default" /> Clear
        </button>
    </div>
}
else
{
    <!-- RESULTS -->
    <div class="button-group" style="margin-bottom: 24px;">
        <button class="btn btn-secondary" @onclick="BackToInput">
            <ModuleIcon Type="back" Size="button" Style="default" /> Back to Input
        </button>
        <button class="btn btn-secondary" @onclick="ClearForm">
            <ModuleIcon Type="new" Size="button" Style="default" /> New Calculation
        </button>
        <button class="btn btn-info @(isSavingPdf ? "btn-saving" : "")" @onclick="SaveAsPdf" disabled="@isSavingPdf">
            @if (isSavingPdf)
            {
                <span class="spinner"></span>
                <span>Generating PDF...</span>
            }
            else
            {
                <ModuleIcon Type="pdf" Size="button" Style="default" />
                <span>Save as PDF</span>
            }
        </button>
        <Viewer3D Module="gear-pair" Parameters="@Build3dParameters()" />
        <ShareCalculation Module="gear-pair" State="@BuildShareState()" />
        <SaveCalculation Module="gear-pair" State="@BuildShareState()" />
    </div>

    @if (openedFromSharedLink)
    {
        <div class="alert alert-info" style="margin-bottom: 24px;">
            <ModuleIcon Type="info" Size="small" Style="default" />
            <div>
                <strong>Opened from a shared link.</strong>
                The inputs below came from the link and were recalculated with the current engine.
            </div>
        </div>
    }

    <!-- Detailed Results Container -->
    <div id="results-content">
        <!-- Basic Geometry Results -->
        <div class="card">
            <div class="card-header"><ModuleIcon Type="geometry" Size="medium" Style="solid" /><h2>Basic Geometry</h2></div>
            <table class="results-table">
                <thead><tr><th>Description</th><th>Symbol</th><th>Gear 1</th><th>Gear 2</th><th>Unit</th></tr></thead>
                <tbody>
                    <tr><td>Number of Teeth</td><td>z</td><td>@engine.NumberOfTeeth1</td><td>@engine.NumberOfTeeth2</td><td>-</td></tr>
                    <tr><td>Normal Module</td><td>m<sub>n</sub></td><td colspan="2">@engine.NormalModule.ToString("F3")</td><td>mm</td></tr>
                    <tr><td>Transverse Module</td><td>m<sub>t</sub></td><td colspan="2">@engine.TransverseModule.ToString("F3")</td><td>mm</td></tr>
                    <tr><td>Pressure Angle (Normal)</td><td>&#945;<sub>n</sub></td><td colspan="2">@engine.PressureAngle.ToString("F2")</td><td>&#176;</td></tr>
                    <tr><td>Pressure Angle (Transverse)</td><td>&#945;<sub>t</sub></td><td colspan="2">@engine.TransversePressureAngle.ToString("F3")</td><td>&#176;</td></tr>
                    <tr><td>Working Pressure Angle</td><td>&#945;<sub>wt</sub></td><td colspan="2">@engine.WorkingPressureAngle.ToString("F3")</td><td>&#176;</td></tr>
                    <tr><td>Helix Angle</td><td>&#946;</td><td colspan="2">@engine.HelixAngle.ToString("F2")</td><td>&#176;</td></tr>
                    <tr><td>Base Helix Angle</td><td>&#946;<sub>b</sub></td><td colspan="2">@engine.BaseHelixAngle.ToString("F3")</td><td>&#176;</td></tr>
                    <tr class="highlight"><td>Center Distance</td><td>a</td><td colspan="2">@engine.CenterDistance.ToString("F3")</td><td>mm</td></tr>
                    <tr><td>Gear Ratio</td><td>u</td><td colspan="2">@engine.GearRatio.ToString("F3")</td><td>-</td></tr>
                    <tr><td>Profile Shift Coefficient</td><td>x</td><td>@engine.ProfileShiftCoeff1.ToString("F4")</td><td>@engine.ProfileShiftCoeff2.ToString("F4")</td><td>-</td></tr>
                    <tr><td>Sum of Profile Shifts</td><td>&#931;x</td><td colspan="2">@engine.SumProfileShift.ToString("F4")</td><td>-</td></tr>
                    <tr class="@(engine.ProfileShiftCoeff1 < engine.MinProfileShift1 || engine.ProfileShiftCoeff2 < engine.MinProfileShift2 ? "warning" : "")">
                        <td>Undercut Limit</td><td>x<sub>min</sub></td>
                        <td>@engine.MinProfileShift1.ToString("F4")</td>
                        <td>@engine.MinProfileShift2.ToString("F4")</td><td>-</td>
                    </tr>
                </tbody>
            </table>
            @if (engine.ProfileShiftCoeff1 < engine.MinProfileShift1 || engine.ProfileShiftCoeff2 < engine.MinProfileShift2)
            {
                <div class="alert alert-warning" style="margin: 16px;">
                    <ModuleIcon Type="warning" Size="small" Style="default" CustomStyle="margin-right: 8px;" />
                    <strong>Undercut:</strong> at least one gear has x below the undercut limit x<sub>min</sub>.
                    The generating rack cuts into the involute flank, which shortens the usable profile
                    and weakens the root. Increase the profile shift or the number of teeth.
                </div>
            }
        </div>

        <!-- Diameters -->
        <div class="card">
            <div class="card-header"><ModuleIcon Type="diameter" Size="medium" Style="solid" /><h2>Diameters</h2></div>
            <table class="results-table">
                <thead><tr><th>Description</th><th>Symbol</th><th>Gear 1</th><th>Gear 2</th><th>Unit</th></tr></thead>
                <tbody>
                    <tr><td>Reference Diameter</td><td>d</td><td>@engine.ReferenceDiameter1.ToString("F3")</td><td>@engine.ReferenceDiameter2.ToString("F3")</td><td>mm</td></tr>
                    <tr><td>Base Diameter</td><td>d<sub>b</sub></td><td>@engine.BaseDiameter1.ToString("F3")</td><td>@engine.BaseDiameter2.ToString("F3")</td><td>mm</td></tr>
                    <tr class="highlight"><td>Tip Diameter</td><td>d<sub>a</sub></td><td>@engine.TipDiameter1.ToString("F3")</td><td>@engine.TipDiameter2.ToString("F3")</td><td>mm</td></tr>
                    @if (engine.TipDiameterUpperDev != 0 || engine.TipDiameterLowerDev != 0)
                    {
                        <tr><td>Tip Diameter Deviation</td><td>A<sub>da</sub></td>
                            <td colspan="2">@((engine.TipDiameterUpperDev * 1000).ToString("F0")) / @((engine.TipDiameterLowerDev * 1000).ToString("F0"))</td>
                            <td>&#956;m</td></tr>
                    }
                    <tr class="highlight"><td>Root Diameter</td><td>d<sub>f</sub></td><td>@engine.RootDiameter1.ToString("F3")</td><td>@engine.RootDiameter2.ToString("F3")</td><td>mm</td></tr>
                    @if (engine.RootDiameterUpperDev != 0 || engine.RootDiameterLowerDev != 0)
                    {
                        <tr><td>Root Diameter Deviation</td><td>A<sub>df</sub></td>
                            <td colspan="2">@((engine.RootDiameterUpperDev * 1000).ToString("F0")) / @((engine.RootDiameterLowerDev * 1000).ToString("F0"))</td>
                            <td>&#956;m</td></tr>
                    }
                    <tr><td>Working Pitch Diameter</td><td>d<sub>w</sub></td><td>@engine.WorkingPitchDiameter1.ToString("F3")</td><td>@engine.WorkingPitchDiameter2.ToString("F3")</td><td>mm</td></tr>
                    <tr><td>Addendum</td><td>h<sub>a</sub></td><td>@engine.Addendum1.ToString("F3")</td><td>@engine.Addendum2.ToString("F3")</td><td>mm</td></tr>
                    <tr><td>Dedendum</td><td>h<sub>f</sub></td><td>@engine.Dedendum1.ToString("F3")</td><td>@engine.Dedendum2.ToString("F3")</td><td>mm</td></tr>
                    <tr><td>Tooth Height</td><td>h</td><td colspan="2">@engine.ToothHeight.ToString("F3")</td><td>mm</td></tr>
                    <tr class="@(engine.TipAlterationCoeff != 0 ? "highlight" : "")">
                        <td>Tip Alteration Coefficient</td><td>k</td>
                        <td colspan="2">@engine.TipAlterationCoeff.ToString("F4")</td><td>-</td>
                    </tr>
                    <tr class="@(engine.TipClearance < 0.1 * engine.NormalModule ? "danger" : engine.TipClearance < 0.2 * engine.NormalModule ? "warning" : "")">
                        <td>Tip Clearance (working)</td><td>c</td><td colspan="2">@engine.TipClearance.ToString("F3")</td><td>mm</td>
                    </tr>
                </tbody>
            </table>
            @if (engine.TipAlterationNote != null)
            {
                <div class="alert alert-info" style="margin: 16px;">
                    <ModuleIcon Type="info" Size="small" Style="default" CustomStyle="margin-right: 8px;" />
                    <div>@engine.TipAlterationNote</div>
                </div>
            }
            else if (engine.TipAlterationMode == TipAlterationSource.None && engine.TipClearance < 0.2 * engine.NormalModule)
            {
                <div class="alert alert-warning" style="margin: 16px;">
                    <ModuleIcon Type="warning" Size="small" Style="default" CustomStyle="margin-right: 8px;" />
                    <div>
                        The tip clearance is tight and no tip alteration is applied. Setting
                        <strong>Tip Alteration</strong> to <em>Calculated</em> on the input form turns both
                        tips down by k&#183;m<sub>n</sub> and restores the reference profile's clearance
                        of @((engine.DedendumCoeff - engine.AddendumCoeff).ToString("F2"))&#183;m<sub>n</sub>.
                    </div>
                </div>
            }
            @if (engine.TipClearance < 0.1 * engine.NormalModule)
            {
                <div class="alert alert-danger" style="margin: 16px;">
                    <ModuleIcon Type="warning" Size="small" Style="default" CustomStyle="margin-right: 8px;" />
                    <strong>Tip clearance too small:</strong> c = @engine.TipClearance.ToString("F3") mm is below
                    0.1&#183;m<sub>n</sub>. At this center distance the tip of one gear can foul the root of the
                    other. Increase the center distance or reduce the tip diameters.
                </div>
            }
        </div>

        <!-- Contact Ratios -->
        <div class="card">
            <div class="card-header"><ModuleIcon Type="contact" Size="medium" Style="solid" /><h2>Contact Ratios &amp; Meshing</h2></div>
            <table class="results-table">
                <thead><tr><th>Description</th><th>Symbol</th><th>Value</th><th>Min. Req.</th><th>Status</th></tr></thead>
                <tbody>
                    <tr class="@(engine.TransverseContactRatio >= 1.2 ? "success" : engine.TransverseContactRatio >= 1.0 ? "warning" : "danger")">
                        <td>Transverse Contact Ratio</td><td>&#949;<sub>&#945;</sub></td><td>@engine.TransverseContactRatio.ToString("F3")</td><td>&#8805; 1.2</td><td>@(engine.TransverseContactRatio >= 1.2 ? "✓ OK" : engine.TransverseContactRatio >= 1.0 ? "⚠️ Marginal" : "❌ FAIL")</td></tr>
                    <tr><td>Overlap Ratio</td><td>&#949;<sub>&#946;</sub></td><td>@engine.OverlapRatio.ToString("F3")</td><td>-</td><td>-</td></tr>
                    <tr class="highlight"><td>Total Contact Ratio</td><td>&#949;<sub>&#947;</sub></td><td>@engine.TotalContactRatio.ToString("F3")</td><td>-</td><td>-</td></tr>
                    <tr><td>Virtual Contact Ratio</td><td>&#949;<sub>&#945;n</sub></td><td>@engine.VirtualContactRatio.ToString("F3")</td><td>-</td><td>-</td></tr>
                    <tr><td>Length of Path of Contact</td><td>g<sub>&#945;</sub></td><td>@engine.PathOfContact.ToString("F3")</td><td>mm</td><td>-</td></tr>
                    <tr><td>Approach Path / Contact Ratio</td><td>g<sub>f</sub> / &#949;<sub>1</sub></td><td>@engine.ApproachPath.ToString("F3") / @engine.ApproachContactRatio.ToString("F3")</td><td>mm / -</td><td>-</td></tr>
                    <tr><td>Recess Path / Contact Ratio</td><td>g<sub>a</sub> / &#949;<sub>2</sub></td><td>@engine.RecessPath.ToString("F3") / @engine.RecessContactRatio.ToString("F3")</td><td>mm / -</td><td>-</td></tr>
                    <tr class="@(Math.Abs(engine.SpecificSliding1) > 3.0 ? "warning" : "")"><td>Specific Sliding at Pinion Root</td><td>&#950;<sub>1</sub></td><td>@engine.SpecificSliding1.ToString("F3")</td><td>|&#950;| &#8804; 3</td><td>@(Math.Abs(engine.SpecificSliding1) > 3.0 ? "⚠️ High" : "✓ OK")</td></tr>
                    <tr class="@(Math.Abs(engine.SpecificSliding2) > 3.0 ? "warning" : "")"><td>Specific Sliding at Wheel Root</td><td>&#950;<sub>2</sub></td><td>@engine.SpecificSliding2.ToString("F3")</td><td>|&#950;| &#8804; 3</td><td>@(Math.Abs(engine.SpecificSliding2) > 3.0 ? "⚠️ High" : "✓ OK")</td></tr>
                    <tr><td>Gear Loss Factor</td><td>H<sub>V</sub></td><td>@engine.ToothLossFactor.ToString("F4")</td><td>-</td><td>-</td></tr>
                </tbody>
            </table>
            <div class="note-box">
                Specific sliding is the sliding velocity divided by that gear's own rolling velocity,
                &#950; = 1 &#8722; &#961;<sub>mate</sub>/(u&#183;&#961;), evaluated at the ends of the path of contact where it
                peaks. Values beyond about &#177;3 mean heavy sliding at the root and a raised risk of
                scuffing and wear &#8212; positive profile shift on the pinion is the usual remedy.
                H<sub>V</sub> is the ISO/TR 14179-2 gear loss factor: multiply it by a mean coefficient
                of friction to get the mesh power loss.
            </div>
        </div>

        <!-- Kinematics & Forces -->
        <div class="card">
            <div class="card-header"><ModuleIcon Type="force" Size="medium" Style="solid" /><h2>Kinematics & Forces</h2></div>
            <table class="results-table">
                <thead><tr><th>Description</th><th>Symbol</th><th>Gear 1</th><th>Gear 2</th><th>Unit</th></tr></thead>
                <tbody>
                    <tr><td>Speed</td><td>n</td><td>@engine.Speed1.ToString("F1")</td><td>@engine.Speed2.ToString("F1")</td><td>rpm</td></tr>
                    <tr><td>Torque</td><td>T</td><td>@engine.Torque1.ToString("F2")</td><td>@engine.Torque2.ToString("F2")</td><td>Nm</td></tr>
                    <tr><td>Pitch Line Velocity</td><td>v</td><td colspan="2">@engine.PitchLineVelocity.ToString("F2")</td><td>m/s</td></tr>
                    <tr class="highlight"><td>Tangential Force</td><td>F<sub>t</sub></td><td colspan="2">@engine.TangentialForce.ToString("F0")</td><td>N</td></tr>
                    <tr><td>Radial Force</td><td>F<sub>r</sub></td><td colspan="2">@engine.RadialForce.ToString("F0")</td><td>N</td></tr>
                    <tr><td>Axial Force</td><td>F<sub>a</sub></td><td colspan="2">@engine.AxialForce.ToString("F0")</td><td>N</td></tr>
                    <tr><td>Normal Force</td><td>F<sub>n</sub></td><td colspan="2">@engine.NormalForce.ToString("F0")</td><td>N</td></tr>
                    <tr><td>Specific Load</td><td>w</td><td colspan="2">@engine.SpecificLoad.ToString("F1")</td><td>N/mm</td></tr>
                </tbody>
            </table>
        </div>

        <!-- Load Factors -->
        <div class="card">
            <div class="card-header"><ModuleIcon Type="force" Size="medium" Style="solid" /><h2>Load Factors (ISO 6336-1)</h2></div>
            <table class="results-table">
                <thead><tr><th>Description</th><th>Symbol</th><th>Value</th><th>Unit</th></tr></thead>
                <tbody>
                    <tr><td>Application Factor</td><td>K<sub>A</sub></td><td>@engine.ApplicationFactor.ToString("F2")</td><td>-</td></tr>
                    <tr><td>Dynamic Factor</td><td>K<sub>V</sub></td><td>@engine.DynamicFactor.ToString("F3")</td><td>-</td></tr>
                    <tr><td>Face Load Factor (Flank)</td><td>K<sub>H&#946;</sub></td><td>@engine.FaceLoadFactorFlank.ToString("F3")</td><td>-</td></tr>
                    <tr><td>Face Load Factor (Root)</td><td>K<sub>F&#946;</sub></td><td>@engine.FaceLoadFactorRoot.ToString("F3")</td><td>-</td></tr>
                    <tr><td>Transverse Load Factor (Flank)</td><td>K<sub>H&#945;</sub></td><td>@engine.TransverseLoadFactorFlank.ToString("F3")</td><td>-</td></tr>
                    <tr><td>Transverse Load Factor (Root)</td><td>K<sub>F&#945;</sub></td><td>@engine.TransverseLoadFactorRoot.ToString("F3")</td><td>-</td></tr>
                    @if (engine.ShaftDeflectionResult is { Valid: true } sd)
                    {
                        <tr><td>Shaft Deflection (Eq. 57)</td><td>f<sub>sh</sub></td><td>@sd.fsh.ToString("F2")</td><td>&#956;m</td></tr>
                        <tr><td>Figure 13 Constant</td><td>K&#8242;</td><td>@sd.KPrime.ToString("F2") (@(sd.Stiffened ? "stiffened" : "unstiffened"))</td><td>-</td></tr>
                        <tr><td>Pinion Offset Ratio</td><td>s/l</td><td>@sd.OffsetRatio.ToString("F3")</td><td>-</td></tr>
                        <tr><td>Eq. 57 Bracket</td><td>-</td><td>@sd.Bracket.ToString("F3")</td><td>-</td></tr>
                    }
                    else if (engine.FshSource == ShaftDeflectionSource.Manual)
                    {
                        <tr><td>Shaft Deflection (entered)</td><td>f<sub>sh</sub></td><td>@engine.ShaftDeflectionFsh.ToString("F2")</td><td>&#956;m</td></tr>
                    }
                    @if (engine.FaceLoadResult is { } fl)
                    {
                        @if (fl.FbxFloored)
                        {
                            <tr class="warning"><td>Calculated Misalignment (before floor)</td><td>-</td><td>@fl.FbxCalculated.ToString("F2")</td><td>&#956;m</td></tr>
                            <tr class="warning"><td>Minimum Misalignment (Eq. 56)</td><td>F<sub>&#946;x,min</sub></td><td>@fl.FbxMin.ToString("F2")</td><td>&#956;m</td></tr>
                        }
                        <tr><td>Initial Equivalent Misalignment</td><td>F<sub>&#946;x</sub></td><td>@fl.Fbx.ToString("F2")</td><td>&#956;m</td></tr>
                        <tr><td>Running-in Allowance</td><td>y<sub>&#946;</sub></td><td>@fl.yBeta.ToString("F2")</td><td>&#956;m</td></tr>
                        <tr><td>Effective Misalignment</td><td>F<sub>&#946;y</sub></td><td>@fl.Fby.ToString("F2")</td><td>&#956;m</td></tr>
                        <tr><td>Table 8 Constants</td><td>B<sub>1</sub>/B<sub>2</sub></td><td>@fl.B1.ToString("F2") / @fl.B2.ToString("F2")</td><td>-</td></tr>
                        <tr><td>Mean Load Intensity</td><td>F<sub>m</sub>/b</td><td>@fl.FmOverB.ToString("F1")</td><td>N/mm</td></tr>
                        <tr><td>Contact Width Ratio</td><td>b<sub>cal</sub>/b</td><td>@fl.BcalOverB.ToString("F3")</td><td>-</td></tr>
                        <tr><td>Root Exponent</td><td>N<sub>F</sub></td><td>@fl.NF.ToString("F3")</td><td>-</td></tr>
                    }
                    @if (engine.TransverseResult is { } tr)
                    {
                        <tr><td>Running-in Allowance</td><td>y<sub>&#945;</sub></td><td>@tr.yAlpha.ToString("F2")</td><td>&#956;m</td></tr>
                        <tr><td>Determinant Load</td><td>F<sub>tH</sub></td><td>@tr.FtH.ToString("F0")</td><td>N</td></tr>
                        <tr><td>q<sub>&#945;</sub> = c<sub>&#947;&#945;</sub>(f<sub>pb</sub>&#8722;y<sub>&#945;</sub>)/(F<sub>tH</sub>/b)</td><td>q<sub>&#945;</sub></td><td>@tr.qAlpha.ToString("F3")</td><td>-</td></tr>
                        @if (tr.KHalphaLimited || tr.KFalphaLimited)
                        {
                            <tr class="warning"><td colspan="4">Limited by ISO 6336-1 8.3.3 / 8.3.4 boundary conditions</td></tr>
                        }
                    }
                </tbody>
            </table>

            @if (engine.DynamicResult is { Valid: true } dyn)
            {
                <h4 style="margin: 20px 16px 8px; color: #495057;">K<sub>V</sub> breakdown (ISO 6336-1 Method B)</h4>
                <table class="results-table">
                    <thead><tr><th>Description</th><th>Symbol</th><th>Value</th><th>Unit</th></tr></thead>
                    <tbody>
                        <tr><td>Specific Loading</td><td>F<sub>t</sub>K<sub>A</sub>/b</td><td>@dyn.SpecificLoad.ToString("F1")</td><td>N/mm</td></tr>
                        <tr><td>Single Tooth Stiffness</td><td>c&#8242;</td><td>@dyn.cPrime.ToString("F2")</td><td>N/(mm&#183;&#956;m)</td></tr>
                        <tr><td>Mesh Stiffness</td><td>c<sub>&#947;&#945;</sub></td><td>@dyn.cGammaAlpha.ToString("F2")</td><td>N/(mm&#183;&#956;m)</td></tr>
                        <tr><td>Reduced Mass</td><td>m<sub>red</sub></td><td>@dyn.mred.ToString("F5")</td><td>kg/mm</td></tr>
                        <tr><td>Resonance Speed</td><td>n<sub>E1</sub></td><td>@dyn.nE1.ToString("F0")</td><td>rpm</td></tr>
                        <tr class="highlight"><td>Resonance Ratio</td><td>N</td><td>@dyn.N.ToString("F3")</td><td>-</td></tr>
                        <tr><td>Lower Limit of Main Resonance</td><td>N<sub>S</sub></td><td>@dyn.NS.ToString("F3")</td><td>-</td></tr>
                        <tr class="@(dyn.Range == Iso6336DynamicFactor.SpeedRange.Subcritical || dyn.Range == Iso6336DynamicFactor.SpeedRange.Supercritical ? "success" : "warning")">
                            <td>Operating Range</td><td>-</td><td>@dyn.Range</td><td>-</td>
                        </tr>
                        <tr><td>B<sub>p</sub> / B<sub>f</sub> / B<sub>k</sub></td><td>-</td><td>@dyn.Bp.ToString("F3") / @dyn.Bf.ToString("F3") / @dyn.Bk.ToString("F3")</td><td>-</td></tr>
                        <tr class="highlight"><td>Dynamic Factor</td><td>K<sub>V</sub></td><td>@dyn.KV.ToString("F4")</td><td>-</td></tr>
                    </tbody>
                </table>

                @foreach (var wmsg in dyn.Warnings)
                {
                    <div class="alert alert-warning" style="margin: 12px 16px;">@wmsg</div>
                }
            }

            @if (engine.ShaftDeflectionResult is { } sdNotes)
            {
                @foreach (var n in sdNotes.Notes)
                {
                    <div class="alert alert-warning" style="margin: 12px 16px; font-size: 13px;">@n</div>
                }
            }

            @if (engine.FaceLoadResult is { } flNotes)
            {
                @foreach (var n in flNotes.Notes)
                {
                    <div class="alert alert-warning" style="margin: 12px 16px; font-size: 13px;">@n</div>
                }
            }

            @if (engine.DeviationNote != null)
            {
                <div class="note-box tight">
                    <strong>Deviation source:</strong> @engine.DeviationNote
                </div>
            }
        </div>

        <!-- Manufacturing Tolerances -->
        <div class="card">
            <div class="card-header"><ModuleIcon Type="tolerance" Size="medium" Style="solid" /><h2>Flank Tolerances (ISO 1328-1)</h2></div>
            <table class="results-table">
                <thead><tr><th>Description</th><th>Symbol</th><th>Gear 1</th><th>Gear 2</th><th>Unit</th></tr></thead>
                <tbody>
                    <tr class="highlight"><td>Flank Tolerance Class</td><td>A</td><td>@engine.QualityGrade1</td><td>@engine.QualityGrade2</td><td>-</td></tr>
                    @if (engine.Tolerance1 is { } t1 && engine.Tolerance2 is { } t2)
                    {
                        <tr><td>Single Pitch Tolerance</td><td>f<sub>pT</sub></td><td>@t1.SinglePitch.ToString("F1")</td><td>@t2.SinglePitch.ToString("F1")</td><td>&#956;m</td></tr>
                        <tr><td>Cumulative Pitch Tolerance</td><td>F<sub>pT</sub></td><td>@t1.CumulativePitch.ToString("F1")</td><td>@t2.CumulativePitch.ToString("F1")</td><td>&#956;m</td></tr>
                        <tr><td>Profile Slope Tolerance</td><td>f<sub>H&#945;T</sub></td><td>@t1.ProfileSlope.ToString("F1")</td><td>@t2.ProfileSlope.ToString("F1")</td><td>&#956;m</td></tr>
                        <tr><td>Profile Form Tolerance</td><td>f<sub>f&#945;T</sub></td><td>@t1.ProfileForm.ToString("F1")</td><td>@t2.ProfileForm.ToString("F1")</td><td>&#956;m</td></tr>
                        <tr class="highlight"><td>Total Profile Tolerance</td><td>F<sub>&#945;T</sub></td><td>@t1.ProfileTotal.ToString("F1")</td><td>@t2.ProfileTotal.ToString("F1")</td><td>&#956;m</td></tr>
                        <tr><td>Helix Slope Tolerance</td><td>f<sub>H&#946;T</sub></td><td>@t1.HelixSlope.ToString("F1")</td><td>@t2.HelixSlope.ToString("F1")</td><td>&#956;m</td></tr>
                        <tr><td>Helix Form Tolerance</td><td>f<sub>f&#946;T</sub></td><td>@t1.HelixForm.ToString("F1")</td><td>@t2.HelixForm.ToString("F1")</td><td>&#956;m</td></tr>
                        <tr class="highlight"><td>Total Helix Tolerance</td><td>F<sub>&#946;T</sub></td><td>@t1.HelixTotal.ToString("F1")</td><td>@t2.HelixTotal.ToString("F1")</td><td>&#956;m</td></tr>
                    }
                </tbody>
            </table>

            @if (engine.Tolerance1?.Warning != null)
            {
                <div class="alert alert-warning" style="margin: 12px 16px; font-size: 13px;"><strong>Gear 1:</strong> @engine.Tolerance1.Warning</div>
            }
            @if (engine.Tolerance2?.Warning != null)
            {
                <div class="alert alert-warning" style="margin: 12px 16px; font-size: 13px;"><strong>Gear 2:</strong> @engine.Tolerance2.Warning</div>
            }

            <div class="note-box">
                Tolerances are calculated from the ISO 1328-1:2013 formulae, in which the classes run
                1 (tightest) to 11 (loosest) and each step is a factor of &#8730;2. Note that ISO 6336-1:2006
                normatively references the 1995 edition, whose accuracy grades 0-12 are numbered
                differently &#8212; confirm which edition is specified on the gear drawing.
            </div>
        </div>

        <!-- Tooth Thickness & Control Dimensions -->
        <div class="card">
            <div class="card-header"><ModuleIcon Type="dimensions" Size="medium" Style="solid" /><h2>Tooth Thickness &amp; Control Dimensions (ISO 21771)</h2></div>

            @if (engine.Measurement1 is { } m1 && engine.Measurement2 is { } m2)
            {
                <table class="results-table">
                    <thead><tr><th>Description</th><th>Symbol</th><th>Gear 1</th><th>Gear 2</th><th>Unit</th></tr></thead>
                    <tbody>
                        <tr class="highlight"><td>Normal Tooth Thickness (reference)</td><td>s<sub>n</sub></td><td>@m1.sn.ToString("F4")</td><td>@m2.sn.ToString("F4")</td><td>mm</td></tr>
                        <tr><td>Transverse Tooth Thickness</td><td>s<sub>t</sub></td><td>@m1.st.ToString("F4")</td><td>@m2.st.ToString("F4")</td><td>mm</td></tr>
                        <tr><td>Tooth Thickness at Base Circle</td><td>s<sub>bt</sub></td><td>@m1.sbt.ToString("F4")</td><td>@m2.sbt.ToString("F4")</td><td>mm</td></tr>
                        <tr class="@(m1.san < 0.2 * engine.NormalModule || m2.san < 0.2 * engine.NormalModule ? "warning" : "")">
                            <td>Normal Tip Tooth Thickness</td><td>s<sub>an</sub></td><td>@m1.san.ToString("F4")</td><td>@m2.san.ToString("F4")</td><td>mm</td></tr>
                        <tr><td>Tip Pressure Angle</td><td>&#945;<sub>at</sub></td><td>@m1.alphaAt.ToString("F3")</td><td>@m2.alphaAt.ToString("F3")</td><td>&#176;</td></tr>
                        <tr><td>Upper Thickness Allowance</td><td>A<sub>sne</sub></td><td>@((m1.Asne * 1000).ToString("F1"))</td><td>@((m2.Asne * 1000).ToString("F1"))</td><td>&#956;m</td></tr>
                        <tr><td>Lower Thickness Allowance</td><td>A<sub>sni</sub></td><td>@((m1.Asni * 1000).ToString("F1"))</td><td>@((m2.Asni * 1000).ToString("F1"))</td><td>&#956;m</td></tr>
                        <tr><td>Thickness Tolerance</td><td>T<sub>sn</sub></td><td>@((m1.Tsn * 1000).ToString("F1"))</td><td>@((m2.Tsn * 1000).ToString("F1"))</td><td>&#956;m</td></tr>
                    </tbody>
                </table>

                <h4 style="margin: 20px 16px 8px; color: #495057;">Base tangent length (span measurement)</h4>
                <table class="results-table">
                    <thead><tr><th>Description</th><th>Symbol</th><th>Gear 1</th><th>Gear 2</th><th>Unit</th></tr></thead>
                    <tbody>
                        <tr><td>Number of Teeth Spanned</td><td>k</td><td>@m1.k</td><td>@m2.k</td><td>-</td></tr>
                        @if (m1.k != m1.kPreferred || m2.k != m2.kPreferred)
                        {
                            <tr><td>k this calculator would choose</td><td>k<sub>pref</sub></td>
                                <td>@m1.kPreferred</td><td>@m2.kPreferred</td><td>-</td></tr>
                        }
                        <tr><td>Theoretical (zero allowance)</td><td>W<sub>k</sub></td><td>@m1.Wk.ToString("F4")</td><td>@m2.Wk.ToString("F4")</td><td>mm</td></tr>
                        <tr><td>Allowances</td><td>A<sub>We</sub>/A<sub>Wi</sub></td><td>@((m1.AWe * 1000).ToString("F1")) / @((m1.AWi * 1000).ToString("F1"))</td><td>@((m2.AWe * 1000).ToString("F1")) / @((m2.AWi * 1000).ToString("F1"))</td><td>&#956;m</td></tr>
                        <tr class="highlight"><td>Largest Permitted (at A<sub>sne</sub>)</td><td>W<sub>k,max</sub></td><td>@m1.WkUpper.ToString("F4")</td><td>@m2.WkUpper.ToString("F4")</td><td>mm</td></tr>
                        <tr class="highlight"><td>Smallest Permitted (at A<sub>sni</sub>)</td><td>W<sub>k,min</sub></td><td>@m1.WkLower.ToString("F4")</td><td>@m2.WkLower.ToString("F4")</td><td>mm</td></tr>
                        <tr><td>Measuring Circle Diameter</td><td>d<sub>Mk</sub></td><td>@m1.dMk.ToString("F3")</td><td>@m2.dMk.ToString("F3")</td><td>mm</td></tr>
                        <tr><td>Face Width Needed for the Span</td><td>b<sub>min</sub></td><td>@m1.bMinSpan.ToString("F2")</td><td>@m2.bMinSpan.ToString("F2")</td><td>mm</td></tr>
                    </tbody>
                </table>
                @if (m1.SpanWarning != null)
                {
                    <div class="alert alert-warning" style="margin: 12px 16px; font-size: 13px;"><strong>Gear 1:</strong> @m1.SpanWarning</div>
                }
                @if (m2.SpanWarning != null)
                {
                    <div class="alert alert-warning" style="margin: 12px 16px; font-size: 13px;"><strong>Gear 2:</strong> @m2.SpanWarning</div>
                }

                <h4 style="margin: 20px 16px 8px; color: #495057;">Dimension over balls / pins</h4>
                <table class="results-table">
                    <thead><tr><th>Description</th><th>Symbol</th><th>Gear 1</th><th>Gear 2</th><th>Unit</th></tr></thead>
                    <tbody>
                        <tr><td>Ball Diameter Used</td><td>D<sub>M</sub></td><td>@m1.DM.ToString("F3")</td><td>@m2.DM.ToString("F3")</td><td>mm</td></tr>
                        <tr><td>Best Size for this Gear</td><td>D<sub>M,best</sub></td><td>@m1.DMBest.ToString("F3")</td><td>@m2.DMBest.ToString("F3")</td><td>mm</td></tr>
                        <tr><td>Theoretical (zero allowance)</td><td>M<sub>d</sub></td><td>@m1.Md.ToString("F4")</td><td>@m2.Md.ToString("F4")</td><td>mm</td></tr>
                        <tr class="highlight"><td>Largest Permitted (at A<sub>sne</sub>)</td><td>M<sub>d,max</sub></td><td>@m1.MdUpper.ToString("F4")</td><td>@m2.MdUpper.ToString("F4")</td><td>mm</td></tr>
                        <tr class="highlight"><td>Smallest Permitted (at A<sub>sni</sub>)</td><td>M<sub>d,min</sub></td><td>@m1.MdLower.ToString("F4")</td><td>@m2.MdLower.ToString("F4")</td><td>mm</td></tr>
                        <tr><td>Ball Centre Circle</td><td>d<sub>M</sub></td><td>@m1.dMBallCentre.ToString("F3")</td><td>@m2.dMBallCentre.ToString("F3")</td><td>mm</td></tr>
                        <tr><td>Pressure Angle at Ball Centre</td><td>&#945;<sub>M</sub></td><td>@m1.alphaM.ToString("F3")</td><td>@m2.alphaM.ToString("F3")</td><td>&#176;</td></tr>
                        <tr><td>Ball Contact Diameter</td><td>d<sub>y</sub></td><td>@m1.dBallContact.ToString("F3")</td><td>@m2.dBallContact.ToString("F3")</td><td>mm</td></tr>
                        <tr><td>Tooth Count</td><td>-</td><td>@(m1.OddTeeth ? "odd" : "even")</td><td>@(m2.OddTeeth ? "odd" : "even")</td><td>-</td></tr>
                    </tbody>
                </table>
                @if (m1.BallWarning != null)
                {
                    <div class="alert alert-warning" style="margin: 12px 16px; font-size: 13px;"><strong>Gear 1:</strong> @m1.BallWarning</div>
                }
                @if (m2.BallWarning != null)
                {
                    <div class="alert alert-warning" style="margin: 12px 16px; font-size: 13px;"><strong>Gear 2:</strong> @m2.BallWarning</div>
                }

                <h4 style="margin: 20px 16px 8px; color: #495057;">Chordal tooth thickness (gear tooth caliper)</h4>
                <table class="results-table">
                    <thead><tr><th>Description</th><th>Symbol</th><th>Gear 1</th><th>Gear 2</th><th>Unit</th></tr></thead>
                    <tbody>
                        <tr><td>Virtual Number of Teeth</td><td>z<sub>n</sub></td><td>@m1.zn.ToString("F3")</td><td>@m2.zn.ToString("F3")</td><td>-</td></tr>
                        <tr class="highlight"><td>Normal Chordal Thickness</td><td>s&#772;<sub>n</sub></td><td>@m1.snChordal.ToString("F4")</td><td>@m2.snChordal.ToString("F4")</td><td>mm</td></tr>
                        <tr class="highlight"><td>Chordal Height</td><td>h&#772;<sub>a</sub></td><td>@m1.haChordal.ToString("F4")</td><td>@m2.haChordal.ToString("F4")</td><td>mm</td></tr>
                    </tbody>
                </table>

                @foreach (var n in m1.Notes)
                {
                    <div class="alert alert-warning" style="margin: 12px 16px; font-size: 13px;"><strong>Gear 1:</strong> @n</div>
                }
                @foreach (var n in m2.Notes)
                {
                    <div class="alert alert-warning" style="margin: 12px 16px; font-size: 13px;"><strong>Gear 2:</strong> @n</div>
                }
            }
        </div>

        <!-- Backlash -->
        <div class="card">
            <div class="card-header"><ModuleIcon Type="depth" Size="medium" Style="solid" /><h2>Backlash (ISO/TR 10064-2)</h2></div>
            @if (engine.Backlash is { } bl)
            {
                <table class="results-table">
                    <thead><tr><th>Description</th><th>Symbol</th><th>Minimum</th><th>Maximum</th><th>Unit</th></tr></thead>
                    <tbody>
                        <tr class="highlight"><td>Normal Backlash</td><td>j<sub>bn</sub></td><td>@((bl.jbnMin * 1000).ToString("F1"))</td><td>@((bl.jbnMax * 1000).ToString("F1"))</td><td>&#956;m</td></tr>
                        <tr><td>Circumferential Backlash</td><td>j<sub>wt</sub></td><td>@((bl.jwtMin * 1000).ToString("F1"))</td><td>@((bl.jwtMax * 1000).ToString("F1"))</td><td>&#956;m</td></tr>
                        <tr><td>Radial Backlash</td><td>j<sub>r</sub></td><td>@((bl.jrMin * 1000).ToString("F1"))</td><td>@((bl.jrMax * 1000).ToString("F1"))</td><td>&#956;m</td></tr>
                        <tr><td>Center Distance Deviation</td><td>A<sub>a</sub></td><td>@((engine.UsedCentreDistanceLowerDev * 1000).ToString("F1"))</td><td>@((engine.UsedCentreDistanceUpperDev * 1000).ToString("F1"))</td><td>&#956;m</td></tr>
                        <tr class="@(bl.jbnMin >= bl.jbnRecommended ? "success" : bl.jbnMin > 0 ? "warning" : "danger")">
                            <td>Recommended Minimum</td><td>j<sub>bn,min</sub></td>
                            <td colspan="2">@((bl.jbnRecommended * 1000).ToString("F1"))</td><td>&#956;m</td>
                        </tr>
                    </tbody>
                </table>

                @foreach (var n in bl.Notes)
                {
                    <div class="alert alert-warning" style="margin: 12px 16px; font-size: 13px;">@n</div>
                }

                @if (engine.AllowanceNote != null)
                {
                    <div class="note-box">
                        <strong>Allowance source:</strong> @engine.AllowanceNote
                    </div>
                }

                @if (engine.CentreDistanceNote != null)
                {
                    <div class="note-box">
                        <strong>Center distance:</strong> @engine.CentreDistanceNote
                    </div>
                }

                <div class="note-box">
                    Backlash follows from the tooth thickness allowances and the center distance deviation:
                    j<sub>bn</sub> = &#8722;(A<sub>sn1</sub> + A<sub>sn2</sub>)&#183;cos&#945;<sub>n</sub> +
                    2&#183;A<sub>a</sub>&#183;sin&#945;<sub>wt</sub>&#183;cos&#946;<sub>b</sub>. The minimum occurs with the
                    thickest teeth and the smallest center distance. Thermal expansion, housing deflection
                    and contamination all eat into it, which is why the recommended minimum exists.
                </div>
            }
        </div>

        <!-- Tooth Root Strength -->
        <div class="card">
            <div class="card-header"><ModuleIcon Type="stress" Size="medium" Style="solid" /><h2>Tooth Root Strength (Bending)</h2></div>
            <table class="results-table">
                <thead><tr><th>Description</th><th>Symbol</th><th>Gear 1</th><th>Gear 2</th><th>Unit</th></tr></thead>
                <tbody>
                    <tr><td>Tooth Root Normal Chord</td><td>s<sub>Fn</sub></td><td>@engine.RootChord1.ToString("F3")</td><td>@engine.RootChord2.ToString("F3")</td><td>mm</td></tr>
                    <tr><td>Bending Moment Arm</td><td>h<sub>Fe</sub></td><td>@engine.MomentArm1.ToString("F3")</td><td>@engine.MomentArm2.ToString("F3")</td><td>mm</td></tr>
                    <tr><td>Root Fillet Radius</td><td>&#961;<sub>F</sub></td><td>@engine.RootFilletRadius1.ToString("F3")</td><td>@engine.RootFilletRadius2.ToString("F3")</td><td>mm</td></tr>
                    <tr><td>Notch Parameter</td><td>q<sub>s</sub></td><td>@engine.NotchParameter1.ToString("F3")</td><td>@engine.NotchParameter2.ToString("F3")</td><td>-</td></tr>
                    <tr><td>Tooth Form Factor</td><td>Y<sub>F</sub></td><td>@engine.ToothFormFactor1.ToString("F3")</td><td>@engine.ToothFormFactor2.ToString("F3")</td><td>-</td></tr>
                    <tr><td>Stress Correction Factor</td><td>Y<sub>S</sub></td><td>@engine.StressCorrectionFactor1.ToString("F3")</td><td>@engine.StressCorrectionFactor2.ToString("F3")</td><td>-</td></tr>
                    <tr><td>Helix Angle Factor</td><td>Y<sub>&#946;</sub></td><td colspan="2">@engine.HelixAngleFactorRoot.ToString("F3")</td><td>-</td></tr>
                    <tr><td>Rim Thickness Factor</td><td>Y<sub>B</sub></td><td>@engine.RimThicknessFactor1.ToString("F3")</td><td>@engine.RimThicknessFactor2.ToString("F3")</td><td>-</td></tr>
                    <tr><td>Deep Tooth Factor</td><td>Y<sub>DT</sub></td><td colspan="2">@engine.DeepToothFactor.ToString("F3")</td><td>-</td></tr>
                    <tr><td>Nominal Root Stress</td><td>&#963;<sub>F0</sub></td><td>@engine.NominalRootStress1.ToString("F1")</td><td>@engine.NominalRootStress2.ToString("F1")</td><td>MPa</td></tr>
                    <tr class="highlight"><td>Root Stress</td><td>&#963;<sub>F</sub></td><td>@engine.RootStress1.ToString("F1")</td><td>@engine.RootStress2.ToString("F1")</td><td>MPa</td></tr>
                    <tr><td>Life Factor</td><td>Y<sub>NT</sub></td><td>@engine.LifeFactorRoot1.ToString("F4")</td><td>@engine.LifeFactorRoot2.ToString("F4")</td><td>-</td></tr>
                    <tr><td>Relative Notch Sensitivity</td><td>Y<sub>&#948;relT</sub></td><td>@engine.NotchSensitivity1.ToString("F4")</td><td>@engine.NotchSensitivity2.ToString("F4")</td><td>-</td></tr>
                    <tr><td>Relative Surface Factor</td><td>Y<sub>RrelT</sub></td><td>@engine.SurfaceFactorRoot1.ToString("F4")</td><td>@engine.SurfaceFactorRoot2.ToString("F4")</td><td>-</td></tr>
                    <tr><td>Size Factor</td><td>Y<sub>X</sub></td><td>@engine.SizeFactorRoot1.ToString("F4")</td><td>@engine.SizeFactorRoot2.ToString("F4")</td><td>-</td></tr>
                    <tr><td>Permissible Root Stress</td><td>&#963;<sub>FP</sub></td><td>@engine.PermissibleRootStress1.ToString("F1")</td><td>@engine.PermissibleRootStress2.ToString("F1")</td><td>MPa</td></tr>
                </tbody>
            </table>
            @if (engine.ToothFormWarning1 != null || engine.ToothFormWarning2 != null)
            {
                <div class="alert alert-warning" style="margin: 16px;">
                    <strong>Tooth form note:</strong>
                    @if (engine.ToothFormWarning1 != null)
                    {
                        <div>Gear 1: @engine.ToothFormWarning1</div>
                    }
                    @if (engine.ToothFormWarning2 != null)
                    {
                        <div>Gear 2: @engine.ToothFormWarning2</div>
                    }
                </div>
            }
            <div class="note-box">
                Y<sub>F</sub> and Y<sub>S</sub> are calculated from the real tooth geometry per
                <strong>ISO 6336-3 Method B</strong> (30&#176; tangent construction, load at the outer
                point of single pair tooth contact). Because the load is applied at that point rather
                than at the tip, the contact ratio factor Y<sub>&#949;</sub> of the DIN 3990 Method C
                scheme is deliberately <em>not</em> applied &#8212; using both would count the benefit
                of load sharing twice.
            </div>
        </div>

        <!-- Tooth Flank Strength -->
        <div class="card">
            <div class="card-header"><ModuleIcon Type="surface" Size="medium" Style="solid" /><h2>Tooth Flank Strength (Pitting)</h2></div>
            <table class="results-table">
                <thead><tr><th>Description</th><th>Symbol</th><th>Value</th><th>Unit</th></tr></thead>
                <tbody>
                    <tr><td>Zone Factor</td><td>Z<sub>H</sub></td><td>@engine.ZoneFactorH.ToString("F3")</td><td>-</td></tr>
                    <tr><td>Elasticity Factor</td><td>Z<sub>E</sub></td><td>@engine.ElasticityFactor.ToString("F3")</td><td>&#8730;N/mm&#178;</td></tr>
                    <tr><td>Contact Ratio Factor</td><td>Z<sub>&#949;</sub></td><td>@engine.ContactRatioFactorFlank.ToString("F3")</td><td>-</td></tr>
                    <tr><td>Helix Angle Factor</td><td>Z<sub>&#946;</sub></td><td>@engine.HelixAngleFactorFlank.ToString("F3")</td><td>-</td></tr>
                    <tr><td>Nominal Contact Stress</td><td>&#963;<sub>H0</sub></td><td>@engine.NominalContactStress.ToString("F1")</td><td>MPa</td></tr>
                    <tr class="highlight"><td>Contact Stress</td><td>&#963;<sub>H</sub></td><td>@engine.ContactStress.ToString("F1")</td><td>MPa</td></tr>
                </tbody>
            </table>
            <table class="results-table" style="margin-top: 16px;">
                <thead><tr><th>Description</th><th>Symbol</th><th>Gear 1</th><th>Gear 2</th><th>Unit</th></tr></thead>
                <tbody>
                    <tr class="highlight"><td>Single Pair Tooth Contact Factor</td><td>Z<sub>B</sub>/Z<sub>D</sub></td><td>@engine.SingleToothContactFactor1.ToString("F3")</td><td>@engine.SingleToothContactFactor2.ToString("F3")</td><td>-</td></tr>
                    <tr class="highlight"><td>Contact Stress (Individual)</td><td>&#963;<sub>HB</sub>/&#963;<sub>HD</sub></td><td>@engine.ContactStress1.ToString("F1")</td><td>@engine.ContactStress2.ToString("F1")</td><td>MPa</td></tr>
                    <tr><td>Life Factor</td><td>Z<sub>NT</sub></td><td>@engine.LifeFactorFlank1.ToString("F4")</td><td>@engine.LifeFactorFlank2.ToString("F4")</td><td>-</td></tr>
                    <tr><td>Work Hardening Factor</td><td>Z<sub>W</sub></td><td>@engine.WorkHardeningFactor1.ToString("F4")</td><td>@engine.WorkHardeningFactor2.ToString("F4")</td><td>-</td></tr>
                    <tr><td>Size Factor</td><td>Z<sub>X</sub></td><td>@engine.SizeFactorFlank1.ToString("F4")</td><td>@engine.SizeFactorFlank2.ToString("F4")</td><td>-</td></tr>
                    <tr><td>Permissible Contact Stress</td><td>&#963;<sub>HP</sub></td><td>@engine.PermissibleContactStress1.ToString("F1")</td><td>@engine.PermissibleContactStress2.ToString("F1")</td><td>MPa</td></tr>
                </tbody>
            </table>

            @if (engine.LubricantFilmResult is { } film)
            {
                <h4 style="margin: 20px 16px 8px; color: #495057;">Lubricant film factors (ISO 6336-2 Method B)</h4>
                <table class="results-table">
                    <thead><tr><th>Description</th><th>Symbol</th><th>Value</th><th>Unit</th></tr></thead>
                    <tbody>
                        <tr><td>Nominal Viscosity at 40&#176;C</td><td>&#957;<sub>40</sub></td><td>@engine.LubricantViscosity40.ToString("F0")</td><td>mm&#178;/s</td></tr>
                        <tr><td>Radius of Relative Curvature</td><td>&#961;<sub>red</sub></td><td>@film.RhoRed.ToString("F2")</td><td>mm</td></tr>
                        <tr><td>Mean Roughness</td><td>R<sub>z</sub></td><td>@film.Rz.ToString("F2")</td><td>&#956;m</td></tr>
                        <tr><td>Mean Relative Roughness</td><td>R<sub>z10</sub></td><td>@film.Rz10.ToString("F2")</td><td>&#956;m</td></tr>
                        <tr><td>C<sub>ZL</sub> / C<sub>Zv</sub> / C<sub>ZR</sub></td><td>-</td><td>@film.CZL.ToString("F3") / @film.CZv.ToString("F3") / @film.CZR.ToString("F3")</td><td>-</td></tr>
                        <tr class="highlight"><td>Lubricant Factor</td><td>Z<sub>L</sub></td><td>@film.ZL.ToString("F4")</td><td>-</td></tr>
                        <tr class="highlight"><td>Velocity Factor</td><td>Z<sub>v</sub></td><td>@film.Zv.ToString("F4")</td><td>-</td></tr>
                        <tr class="highlight"><td>Roughness Factor</td><td>Z<sub>R</sub></td><td>@film.ZR.ToString("F4")</td><td>-</td></tr>
                        <tr><td>Combined</td><td>Z<sub>L</sub>Z<sub>v</sub>Z<sub>R</sub></td><td>@((film.ZL * film.Zv * film.ZR).ToString("F4"))</td><td>-</td></tr>
                    </tbody>
                </table>
                @if (film.Warning != null)
                {
                    <div class="alert alert-warning" style="margin: 12px 16px;">@film.Warning</div>
                }
            }

            @if (engine.ContactFactorWarning != null)
            {
                <div class="alert alert-warning" style="margin: 12px 16px;">@engine.ContactFactorWarning</div>
            }
        </div>

        <!-- Scuffing -->
        <div class="card">
            <div class="card-header"><ModuleIcon Type="surface" Size="medium" Style="solid" /><h2>Scuffing (ISO/TR 13989)</h2></div>
            <h3 style="margin: 0 16px 8px; font-size: 15px; color: #2c3e50;">Flash Temperature Method (Part 1)</h3>
            @if (engine.Scuffing is { Valid: true } sc)
            {
                <table class="results-table">
                    <thead><tr><th>Description</th><th>Symbol</th><th>Value</th><th>Unit</th></tr></thead>
                    <tbody>
                        <tr><td>Mean Coefficient of Friction</td><td>&#956;<sub>m</sub></td><td>@sc.MuM.ToString("F4")</td><td>-</td></tr>
                        <tr><td>Lubricant Factor</td><td>X<sub>L</sub></td><td>@sc.XL.ToString("F3")</td><td>-</td></tr>
                        <tr><td>Roughness Factor</td><td>X<sub>R</sub></td><td>@sc.XR.ToString("F3")</td><td>-</td></tr>
                        <tr><td>Thermo-elastic Factor</td><td>X<sub>M</sub></td><td>@sc.XM.ToString("F1")</td><td>K&#183;N<sup>-&#190;</sup>s<sup>&#189;</sup>m<sup>-&#189;</sup>mm</td></tr>
                        <tr><td>Lubrication Method Factor</td><td>X<sub>S</sub></td><td>@sc.XS.ToString("F1")</td><td>-</td></tr>
                        <tr><td>Transverse Unit Load</td><td>w<sub>Bt</sub></td><td>@sc.wBt.ToString("F1")</td><td>N/mm</td></tr>
                        <tr><td>Viscosity at Oil Temperature</td><td>&#957;</td><td>@engine.ScuffingViscosityAtOil.ToString("F1")</td><td>mm&#178;/s</td></tr>
                        <tr><td>Oil Temperature</td><td>&#920;<sub>oil</sub></td><td>@engine.OilTemperatureUsed.ToString("F0")</td><td>&#176;C</td></tr>
                        <tr class="highlight"><td>Maximum Flash Temperature</td><td>&#920;<sub>flmax</sub></td><td>@sc.FlashMax.ToString("F1")</td><td>K</td></tr>
                        <tr><td>Mean Flash Temperature</td><td>&#920;<sub>flm</sub></td><td>@sc.FlashMean.ToString("F1")</td><td>K</td></tr>
                        <tr><td>Bulk Temperature</td><td>&#920;<sub>M</sub></td><td>@sc.BulkTemperature.ToString("F1")</td><td>&#176;C</td></tr>
                        <tr class="highlight"><td>Maximum Contact Temperature</td><td>&#920;<sub>Bmax</sub></td><td>@sc.ContactMax.ToString("F1")</td><td>&#176;C</td></tr>
                        <tr><td>Scuffing Temperature</td><td>&#920;<sub>S</sub></td><td>@sc.ScuffingTemperature.ToString("F0")</td><td>&#176;C</td></tr>
                        <tr><td>Contact Exposure Time</td><td>t<sub>max</sub></td><td>@sc.ContactExposureTime.ToString("F1")</td><td>&#956;s</td></tr>
                        <tr class="@GetScuffingRowClass(sc)">
                            <td>Temperature Margin</td><td>&#920;<sub>S</sub> &#8722; &#920;<sub>Bmax</sub></td>
                            <td>@sc.MarginKelvin.ToString("F0")</td><td>K</td>
                        </tr>
                    </tbody>
                </table>

                @foreach (var n in sc.Notes)
                {
                    <div class="alert alert-warning" style="margin: 12px 16px; font-size: 13px;">@n</div>
                }

                @if (engine.ScuffingIntegral is { Valid: true } si)
                {
                    <h3 style="margin: 24px 16px 8px; font-size: 15px; color: #2c3e50;">
                        Cross-check &#8212; Integral Temperature Method (ISO/TR 13989-2)
                    </h3>
                    <table class="results-table">
                        <thead><tr><th>Description</th><th>Symbol</th><th>Value</th><th>Unit</th></tr></thead>
                        <tbody>
                            <tr><td>Mean Coefficient of Friction</td><td>&#956;<sub>mC</sub></td><td>@si.MuMc.ToString("F4")</td><td>-</td></tr>
                            <tr><td>Geometry Factor at Pinion Tip</td><td>X<sub>BE</sub></td><td>@si.XBE.ToString("F4")</td><td>-</td></tr>
                            <tr><td>Contact Ratio Factor</td><td>X<sub>&#949;</sub></td><td>@si.XEps.ToString("F4")</td><td>-</td></tr>
                            <tr><td>Approach / Tip Relief Factors</td><td>X<sub>Q</sub> / X<sub>Ca</sub></td><td>@si.XQ.ToString("F3") / @si.XCa.ToString("F3")</td><td>-</td></tr>
                            <tr><td>Flash Temperature at Pinion Tip</td><td>&#920;<sub>flaE</sub></td><td>@si.FlashAtTip.ToString("F1")</td><td>K</td></tr>
                            <tr class="highlight"><td>Mean Flash Temperature</td><td>&#920;<sub>flaint</sub></td><td>@si.FlashIntegral.ToString("F1")</td><td>K</td></tr>
                            <tr><td>Bulk Temperature</td><td>&#920;<sub>M</sub></td><td>@si.BulkTemperature.ToString("F1")</td><td>&#176;C</td></tr>
                            <tr class="highlight"><td>Integral Temperature</td><td>&#920;<sub>int</sub></td><td>@si.IntegralTemperature.ToString("F1")</td><td>&#176;C</td></tr>
                            <tr><td>Scuffing Integral Temperature</td><td>&#920;<sub>intS</sub></td><td>@si.ScuffingIntegralTemperature.ToString("F0")</td><td>&#176;C</td></tr>
                            <tr class="@(si.SafetyFactor < 1 ? "danger" : si.SafetyFactor <= 2 ? "warning" : "success")">
                                <td>Scuffing Safety (integral)</td><td>S<sub>intS</sub></td>
                                <td>@si.SafetyFactor.ToString("F2")</td><td>@si.RiskBand</td>
                            </tr>
                            <tr><td>Load Safety Factor</td><td>S<sub>Sl</sub></td><td>@si.LoadSafetyFactor.ToString("F2")</td><td>-</td></tr>
                        </tbody>
                    </table>

                    @foreach (var n in si.Notes)
                    {
                        <div class="alert alert-warning" style="margin: 12px 16px; font-size: 13px;">@n</div>
                    }

                    <div class="note-box">
                        The two methods answer the same question differently: the flash method sweeps the
                        whole path of contact and takes the peak, the integral method takes the tip value
                        and weights it into a mean. The standard's introduction says they give about the
                        same assessment of risk, and that the integral method is the <em>less</em>
                        sensitive of the two where the flash temperature has a local peak &#8212; a low
                        contact ratio, or contact near the base circle. <strong>The two safety factors are
                        not on the same scale:</strong> S<sub>B</sub> is a ratio of temperatures above the
                        oil, S<sub>intS</sub> a ratio of absolute temperatures. Compare the verdicts, not
                        the numbers. Clause 6.1.1 reads S<sub>intS</sub> as: below 1 high risk, 1 to 2
                        critical, above 2 low risk.
                    </div>
                }

                <div class="note-box">
                    Scuffing is a <strong>temperature limit, not a fatigue life</strong> &#8212; a single
                    momentary overload can do damage that ends the gear's service, which is why the
                    standard asks for a wider margin here than a fatigue safety would need.
                    Clause 10.5 warns that a safety expressed as a quotient of temperatures
                    "may cause confusion", and advises stating the margin
                    &#920;<sub>S</sub> &#8722; &#920;<sub>Bmax</sub> directly &#8212; for instance
                    &#8805; 50 K. Both are given above and in the safety table.
                </div>
            }
            else
            {
                <div class="alert alert-warning" style="margin: 16px;">
                    <ModuleIcon Type="warning" Size="small" Style="default" CustomStyle="margin-right: 8px;" />
                    <div>
                        Scuffing could not be evaluated.
                        @foreach (var n in engine.Scuffing?.Notes ?? new List<string>())
                        {
                            <text>@n</text>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- Micropitting -->
        <div class="card">
            <div class="card-header"><ModuleIcon Type="surface" Size="medium" Style="solid" /><h2>Micropitting (ISO/TR 15144-1, Method B)</h2></div>
            @if (engine.Micropitting is { Valid: true } mp)
            {
                <table class="results-table results-table-numeric">
                    <thead><tr><th>Point</th><th>g<sub>Y</sub> (mm)</th><th>&#961;<sub>n,Y</sub> (mm)</th><th>X<sub>Y</sub></th><th>&#920;<sub>fl,Y</sub> (K)</th><th>&#955;<sub>GF,Y</sub></th></tr></thead>
                    <tbody>
                        @foreach (var p in engine.Micropitting.Points)
                        {
                            <tr class="@(p.Name == mp.LambdaMinAt ? "warning" : null)">
                                <td><strong>@p.Name</strong></td>
                                <td>@p.gY.ToString("F3")</td>
                                <td>@p.RhoN.ToString("F3")</td>
                                <td>@p.XY.ToString("F3")</td>
                                <td>@p.Flash.ToString("F1")</td>
                                <td>@p.Lambda.ToString("F4")</td>
                            </tr>
                        }
                    </tbody>
                </table>

                <table class="results-table" style="margin-top: 12px;">
                    <thead><tr><th>Description</th><th>Symbol</th><th>Value</th><th>Unit</th></tr></thead>
                    <tbody>
                        <tr><td>Mean Coefficient of Friction</td><td>&#956;<sub>m</sub></td><td>@mp.MuM.ToString("F4")</td><td>-</td></tr>
                        <tr><td>Load Losses Factor</td><td>H<sub>V</sub></td><td>@mp.HV.ToString("F4")</td><td>-</td></tr>
                        <tr><td>Bulk Temperature</td><td>&#920;<sub>M</sub></td><td>@mp.BulkTemperature.ToString("F1")</td><td>&#176;C</td></tr>
                        <tr><td>Material Parameter</td><td>G<sub>M</sub></td><td>@mp.GM.ToString("F0")</td><td>-</td></tr>
                        <tr><td>Effective Roughness</td><td>Ra</td><td>@mp.Ra.ToString("F3")</td><td>&#956;m</td></tr>
                        <tr class="highlight"><td>Minimum Specific Film Thickness (at @mp.LambdaMinAt)</td><td>&#955;<sub>GF,min</sub></td><td>@mp.LambdaMin.ToString("F4")</td><td>-</td></tr>
                        <tr><td>Permissible Specific Film Thickness</td><td>&#955;<sub>GFP</sub></td><td>@mp.LambdaGfp.ToString("F3")</td><td>-</td></tr>
                        <tr class="@(mp.SafetyFactor < 1 ? "danger" : mp.SafetyFactor < 2 ? "warning" : "success")">
                            <td>Micropitting Safety</td><td>S<sub>&#955;</sub></td>
                            <td>@mp.SafetyFactor.ToString("F2")</td>
                            <td>@(mp.SafetyFactor < 1 ? "❌ FAIL" : mp.SafetyFactor < 2 ? "⚠️ Marginal" : "✓ OK")</td>
                        </tr>
                    </tbody>
                </table>

                @foreach (var n in mp.Notes)
                {
                    <div class="alert alert-warning" style="margin: 12px 16px; font-size: 13px;">@n</div>
                }

                <div class="note-box">
                    Micropitting is a <strong>lubrication-regime</strong> failure, not a stress one: it
                    starts where the oil film is thin next to the roughness of the flanks. So the
                    criterion is a ratio of lengths &#8212; film thickness over roughness &#8212; and the
                    two levers that move it most are <em>smoother flanks</em> and <em>a thicker oil</em>,
                    not a stronger material. The flash temperature is zero at the pitch point C because
                    the contact rolls without sliding there; the thinnest film is normally near A, in the
                    area of negative specific sliding on the driving gear.
                </div>
            }
            else
            {
                <div class="alert alert-warning" style="margin: 16px;">
                    <ModuleIcon Type="warning" Size="small" Style="default" CustomStyle="margin-right: 8px;" />
                    <div>
                        Micropitting could not be evaluated.
                        @foreach (var n in engine.Micropitting?.Notes ?? new List<string>())
                        {
                            <text>@n</text>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- Safety Factors -->
        <div class="card">
            <div class="card-header"><ModuleIcon Type="safety" Size="medium" Style="solid" /><h2>Safety Factors</h2></div>
            <table class="results-table">
                <thead><tr><th>Description</th><th>Symbol</th><th>Gear 1</th><th>Gear 2</th><th>Required</th><th>Status</th></tr></thead>
                <tbody>
                    @if (!engine.ToothFormValid1 || !engine.ToothFormValid2)
                    {
                        <tr class="danger">
                            <td>Root Safety Factor</td><td>S<sub>F</sub></td>
                            <td colspan="2">not evaluable</td>
                            <td>&#8805; @GearPairEngine.MinSafetyFactorRoot.ToString("F2")</td>
                            <td>Invalid geometry</td>
                        </tr>
                    }
                    else
                    {
                        <tr class="@GetSafetyRowClass(engine.MinRootSafety, GearPairEngine.MinSafetyFactorRoot)">
                            <td>Root Safety Factor</td><td>S<sub>F</sub></td>
                            <td>@engine.RootSafetyFactor1.ToString("F2")</td>
                            <td>@engine.RootSafetyFactor2.ToString("F2")</td>
                            <td>&#8805; @GearPairEngine.MinSafetyFactorRoot.ToString("F2")</td>
                            <td>@GetSafetyStatus(engine.MinRootSafety, GearPairEngine.MinSafetyFactorRoot)</td>
                        </tr>
                    }
                    <tr class="@GetSafetyRowClass(engine.MinFlankSafety, GearPairEngine.MinSafetyFactorFlank)">
                        <td>Flank Safety Factor</td><td>S<sub>H</sub></td>
                        <td>@engine.FlankSafetyFactor1.ToString("F2")</td>
                        <td>@engine.FlankSafetyFactor2.ToString("F2")</td>
                        <td>&#8805; @GearPairEngine.MinSafetyFactorFlank.ToString("F2")</td>
                        <td>@GetSafetyStatus(engine.MinFlankSafety, GearPairEngine.MinSafetyFactorFlank)</td>
                    </tr>
                    @if (engine.Micropitting is { Valid: true } mps)
                    {
                        <tr class="@(mps.SafetyFactor < 1 ? "danger" : mps.SafetyFactor < 2 ? "warning" : "success")">
                            <td>Micropitting Safety</td><td>S<sub>&#955;</sub></td>
                            <td colspan="2">@mps.SafetyFactor.ToString("F2")</td>
                            <td>&#8805; 2 preferred</td>
                            <td>@(mps.SafetyFactor < 1 ? "❌ FAIL" : mps.SafetyFactor < 2 ? "⚠️ Marginal" : "✓ OK")</td>
                        </tr>
                    }
                    @if (engine.Scuffing is { Valid: true } scs)
                    {
                        <tr class="@GetScuffingRowClass(scs)">
                            <td>Scuffing Safety (margin @scs.MarginKelvin.ToString("F0") K)</td><td>S<sub>B</sub></td>
                            <td colspan="2">@scs.SafetyFactor.ToString("F2")</td>
                            <td>margin &#8805; 50 K</td>
                            <td>@GetScuffingStatus(scs)</td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="note-box">
                S<sub>F</sub> and S<sub>H</sub> are true safety factors:
                S = &#963;<sub>P</sub>/&#963;, with no minimum divided out of the permissible stress.
                Compare them against the ISO 6336 recommended minima shown in the Required column,
                not against 1.0. S<sub>B</sub> is a different animal &#8212; a ratio of
                <em>temperatures above the oil</em>, judged on the margin in kelvin rather than on
                the ratio itself.
            </div>
        </div>

        <!-- Design Assessment -->
        <div class="card">
            <div class="card-header"><ModuleIcon Type="design" Size="medium" Style="solid" /><h2>Design Assessment</h2></div>
            <table class="results-table">
                <thead><tr><th>Description</th><th>Symbol</th><th>Value</th><th>Unit</th></tr></thead>
                <tbody>
                    <tr><td>Load Cycles (Pinion)</td><td>N<sub>L1</sub></td><td>@(engine.LoadCycles1.ToString("F2")) &#215; 10&#8310;</td><td>-</td></tr>
                    <tr><td>Load Cycles (Wheel)</td><td>N<sub>L2</sub></td><td>@(engine.LoadCycles2.ToString("F2")) &#215; 10&#8310;</td><td>-</td></tr>
                    <tr class="highlight"><td>Minimum Root Safety</td><td>S<sub>F,min</sub></td><td>@engine.MinRootSafety.ToString("F2")</td><td>-</td></tr>
                    <tr class="highlight"><td>Minimum Flank Safety</td><td>S<sub>H,min</sub></td><td>@engine.MinFlankSafety.ToString("F2")</td><td>-</td></tr>
                </tbody>
            </table>

            @if (engine.MinRootSafety < GearPairEngine.MinSafetyFactorRoot * 0.8 || engine.MinFlankSafety < GearPairEngine.MinSafetyFactorFlank * 0.8)
            {
                <div class="alert alert-danger" style="margin-top: 16px;"><ModuleIcon Type="warning" Size="small" Style="default" CustomStyle="margin-right: 8px;" /> <strong>Warning:</strong> Design is unsafe! Safety factor well below the ISO 6336 minimum requirement.</div>
            }
            else if (engine.MinRootSafety < GearPairEngine.MinSafetyFactorRoot || engine.MinFlankSafety < GearPairEngine.MinSafetyFactorFlank)
            {
                <div class="alert alert-warning" style="margin-top: 16px;"><ModuleIcon Type="warning" Size="small" Style="default" CustomStyle="margin-right: 8px;" /> <strong>Note:</strong> Safety factors are marginal. Consider increasing module or face width.</div>
            }
            else if (engine.TransverseContactRatio < 1.2)
            {
                <div class="alert alert-warning" style="margin-top: 16px;"><ModuleIcon Type="warning" Size="small" Style="default" CustomStyle="margin-right: 8px;" /> <strong>Note:</strong> Contact ratio is below 1.2. Smooth operation may be affected.</div>
            }
            else if (OtherCriteriaFalling() is { Count: > 0 } falling)
            {
                @* The band used to go green on the tooth root and flank alone, which meant it
                   could sit directly under a red micropitting row and contradict it. Scuffing
                   and micropitting are different standards, so they do not turn the band red -
                   but they do stop it claiming everything passed. *@
                <div class="alert alert-warning" style="margin-top: 16px;"><ModuleIcon Type="warning" Size="small" Style="default" CustomStyle="margin-right: 8px;" /> <strong>Note:</strong> Tooth root and flank meet ISO 6336, but @string.Join(" and ", falling) above @(falling.Count > 1 ? "are" : "is") not satisfied. Read those sections before accepting the design.</div>
            }
            else
            {
                <div class="alert alert-success" style="margin-top: 16px;"><ModuleIcon Type="check" Size="small" Style="default" CustomStyle="margin-right: 8px;" /> <strong>OK:</strong> Tooth root and flank meet ISO 6336, and the scuffing and micropitting checks above are satisfied.</div>
            }

            <div class="note-box below">
                <strong>Scope:</strong> this module covers geometry (ISO 21771), flank tolerances
                (ISO 1328-1), backlash (ISO/TR 10064-2), tooth root and flank load capacity
                (ISO 6336-1/2/3), allowable stress numbers (ISO 6336-5) and scuffing by both the
                flash temperature (ISO/TR 13989-1) and integral temperature (ISO/TR 13989-2)
                methods, and micropitting by ISO/TR 15144-1 Method B. It does <em>not</em> cover
                tooth flank fracture, or planetary and internal gear arrangements. Within scuffing,
                bevel and hypoid geometry and the profile-modified load sharing branches of Part 1
                are not implemented; within micropitting, the profile-modified load sharing
                branches and the buttressing factor are not implemented, and ISO/TR 15144-1 itself
                restricts &#949;<sub>&#945;</sub> &gt; 2 to Method A.
            </div>

            <div class="note-box below">
                <strong>Comparing with commercial gear software?</strong> Two choices here are
                deliberately on the safe side, and together they can put the safety factors below
                what a package such as KISSsoft reports for the same gear.
                <ul style="margin: 8px 0 0 18px; padding: 0;">
                    <li>
                        <strong>Face load factor K<sub>H&#946;</sub>.</strong> This module always
                        uses the additive form of ISO 6336-1 Eq. (52) with B<sub>1</sub> =
                        B<sub>2</sub> = 1. Commercial software will apply the compensating Eq. (53)
                        and B = 0.7 once it is told the helix carries end relief and the contact
                        pattern is favourable &mdash; credits the standard allows only when that
                        pattern has been <em>verified on the assembled pair</em>, which a browser
                        cannot do. On a benchmark 22/45 helical pair the difference is about 9% on
                        K<sub>H&#946;</sub> and 6% on S<sub>H</sub>.
                    </li>
                    <li>
                        <strong>Allowable bending stress &#963;<sub>Flim</sub>.</strong> Taken from
                        ISO 6336-5:2016, which gives 425 N/mm&#178; for case-hardened steel of
                        grade MQ. The 2006 edition gives 430, worth about 1.2% on
                        S<sub>F</sub>.
                    </li>
                </ul>
                <div style="margin-top: 8px;">
                    Neither is an error on either side; the figures above are a lower bound that
                    holds without any assumption about how the pair was built. An
                    S<sub>H</sub> below 1 here does not say the flank will pit &mdash; it says
                    there is no margin left once the favourable-contact-pattern credit is set
                    aside.
                </div>
            </div>
        </div>
    </div>
}

<style>
    .material-info {
        font-size: 11px;
        color: #6c757d;
        margin-top: 4px;
        padding-left: 4px;
    }

    .results-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
    }

    .results-table th {
        background: #f8f9fa;
        padding: 10px 12px;
        text-align: left;
        font-weight: 600;
        color: #2c3e50;
        border-bottom: 2px solid #dee2e6;
    }

    .results-table td {
        padding: 8px 12px;
        border-bottom: 1px solid #eee;
    }

    .results-table tr:hover {
        background: #f8f9fa;
    }

    .results-table tr.highlight {
        background: #e3f2fd;
        font-weight: 500;
    }

    .results-table tr.warning {
        background: #fff8e1;
    }

    .results-table tr.danger {
        background: #ffebee;
    }

    .results-table tr.success {
        background: #e8f5e9;
    }

    /*
        This page does not have one table shape, it has four, and the rules below
        are keyed to each of them.

        They used to be a single 5-column set (Description | Symbol | Gear 1 |
        Gear 2 | Unit) applied to every .results-table on the page. Eight of the
        results tables are 4-column (Description | Symbol | Value | Unit), so
        their Unit column was being styled as if it were "Gear 2": right-aligned
        in monospace instead of centred in grey, and the widths summed to 83%,
        leaving the browser to hand out the remaining 17% however it liked. Two
        tables on the same screen visibly disagreed.

        `:nth-child(n):nth-last-child(m)` matches a cell only in a row of exactly
        n+m-1 cells, so each set applies to its own shape and nothing else. It
        also maintains itself: add a column to a table and the rules follow,
        which a hand-applied `.cols-5` class would not.

        Note these are more specific than the plain `th:nth-child(1)` rules the
        other eleven calculators declare, and three of those use 45/15/25/15
        rather than 40/15/25/20. That only stays harmless because a Razor style
        block lives and dies with its component: it is in the DOM while this page
        is rendered and gone once it is not. If these rules ever need to move to a
        shared stylesheet, scope them to this page first, or gear-pair will start
        re-laying-out key-connection's tables.

        (Do not write that tag name in angle brackets here. Razor parses the body
        of a style block as markup and does not know CSS comment syntax, so the
        literal tag inside this comment was read as a nested open tag - the next
        real closing tag matched it, the outer block was left unclosed, and the
        build failed with RZ9980. Which is how this parenthesis came to exist.)
    */

    /* --- 4 columns: Description | Symbol | Value | Unit --- */
    .results-table th:nth-child(1):nth-last-child(4) { width: 40%; }
    .results-table th:nth-child(2):nth-last-child(3) { width: 15%; text-align: center; }
    .results-table th:nth-child(3):nth-last-child(2) { width: 25%; text-align: right; }
    .results-table th:nth-child(4):nth-last-child(1) { width: 20%; text-align: center; }

    .results-table td:nth-child(3):nth-last-child(2) {
        text-align: right;
        font-weight: 500;
        font-family: 'Consolas', monospace;
    }

    .results-table td:nth-child(4):nth-last-child(1) {
        text-align: center;
        color: #666;
    }

    /* --- 5 columns: Description | Symbol | Gear 1 | Gear 2 | Unit --- */
    .results-table th:nth-child(1):nth-last-child(5) { width: 35%; }
    .results-table th:nth-child(2):nth-last-child(4) { width: 12%; text-align: center; }
    .results-table th:nth-child(3):nth-last-child(3) { width: 18%; text-align: right; }
    .results-table th:nth-child(4):nth-last-child(2) { width: 18%; text-align: right; }
    .results-table th:nth-child(5):nth-last-child(1) { width: 17%; text-align: center; }

    .results-table td:nth-child(3):nth-last-child(3),
    .results-table td:nth-child(4):nth-last-child(2) {
        text-align: right;
        font-weight: 500;
        font-family: 'Consolas', monospace;
    }

    .results-table td:nth-child(5):nth-last-child(1) {
        text-align: center;
        color: #666;
    }

    /* The symbol column. Every .results-table on the page has one at column 2;
       the prose tables in the dialogs are .info-table and are not touched here. */
    .results-table td:nth-child(2):nth-last-child(3),
    .results-table td:nth-child(2):nth-last-child(4),
    .results-table td:nth-child(2):nth-last-child(5) {
        text-align: center;
        font-family: 'Times New Roman', serif;
        font-style: italic;
        color: #666;
    }

    /* --- 6 columns: Description | Symbol | Gear 1 | Gear 2 | Required | Status.
           No fixed widths; six columns of text fit better left to the browser. --- */
    .results-table th:nth-child(3):nth-last-child(4),
    .results-table th:nth-child(4):nth-last-child(3),
    .results-table th:nth-child(5):nth-last-child(2) { text-align: right; }
    .results-table th:nth-child(6):nth-last-child(1) { text-align: center; }

    .results-table td:nth-child(3):nth-last-child(4),
    .results-table td:nth-child(4):nth-last-child(3),
    .results-table td:nth-child(5):nth-last-child(2) {
        text-align: right;
        font-weight: 500;
        font-family: 'Consolas', monospace;
    }

    .results-table td:nth-child(6):nth-last-child(1) {
        text-align: center;
        color: #666;
    }

    /*
        The micropitting sweep is a label followed by five numbers (Point | gY |
        ρn,Y | XY | Θfl,Y | λGF,Y) - the same six columns as the safety comparison
        above, so nothing in the markup's shape distinguishes them. Left to the
        rules above, its gY column would be rendered as if it were a symbol.
        Hence the explicit class: this is the table where every column after the
        first is a number.
    */
    .results-table.results-table-numeric th:not(:first-child) { text-align: right; }

    .results-table.results-table-numeric tbody td:not(:first-child) {
        text-align: right;
        font-weight: 500;
        font-style: normal;
        font-family: 'Consolas', monospace;
        color: inherit;
    }

    .results-table td[colspan="2"] {
        text-align: center !important;
    }

    .btn-info {
        background: linear-gradient(135deg, #17a2b8 0%, #138496 100%);
        color: white;
    }

    .btn-info:hover {
        background: linear-gradient(135deg, #138496 0%, #117a8b 100%);
    }
</style>

@code {
    private GearPairEngine engine = new();

    /// <summary>Why Calculate refused, shown by <see cref="ValidationAlert"/>.</summary>
    private List<string> validationMessages = new();
    private List<GearMaterial> gearMaterials = new();
    private ModuleInfo moduleInfo = new();
    private bool showResults = false;
    private bool isCalculating = false;
    private bool isSavingPdf = false;
    private string selectedApplicationFactor = "1.0";
    private int selectedMaterial1Index = 5; // 18CrNiMo7-6 Case-hardened
    private int selectedMaterial2Index = 5;
    private bool openedFromSharedLink = false;

    // Lubricant viscosity grade selection
    private string selectedLubricant = "Mobilgear 600 XP 220";

    // Tooth thickness allowances and centre distance deviation are entered in micrometres
    // (that is how they appear on a drawing) but held in millimetres on the engine.
    private double asne1Micron, asni1Micron, asne2Micron, asni2Micron;
    private double aaUpperMicron, aaLowerMicron;
    private double daUpperMicron, daLowerMicron, dfUpperMicron, dfLowerMicron;

    /// <summary>Target backlash, in whichever quantity the allowance mode selects (µm).</summary>
    private double jMinMicron, jMaxMicron;

    // Gear blank shape. MODEL ONLY - none of these reach GearPairEngine, which is why they
    // live on the page rather than on the engine. They feed the 3D viewer, and the bore
    // (which IS an engine input, through Y_B) sits alongside them on the form.
    private string blankType1 = "Solid", blankType2 = "Solid";
    private double rimInnerDia1, rimInnerDia2;
    private double hubDia1, hubDia2;
    private double webThickness1, webThickness2;

    /// <summary>Blank types offered by the dropdowns; a link carrying anything else falls back to Solid.</summary>
    private static readonly string[] BlankTypeOptions = { "Solid", "Webbed" };

    /*
     * Blazor's @bind formats a bool as "True"/"False" with a capital letter, so a <select>
     * whose options say "true"/"false" matches nothing and renders BLANK - and then never
     * writes back, which is exactly how the driving gear selector looked broken. Binding
     * through a string keeps the option set and the bound value in the same alphabet.
     */
    private string DrivingGear
    {
        get => engine.PinionDrives ? "pinion" : "wheel";
        set => engine.PinionDrives = value != "wheel";
    }

    /// <inheritdoc cref="DrivingGear"/>
    private string OilTemperatureSource
    {
        get => engine.OilTemperatureFromAmbient ? "ambient" : "direct";
        set => engine.OilTemperatureFromAmbient = value != "direct";
    }

    /// <summary>
    /// Everything you might specify the tooth thickness BY, other than a standard's own zone.
    /// The card carries the two standard routes because they need no further input; this
    /// dialog carries the ones that need a measurement or a required backlash typed in.
    /// </summary>
    private RenderFragment ToleranceDialog() => @<DialogButton
        Icon="open-options-dialog"
        Title="Tooth Thickness &#8212; from a measurement or a required backlash"
        MaxWidth="720"
        ButtonTitle="Enter a measured dimension or a required backlash">
        <Intro>
            All of these end up as the allowances A<sub>sne</sub> / A<sub>sni</sub>; pick whichever
            one you actually have. Backlash belongs to the <em>pair</em>, so it also needs a split
            rule; W<sub>k</sub> and M<sub>d</sub> are measured on one gear and do not.
        </Intro>
        <ChildContent>
            <div class="form-group">
                <label>Specify By</label>
                <select @bind="engine.AllowanceMode">
                    <option value="@ToothThicknessAllowanceMode.Manual">Tooth thickness allowance A<sub>sne</sub> / A<sub>sni</sub></option>
                    <option value="@ToothThicknessAllowanceMode.NormalBacklash">Normal backlash j<sub>bn</sub></option>
                    <option value="@ToothThicknessAllowanceMode.CircumferentialBacklash">Circumferential backlash j<sub>wt</sub></option>
                    <option value="@ToothThicknessAllowanceMode.RadialBacklash">Radial backlash j<sub>r</sub></option>
                    <option value="@ToothThicknessAllowanceMode.SpanLimits">Base tangent length W<sub>k</sub> limits</option>
                    <option value="@ToothThicknessAllowanceMode.BallLimits">Dimension over balls M<sub>d</sub> limits</option>
                </select>
            </div>

            @if (engine.AllowanceMode == ToothThicknessAllowanceMode.Manual)
            {
                <div class="form-group">
                    <label>Gear 1 Allowance (A<sub>sne1</sub> / A<sub>sni1</sub>)</label>
                    <div class="input-group">
                        <input type="number" step="1" max="0" @bind="asne1Micron" />
                        <input type="number" step="1" max="0" @bind="asni1Micron" style="margin-left:8px;" />
                        <span class="unit">&#956;m</span>
                    </div>
                </div>

                <div class="form-group">
                    <label>Gear 2 Allowance (A<sub>sne2</sub> / A<sub>sni2</sub>)</label>
                    <div class="input-group">
                        <input type="number" step="1" max="0" @bind="asne2Micron" />
                        <input type="number" step="1" max="0" @bind="asni2Micron" style="margin-left:8px;" />
                        <span class="unit">&#956;m</span>
                    </div>
                    <small style="color: #6c757d; font-size: 12px;">
                        Both negative (teeth are thinned from nominal), upper first.
                    </small>
                </div>
            }
            else if (IsBacklashMode(engine.AllowanceMode))
            {
                <div class="form-group">
                    <label>@BacklashModeLabel(engine.AllowanceMode) (min / max)</label>
                    <div class="input-group">
                        <input type="number" step="1" min="0" @bind="jMinMicron" />
                        <input type="number" step="1" min="0" @bind="jMaxMicron" style="margin-left:8px;" />
                        <span class="unit">&#956;m</span>
                    </div>
                    <small style="color: #6c757d; font-size: 12px;">
                        Leave the maximum at 0 to let the tolerance width come from the two gears'
                        ISO 1328-1 cumulative pitch tolerances F<sub>p</sub>.
                    </small>
                </div>

                <div class="form-group">
                    <label>Share the Thinning</label>
                    <select @bind="engine.SplitRule">
                        <option value="@BacklashSplit.Even">Evenly between both gears</option>
                        <option value="@BacklashSplit.PinionOnly">All on the pinion</option>
                        <option value="@BacklashSplit.WheelOnly">All on the wheel</option>
                    </select>
                    <small style="color: #6c757d; font-size: 12px;">
                        A backlash figure fixes only the <em>sum</em> of the two gears' allowances.
                    </small>
                </div>
            }
            else if (engine.AllowanceMode == ToothThicknessAllowanceMode.SpanLimits)
            {
                <div class="form-group">
                    <label>Teeth Spanned (k)</label>
                    <div class="dual-field">
                        <div class="dual-box">
                            <span class="dual-cap">Gear 1</span>
                            <input type="number" step="1" min="0" @bind="engine.SpanTeeth1" />
                        </div>
                        <div class="dual-box">
                            <span class="dual-cap">Gear 2</span>
                            <input type="number" step="1" min="0" @bind="engine.SpanTeeth2" />
                        </div>
                    </div>
                    <small style="color: #6c757d; font-size: 12px;">
                        0 lets the calculator choose the k that puts the contact at mid-flank.
                        A W<sub>k</sub> dimension only means anything against the k it was measured
                        over, so enter the k from the drawing if it states one. The results show
                        both the k used and the one this calculator would pick.
                    </small>
                </div>

                <div class="form-group">
                    <label>Gear 1 W<sub>k</sub> (largest / smallest permitted)</label>
                    <div class="input-group">
                        <input type="number" step="0.001" min="0" @bind="engine.SpanLimitUpper1" />
                        <input type="number" step="0.001" min="0" @bind="engine.SpanLimitLower1" style="margin-left:8px;" />
                        <span class="unit">mm</span>
                    </div>
                </div>

                <div class="form-group">
                    <label>Gear 2 W<sub>k</sub> (largest / smallest permitted)</label>
                    <div class="input-group">
                        <input type="number" step="0.001" min="0" @bind="engine.SpanLimitUpper2" />
                        <input type="number" step="0.001" min="0" @bind="engine.SpanLimitLower2" style="margin-left:8px;" />
                        <span class="unit">mm</span>
                    </div>
                    <small style="color: #6c757d; font-size: 12px;">
                        Both sit <strong>below</strong> the theoretical W<sub>k</sub>, because the teeth are
                        thinned from nominal.
                        @if (RecommendedSpanTeeth(1) is { } k1 && RecommendedSpanTeeth(2) is { } k2)
                        {
                            <text>
                                For this pair the micrometer should span <strong>k = @k1</strong> teeth on
                                gear 1 and <strong>k = @k2</strong> on gear 2 &#8212; the count that puts
                                the anvils on the flanks near mid-height, which is where the measurement
                                is least sensitive to the exact contact point.
                            </text>
                        }
                    </small>
                </div>
            }
            else if (engine.AllowanceMode == ToothThicknessAllowanceMode.BallLimits)
            {
                <div class="form-group">
                    <label>Gear 1 M<sub>d</sub> (largest / smallest permitted)</label>
                    <div class="input-group">
                        <input type="number" step="0.001" min="0" @bind="engine.BallLimitUpper1" />
                        <input type="number" step="0.001" min="0" @bind="engine.BallLimitLower1" style="margin-left:8px;" />
                        <span class="unit">mm</span>
                    </div>
                </div>

                <div class="form-group">
                    <label>Gear 2 M<sub>d</sub> (largest / smallest permitted)</label>
                    <div class="input-group">
                        <input type="number" step="0.001" min="0" @bind="engine.BallLimitUpper2" />
                        <input type="number" step="0.001" min="0" @bind="engine.BallLimitLower2" style="margin-left:8px;" />
                        <span class="unit">mm</span>
                    </div>
                    <small style="color: #6c757d; font-size: 12px;">
                        Both sit below the theoretical M<sub>d</sub>. Measured with
                        @BallDiameterCaption(1) on gear 1 and @BallDiameterCaption(2) on gear 2
                        &#8212; set the ball in that gear's <em>Advanced Gear Geometry</em> dialog.
                    </small>
                </div>
            }
        </ChildContent>
        <Footer>
            The allowances are negative &#8212; the teeth are thinned from nominal &#8212; so both
            permitted limits of W<sub>k</sub> and M<sub>d</sub> sit BELOW the theoretical value.
        </Footer>
    </DialogButton>;

    /// <summary>
    /// Which of the three routes the card is on. The engine keeps a single AllowanceMode; this
    /// maps it onto "a standard, or something you measured", which is the choice the user is
    /// actually making. Switching to manual lands on the plain allowances and the dialog takes
    /// it from there.
    /// </summary>
    private string ToleranceSource
    {
        get => engine.AllowanceMode switch
        {
            ToothThicknessAllowanceMode.Automatic => "auto",
            ToothThicknessAllowanceMode.Din3967 => "din3967",
            _ => "manual"
        };
        set => engine.AllowanceMode = value switch
        {
            "auto" => ToothThicknessAllowanceMode.Automatic,
            "din3967" => ToothThicknessAllowanceMode.Din3967,
            _ => engine.AllowanceMode is ToothThicknessAllowanceMode.Automatic
                                      or ToothThicknessAllowanceMode.Din3967
                 ? ToothThicknessAllowanceMode.Manual
                 : engine.AllowanceMode
        };
    }

    /// <summary>What the manual route is currently set to, for the line under the select.</summary>
    private string ManualToleranceSummary => engine.AllowanceMode switch
    {
        ToothThicknessAllowanceMode.NormalBacklash => "normal backlash j_bn",
        ToothThicknessAllowanceMode.CircumferentialBacklash => "circumferential backlash j_wt",
        ToothThicknessAllowanceMode.RadialBacklash => "radial backlash j_r",
        ToothThicknessAllowanceMode.SpanLimits => "base tangent length W_k limits",
        ToothThicknessAllowanceMode.BallLimits => "dimension over balls M_d limits",
        _ => "tooth thickness allowances A_sne / A_sni"
    };

    /*
     * The card's number field is the manual entry, and the dialog is only ever opened to have
     * the value CALCULATED. So there is no "enter directly" checkbox anywhere: typing in the
     * field puts you back in manual mode, and "Use this value" in the dialog switches to the
     * standard's result. The mode is a consequence of what you touched last, not a separate
     * thing to keep in sync.
     */
    /* Calculated is now the default for both, so before the first calculation the underlying
       value is still 0. Showing a bare 0 in the box invites the user to "correct" it, which
       silently flips the field into manual mode - exactly the trap the asymmetric default
       used to spring. Fall back to 1.000 until there is a real number. */
    private double KvShown
    {
        get => engine.UseDirectDynamicFactor ? engine.DirectKV
             : engine.DynamicFactor > 0 ? engine.DynamicFactor : 1.0;
        set { engine.DirectKV = value; engine.UseDirectDynamicFactor = true; }
    }

    private double KhbShown
    {
        get => engine.UseDirectFaceLoadFactor ? engine.DirectKHbeta
             : engine.FaceLoadFactorFlank > 0 ? engine.FaceLoadFactorFlank : 1.0;
        set { engine.DirectKHbeta = value; engine.UseDirectFaceLoadFactor = true; }
    }

    /// <summary>
    /// Which of the two routes the K_V dialog takes its tooth deviations from. A string view of
    /// engine.UseMeasuredDeviations, for the same reason ToleranceSource is one: a select binds
    /// through its value attribute, and the renderer drops that attribute when it is given a
    /// bool false, so the two options could not be told apart.
    /// </summary>
    private string DeviationSource
    {
        get => engine.UseMeasuredDeviations ? "measured" : "class";
        set => engine.UseMeasuredDeviations = value == "measured";
    }

    private void UseCalculatedKv() => engine.UseDirectDynamicFactor = false;

    private void UseCalculatedKhbeta() => engine.UseDirectFaceLoadFactor = false;

    /// <summary>
    /// The number of teeth the span micrometer should reach over, from the same
    /// GearToothMeasurement solve that produces W_k, so the suggestion and the reported
    /// dimension can never disagree. Null until the geometry is complete.
    /// </summary>
    /// <summary>
    /// The checks outside ISO 6336 that are failing: scuffing, judged on the margin in kelvin
    /// that Clause 10.5 asks for rather than on the temperature quotient, and micropitting.
    /// Empty when they pass or were not evaluated.
    /// </summary>
    private List<string> OtherCriteriaFalling()
    {
        var falling = new List<string>();
        if (engine.Scuffing is { Valid: true } sc && sc.MarginKelvin < 50)
            falling.Add($"scuffing (margin {sc.MarginKelvin:F0} K, below the 50 K the standard suggests)");
        if (engine.ScuffingIntegral is { Valid: true } si && si.SafetyFactor < 1.8)
            falling.Add($"scuffing by the integral method (S_intS {si.SafetyFactor:F2} < 1.8)");
        if (engine.Micropitting is { Valid: true } mp && mp.SafetyFactor < 1.0)
            falling.Add($"micropitting (S_lambda {mp.SafetyFactor:F2} < 1.00)");
        return falling;
    }

    private int? RecommendedSpanTeeth(int gear)
    {
        // kPreferred, not k. k is what is IN USE - the user's own entry when they made one -
        // whereas this hint answers "how many teeth should I span?", which is the calculator's
        // own choice. Returning k made the hint agree with whatever had been typed and hide the
        // disagreement the results table then reported.
        var m = gear == 1 ? engine.Measurement1 : engine.Measurement2;
        if (m is { kPreferred: > 0 }) return m.kPreferred;

        // Before the first calculation there is no solve to draw on, so this falls back to the
        // classical estimate k = z alpha_t/180 + 0.5. It ignores profile shift and so can differ
        // from kPreferred by a tooth on a shifted gear - which is exactly what happened, the
        // dialog saying 2 where the engine chose 3. Once a calculation exists the engine wins.
        if (engine.NumberOfTeeth1 <= 0 || engine.NormalModule <= 0) return null;
        int z = TeethOf(gear);
        if (z <= 0) return null;

        double betaRad = engine.HelixAngle * Math.PI / 180.0;
        double alphaNRad = engine.PressureAngle * Math.PI / 180.0;
        double alphaT = Math.Atan(Math.Tan(alphaNRad) / Math.Cos(betaRad)) * 180.0 / Math.PI;
        int k = (int)Math.Round(z * alphaT / 180.0 + 0.5);
        return Math.Max(k, 2);
    }

    private static bool IsBacklashMode(ToothThicknessAllowanceMode mode)
        => mode is ToothThicknessAllowanceMode.NormalBacklash
                or ToothThicknessAllowanceMode.CircumferentialBacklash
