                        <div class="schematic-note">
                            <strong>Source.</strong> @lp.Source
                            @if (lp.FzgStageA8390 == null)
                            {
                                <text> The scuffing stage is not published for this product, so it stays yours to enter.</text>
                            }
                        </div>
                    }
                </ChildContent>
                <Footer>
                    X<sub>L</sub> = coefficient &#183; &#951;<sub>oil</sub><sup>&#8722;0.05</sup>,
                    with &#951; the dynamic viscosity at the oil temperature. Values a product
                    supplies are locked; choose <em>Custom</em> on the card to edit them.
                </Footer>
            </DialogButton>;

    private RenderFragment DynamicFactorDialog() => @<DialogButton
        Icon="open-options-dialog"
        Title="Dynamic Factor K_V &#8212; ISO 6336-1 Clause 6, Method B"
        MaxWidth="720"
        ButtonTitle="Calculate K_V from the tooth deviations"
        ConfirmLabel="OK" OnConfirm="UseCalculatedKv">
        <ChildContent>
            <div class="dialog-intro">
                Enter what the standard needs and press <strong>OK</strong>. Method B
                carries a resonance check that a figure taken from experience cannot give you, so
                it is worth doing for a fast drive. To go back to your own number, just type it in
                the field on the card.
            </div>

            <div class="form-group">
                <label>Tooth Deviations</label>
                <select @bind="DeviationSource">
                    <option value="class">From the wheel's ISO 1328-1 class &#8212; Clause 6.4.3</option>
                    <option value="measured">Measured on the gears &#8212; enter them below</option>
                </select>
                <small style="color: #6c757d; font-size: 12px;">
                    @if (engine.UseMeasuredDeviations)
                    {
                        <text>
                            Taken as entered. Fill these in from an inspection chart:
                            <strong>leaving them at 0 puts K<sub>V</sub> at about 1</strong>, which is
                            not conservative.
                        </text>
                    }
                    else
                    {
                        <text>
                            Derived from the wheel's tolerance class &#8212; f<sub>pT</sub> becomes
                            f<sub>pb</sub> via cos(&#945;<sub>t</sub>), and the running-in allowances
                            are taken as 0. The fields below show what was used.
                        </text>
                    }
                </small>
            </div>

            <div class="form-group">
                <label>Base Pitch Deviation (f<sub>pb</sub>)</label>
                <div class="input-group">
                    <input type="number" step="0.1" min="0" @bind="engine.BasePitchDeviation"
                           readonly="@(!engine.UseMeasuredDeviations)" />
                    <span class="unit">&#956;m</span>
                </div>
            </div>
            <div class="form-group">
                <label>Profile Form Deviation (f<sub>f&#945;</sub>)</label>
                <div class="input-group">
                    <input type="number" step="0.1" min="0" @bind="engine.ProfileFormDeviation"
                           readonly="@(!engine.UseMeasuredDeviations)" />
                    <span class="unit">&#956;m</span>
                </div>
            </div>
            <div class="form-group">
                <label>Running-in Allowances (y<sub>p</sub> / y<sub>f</sub>)</label>
                <div class="input-group">
                    <input type="number" step="0.1" min="0" @bind="engine.RunningInAllowanceP"
                           readonly="@(!engine.UseMeasuredDeviations)" />
                    <input type="number" step="0.1" min="0" @bind="engine.RunningInAllowanceF"
                           readonly="@(!engine.UseMeasuredDeviations)" style="margin-left:8px;" />
                    <span class="unit">&#956;m</span>
                </div>
                <small style="color: #6c757d; font-size: 12px;">0 is conservative (no running-in benefit)</small>
            </div>

            @if (!engine.UseMeasuredDeviations && engine.BasePitchDeviation <= 0)
            {
                <div class="schematic-note">
                    The class values land in the three fields above after the next calculation.
                </div>
            }

            <div class="dialog-action">
                @if (engine.DynamicResult is { Valid: true } dyn)
                {
                    <span class="dialog-action-note">
                        Method B on the last calculation gives K<sub>V</sub> =
                        <strong>@dyn.KV.ToString("F3")</strong>.
                    </span>
                }
                else
                {
                    <span class="dialog-action-note">
                        The value appears after the next calculation.
                    </span>
                }
            </div>
        </ChildContent>
        <Footer>
            K<sub>V</sub> covers the internal dynamic load from the meshing itself. It is not a
            shock factor &#8212; that is K<sub>A</sub>, on the Power Data card.
        </Footer>
    </DialogButton>;

    /// <summary>
    /// The ISO 6336-1 Method C inputs behind the face load factor: mesh misalignment, shaft
    /// deflection and the mounting arrangement.
    /// </summary>
    private RenderFragment FaceLoadFactorDialog() => @<DialogButton
        Icon="open-options-dialog"
        Title="Face Load Factor K_Hbeta &#8212; ISO 6336-1 Clause 7.5, Method C"
        MaxWidth="760"
        ButtonTitle="Calculate K_Hbeta from the misalignment and shaft deflection"
        ConfirmLabel="OK" OnConfirm="UseCalculatedKhbeta">
        <ChildContent>
            <div class="dialog-intro">
                Enter what the standard needs and press <strong>OK</strong>.
                <strong>Neglecting the shaft deflection is not conservative</strong> &#8212; on a
                typical pair it is what takes K<sub>H&#946;</sub> from about 1,8 to 3,0. To go back
                to your own number, just type it in the field on the card.
            </div>

            @{
                bool __ = true;
            }
            @if (__)
            {
                <div class="form-group">
                    <label>Helix Modification (ISO 6336-1 Table 8)</label>
                    <select @bind="engine.HelixMod">
                        <option value="@Iso6336FaceLoadFactor.HelixModification.None">None</option>
                        <option value="@Iso6336FaceLoadFactor.HelixModification.CentralCrowningFma">Central crowning (C&#946; = 0.5 f<sub>ma</sub>)</option>
                        <option value="@Iso6336FaceLoadFactor.HelixModification.CentralCrowningFmaFsh">Central crowning (C&#946; = 0.5 (f<sub>ma</sub>+f<sub>sh</sub>))</option>
                        <option value="@Iso6336FaceLoadFactor.HelixModification.HelixCorrectionOnly">Helix correction only</option>
                        <option value="@Iso6336FaceLoadFactor.HelixModification.HelixCorrectionPlusCrowning">Helix correction + central crowning</option>
                        <option value="@Iso6336FaceLoadFactor.HelixModification.EndRelief">End relief</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Shaft Deflection (f<sub>sh</sub>)</label>
                    <select @bind="engine.FshSource">
                        <option value="@ShaftDeflectionSource.Calculated">Calculate from the shaft dimensions (ISO 6336-1 Eq. 57)</option>
                        <option value="@ShaftDeflectionSource.Manual">Enter f_sh directly (from a shaft analysis)</option>
                        <option value="@ShaftDeflectionSource.Neglected">Neglect &#8212; rigid shaft, f_sh = 0</option>
                    </select>
                    <small style="color: #6c757d; font-size: 12px;">
                        This calculator does not model shafts. Eq. 57 is the standard's approximate
                        method: it reduces the shaft to a span, an offset and a diameter.
                        <strong>Neglecting f_sh is not conservative.</strong>
                    </small>
                </div>

                @if (engine.FshSource == ShaftDeflectionSource.Manual)
                {
                    <div class="form-group">
                        <label>f<sub>sh</sub></label>
                        <div class="input-group">
                            <input type="number" step="0.5" min="0" @bind="engine.ShaftDeflectionFsh" />
                            <span class="unit">&#956;m</span>
                        </div>
                    </div>
                }
                else if (engine.FshSource == ShaftDeflectionSource.Calculated)
                {
                    <div class="form-group">
                        <label>Bearing Span (l)</label>
                        <div class="input-group">
                            <input type="number" step="1" min="0" @bind="engine.ShaftBearingSpan" />
                            <span class="unit">mm</span>
                        </div>
                        <small style="color: #6c757d; font-size: 12px;">
                            0 = assume 3&#183;b. Distance between the pinion shaft bearings.
                        </small>
                    </div>

                    <div class="form-group">
                        <label>Pinion Offset (s)</label>
                        <div class="input-group">
                            <input type="number" step="1" min="0" @bind="engine.PinionOffset" />
                            <span class="unit">mm</span>
                        </div>
                        <small style="color: #6c757d; font-size: 12px;">
                            From the pinion mid-plane to the middle of the bearing span. 0 = centred.
                            Eq. 57 is drawn for s/l &#8804; 0.3.
                        </small>
                    </div>

                    <div class="form-group">
                        <label>Shaft Diameter (d<sub>sh</sub> / bore)</label>
                        <div class="input-group">
                            <input type="number" step="1" min="0" @bind="engine.ShaftDiameter" />
                            <input type="number" step="1" min="0" @bind="engine.ShaftBoreDiameter" style="margin-left:8px;" />
                            <span class="unit">mm</span>
                        </div>
                        <small style="color: #6c757d; font-size: 12px;">
                            Outside diameter for bending, then the bore (0 = solid).
                            0 = assume d<sub>1</sub>/1.15.
                        </small>
                    </div>

                    <div class="form-group">
                        <label>Mounting Arrangement (ISO 6336-1 Figure 13)</label>
                        <select @bind="engine.ShaftArrangement">
                            @foreach (var a in Enum.GetValues<Iso6336ShaftDeflection.Arrangement>())
                            {
                                <option value="@a">@Iso6336ShaftDeflection.Description(a)</option>
                            }
                        </select>
                        <small style="color: #6c757d; font-size: 12px;">
                            Match your layout against Figure 13, which shows where the torqued end sits
                            relative to the pinion. The sign of K&#8242; decides whether bending and torsion
                            add or partly cancel.
                        </small>
                    </div>

                    <div class="form-group">
                        <label class="checkbox-label">
                            <input type="checkbox" @bind="engine.PinionCanStiffenShaft" />
                            <span>Pinion body can stiffen the shaft span</span>
                        </label>
                        <small style="color: #6c757d; font-size: 12px;">
                            Uncheck for a pinion sliding on a feather key or a normal shrink fit.
                            Otherwise stiffening is taken when d<sub>1</sub>/d<sub>sh</sub> &#8805; 1.15.
                        </small>
                    </div>
                }
            }
            <div class="dialog-action">
                <span class="dialog-action-note">
                    Method C gave K<sub>H&#946;</sub> =
                    <strong>@engine.FaceLoadFactorFlank.ToString("F3")</strong> on the last calculation.
                </span>
            </div>
        </ChildContent>
        <Footer>
            K<sub>F&#946;</sub> for the tooth root is derived from K<sub>H&#946;</sub> by
            ISO 6336-1 Eq. (69), so it is not asked for separately.
        </Footer>
    </DialogButton>;

    /// <summary>
    /// Everything about one gear that would crowd its card: how it is finished, the surface
    /// roughness that follows, and the blank it is cut from. Only the bore reaches the
    /// calculation, through Y_B; the rest shapes the 3D model.
    /// </summary>
    private RenderFragment GearAdvancedDialog(int gear) => @<DialogButton
        Icon="open-options-dialog"
        Title="@($"Advanced Gear Geometry — gear {gear}")"
        MaxWidth="720"
        ButtonTitle="@($"Surface finish, rim and hub of gear {gear}")">
        <ChildContent>
            <h4 style="margin: 0 0 12px; font-size: 14px; color: #2c3e50;">Surface finish</h4>
            <div class="dialog-form">
                <div class="form-group full">
                    <label>Finishing Route</label>
                    <select value="@(gear == 1 ? finishingRoute1 : finishingRoute2)"
                            @onchange="e => SetFinishingRoute(gear, e.Value?.ToString())">
                        @foreach (var r in FinishingRoutes)
                        {
                            <option value="@r.Key">@r.Label</option>
                        }
                    </select>
                    <small style="color: #6c757d; font-size: 12px;">
                        Fills the two roughness fields with values typical of that route. They stay
                        editable &#8212; measured values always win.
                    </small>
                </div>

                <div class="form-group">
                    <label>Flank R<sub>z</sub> after running-in</label>
                    <div class="input-group">
                        <input type="number" step="0.1" min="0.1"
                               value="@(gear == 1 ? engine.FlankRoughnessRz1 : engine.FlankRoughnessRz2)"
                               @onchange="e => SetFlankRz(gear, e.Value?.ToString())" />
                        <span class="unit">&#956;m</span>
                    </div>
                    <small style="color: #6c757d; font-size: 12px;">
                        Drives Z<sub>R</sub>. If you have R<sub>a</sub>, use R<sub>z</sub> &#8776; 6&#183;R<sub>a</sub>.
                    </small>
                </div>

                <div class="form-group">
                    <label>Flank R<sub>a</sub></label>
                    <div class="input-group">
                        <input type="number" step="0.05" min="0"
                               placeholder="@FlankRaPlaceholder(gear)"
                               value="@FlankRaValue(gear)"
                               @onchange="e => SetFlankRa(gear, e.Value?.ToString())" />
                        <span class="unit">&#956;m</span>
                    </div>
                    <small style="color: #6c757d; font-size: 12px;">
                        Drives the coefficient of friction in the scuffing and micropitting checks,
                        as R<sub>a</sub><sup>0.25</sup>. Left blank it is taken as R<sub>z</sub>/6 &#8212;
                        a rule of thumb, not a measurement: a drawing calling out R<sub>z</sub> 4.8 with
                        R<sub>a</sub> 0.60 has a ratio of 8, and R<sub>z</sub>/6 would put it 33 % high.
                    </small>
                </div>

                <div class="form-group">
                    <label>Tip Relief (C<sub>a</sub>)</label>
                    <div class="input-group">
                        <input type="number" step="1" min="0"
                               value="@(gear == 1 ? engine.TipRelief1 : engine.TipRelief2)"
                               @onchange="e => SetTipRelief(gear, e.Value?.ToString())" />
                        <span class="unit">&#956;m</span>
                    </div>
                    <small style="color: #6c757d; font-size: 12px;">
                        0 = unmodified profile. Both scuffing methods use it. ISO/TR 13989-2 only
                        credits it for ISO 1328-1 grade 6 or better, and says so in the results when
                        the grade is coarser than that.
                    </small>
                </div>

                <div class="form-group">
                    <label>Root Fillet R<sub>z</sub></label>
                    <div class="input-group">
                        <input type="number" step="0.5" min="0.1"
                               value="@(gear == 1 ? engine.RootRoughnessRz1 : engine.RootRoughnessRz2)"
                               @onchange="e => SetRootRz(gear, e.Value?.ToString())" />
                        <span class="unit">&#956;m</span>
                    </div>
                    <small style="color: #6c757d; font-size: 12px;">
                        Drives Y<sub>RrelT</sub>. 10 &#956;m is the ISO 6336-3 reference test gear.
                    </small>
                </div>

                <div class="form-group full">
                    <label>Ball / Pin Diameter for M<sub>d</sub> (D<sub>M</sub>)</label>
                    <div class="input-group">
                        <input type="number" step="0.1" min="0"
                               value="@(gear == 1 ? engine.BallDiameter1 : engine.BallDiameter2)"
                               @onchange="e => SetBallDiameter(gear, e.Value?.ToString())" />
                        <span class="unit">mm</span>
                    </div>
                    <small style="color: #6c757d; font-size: 12px;">
                        The ball this gear's dimension over balls is measured with &#8212; a bigger ball
                        sits higher on the flank and reads larger, so use the size you actually have.
                        <strong>0</strong> lets the calculator pick a best size; the results report both
                        the size used and the best size. It belongs to the gear, not to the tolerance,
                        which is why it lives here.
                    </small>
                </div>
            </div>

            <h4 style="margin: 18px 0 12px; font-size: 14px; color: #2c3e50;">Rim and hub</h4>
            <div class="dialog-form">
                <div class="form-group">
                    <label>Bore Diameter (d<sub>i</sub>)</label>
                    <div class="input-group">
                        <input type="number" step="1" min="0"
                               value="@(gear == 1 ? engine.BoreDiameter1 : engine.BoreDiameter2)"
                               @onchange="e => SetBore(gear, e.Value?.ToString())" />
                        <span class="unit">mm</span>
                    </div>
                    <small style="color: #6c757d; font-size: 12px;">
                        0 = solid. The only body dimension the calculation uses.
                    </small>
                </div>

                <div class="form-group">
                    <label>Blank Type</label>
                    <select value="@(gear == 1 ? blankType1 : blankType2)"
                            @onchange="e => SetBlankType(gear, e.Value?.ToString())">
                        <option value="Solid">Solid disc</option>
                        <option value="Webbed">Rim + web + hub</option>
                    </select>
                </div>

                @if ((gear == 1 ? blankType1 : blankType2) == "Webbed")
                {
                    <div class="form-group">
                        <label>Rim Inner &#216; (d<sub>R</sub>)</label>
                        <div class="input-group">
                            <input type="number" step="1" min="0"
                                   value="@(gear == 1 ? rimInnerDia1 : rimInnerDia2)"
                                   @onchange="e => SetRimInner(gear, e.Value?.ToString())" />
                            <span class="unit">mm</span>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Hub &#216; (d<sub>N</sub>)</label>
                        <div class="input-group">
                            <input type="number" step="1" min="0"
                                   value="@(gear == 1 ? hubDia1 : hubDia2)"
                                   @onchange="e => SetHubDia(gear, e.Value?.ToString())" />
                            <span class="unit">mm</span>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Web Thickness (s<sub>W</sub>)</label>
                        <div class="input-group">
                            <input type="number" step="1" min="0"
                                   value="@(gear == 1 ? webThickness1 : webThickness2)"
                                   @onchange="e => SetWebThickness(gear, e.Value?.ToString())" />
                            <span class="unit">mm</span>
                        </div>
                        <small style="color: #6c757d; font-size: 12px;">
                            Less than the face width, or the web fills the blank.
                        </small>
                    </div>
                }
            </div>

            @if (RimPreview(gear) is { } rim)
            {
                <div class="alert @(rim.yb > 1.0 ? "alert-warning" : "alert-info")" style="margin: 16px 0 0;">
                    <ModuleIcon Type="info" Size="small" Style="default" CustomStyle="margin-right: 8px;" />
                    <div>
                        s<sub>R</sub>/m<sub>n</sub> = @rim.ratio.ToString("F2")
                        &#8594; Y<sub>B</sub> = @rim.yb.ToString("F3").
                        @if (rim.yb > 1.0)
                        {
                            <text>A thin rim lets the root bend as part of the rim, raising the root stress.</text>
                        }
                        else
                        {
                            <text>
                                Above s<sub>R</sub>/m<sub>n</sub> = 1.2 the rim is thick enough that
                                Y<sub>B</sub> = 1 and the bore changes nothing.
                            </text>
                        }
                    </div>
                </div>
            }
        </ChildContent>
        <Footer>
            Rim, hub and web shape the <strong>3D model only</strong> &#8212; ISO 6336 has no term
            for them. The bore is the exception: it fixes the rim thickness and through it
            Y<sub>B</sub>.
        </Footer>
    </DialogButton>;

    // Setters for the dialog's fields. The dialog builds its inputs from a gear index rather
    // than @bind, so each one needs an explicit target.
    private static double ParseOr(string? text, double fallback)
        => double.TryParse(text, System.Globalization.NumberStyles.Any,
                           System.Globalization.CultureInfo.InvariantCulture, out double v) ? v : fallback;

    private void SetFinishingRoute(int gear, string? key)
    {
        if (key is null || !FinishingRouteOptions.Contains(key)) return;
        if (gear == 1) finishingRoute1 = key; else finishingRoute2 = key;
        OnFinishingRouteChanged(gear);
    }

    private void SetFlankRz(int gear, string? v)
    {
        if (gear == 1) engine.FlankRoughnessRz1 = ParseOr(v, engine.FlankRoughnessRz1);
        else engine.FlankRoughnessRz2 = ParseOr(v, engine.FlankRoughnessRz2);
    }

    private void SetRootRz(int gear, string? v)
    {
        if (gear == 1) engine.RootRoughnessRz1 = ParseOr(v, engine.RootRoughnessRz1);
        else engine.RootRoughnessRz2 = ParseOr(v, engine.RootRoughnessRz2);
    }

    /* An <input type="number"> only accepts a dot as the decimal separator, whatever the
       user's locale. @bind knows that; a hand-written value="@..." does not, so these format
       with InvariantCulture explicitly. Formatting "0,6" into the value attribute made the
       browser reject it and render an empty box, which looked like the entry had been thrown
       away while the engine had in fact stored it. */
    private static readonly System.Globalization.CultureInfo Inv =
        System.Globalization.CultureInfo.InvariantCulture;

    /// <summary>The Rz/6 fallback, shown greyed so it is clear what is being used.</summary>
    private string FlankRaPlaceholder(int gear)
        => ((gear == 1 ? engine.FlankRoughnessRz1 : engine.FlankRoughnessRz2) / 6.0).ToString("F2", Inv);

    /// <summary>Empty when no override is set, so the placeholder shows through.</summary>
    private string FlankRaValue(int gear)
    {
        double ra = gear == 1 ? engine.FlankRoughnessRa1 : engine.FlankRoughnessRa2;
        return ra > 0 ? ra.ToString("0.###", Inv) : "";
    }

    private void SetFlankRa(int gear, string? v)
    {
        // Blank clears the override and returns to Rz/6.
        double parsed = string.IsNullOrWhiteSpace(v) ? 0 : ParseOr(v, 0);
        if (gear == 1) engine.FlankRoughnessRa1 = parsed;
        else engine.FlankRoughnessRa2 = parsed;
    }

    private void SetTipRelief(int gear, string? v)
    {
        if (gear == 1) engine.TipRelief1 = ParseOr(v, engine.TipRelief1);
        else engine.TipRelief2 = ParseOr(v, engine.TipRelief2);
    }

    /// <summary>What the M_d limits will actually be measured with, for the caption.</summary>
    private string BallDiameterCaption(int gear)
    {
        double set = gear == 1 ? engine.BallDiameter1 : engine.BallDiameter2;
        return set > 0 ? "Ø" + set.ToString("0.###") + " mm" : "the best size";
    }

    private void SetBallDiameter(int gear, string? v)
    {
        if (gear == 1) engine.BallDiameter1 = ParseOr(v, engine.BallDiameter1);
        else engine.BallDiameter2 = ParseOr(v, engine.BallDiameter2);
    }

    private void SetBore(int gear, string? v)
    {
        if (gear == 1) engine.BoreDiameter1 = ParseOr(v, engine.BoreDiameter1);
        else engine.BoreDiameter2 = ParseOr(v, engine.BoreDiameter2);
    }

    private void SetBlankType(int gear, string? v)
    {
        if (v is null || !BlankTypeOptions.Contains(v)) return;
        if (gear == 1) blankType1 = v; else blankType2 = v;
        if (v == "Webbed") SeedWebbedBlank(gear);
    }

    /// <summary>
    /// Fills the rim, hub and web with a proportioned starting set the first time a blank is
    /// switched to webbed.
    ///
    /// Without this the three fields sit at zero, and the 3D builder needs all of them
    /// positive before it will draw a web at all - so the model silently stayed a solid disc
    /// and the choice looked like it had done nothing. Values already entered are left alone.
    /// </summary>
    private void SeedWebbedBlank(int gear)
    {
        double df = gear == 1 ? engine.RootDiameter1 : engine.RootDiameter2;
        if (df <= 0)
        {
            // Before the first calculation the engine has no diameters yet; derive from the form.
            double d = ReferenceDiameterOf(gear);
            double x = gear == 1 ? engine.ProfileShiftCoeff1 : engine.ProfileShiftCoeff2;
            df = d - 2.0 * engine.NormalModule * (engine.DedendumCoeff - x);
        }
        if (df <= 0 || engine.NormalModule <= 0) return;

        double bore = gear == 1 ? engine.BoreDiameter1 : engine.BoreDiameter2;
        if (bore <= 0) bore = Math.Round(df * 0.25);

        double rim = Math.Round(df - 5.0 * engine.NormalModule);
        double hub = Math.Round(Math.Min(bore * 1.8, rim * 0.7));
        double web = Math.Round(Math.Max(1.0, (gear == 1 ? engine.FaceWidth1 : engine.FaceWidth2) / 3.0));

        if (rim <= bore) return;   // too small a blank to web sensibly

        if (gear == 1)
        {
            if (engine.BoreDiameter1 <= 0) engine.BoreDiameter1 = bore;
            if (rimInnerDia1 <= 0) rimInnerDia1 = rim;
            if (hubDia1 <= 0) hubDia1 = hub;
            if (webThickness1 <= 0) webThickness1 = web;
        }
        else
        {
            if (engine.BoreDiameter2 <= 0) engine.BoreDiameter2 = bore;
            if (rimInnerDia2 <= 0) rimInnerDia2 = rim;
            if (hubDia2 <= 0) hubDia2 = hub;
            if (webThickness2 <= 0) webThickness2 = web;
        }
    }

    private void SetRimInner(int gear, string? v)
    {
        if (gear == 1) rimInnerDia1 = ParseOr(v, rimInnerDia1); else rimInnerDia2 = ParseOr(v, rimInnerDia2);
    }

    private void SetHubDia(int gear, string? v)
    {
        if (gear == 1) hubDia1 = ParseOr(v, hubDia1); else hubDia2 = ParseOr(v, hubDia2);
    }

    private void SetWebThickness(int gear, string? v)
    {
        if (gear == 1) webThickness1 = ParseOr(v, webThickness1); else webThickness2 = ParseOr(v, webThickness2);
    }

    // --- DIN 3967 ---

    private bool Din3967PickerBlocked()
        => engine.NormalModule <= 0 || engine.NumberOfTeeth1 <= 0 || engine.NumberOfTeeth2 <= 0;

    /// <summary>Table 1 evaluated for the pinion; the wheel's columns come from <see cref="Din3967SecondGear"/>.</summary>
    private IEnumerable<Din3967.Result> Din3967SeriesRows()
        => Din3967.AllZones(engine.Din3967ToleranceSeries1, ReferenceDiameterOf(1));

    private Din3967.Result? Din3967SecondGear(string letter)
        => Din3967.Allowances(engine.Din3967ToleranceSeries2, letter, ReferenceDiameterOf(2));

    /// <summary>"27cd" -> "cd". The designation is series number then letter (Clause 3.4).</summary>
    private static string SeriesLetterOf(string designation)
        => new(designation.SkipWhile(char.IsDigit).ToArray());


    /// <summary>ISO 286 fields offered for the centre distance. A link carrying anything else falls back to js7.</summary>
    private static readonly string[] CentreDistanceFieldOptions =
        { "js6", "js7", "js8", "js9", "js10", "H7", "H8" };

    /// <summary>One ISO 286 field evaluated at the current centre distance.</summary>
    private record CentreDistanceFieldRow(string Field, double Upper, double Lower, bool Supported, string Use);

    private IEnumerable<CentreDistanceFieldRow> CentreDistanceFieldRows()
    {
        var uses = new Dictionary<string, string>
        {
            ["js6"] = "Precision, ground bores",
            ["js7"] = "Machined housing — the usual choice",
            ["js8"] = "General machined housing",
            ["js9"] = "Cast or fabricated housing",
            ["js10"] = "Coarse / non-critical drive",
            ["H7"] = "Bore fit, one-sided",
            ["H8"] = "Bore fit, one-sided, coarser"
        };

        foreach (var field in CentreDistanceFieldOptions)
        {
            var dev = Iso286.TryGetDeviations(field, engine.CenterDistance);
            yield return new CentreDistanceFieldRow(
                field, dev?.upper ?? 0, dev?.lower ?? 0, dev != null, uses[field]);
        }
    }

    private int TeethOf(int gear) => gear == 1 ? engine.NumberOfTeeth1 : engine.NumberOfTeeth2;

    private double FaceWidthOf(int gear) => gear == 1 ? engine.FaceWidth1 : engine.FaceWidth2;

    /// <summary>
    /// d = mn z / cos(beta). The engine only fills ReferenceDiameter1/2 during Calculate(),
    /// and the picker has to work while the form is still being filled in.
    /// </summary>
    private double ReferenceDiameterOf(int gear)
    {
        double cosBeta = Math.Cos(engine.HelixAngle * Math.PI / 180.0);
        return cosBeta > 1e-9 ? engine.NormalModule * TeethOf(gear) / cosBeta : 0;
    }

    private bool QualityPickerBlocked(int gear)
        => engine.NormalModule <= 0 || TeethOf(gear) <= 0 || FaceWidthOf(gear) <= 0;

    private IEnumerable<QualityRow> QualityRows(int gear)
    {
        double d = ReferenceDiameterOf(gear);
        foreach (var (grade, _) in QualityGradeChoices)
        {
            yield return new QualityRow(grade, Iso1328Tolerance.Calculate(
                grade, d, engine.NormalModule, FaceWidthOf(gear), TeethOf(gear), engine.HelixAngle));
        }
    }

    private void SetQualityGrade(int gear, int grade)
    {
        if (gear == 1) engine.QualityGrade1 = grade;
        else engine.QualityGrade2 = grade;
    }

    /// <summary>
    /// The tolerance-class picker. Unlike a static table this one is computed from the gear
    /// the user is editing, so the choice is made against the actual micrometres rather than
    /// against words like "High".
    /// </summary>
    private RenderFragment QualityPicker(int gear) => @<DialogButton
        Title="@($"Flank Tolerances — ISO 1328-1:2013, gear {gear}")"
        MaxWidth="820"
        Disabled="@QualityPickerBlocked(gear)"
        ButtonTitle="@(QualityPickerBlocked(gear)
            ? "Enter the normal module, number of teeth and face width first"
            : $"Flank tolerances for each class, gear {gear}")">
        <Intro>
            Tolerances in micrometres for this gear as entered:
            d = @ReferenceDiameterOf(gear).ToString("F2") mm,
            m<sub>n</sub> = @engine.NormalModule.ToString("F2") mm,
            b = @FaceWidthOf(gear).ToString("F1") mm, z = @TeethOf(gear).
            A class costs roughly &#8730;2 in tolerance per step, and the wheel's deviations drive
            the dynamic factor K<sub>V</sub> and the face load factor K<sub>H&#946;</sub> &#8212; so
            this is a strength decision, not only a manufacturing one.
        </Intro>
        <ChildContent>
            <div class="dialog-scroll">
                <table class="info-table">
                    <thead>
                        <tr>
                            <th>Class</th>
                            <th class="num">f<sub>pt</sub></th>
                            <th class="num">F<sub>p</sub></th>
                            <th class="num">f<sub>f&#945;</sub></th>
                            <th class="num">F<sub>&#945;</sub></th>
                            <th class="num">f<sub>H&#946;</sub></th>
                            <th class="num">F<sub>&#946;</sub></th>
                            <th>Typical process</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in QualityRows(gear))
                        {
                            <tr class="@(r.Grade == (gear == 1 ? engine.QualityGrade1 : engine.QualityGrade2) ? "is-current" : null)">
                                <td><strong>@r.Grade</strong></td>
                                <td class="num">@r.T.SinglePitch.ToString("F1")</td>
                                <td class="num">@r.T.CumulativePitch.ToString("F1")</td>
                                <td class="num">@r.T.ProfileForm.ToString("F1")</td>
                                <td class="num">@r.T.ProfileTotal.ToString("F1")</td>
                                <td class="num">@r.T.HelixSlope.ToString("F1")</td>
                                <td class="num">@r.T.HelixTotal.ToString("F1")</td>
                                <td>@QualityProcessHint(r.Grade)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </ChildContent>
        <Footer>
            The process column is a workshop guide, not part of the standard.
            @Iso1328Tolerance.EditionMismatchNote
        </Footer>
    </DialogButton>;

    protected override void OnInitialized()
    {
        gearMaterials = GearMaterial.StandardMaterials;
        ResetEngine();
    }

    /// <summary>
    /// Default values (based on the KISSsoft tutorial example). The centre distance is the
    /// reference one for z1 = 20, z2 = 40, mn = 1.5 and x = 0, so the form opens on a
    /// consistent gear pair rather than one with an implied profile shift.
    /// </summary>
    private void ResetEngine()
    {
        engine = new GearPairEngine
        {
            Power = 3.5,
            Speed1 = 2500,
            ApplicationFactor = 1.0,
            RequiredServiceLife = 10000,
            NormalModule = 1.5,
            PressureAngle = 20.0,
            HelixAngle = 0.0,
            CenterDistance = 45.0,
            NumberOfTeeth1 = 20,
            NumberOfTeeth2 = 40,
            FaceWidth1 = 15,
            FaceWidth2 = 15,
            ProfileShiftCoeff1 = 0.0,
            AddendumCoeff = 1.0,
            DedendumCoeff = 1.25,
            RootRadiusCoeff = 0.3,
            QualityGrade1 = 6,
            QualityGrade2 = 6
        };

        selectedApplicationFactor = "1.0";

        // Naming the default lubricant is not the same as loading it. Setting the field alone
        // left the card claiming a named product while the engine still held its own defaults
        // (nu100 = 0, i.e. "estimated", for an oil whose sheet publishes 19,0) - the selector
        // and the numbers behind it disagreeing, which is the whole thing this card was
        // rebuilt to stop. Apply it.
        selectedLubricant = "Mobilgear 600 XP 220";
        lastOil = lastGrease = null;
        OnLubricantChanged();
        asne1Micron = asni1Micron = asne2Micron = asni2Micron = 0;
        aaUpperMicron = aaLowerMicron = 0;
        daUpperMicron = daLowerMicron = dfUpperMicron = dfLowerMicron = 0;
        jMinMicron = jMaxMicron = 0;
        blankType1 = blankType2 = "Solid";
        finishingRoute1 = finishingRoute2 = "custom";
        rimInnerDia1 = rimInnerDia2 = hubDia1 = hubDia2 = webThickness1 = webThickness2 = 0;
    }

    /// <summary>
    /// Applies a chosen product's data sheet figures. Custom changes nothing — the user keeps
    /// whatever is already in the fields and edits it in the dialog.
    ///
    /// F_ZG and the micropitting stage are only overwritten when the product actually publishes
    /// them. Most sheets do not, and a stale value from a previously selected product would be
    /// worse than the user's own: the scuffing temperature is derived from that number.
    /// </summary>
    private void OnLubricantChanged()
    {
        var lp = LubricantPreset.Find(selectedLubricant);
        if (lp == null) return;

        engine.LubricantViscosity40 = lp.Nu40;
        engine.LubricantViscosity100 = lp.Nu100;
        engine.OilDensity = lp.Density15;
        engine.OilType = lp.Type;

        if (lp.FzgStageA8390 is { } fzg) engine.FzgLoadStage = fzg;
        if (lp.MicropittingStage is { } gf) engine.MicropittingLoadStage = gf;

        // Defensive only: the select is filtered by method, so a mismatch cannot be produced
        // by clicking. A shared link carrying an older or hand-edited pair still can.
        if (lp.IsGrease && engine.LubricationMethod != LubricationMethod.Grease)
            engine.LubricationMethod = LubricationMethod.Grease;
        else if (!lp.IsGrease && engine.LubricationMethod == LubricationMethod.Grease)
            engine.LubricationMethod = LubricationMethod.Dip;
    }

    /// <summary>
    /// The method now drives which lubricants are on offer, so switching between oil and grease
    /// has to move the selection with it. A named oil left selected under "Grease" would be a
    /// card contradicting itself. Custom is left alone — the user's own figures are theirs.
    /// </summary>
    private void OnLubricationMethodChanged()
    {
        var lp = LubricantPreset.Find(selectedLubricant);
        if (lp == null) return;                                  // Custom: nothing to move
        bool wantGrease = engine.LubricationMethod == LubricationMethod.Grease;
        if (lp.IsGrease == wantGrease) return;

        // Remember what was selected on each side, so toggling oil -> grease -> oil comes back
        // to the oil the user chose instead of silently dropping them on the first of the list
        // and changing their viscosity grade underneath them.
        if (lp.IsGrease) lastGrease = lp.Name; else lastOil = lp.Name;

        string? remembered = wantGrease ? lastGrease : lastOil;
        selectedLubricant = LubricantPreset.Find(remembered) is { } back && back.IsGrease == wantGrease
            ? back.Name
            : LubricantPreset.For(engine.LubricationMethod).FirstOrDefault()?.Name
              ?? LubricantPreset.CustomName;
        OnLubricantChanged();
    }

    /// <summary>Last product picked on each side of the oil/grease split. <see cref="OnLubricationMethodChanged"/>.</summary>
    private string? lastOil;
    private string? lastGrease;

    private static string OilTypeLabel(LubricantType t) => t switch
    {
        LubricantType.PolyglycolWaterSoluble => "polyglycol (water sol.)",
        LubricantType.PolyglycolNonWaterSoluble => "polyglycol",
        LubricantType.Polyalphaolefin => "PAO",
        LubricantType.PhosphateEster => "phosphate ester",
        LubricantType.TractionFluid => "traction fluid",
        _ => "mineral"
    };

    private void OnApplicationFactorChanged()
    {
        if (double.TryParse(selectedApplicationFactor, System.Globalization.NumberStyles.Any,
            System.Globalization.CultureInfo.InvariantCulture, out double factor))
        {
            engine.ApplicationFactor = factor;
        }
    }

    private void OnGeometryChanged()
    {
        // The displayed A_a follows the centre distance when a standard field is selected.
        OnCentreDistanceFieldChanged();

        // Auto-calculate profile shift coefficient for gear 2
        if (engine.NumberOfTeeth1 > 0 && engine.NumberOfTeeth2 > 0 &&
            engine.NormalModule > 0 && engine.CenterDistance > 0)
        {
            engine.CalculateProfileShift2();
        }
    }

    /// <summary>
    /// k as the engine would derive it, shown on the input form so the choice is not blind.
    /// Same expression as GearPairEngine.CalculateTipAlteration; Σx is already current because
    /// OnGeometryChanged calls CalculateProfileShift2.
    /// </summary>
    private double? PreviewTipAlteration()
    {
        double ad = engine.ReferenceCentreDistance();
        if (ad <= 0 || engine.NormalModule <= 0 || engine.CenterDistance <= 0) return null;
        return (engine.CenterDistance - ad) / engine.NormalModule - engine.SumProfileShift;
    }

    /// <summary>
    /// Shows what the chosen ISO 286 field actually gives, in micrometres. Without this the two
    /// boxes sat at 0 whatever field was selected, so the field looked as if it did nothing.
    /// Custom leaves whatever is there for the user to edit.
    /// </summary>
    private void OnCentreDistanceFieldChanged()
    {
        if (engine.CentreDistanceToleranceField == "custom") return;

        var dev = Iso286.TryGetDeviations(engine.CentreDistanceToleranceField, engine.CenterDistance);
        aaUpperMicron = dev?.upper ?? 0;
        aaLowerMicron = dev?.lower ?? 0;
    }

    private void UseReferenceCentreDistance()
    {
        double a = engine.ReferenceCentreDistance();
        if (a > 0)
        {
            engine.CenterDistance = Math.Round(a, 4);
            OnGeometryChanged();
        }
    }

    /// <summary>
    /// Scuffing is judged on the temperature margin, not on S_B. Clause 10.5 advises a demanded
    /// minimum difference "for instance >= 50 K" between the scuffing temperature and the
    /// estimated maximum contact temperature, and warns that a temperature quotient can mislead.
    /// </summary>
    private string GetScuffingRowClass(Iso13989FlashTemperature.Result s)
        => s.MarginKelvin < 0 ? "danger" : s.MarginKelvin < 50 ? "warning" : "success";

    private string GetScuffingStatus(Iso13989FlashTemperature.Result s)
        => s.MarginKelvin < 0 ? "❌ FAIL" : s.MarginKelvin < 50 ? "⚠️ Marginal" : "✓ OK";

    private string GetSafetyRowClass(double sf, double minRequired)
    {
        if (sf < minRequired * 0.8) return "danger";
        if (sf < minRequired) return "warning";
        return "success";
    }

    // Status text uses literal characters, not HTML entities: Razor escapes the string it
    // renders, so "&#10003;" would show up on the page verbatim instead of a tick.
    private string GetSafetyStatus(double sf, double minRequired)
    {
        if (sf < minRequired * 0.8) return "❌ FAIL";
        if (sf < minRequired) return "⚠️ Marginal";
        return "✓ OK";
    }

    private async Task Calculate()
    {
        isCalculating = true;
        StateHasChanged();
        await Task.Delay(350);

        // One message per missing field, not a single silent return. The bare
        // guard that used to be here left the button doing nothing at all with
        // no explanation - the last of the twelve calculators to behave that way.
        validationMessages.Clear();
        if (engine.Power <= 0) validationMessages.Add("Transmitted power (P) must be greater than 0.");
        if (engine.Speed1 <= 0) validationMessages.Add("Pinion speed (n₁) must be greater than 0.");
        if (engine.NormalModule <= 0) validationMessages.Add("Normal module (mₙ) must be greater than 0.");
        if (engine.NumberOfTeeth1 <= 0) validationMessages.Add("Number of teeth on the pinion (z₁) must be greater than 0.");
        if (engine.NumberOfTeeth2 <= 0) validationMessages.Add("Number of teeth on the wheel (z₂) must be greater than 0.");
        if (engine.FaceWidth1 <= 0) validationMessages.Add("Pinion face width (b₁) must be greater than 0.");
        if (engine.FaceWidth2 <= 0) validationMessages.Add("Wheel face width (b₂) must be greater than 0.");
        if (engine.CenterDistance <= 0) validationMessages.Add("Centre distance (a) must be greater than 0.");
        if (engine.RequiredServiceLife <= 0) validationMessages.Add("Required service life must be greater than 0.");

        if (validationMessages.Count > 0)
        {
            isCalculating = false;
            await Analytics.TrackCalculationError("gear-pair", "validation_failed", string.Join("; ", validationMessages));
            return;
        }

        // Set materials
        engine.Material1 = gearMaterials[selectedMaterial1Index];
        engine.Material2 = gearMaterials[selectedMaterial2Index];

        // Micrometre form fields -> millimetre engine inputs
        engine.Asne1 = asne1Micron / 1000.0;
        engine.Asni1 = asni1Micron / 1000.0;
        engine.Asne2 = asne2Micron / 1000.0;
        engine.Asni2 = asni2Micron / 1000.0;
        // Only a Custom field is an override. With a standard field selected the boxes are a
        // read-only display of what that field gives, so passing them on would freeze the
        // deviations at whatever centre distance was in force when the field was picked.
        bool customAa = engine.CentreDistanceToleranceField == "custom";
        engine.CentreDistanceUpperDev = customAa ? aaUpperMicron / 1000.0 : 0;
        engine.CentreDistanceLowerDev = customAa ? aaLowerMicron / 1000.0 : 0;

        engine.TipDiameterUpperDev = daUpperMicron / 1000.0;
        engine.TipDiameterLowerDev = daLowerMicron / 1000.0;
        engine.RootDiameterUpperDev = dfUpperMicron / 1000.0;
        engine.RootDiameterLowerDev = dfLowerMicron / 1000.0;
        engine.TargetBacklashMin = jMinMicron / 1000.0;
        engine.TargetBacklashMax = jMaxMicron / 1000.0;

        engine.Calculate();

        // Every mode except Manual derives the allowances, so mirror them back into the form
        // fields: switching to Manual then starts from the derived values instead of zero.
        if (engine.AllowanceMode != ToothThicknessAllowanceMode.Manual)
        {
            asne1Micron = Math.Round(engine.Asne1 * 1000.0, 1);
            asni1Micron = Math.Round(engine.Asni1 * 1000.0, 1);
            asne2Micron = Math.Round(engine.Asne2 * 1000.0, 1);
            asni2Micron = Math.Round(engine.Asni2 * 1000.0, 1);
        }

        showResults = true;
        isCalculating = false;
    }

    private void BackToInput() => showResults = false;

    private void ClearForm()
    {
        ResetEngine();
        validationMessages.Clear();
        showResults = false;
        openedFromSharedLink = false;
    }

