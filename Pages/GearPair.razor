    /// <summary>
    /// Restores state produced by <see cref="BuildShareState"/>, then recalculates so the
    /// recipient lands straight on the results.
    ///
    /// Every read supplies the current value as its fallback, so a link written by an older
    /// build that lacked a field leaves that field at its default instead of zeroing it.
    /// </summary>
    private async Task ApplyShareState(CalculationState state)
    {
        engine.Power = state.GetDouble("P", engine.Power);
        engine.Speed1 = state.GetDouble("n1", engine.Speed1);
        engine.RequiredServiceLife = state.GetDouble("Lh", engine.RequiredServiceLife);
        engine.NormalModule = state.GetDouble("mn", engine.NormalModule);
        engine.PressureAngle = state.GetDouble("alpha", engine.PressureAngle);
        engine.HelixAngle = state.GetDouble("beta", engine.HelixAngle);
        engine.CenterDistance = state.GetDouble("a", engine.CenterDistance);
        engine.NumberOfTeeth1 = state.GetInt("z1", engine.NumberOfTeeth1);
        engine.NumberOfTeeth2 = state.GetInt("z2", engine.NumberOfTeeth2);
        engine.FaceWidth1 = state.GetDouble("b1", engine.FaceWidth1);
        engine.FaceWidth2 = state.GetDouble("b2", engine.FaceWidth2);
        engine.ProfileShiftCoeff1 = state.GetDouble("x1", engine.ProfileShiftCoeff1);
        engine.AddendumCoeff = state.GetDouble("ha", engine.AddendumCoeff);
        engine.DedendumCoeff = state.GetDouble("hf", engine.DedendumCoeff);
        engine.RootRadiusCoeff = state.GetDouble("rf", engine.RootRadiusCoeff);

        // A link written before k existed carries no "km", so it falls back to None - which is
        // exactly what that build calculated.
        engine.TipAlterationMode =
            Enum.TryParse<TipAlterationSource>(state.GetString("km"), out var km)
                ? km : TipAlterationSource.None;
        engine.TipAlterationCoeff = state.GetDouble("k", engine.TipAlterationCoeff);

        // Dropdown values are validated against their option set, or the select renders blank.
        int q1 = state.GetInt("q1", engine.QualityGrade1);
        int q2 = state.GetInt("q2", engine.QualityGrade2);
        engine.QualityGrade1 = QualityGradeOptions.Contains(q1) ? q1 : 6;
        engine.QualityGrade2 = QualityGradeOptions.Contains(q2) ? q2 : 6;

        var ka = state.GetString("Ka", selectedApplicationFactor);
        selectedApplicationFactor = ApplicationFactorOptions.Contains(ka) ? ka : "1.0";
        OnApplicationFactorChanged();

        selectedMaterial1Index = GearMaterialIndexByLabel(state.GetString("m1"), selectedMaterial1Index);
        selectedMaterial2Index = GearMaterialIndexByLabel(state.GetString("m2"), selectedMaterial2Index);

        engine.BoreDiameter1 = state.GetDouble("di1", engine.BoreDiameter1);
        engine.BoreDiameter2 = state.GetDouble("di2", engine.BoreDiameter2);

        var bk1 = state.GetString("bk1", blankType1);
        var bk2 = state.GetString("bk2", blankType2);
        blankType1 = BlankTypeOptions.Contains(bk1) ? bk1 : "Solid";
        blankType2 = BlankTypeOptions.Contains(bk2) ? bk2 : "Solid";

        // The route is restored for display only - the roughness values themselves are stored
        // and restored below, so re-applying the route here would overwrite a manual edit.
        var fr1 = state.GetString("fr1", finishingRoute1);
        var fr2 = state.GetString("fr2", finishingRoute2);
        finishingRoute1 = FinishingRouteOptions.Contains(fr1) ? fr1 : "custom";
        finishingRoute2 = FinishingRouteOptions.Contains(fr2) ? fr2 : "custom";
        rimInnerDia1 = state.GetDouble("ri1", rimInnerDia1);
        rimInnerDia2 = state.GetDouble("ri2", rimInnerDia2);
        hubDia1 = state.GetDouble("hb1", hubDia1);
        hubDia2 = state.GetDouble("hb2", hubDia2);
        webThickness1 = state.GetDouble("wb1", webThickness1);
        webThickness2 = state.GetDouble("wb2", webThickness2);

        engine.AllowanceMode =
            Enum.TryParse<ToothThicknessAllowanceMode>(state.GetString("am"), out var mode)
                ? mode : ToothThicknessAllowanceMode.Automatic;
        asne1Micron = state.GetDouble("ae1", asne1Micron);
        asni1Micron = state.GetDouble("ai1", asni1Micron);
        asne2Micron = state.GetDouble("ae2", asne2Micron);
        asni2Micron = state.GetDouble("ai2", asni2Micron);
        // Dropdown values validated against their option sets, or the selects render blank.
        var d3s = state.GetString("d3s", engine.Din3967AllowanceSeries);
        engine.Din3967AllowanceSeries = Din3967.AllowanceSeries.Contains(d3s) ? d3s : "cd";
        int d3t1 = state.GetInt("d3t1", engine.Din3967ToleranceSeries1);
        int d3t2 = state.GetInt("d3t2", engine.Din3967ToleranceSeries2);
        engine.Din3967ToleranceSeries1 = Din3967.ToleranceSeries.Contains(d3t1) ? d3t1 : 26;
        engine.Din3967ToleranceSeries2 = Din3967.ToleranceSeries.Contains(d3t2) ? d3t2 : 26;

        engine.SplitRule =
            Enum.TryParse<BacklashSplit>(state.GetString("sr"), out var sr) ? sr : BacklashSplit.Even;
        jMinMicron = state.GetDouble("jmin", jMinMicron);
        jMaxMicron = state.GetDouble("jmax", jMaxMicron);
        engine.SpanLimitUpper1 = state.GetDouble("wu1", engine.SpanLimitUpper1);
        engine.SpanLimitLower1 = state.GetDouble("wl1", engine.SpanLimitLower1);
        engine.SpanLimitUpper2 = state.GetDouble("wu2", engine.SpanLimitUpper2);
        engine.SpanLimitLower2 = state.GetDouble("wl2", engine.SpanLimitLower2);
        engine.BallLimitUpper1 = state.GetDouble("mu1", engine.BallLimitUpper1);
        engine.BallLimitLower1 = state.GetDouble("ml1", engine.BallLimitLower1);
        engine.BallLimitUpper2 = state.GetDouble("mu2", engine.BallLimitUpper2);
        engine.BallLimitLower2 = state.GetDouble("ml2", engine.BallLimitLower2);

        var aaField = state.GetString("aaf", engine.CentreDistanceToleranceField);
        engine.CentreDistanceToleranceField =
            (CentreDistanceFieldOptions.Contains(aaField) || aaField == "custom") ? aaField : "js7";
        aaUpperMicron = state.GetDouble("aau", aaUpperMicron);
        aaLowerMicron = state.GetDouble("aal", aaLowerMicron);
        engine.BallDiameter1 = state.GetDouble("bd1", engine.BallDiameter1);
        engine.BallDiameter2 = state.GetDouble("bd2", engine.BallDiameter2);

        engine.UseMeasuredDeviations = state.GetBool("md", engine.UseMeasuredDeviations);
        engine.BasePitchDeviation = state.GetDouble("fpb", engine.BasePitchDeviation);
        engine.ProfileFormDeviation = state.GetDouble("ffa", engine.ProfileFormDeviation);
        engine.RunningInAllowanceP = state.GetDouble("yp", engine.RunningInAllowanceP);
        engine.RunningInAllowanceF = state.GetDouble("yf", engine.RunningInAllowanceF);
        engine.UseDirectFaceLoadFactor = state.GetBool("dk", engine.UseDirectFaceLoadFactor);
        engine.DirectKHbeta = state.GetDouble("khb", engine.DirectKHbeta);
        engine.HelixMod =
            Enum.TryParse<Iso6336FaceLoadFactor.HelixModification>(state.GetString("hm"), out var hm)
                ? hm : Iso6336FaceLoadFactor.HelixModification.None;
        engine.FshSource =
            Enum.TryParse<ShaftDeflectionSource>(state.GetString("fss"), out var fss)
                ? fss : ShaftDeflectionSource.Calculated;
        engine.ShaftDeflectionFsh = state.GetDouble("fsh", engine.ShaftDeflectionFsh);
        engine.ShaftBearingSpan = state.GetDouble("sl", engine.ShaftBearingSpan);
        engine.PinionOffset = state.GetDouble("ss", engine.PinionOffset);
        engine.ShaftDiameter = state.GetDouble("sd", engine.ShaftDiameter);
        engine.ShaftBoreDiameter = state.GetDouble("sb", engine.ShaftBoreDiameter);
        engine.ShaftArrangement =
            Enum.TryParse<Iso6336ShaftDeflection.Arrangement>(state.GetString("sa"), out var sa)
                ? sa : Iso6336ShaftDeflection.Arrangement.A;
        engine.PinionCanStiffenShaft = state.GetBool("sk", engine.PinionCanStiffenShaft);
        engine.OptimumLifeConditions = state.GetBool("ol", engine.OptimumLifeConditions);
        engine.LimitedPittingPermissible = state.GetBool("lp", engine.LimitedPittingPermissible);

        // The lubricant handler overwrites every oil figure, so it has to run BEFORE the stored
        // ones are reapplied - otherwise a link carrying edited values would lose them. Links
        // written before the library existed carry "vg" instead; those fall through to Custom
        // and keep their own nu40, which is exactly what they stored.
        var lub = state.GetString("lub", "");
        selectedLubricant = LubricantPreset.Find(lub) != null ? lub : LubricantPreset.CustomName;
        OnLubricantChanged();
        engine.LubricantViscosity40 = state.GetDouble("nu", engine.LubricantViscosity40);

        engine.FlankRoughnessRz1 = state.GetDouble("rz1", engine.FlankRoughnessRz1);
        engine.FlankRoughnessRa1 = state.GetDouble("ra1", engine.FlankRoughnessRa1);
        engine.FlankRoughnessRa2 = state.GetDouble("ra2", engine.FlankRoughnessRa2);
        engine.TipRelief1 = state.GetDouble("ca1", engine.TipRelief1);
        engine.TipRelief2 = state.GetDouble("ca2", engine.TipRelief2);
        engine.FlankRoughnessRz2 = state.GetDouble("rz2", engine.FlankRoughnessRz2);
        engine.RootRoughnessRz1 = state.GetDouble("rr1", engine.RootRoughnessRz1);
        engine.RootRoughnessRz2 = state.GetDouble("rr2", engine.RootRoughnessRz2);

        engine.OilType = Enum.TryParse<LubricantType>(state.GetString("ot"), out var ot)
            ? ot : LubricantType.Mineral;
        engine.LubricationMethod = Enum.TryParse<LubricationMethod>(state.GetString("lm"), out var lm)
            ? lm : LubricationMethod.Dip;
        engine.OilTemperatureFromAmbient = state.GetBool("ofa", engine.OilTemperatureFromAmbient);
        engine.AmbientTemperature = state.GetDouble("amb", engine.AmbientTemperature);
        engine.OilTemperatureRise = state.GetDouble("rise", engine.OilTemperatureRise);
        engine.OilTemperatureDirect = state.GetDouble("otd", engine.OilTemperatureDirect);
        engine.LubricantViscosity100 = state.GetDouble("nu100", engine.LubricantViscosity100);
        engine.OilDensity = state.GetDouble("rho", engine.OilDensity);
        engine.FzgLoadStage = state.GetDouble("fzg", engine.FzgLoadStage);
        engine.AntiScuffAdditives = state.GetBool("ep", engine.AntiScuffAdditives);
        engine.MicropittingLoadStage = state.GetDouble("mps", engine.MicropittingLoadStage);
        engine.PermissibleFilmThickness = state.GetDouble("lgfp", engine.PermissibleFilmThickness);
        engine.PinionDrives = state.GetBool("drv", engine.PinionDrives);
        engine.SpanTeeth1 = state.GetInt("wk1", engine.SpanTeeth1);
        engine.SpanTeeth2 = state.GetInt("wk2", engine.SpanTeeth2);
        daUpperMicron = state.GetDouble("dau", daUpperMicron);
        daLowerMicron = state.GetDouble("dal", daLowerMicron);
        dfUpperMicron = state.GetDouble("dfu", dfUpperMicron);
        dfLowerMicron = state.GetDouble("dfl", dfLowerMicron);

        // Derives the wheel's profile shift x2 from the restored geometry.
        OnGeometryChanged();

        openedFromSharedLink = true;

        // Calculate() validates, so a damaged link just leaves the user on the form.
        await Calculate();
    }

    // Both of these go through GearMaterial.Label, which is also the key the custom
    // library enforces uniqueness on. Formatting the label a second time here is how the
    // two would silently drift apart and start resolving links to the wrong grade.
    private string GearMaterialLabelAt(int index)
        => index >= 0 && index < gearMaterials.Count ? gearMaterials[index].Label : "";

    /// <summary>Resolves a gear material by its "name - heat treatment" label, falling back when unknown.</summary>
    private int GearMaterialIndexByLabel(string label, int fallback)
    {
        if (string.IsNullOrEmpty(label)) return fallback;

        var index = gearMaterials.FindIndex(m =>
            string.Equals(m.Label, label, StringComparison.OrdinalIgnoreCase));
        return index >= 0 ? index : fallback;
    }

    private async Task SaveAsPdf()
    {
        isSavingPdf = true;
        StateHasChanged();
        try
        {
            await JSRuntime.InvokeVoidAsync("generatePdf", "results-content",
                $"GearPair-Report-{DateTime.Now:yyyyMMdd_HHmmss}.pdf");
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", $"PDF generation error: {ex.Message}");
        }
        finally
        {
            isSavingPdf = false;
        }
    }
}
