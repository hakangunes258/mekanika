@code {
    private GearPairEngine engine = new();
    private List<GearMaterial> gearMaterials = new();
    private ModuleInfo moduleInfo = new();
    private bool showResults = false;
    private bool isCalculating = false;
    private bool isSavingPdf = false;
    private string selectedApplicationFactor = "1.0";
    private int selectedMaterial1Index = 5; // 18CrNiMo7-6 Case-hardened
    private int selectedMaterial2Index = 5;
    private bool openedFromSharedLink = false;

    /// <summary>Application factors offered by the dropdown. A link carrying anything else falls back to 1.0.</summary>
    private static readonly string[] ApplicationFactorOptions = { "1.0", "1.25", "1.35", "1.5", "1.75" };

    protected override void OnInitialized()
    {
        gearMaterials = GearMaterial.StandardMaterials;

        // Default values (based on KISSsoft tutorial example)
        engine.Power = 3.5;
        engine.Speed1 = 2500;
        engine.ApplicationFactor = 1.0;
        engine.RequiredServiceLife = 10000;
        engine.NormalModule = 1.5;
        engine.PressureAngle = 20.0;
        engine.HelixAngle = 0.0;
        engine.CenterDistance = 50.0;
        engine.NumberOfTeeth1 = 20;
        engine.NumberOfTeeth2 = 40;
        engine.FaceWidth1 = 15;
        engine.FaceWidth2 = 15;
        engine.ProfileShiftCoeff1 = 0.0;
        engine.AddendumCoeff = 1.0;
        engine.DedendumCoeff = 1.25;
        engine.RootRadiusCoeff = 0.3;
        engine.QualityGrade1 = 6;
        engine.QualityGrade2 = 6;
    }

    private void OnApplicationFactorChanged()
    {
        if (double.TryParse(selectedApplicationFactor, System.Globalization.NumberStyles.Any,
            System.Globalization.CultureInfo.InvariantCulture, out double factor))
        {
            engine.ApplicationFactor = factor;
        }
    }

    private void OnGeometryChanged()
    {
        // Auto-calculate profile shift coefficient for gear 2
        if (engine.NumberOfTeeth1 > 0 && engine.NumberOfTeeth2 > 0 &&
            engine.NormalModule > 0 && engine.CenterDistance > 0)
        {
            engine.CalculateProfileShift2();
        }
    }

    private string GetSafetyRowClass(double sf, double minRequired)
    {
        if (sf < minRequired * 0.8) return "danger";
        if (sf < minRequired) return "warning";
        return "success";
    }

    private string GetSafetyStatus(double sf, double minRequired)
    {
        if (sf < minRequired * 0.8) return "&#10060; FAIL";
        if (sf < minRequired) return "&#9888; Marginal";
        return "&#10003; OK";
    }

    private async Task Calculate()
    {
        isCalculating = true;
        StateHasChanged();
        await Task.Delay(350);
        // Validation
        if (engine.Power <= 0 || engine.Speed1 <= 0 || engine.NormalModule <= 0 ||
            engine.NumberOfTeeth1 <= 0 || engine.NumberOfTeeth2 <= 0 ||
            engine.FaceWidth1 <= 0 || engine.FaceWidth2 <= 0 ||
            engine.CenterDistance <= 0 || engine.RequiredServiceLife <= 0)
        {
            isCalculating = false;
            return;
        }

        // Set materials
        engine.Material1 = gearMaterials[selectedMaterial1Index];
        engine.Material2 = gearMaterials[selectedMaterial2Index];

        // Run calculation
        engine.Calculate();

        showResults = true;
        isCalculating = false;
    }

    private void BackToInput() => showResults = false;

    private void ClearForm()
    {
        engine = new GearPairEngine
        {
            Power = 3.5,
            Speed1 = 2500,
            ApplicationFactor = 1.0,
            RequiredServiceLife = 10000,
            NormalModule = 1.5,
            PressureAngle = 20.0,
            HelixAngle = 0.0,
            CenterDistance = 50.0,
            NumberOfTeeth1 = 20,
            NumberOfTeeth2 = 40,
            FaceWidth1 = 15,
            FaceWidth2 = 15,
            ProfileShiftCoeff1 = 0.0,
            AddendumCoeff = 1.0,
            DedendumCoeff = 1.25,
            RootRadiusCoeff = 0.3,
            QualityGrade1 = 6,
            QualityGrade2 = 6
        };
        selectedApplicationFactor = "1.0";
        showResults = false;
        openedFromSharedLink = false;
    }

    /// <summary>
    /// The module's inputs in the neutral form used by shareable links (and, later,
    /// cloud-saved calculations). Inputs only — results are recomputed on restore.
    ///
    /// Gear materials go in by their displayed label (name + heat treatment) rather
    /// than by their index in the list, so adding a material cannot repoint existing
    /// links at the wrong grade. The pinion's profile shift x1 is stored; the wheel's
    /// x2 is derived on restore. Keys are kept short because the state rides in a URL.
    /// </summary>
    private CalculationState BuildShareState() => new CalculationState("gear-pair")
        .Set("P", engine.Power)
        .Set("n1", engine.Speed1)
        .Set("Ka", selectedApplicationFactor)
        .Set("Lh", engine.RequiredServiceLife)
        .Set("mn", engine.NormalModule)
        .Set("alpha", engine.PressureAngle)
        .Set("beta", engine.HelixAngle)
        .Set("a", engine.CenterDistance)
        .Set("z1", engine.NumberOfTeeth1)
        .Set("z2", engine.NumberOfTeeth2)
        .Set("b1", engine.FaceWidth1)
        .Set("b2", engine.FaceWidth2)
        .Set("x1", engine.ProfileShiftCoeff1)
        .Set("q1", engine.QualityGrade1)
        .Set("q2", engine.QualityGrade2)
        .Set("ha", engine.AddendumCoeff)
        .Set("hf", engine.DedendumCoeff)
        .Set("rf", engine.RootRadiusCoeff)
        .Set("m1", GearMaterialLabelAt(selectedMaterial1Index))
        .Set("m2", GearMaterialLabelAt(selectedMaterial2Index));

    /// <summary>
    /// Restores state produced by <see cref="BuildShareState"/>, then recalculates so
    /// the recipient lands straight on the results.
    ///
    /// Every read supplies the current value as its fallback, so a link written by an
    /// older build that lacked a field leaves that field at its default instead of
    /// zeroing it.
    /// </summary>
    private async Task ApplyShareState(CalculationState state)
    {
        engine.Power = state.GetDouble("P", engine.Power);
        engine.Speed1 = state.GetDouble("n1", engine.Speed1);
        engine.RequiredServiceLife = state.GetDouble("Lh", engine.RequiredServiceLife);
        engine.NormalModule = state.GetDouble("mn", engine.NormalModule);
        engine.PressureAngle = state.GetDouble("alpha", engine.PressureAngle);
        engine.HelixAngle = state.GetDouble("beta", engine.HelixAngle);
        engine.CenterDistance = state.GetDouble("a", engine.CenterDistance);
        engine.NumberOfTeeth1 = state.GetInt("z1", engine.NumberOfTeeth1);
        engine.NumberOfTeeth2 = state.GetInt("z2", engine.NumberOfTeeth2);
        engine.FaceWidth1 = state.GetDouble("b1", engine.FaceWidth1);
        engine.FaceWidth2 = state.GetDouble("b2", engine.FaceWidth2);
        engine.ProfileShiftCoeff1 = state.GetDouble("x1", engine.ProfileShiftCoeff1);
        engine.QualityGrade1 = state.GetInt("q1", engine.QualityGrade1);
        engine.QualityGrade2 = state.GetInt("q2", engine.QualityGrade2);
        engine.AddendumCoeff = state.GetDouble("ha", engine.AddendumCoeff);
        engine.DedendumCoeff = state.GetDouble("hf", engine.DedendumCoeff);
        engine.RootRadiusCoeff = state.GetDouble("rf", engine.RootRadiusCoeff);

        var ka = state.GetString("Ka", selectedApplicationFactor);
        selectedApplicationFactor = ApplicationFactorOptions.Contains(ka) ? ka : "1.0";
        OnApplicationFactorChanged();

        selectedMaterial1Index = GearMaterialIndexByLabel(state.GetString("m1"), selectedMaterial1Index);
        selectedMaterial2Index = GearMaterialIndexByLabel(state.GetString("m2"), selectedMaterial2Index);

        // Derives the wheel's profile shift x2 from the restored geometry.
        OnGeometryChanged();

        openedFromSharedLink = true;

        // Calculate() validates, so a damaged link just leaves the user on the form.
        await Calculate();
    }

    private string GearMaterialLabelAt(int index)
        => index >= 0 && index < gearMaterials.Count
            ? $"{gearMaterials[index].Name} - {gearMaterials[index].HeatTreatment}" : "";

    /// <summary>Resolves a gear material by its "name - heat treatment" label, falling back when unknown.</summary>
    private int GearMaterialIndexByLabel(string label, int fallback)
    {
        if (string.IsNullOrEmpty(label)) return fallback;

        var index = gearMaterials.FindIndex(m =>
            string.Equals($"{m.Name} - {m.HeatTreatment}", label, StringComparison.OrdinalIgnoreCase));
        return index >= 0 ? index : fallback;
    }

    private async Task SaveAsPdf()
    {
        isSavingPdf = true;
        StateHasChanged();
        try
        {
            await JSRuntime.InvokeVoidAsync("generatePdf", "results-content",
                $"GearPair-Report-{DateTime.Now:yyyyMMdd_HHmmss}.pdf");
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", $"PDF generation error: {ex.Message}");
        }
        finally
        {
            isSavingPdf = false;
        }
    }
}
