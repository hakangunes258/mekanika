    /// <summary>
    /// Rim thickness and Y_B as the engine would compute them, shown while the user is still
    /// filling the form. Mirrors GearPairEngine.RimThicknessFactor — keep the two in step.
    /// </summary>
    private (double sR, double ratio, double yb)? RimPreview(int gear)
    {
        double bore = gear == 1 ? engine.BoreDiameter1 : engine.BoreDiameter2;
        double d = ReferenceDiameterOf(gear);
        double x = gear == 1 ? engine.ProfileShiftCoeff1 : engine.ProfileShiftCoeff2;

        if (bore <= 0 || d <= 0 || engine.NormalModule <= 0) return null;

        double df = d - 2.0 * engine.NormalModule * (engine.DedendumCoeff - x);
        double sR = (df - bore) / 2.0;
        if (sR <= 0) return null;

        double ratio = sR / engine.NormalModule;
        double yb = ratio >= 1.2 ? 1.0 : 1.6 * Math.Log(2.242 / Math.Max(ratio, 0.5));
        return (sR, ratio, yb);
    }

