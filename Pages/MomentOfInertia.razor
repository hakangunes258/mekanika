@page "/moment-of-inertia"
@inject IJSRuntime JSRuntime
@inject MaterialService MaterialService
@inject ModuleMetadataService MetadataService
@inject AnalyticsService Analytics
@inject SeoService Seo
@using MechanicalCalculatorWeb.Services
@using MechanicalCalculatorWeb.Models
@using System.Globalization

<PageTitle>Moment of Inertia Calculator - Mekanika</PageTitle>

<div class="page-header">
    <h1><ModuleIcon Type="moment-inertia" Size="large" Style="transparent" CustomStyle="margin-right: 12px;" /> Moment of Inertia Calculator</h1>
    <p>Calculate section properties for various cross-sectional shapes</p>
</div>

<SharedCalculationLoader Module="moment-of-inertia" OnRestore="ApplyShareState" />



@if (!showResults)
{
    <!-- INPUT FORM -->
    <div class="form-grid">
        <!-- Cross-Section Shape Card -->
        <div class="card">
            <div class="card-header">
                <ModuleIcon Type="moment-inertia" Size="medium" Style="solid" />
                <h2>Cross-Section Shape</h2>
            </div>

            <div class="form-group">
                <label>Select Shape</label>
                <select @bind="selectedShapeIndex" @bind:after="OnShapeChanged">
                    <option value="0">▬ Rectangle</option>
                    <option value="1">▭ Hollow Rectangle (Box)</option>
                    <option value="2">● Circle</option>
                    <option value="3">○ Hollow Circle (Tube)</option>
                    <option value="4">工 I-Beam (H-Beam)</option>
                    <option value="5">⊏ C-Channel</option>
                    <option value="6">⊤ T-Section</option>
                    <option value="7">∟ L-Section (Angle)</option>
                </select>
            </div>

            <div class="form-group">
                <label>Material</label>
                <select @bind="selectedMaterialIndex" @bind:after="OnMaterialChanged">
                    @for (int i = 0; i < materials.Count; i++)
                    {
                        <option value="@i">@materials[i].ToString()</option>
                    }
                </select>
                @if (materials.Any())
                {
                    <div class="material-info">
                        <span>Density: @materials[selectedMaterialIndex].Density kg/m³</span>
                    </div>
                }
            </div>

            <div class="form-group">
                <label>Profile Length</label>
                <div class="input-group">
                    <input type="number" step="1" @bind="engine.Length" placeholder="1000" />
                    <span class="unit">mm</span>
                </div>
                <small class="hint">For weight calculation</small>
            </div>
        </div>

        <!-- Dimensions Card -->
        <div class="card">
            <div class="card-header">
                <ModuleIcon Type="dimensions" Size="medium" Style="solid" />
                <h2>Dimensions</h2>
            </div>

            @switch (engine.SelectedShape)
            {
                case ShapeType.Rectangle:
                    @RenderDimensionInput("Width (b)", "mm", () => engine.Width, v => engine.Width = v)
                    @RenderDimensionInput("Height (h)", "mm", () => engine.Height, v => engine.Height = v)
                    break;

                case ShapeType.HollowRectangle:
                    @RenderDimensionInput("Outer Width (b)", "mm", () => engine.Width, v => engine.Width = v)
                    @RenderDimensionInput("Outer Height (h)", "mm", () => engine.Height, v => engine.Height = v)
                    @RenderDimensionInput("Inner Width (b<sub>i</sub>)", "mm", () => engine.InnerWidth, v => engine.InnerWidth = v, HasInnerWidthError)
                    @RenderDimensionInput("Inner Height (h<sub>i</sub>)", "mm", () => engine.InnerHeight, v => engine.InnerHeight = v, HasInnerHeightError)
                    break;

                case ShapeType.Circle:
                    @RenderDimensionInput("Diameter (d)", "mm", () => engine.Diameter, v => engine.Diameter = v)
                    break;

                case ShapeType.HollowCircle:
                    @RenderDimensionInput("Outer Diameter (d)", "mm", () => engine.Diameter, v => engine.Diameter = v)
                    @RenderDimensionInput("Inner Diameter (d<sub>i</sub>)", "mm", () => engine.InnerDiameter, v => engine.InnerDiameter = v, HasInnerDiameterError)
                    break;

                case ShapeType.IBeam:
                    @RenderDimensionInput("Flange Width (b<sub>f</sub>)", "mm", () => engine.FlangeWidth, v => engine.FlangeWidth = v)
                    @RenderDimensionInput("Total Height (h)", "mm", () => engine.TotalHeight, v => engine.TotalHeight = v)
                    @RenderDimensionInput("Flange Thickness (t<sub>f</sub>)", "mm", () => engine.FlangeThickness, v => engine.FlangeThickness = v, HasFlangeThicknessError)
                    @RenderDimensionInput("Web Thickness (t<sub>w</sub>)", "mm", () => engine.WebThickness, v => engine.WebThickness = v)
                    break;

                case ShapeType.CChannel:
                    @RenderDimensionInput("Width (b)", "mm", () => engine.ChannelWidth, v => engine.ChannelWidth = v)
                    @RenderDimensionInput("Height (h)", "mm", () => engine.ChannelHeight, v => engine.ChannelHeight = v)
                    @RenderDimensionInput("Flange Thickness (t<sub>f</sub>)", "mm", () => engine.ChannelFlangeThickness, v => engine.ChannelFlangeThickness = v, HasChannelFlangeError)
                    @RenderDimensionInput("Web Thickness (t<sub>w</sub>)", "mm", () => engine.ChannelWebThickness, v => engine.ChannelWebThickness = v)
                    break;

                case ShapeType.TSection:
                    @RenderDimensionInput("Flange Width (b<sub>f</sub>)", "mm", () => engine.TFlangeWidth, v => engine.TFlangeWidth = v)
                    @RenderDimensionInput("Total Height (h)", "mm", () => engine.THeight, v => engine.THeight = v)
                    @RenderDimensionInput("Flange Thickness (t<sub>f</sub>)", "mm", () => engine.TFlangeThickness, v => engine.TFlangeThickness = v, HasTFlangeError)
                    @RenderDimensionInput("Stem Thickness (t<sub>w</sub>)", "mm", () => engine.TStemThickness, v => engine.TStemThickness = v)
                    break;

                case ShapeType.LSection:
                    @RenderDimensionInput("Horizontal Leg Width (b)", "mm", () => engine.LegWidth, v => engine.LegWidth = v)
                    @RenderDimensionInput("Vertical Leg Height (h)", "mm", () => engine.LegHeight, v => engine.LegHeight = v)
                    @RenderDimensionInput("Leg Thickness (t)", "mm", () => engine.LegThickness, v => engine.LegThickness = v, HasLegThicknessError)
                    break;
            }
        </div>

        <!-- Shape Preview Card -->
        <div class="card">
            <div class="card-header">
                <ModuleIcon Type="info" Size="medium" Style="solid" />
                <h2>Shape Preview</h2>
            </div>
            <div class="shape-preview-container">
                @((MarkupString)GetSvgWithAxes(350, 300, false))
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(validationError))
    {
        <div class="alert alert-danger" style="margin: 16px 0;">
            <ModuleIcon Type="warning" Size="small" Style="default" CustomStyle="margin-right: 8px;" /> @validationError
        </div>
    }

    <div class="button-group">
        <button class="btn btn-success btn-lg @(isCalculating ? "btn-calculating" : "")" @onclick="Calculate" disabled="@(HasAnyError || isCalculating)">
            @if (isCalculating)
            {
                <span class="spinner"></span>
                <span>Calculating...</span>
            }
            else
            {
                <ModuleIcon Type="calculate" Size="button" Style="default" />
                <span>Calculate</span>
            }
        </button>
        <button class="btn btn-secondary" @onclick="ClearForm" disabled="@isCalculating">
            <ModuleIcon Type="clear" Size="button" Style="default" /> Clear
        </button>
    </div>
}
else
{
    <!-- RESULTS -->
    <div class="button-group" style="margin-bottom: 24px;">
        <button class="btn btn-secondary" @onclick="BackToInput">
            <ModuleIcon Type="back" Size="button" Style="default" /> Back to Input
        </button>
        <button class="btn btn-secondary" @onclick="ClearForm">
            <ModuleIcon Type="new" Size="button" Style="default" /> New Calculation
        </button>
        <button class="btn btn-info @(isSavingPdf ? "btn-saving" : "")" @onclick="SaveAsPdf" disabled="@isSavingPdf">
            @if (isSavingPdf)
            {
                <span class="spinner"></span>
                <span>Generating PDF...</span>
            }
            else
            {
                <ModuleIcon Type="pdf" Size="button" Style="default" />
                <span>Save as PDF</span>
            }
        </button>
        <ShareCalculation Module="moment-of-inertia" State="@BuildShareState()" />
        <SaveCalculation Module="moment-of-inertia" State="@BuildShareState()" />
    </div>

    @if (openedFromSharedLink)
    {
        <div class="alert alert-info" style="margin-bottom: 24px;">
            <ModuleIcon Type="info" Size="small" Style="default" />
            <div>
                <strong>Opened from a shared link.</strong>
                The inputs below came from the link and were recalculated with the current engine.
            </div>
        </div>
    }

    <!-- Detailed Results Container -->
    <div id="results-content">
        <!-- Shape Visualization -->
        <div class="card">
            <div class="card-header"><ModuleIcon Type="moment-inertia" Size="medium" Style="solid" /><h2>Cross-Section Visualization</h2></div>
            <div class="shape-result-preview">
                @if (!string.IsNullOrEmpty(svgBase64Image))
                {
                    <img src="@svgBase64Image" alt="Cross-Section" style="max-width: 100%; height: auto;" />
                }
                else
                {
                    @((MarkupString)GetSvgWithAxes(450, 350, true))
                }
            </div>
        </div>

        <!-- Input Dimensions -->
        <div class="card">
            <div class="card-header"><ModuleIcon Type="dimensions" Size="medium" Style="solid" /><h2>Input Dimensions</h2></div>
            <table class="results-table">
                <thead><tr><th>Description</th><th>Symbol</th><th>Value</th><th>Unit</th></tr></thead>
                <tbody>
                    @((MarkupString)GetInputDimensionsRows())
                    <tr><td>Material</td><td>-</td><td>@materials[selectedMaterialIndex].Name</td><td>-</td></tr>
                    <tr><td>Density</td><td>ρ</td><td>@engine.Density.ToString("F0")</td><td>kg/m³</td></tr>
                    <tr><td>Profile Length</td><td>L</td><td>@engine.Length.ToString("F0")</td><td>mm</td></tr>
                </tbody>
            </table>
        </div>

        <!-- Area & Mass Properties -->
        <div class="card">
            <div class="card-header"><ModuleIcon Type="dimensions" Size="medium" Style="solid" /><h2>Area & Mass Properties</h2></div>
            <table class="results-table">
                <thead><tr><th>Description</th><th>Symbol</th><th>Value</th><th>Unit</th></tr></thead>
                <tbody>
                    <tr class="highlight"><td>Cross-Sectional Area</td><td>A</td><td>@engine.Area.ToString("F2")</td><td>mm²</td></tr>
                    <tr><td>Centroid X (from origin)</td><td>x<sub>c</sub></td><td>@engine.CentroidX.ToString("F2")</td><td>mm</td></tr>
                    <tr><td>Centroid Y (from origin)</td><td>y<sub>c</sub></td><td>@engine.CentroidY.ToString("F2")</td><td>mm</td></tr>
                    <tr class="highlight"><td>Mass per Meter</td><td>m'</td><td>@engine.MassPerMeter.ToString("F3")</td><td>kg/m</td></tr>
                    <tr class="highlight"><td>Total Mass</td><td>m</td><td>@engine.TotalMass.ToString("F3")</td><td>kg</td></tr>
                </tbody>
            </table>
        </div>

        <!-- Moment of Inertia -->
        <div class="card">
            <div class="card-header"><ModuleIcon Type="moment-inertia" Size="medium" Style="solid" /><h2>Moment of Inertia</h2></div>
            <table class="results-table">
                <thead><tr><th>Description</th><th>Symbol</th><th>Value</th><th>Unit</th></tr></thead>
                <tbody>
                    <tr class="highlight"><td>Moment of Inertia (X-axis)</td><td>I<sub>x</sub></td><td>@FormatLargeNumber(engine.Ix)</td><td>mm⁴</td></tr>
                    <tr class="highlight"><td>Moment of Inertia (Y-axis)</td><td>I<sub>y</sub></td><td>@FormatLargeNumber(engine.Iy)</td><td>mm⁴</td></tr>
                    <tr><td>Polar Moment of Inertia</td><td>I<sub>p</sub></td><td>@FormatLargeNumber(engine.Ip)</td><td>mm⁴</td></tr>
                    @if (!engine.AxesArePrincipal)
                    {
                        <tr><td>Product of Inertia</td><td>I<sub>xy</sub></td><td>@FormatLargeNumber(engine.Ixy)</td><td>mm⁴</td></tr>
                        <tr class="highlight"><td>Major Principal Moment</td><td>I<sub>u</sub></td><td>@FormatLargeNumber(engine.IuPrincipal)</td><td>mm⁴</td></tr>
                        <tr class="highlight"><td>Minor Principal Moment</td><td>I<sub>v</sub></td><td>@FormatLargeNumber(engine.IvPrincipal)</td><td>mm⁴</td></tr>
                        <tr><td>Principal Axis Angle</td><td>α</td><td>@engine.PrincipalAngle.ToString("F2")</td><td>°</td></tr>
                    }
                </tbody>
            </table>

            @if (!engine.AxesArePrincipal)
            {
                <div class="alert alert-warning" style="margin-top: 16px;">
                    <ModuleIcon Type="warning" Size="small" Style="default" />
                    <div>
                        <strong>X and Y are not principal axes for this section</strong> (I<sub>xy</sub> ≠ 0).
                        Bending applied about X alone will also deflect the section sideways.
                        For bending design use the principal values: the minor principal moment
                        I<sub>v</sub> = @FormatLargeNumber(engine.IvPrincipal) mm⁴ governs, and the
                        principal axes are rotated @engine.PrincipalAngle.ToString("F2")° from X/Y.
                    </div>
                </div>
            }
        </div>

        <!-- Section Modulus -->
        <div class="card">
            <div class="card-header"><ModuleIcon Type="force" Size="medium" Style="solid" /><h2>Section Modulus</h2></div>
            <table class="results-table">
                <thead><tr><th>Description</th><th>Symbol</th><th>Value</th><th>Unit</th></tr></thead>
                <tbody>
                    <tr class="highlight"><td>Section Modulus (X-axis)</td><td>W<sub>x</sub></td><td>@FormatLargeNumber(engine.Wx)</td><td>mm³</td></tr>
                    <tr class="highlight"><td>Section Modulus (Y-axis)</td><td>W<sub>y</sub></td><td>@FormatLargeNumber(engine.Wy)</td><td>mm³</td></tr>
                </tbody>
            </table>
        </div>

        <!-- Radius of Gyration -->
        <div class="card">
            <div class="card-header"><ModuleIcon Type="geometry" Size="medium" Style="solid" /><h2>Radius of Gyration</h2></div>
            <table class="results-table">
                <thead><tr><th>Description</th><th>Symbol</th><th>Value</th><th>Unit</th></tr></thead>
                <tbody>
                    <tr><td>Radius of Gyration (X-axis)</td><td>r<sub>x</sub></td><td>@engine.rx.ToString("F2")</td><td>mm</td></tr>
                    <tr><td>Radius of Gyration (Y-axis)</td><td>r<sub>y</sub></td><td>@engine.ry.ToString("F2")</td><td>mm</td></tr>
                </tbody>
            </table>
        </div>

        <!-- Extreme Fiber Distances -->
        <div class="card">
            <div class="card-header"><ModuleIcon Type="dimensions" Size="medium" Style="solid" /><h2>Extreme Fiber Distances</h2></div>
            <table class="results-table">
                <thead><tr><th>Description</th><th>Symbol</th><th>Value</th><th>Unit</th></tr></thead>
                <tbody>
                    <tr><td>Distance to Top Fiber</td><td>c<sub>top</sub></td><td>@engine.DistanceToTopFiber.ToString("F2")</td><td>mm</td></tr>
                    <tr><td>Distance to Bottom Fiber</td><td>c<sub>bot</sub></td><td>@engine.DistanceToBottomFiber.ToString("F2")</td><td>mm</td></tr>
                    <tr><td>Distance to Left Fiber</td><td>c<sub>left</sub></td><td>@engine.DistanceToLeftFiber.ToString("F2")</td><td>mm</td></tr>
                    <tr><td>Distance to Right Fiber</td><td>c<sub>right</sub></td><td>@engine.DistanceToRightFiber.ToString("F2")</td><td>mm</td></tr>
                </tbody>
            </table>
        </div>

        <!-- Formulas Used -->
        <div class="card">
            <div class="card-header"><ModuleIcon Type="info" Size="medium" Style="solid" /><h2>Formulas Used</h2></div>
            <div class="formula-section">
                @((MarkupString)GetFormulasHtml())
            </div>
        </div>
    </div>

}

@code {
    private RenderFragment RenderDimensionInput(string label, string unit, Func<double> getter, Action<double> setter, bool hasError = false) => __builder =>
    {
        <div class="form-group">
            <label>@((MarkupString)label)</label>
            <div class="input-group">
                <input type="number" step="0.1" value="@getter()"
                       @onchange="e => { if (double.TryParse(e.Value?.ToString(), out var v)) { setter(v); UpdatePreview(); } }"
                       class="@(hasError ? "input-error" : "")" />
                <span class="unit">@unit</span>
            </div>
            @if (hasError)
            {
                <small class="error-hint">Invalid value</small>
            }
        </div>
    };
}

<style>
    .shape-preview-container {
        min-height: 300px;
        display: flex;
        justify-content: center;
        align-items: center;
        background: #fafafa;
        border-radius: 8px;
        overflow: hidden;
    }

    .shape-result-preview {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 350px;
        background: #fafafa;
        border-radius: 8px;
        padding: 16px;
        overflow: hidden;
    }

    .material-info {
        font-size: 12px;
        color: #6c757d;
        margin-top: 4px;
        padding-left: 4px;
    }

    .hint {
        font-size: 11px;
        color: #6c757d;
        margin-top: 2px;
    }

    .error-hint {
        font-size: 11px;
        color: #dc3545;
