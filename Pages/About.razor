        <div class="standard-item"><strong>EN 13906</strong><span>Helical springs</span></div>
        <div class="standard-item"><strong>EN 10270</strong><span>Spring wire</span></div>
        <div class="standard-item"><strong>VDI 2230</strong><span>Bolted joints</span></div>
    </div>
</div>

