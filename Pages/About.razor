</div>

<style>
    /* Stats Row */
    .stats-row {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
        margin-bottom: 24px;
    }

    .stat-card {
        background: linear-gradient(135deg, #0077be 0%, #005a91 100%);
        color: white;
        border-radius: 12px;
        padding: 20px;
        text-align: center;
        box-shadow: 0 4px 12px rgba(0, 119, 190, 0.25);
    }

    .stat-number {
        font-size: 36px;
        font-weight: 700;
        line-height: 1;
        margin-bottom: 6px;
    }

    .stat-label {
        font-size: 13px;
        opacity: 0.85;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    /* Module List */
    .about-section-label {
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #0077be;
        font-weight: 700;
        padding: 0 0 8px 0;
        border-bottom: 2px solid #e6f3fa;
        margin-bottom: 8px;
    }

    .module-list {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .module-row {
        display: grid;
        grid-template-columns: 200px 100px 1fr;
        gap: 12px;
        align-items: center;
        padding: 10px 12px;
        border-radius: 8px;
        transition: background 0.15s;
    }

    .module-row:hover {
        background: #f8f9fa;
    }

    .module-name {
        font-weight: 600;
        color: #2c3e50;
        font-size: 14px;
    }

    .module-std {
        font-size: 12px;
        font-weight: 600;
        color: #0077be;
        background: #e6f3fa;
        padding: 3px 8px;
        border-radius: 20px;
        text-align: center;
        white-space: nowrap;
    }

    .module-desc {
        font-size: 13px;
        color: #6c757d;
    }

    /* Standards Grid */
    .standards-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
        gap: 12px;
        margin-top: 4px;
    }

    .standard-item {
        display: flex;
        flex-direction: column;
        gap: 4px;
        padding: 12px 16px;
        background: #f8f9fa;
        border-radius: 8px;
        border-left: 3px solid #0077be;
    }

    .standard-item strong {
        color: #2c3e50;
        font-size: 14px;
    }

    .standard-item span {
        color: #6c757d;
        font-size: 12px;
    }

    /* Roadmap */
    .roadmap-list {
        display: flex;
        flex-direction: column;
        gap: 8px;
        margin-top: 4px;
    }

    .roadmap-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 14px;
        background: #f8f9fa;
        border-radius: 8px;
        font-size: 14px;
        color: #495057;
    }

    .roadmap-badge {
        font-size: 11px;
        font-weight: 700;
        padding: 3px 10px;
        border-radius: 20px;
        background: #e6f3fa;
        color: #0077be;
        white-space: nowrap;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .idea-badge {
        background: #fff8e1;
        color: #856404;
    }

    /* Technology Grid */
    .tech-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 16px;
        margin-top: 4px;
    }

    .tech-item {
        padding: 16px;
        background: #f8f9fa;
        border-radius: 10px;
        border-left: 3px solid #0077be;
    }

    .tech-item strong {
        display: block;
        color: #2c3e50;
        font-size: 14px;
        margin-bottom: 4px;
    }

    .tech-item p {
        font-size: 12px;
        color: #6c757d;
        margin: 0;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .stats-row {
            grid-template-columns: repeat(2, 1fr);
        }

        .module-row {
            grid-template-columns: 1fr;
            gap: 4px;
        }

        .module-std {
            width: fit-content;
        }
    }

    @@media (max-width: 480px) {
        .stats-row {
            grid-template-columns: repeat(2, 1fr);
        }
    }
</style>
