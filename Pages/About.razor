@page "/about"

<PageTitle>About - Mekanika</PageTitle>

<div class="page-header">
    <h1><ModuleIcon Type="info" Size="large" Style="transparent" CustomStyle="margin-right: 12px;" /> About Mekanika</h1>
    <p>Free professional engineering calculations based on international standards</p>
</div>

<!-- Stats Row -->
<div class="stats-row">
    <div class="stat-card">
        <div class="stat-number">12</div>
        <div class="stat-label">Calculators</div>
    </div>
    <div class="stat-card">
        <div class="stat-number">8+</div>
        <div class="stat-label">Standards</div>
    </div>
    <div class="stat-card">
        <div class="stat-number">100%</div>
        <div class="stat-label">Free & Open</div>
    </div>
    <div class="stat-card">
        <div class="stat-number">100%</div>
        <div class="stat-label">Client-Side Calc</div>
    </div>
</div>

<!-- Mission -->
<div class="card">
    <div class="card-header">
        <h2>Mission</h2>
    </div>
    <div style="padding: 8px 0; line-height: 1.85; color: #495057;">
        <p>
            Mekanika is a free online platform for mechanical engineering calculations, designed to help
            engineers, students, and technical professionals in their daily design work. All calculations
            are based on established <strong>DIN, ISO, EN, and VDI standards</strong>, providing reliable
            results that align with industry best practices.
        </p>
        <p style="margin-top: 12px;">
            Calculations run entirely in your browser using <strong>WebAssembly technology</strong> —
            your inputs are processed on your device, not on a server. Creating an account and saving
            calculations to it is optional; see our <a href="/privacy" style="color: #0077be; text-decoration: none; font-weight: 600;">Privacy Policy</a> for what an account stores.
        </p>
    </div>
</div>

<!-- Current Modules -->
<div class="card">
    <div class="card-header">
        <h2>Available Calculators</h2>
    </div>

    <div class="about-section-label">Shaft-Hub Connections</div>
    <div class="module-list">
        <div class="module-row">
            <span class="module-name">Interference Fit</span>
            <span class="module-std">DIN 7190</span>
            <span class="module-desc">Press fit & shrink fit — contact pressure, assembly force, safety factors</span>
        </div>
        <div class="module-row">
            <span class="module-name">Taper Fit</span>
            <span class="module-std">DIN 7190</span>
            <span class="module-desc">Conical interference fits with standard ratios and self-locking analysis</span>
        </div>
        <div class="module-row">
            <span class="module-name">Parallel Key</span>
            <span class="module-std">DIN 6885</span>
            <span class="module-desc">Keyway connections — surface pressure, shear stress, recommended key size</span>
        </div>
        <div class="module-row">
            <span class="module-name">Clamp Connection</span>
            @* Not DIN 703 - that standard covers shaft collars, not clamped hubs. *@
            <span class="module-std">VDI 2230</span>
            <span class="module-desc">Clamping hub design — bolt preload, contact pressure, torque capacity</span>
        </div>
    </div>

    <div class="about-section-label" style="margin-top: 20px;">Gears</div>
    <div class="module-list">
        <div class="module-row">
            <span class="module-name">Cylindrical Gear Pair</span>
            <span class="module-std">ISO 6336</span>
            <span class="module-desc">Spur & helical gears — geometry, bending and contact stress analysis</span>
        </div>
    </div>

    <div class="about-section-label" style="margin-top: 20px;">Bolted Connections</div>
    <div class="module-list">
        <div class="module-row">
            <span class="module-name">Single Bolt</span>
            <span class="module-std">VDI 2230</span>
            <span class="module-desc">Preloaded bolt connection — assembly and operating load calculations</span>
        </div>
    </div>

    <div class="about-section-label" style="margin-top: 20px;">Bearings</div>
    <div class="module-list">
        <div class="module-row">
            <span class="module-name">Ball Bearing Life</span>
            <span class="module-std">ISO 281</span>
            <span class="module-desc">Deep groove & angular contact — fatigue life, equivalent load, static safety</span>
        </div>
        <div class="module-row">
            <span class="module-name">Roller Bearing Life</span>
            <span class="module-std">ISO 281</span>
            <span class="module-desc">Cylindrical & tapered roller bearings — radial and combined loading</span>
        </div>
    </div>

    <div class="about-section-label" style="margin-top: 20px;">Springs</div>
    <div class="module-list">
        <div class="module-row">
            <span class="module-name">Compression Spring</span>
            <span class="module-std">EN 13906-1</span>
            <span class="module-desc">Spring rate, Wahl stress, buckling check, fatigue life estimation</span>
        </div>
        <div class="module-row">
            <span class="module-name">Extension Spring</span>
            <span class="module-std">EN 13906-2</span>
            <span class="module-desc">Initial tension, spring rate, hook stress analysis</span>
        </div>
        <div class="module-row">
            <span class="module-name">Torsion Spring</span>
            <span class="module-std">EN 13906-3</span>
            <span class="module-desc">Torque-angle relationship, bending stress, fatigue analysis</span>
        </div>
    </div>

    <div class="about-section-label" style="margin-top: 20px;">Section Properties</div>
    <div class="module-list">
        <div class="module-row">
            <span class="module-name">Moment of Inertia</span>
            <span class="module-std">Reference</span>
            <span class="module-desc">I, W, i<sub>g</sub> for solid, hollow, rectangular, and composite cross-sections</span>
        </div>
    </div>
</div>

<!-- Standards -->
<div class="card">
    <div class="card-header">
        <h2>Standards Reference</h2>
