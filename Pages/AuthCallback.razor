@page "/auth/callback"
@using System.Text.Json
@inject SupabaseAuthService Auth
@inject CalculationStorageService Storage
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

@*
    Landing page for the redirect back from Google / a magic link. Supabase leaves the
    session in the URL fragment; we consume it, persist the session, and move on. This
    route must be in the Supabase "Redirect URLs" list, and it relies on the GitHub
    Pages 404.html SPA rewrite to resolve on a hard load.
*@

<PageTitle>Signing in… - Mekanika</PageTitle>

<div class="callback-wrap">
    @if (error == null)
    {
        <div class="spinner spinner-lg"></div>
        <p>Signing you in…</p>
    }
    else
    {
        <div class="alert alert-danger" style="max-width: 420px;">
            <div>
                <strong>Sign-in could not be completed.</strong>
                <div style="margin-top: 6px;">@error</div>
            </div>
        </div>
        <a href="/login" class="btn btn-primary" style="margin-top: 16px;">Back to sign in</a>
    }
</div>

<style>
    .callback-wrap {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 16px;
        min-height: 50vh;
        color: #495057;
    }
    .spinner-lg {
        width: 36px;
        height: 36px;
        border-width: 4px;
    }
</style>

@code {
    private string? error = null;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // JS interop (reading the fragment) is only safe after the first render.
        if (!firstRender) return;

        var (ok, err) = await Auth.CompleteFromCallbackAsync();

        if (ok)
        {
            // If the user pressed "Save" before signing in, the calculation was
            // stashed; persist it now so signing in mid-calculation loses nothing.
            await FlushPendingSaveAsync();
            Navigation.NavigateTo("/my-calculations", forceLoad: false);
        }
        else
        {
            error = err ?? "The sign-in link may have expired.";
            StateHasChanged();
        }
    }

    private const string PendingSaveKey = "mekanika.pendingSave";

    private async Task FlushPendingSaveAsync()
    {
        string? raw;
        try { raw = await JSRuntime.InvokeAsync<string?>("mekanikaAuth.get", PendingSaveKey); }
        catch { return; }

        if (string.IsNullOrEmpty(raw)) return;

        // Consume it unconditionally, so a malformed or un-saveable stash cannot
        // reappear on every future sign-in.
        try { await JSRuntime.InvokeVoidAsync("mekanikaAuth.remove", PendingSaveKey); } catch { }

        try
        {
            var pending = JsonSerializer.Deserialize<PendingSave>(raw);
            if (pending == null || string.IsNullOrEmpty(pending.Module)) return;

            var state = CalculationState.Deserialize(pending.Payload);
            if (state == null) return;

            await Storage.SaveAsync(pending.Module, pending.Title, state);
        }
        catch
        {
            // Best-effort: a failed migration should never block the sign-in landing.
        }
    }

    private class PendingSave
    {
        public string Module { get; set; } = "";
        public string Title { get; set; } = "";
        public string Payload { get; set; } = "";
    }
}
