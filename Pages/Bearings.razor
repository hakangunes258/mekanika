@page "/bearings"
@inject CustomLibraryService Library
@inject AnalyticsService Analytics
@inject SeoService Seo
@inject ModuleMetadataService Metadata

<PageTitle>Bearing Database - Mekanika</PageTitle>

<div class="page-header">
    <h1>
        <ModuleIcon Type="ball-bearing" Size="large" Style="transparent" CustomStyle="margin-right: 12px;" />
        Bearing Database
    </h1>
    <p>Standard rolling bearing catalog</p>
</div>

<div class="card" style="margin-bottom: 24px;">
    <div class="card-header">
        <ModuleIcon Type="info" Size="medium" Style="solid" />
        <h2>Filter & Search</h2>
    </div>
    
    <div class="form-grid" style="grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));">
        <div class="form-group">
            <label>Bearing Type</label>
            <select @bind="selectedType">
                <option value="All">All Types</option>
                <option value="Deep Groove Ball">Deep Groove Ball</option>
                <option value="Cylindrical Roller">Cylindrical Roller</option>
                <option value="Tapered Roller">Tapered Roller</option>
                <option value="Angular Contact Ball">Angular Contact Ball</option>
            </select>
        </div>
        
        <div class="form-group">
            <label>Bore Diameter (d)</label>
            <div class="input-group">
                <input type="number" @bind="filterBore" placeholder="e.g. 30" />
                <span class="unit">mm</span>
            </div>
        </div>
        
        <div class="form-group">
            <label>Search Designation</label>
            <input type="text" @bind="searchText" placeholder="e.g. 6205" />
        </div>
    </div>
</div>

<!-- Bearing Table -->
<div class="card">
    <div class="card-header">
        <ModuleIcon Type="bearing-database" Size="medium" Style="solid" />
        <h2>Bearing Catalog (@FilteredBearingsWithDetails.Count() bearings)</h2>
        <div class="header-actions">
            <AuthorizeView>
                <Authorized>
                    <button class="btn btn-secondary btn-sm" @onclick="StartNew" disabled="@(draft != null)">
                        <ModuleIcon Type="add" Size="button" Style="transparent" />
                        <span>Add my own</span>
                    </button>
                </Authorized>
                <NotAuthorized>
                    <a href="/login" class="btn btn-secondary btn-sm">Sign in to add your own</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>

    @if (draft != null)
    {
        <div class="entry-form">
            <div class="entry-form-title">
                @(draft.CustomId == null ? "New bearing" : $"Editing “{draft.Designation}”")
            </div>

            <div class="entry-form-grid">
                <div class="form-group">
                    <label>Designation</label>
                    <input type="text" @bind="draft.Designation" placeholder="e.g. 6205-2RS-SPECIAL" />
                </div>
                <div class="form-group">
                    <label>Type</label>
                    <select @bind="draft.Type">
                        <option value="@BearingService.TypeDeepGroove">Deep Groove Ball</option>
                        <option value="@BearingService.TypeCylindrical">Cylindrical Roller</option>
                        <option value="@BearingService.TypeTapered">Tapered Roller</option>
                        <option value="@BearingService.TypeAngular">Angular Contact Ball</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Bore d (mm)</label>
                    <input type="number" step="0.1" @bind="draft.Bore" />
                </div>
                <div class="form-group">
                    <label>Outside diameter D (mm)</label>
                    <input type="number" step="0.1" @bind="draft.Outer" />
                </div>
                <div class="form-group">
                    <label>Width B/T (mm)</label>
                    <input type="number" step="0.1" @bind="draft.Width" />
                </div>
                <div class="form-group">
                    <label>Dynamic rating C (kN)</label>
                    <input type="number" step="0.1" @bind="draft.C" />
                </div>
                <div class="form-group">
                    <label>Static rating C₀ (kN)</label>
                    <input type="number" step="0.1" @bind="draft.C0" />
                </div>
                <div class="form-group">
                    <label>Limiting speed (rpm)</label>
                    <input type="number" step="100" @bind="draft.LimitSpeed" />
                </div>

                @if (draft.IsDeepGroove)
                {
                    <div class="form-group">
                        <label>f₀ (ISO 76)</label>
                        <input type="number" step="0.1" @bind="draft.f0" />
                        <small>Drives the X/Y factors under combined load</small>
                    </div>
                }

                @if (draft.IsTapered || draft.IsAngular)
                {
                    <div class="form-group">
                        <label>e — F<sub>a</sub>/F<sub>r</sub> limit</label>
                        <input type="number" step="0.01" @bind="draft.e" />
                    </div>
                    <div class="form-group">
                        <label>Y — dynamic axial factor</label>
                        <input type="number" step="0.01" @bind="draft.Y" />
                    </div>
                    <div class="form-group">
                        <label>Y₀ — static axial factor</label>
                        <input type="number" step="0.01" @bind="draft.Y0" />
                    </div>
                }

                @if (draft.IsAngular)
                {
                    <div class="form-group">
                        <label>Contact angle α (°)</label>
                        <input type="number" step="1" @bind="draft.ContactAngle" />
                    </div>
                    <div class="form-group">
                        <label>X — radial factor</label>
                        <input type="number" step="0.01" @bind="draft.X" />
                    </div>
                    <div class="form-group">
                        <label>Limiting speed, oil (rpm)</label>
                        <input type="number" step="100" @bind="draft.LimitSpeedOil" />
                        <small>Left at 0, the grease value is used</small>
                    </div>
                }
            </div>

            @if (formError != null)
            {
                <div class="alert alert-danger" style="margin: 12px 0 0;">
                    <ModuleIcon Type="warning" Size="button" Style="transparent" />
                    <div>@formError</div>
                </div>
            }

            <div class="entry-form-actions">
                <button class="btn btn-success" @onclick="SaveDraft" disabled="@isBusy">
                    @if (isBusy)
                    {
                        <span class="spinner"></span>
                    }
                    else
                    {
                        <ModuleIcon Type="save" Size="button" Style="transparent" />
                        <span>Save bearing</span>
                    }
                </button>
                <button class="btn btn-secondary" @onclick="CancelDraft" disabled="@isBusy">Cancel</button>
            </div>

            <small class="entry-form-note">
                Saved to your account and available in the ball and roller bearing
                calculators. Shared calculation links carry the bearing by designation,
                so someone opening your link without this bearing falls back to their
                own selection.
            </small>
        </div>
    }

    <div style="overflow-x: auto;">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Designation</th>
                    <th>Type</th>
                    <th>d (mm)</th>
                    <th>D (mm)</th>
                    <th>B/T (mm)</th>
                    <th>C (kN)</th>
                    <th>C₀ (kN)</th>
                    <th>f₀/e</th>
                    <th>Y</th>
                    <th>Limit (rpm)</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in FilteredBearingsWithDetails)
                {
                    <tr>
                        <td>
                            <strong>@item.Designation</strong>
                            @if (item.CustomId != null)
                            {
                                <span class="badge-custom">Mine</span>
                            }
                        </td>
                        <td>@item.Type</td>
                        <td>@item.Bore</td>
                        <td>@item.Outer</td>
                        <td>@item.Width</td>
                        <td>@item.C</td>
                        <td>@item.C0</td>
                        <td>@item.F0OrE</td>
                        <td>@item.Y</td>
                        <td>@item.LimitSpeed.ToString("N0")</td>
                        <td class="row-actions">
                            @if (item.CustomId != null)
                            {
                                var id = item.CustomId;
                                if (confirmDeleteId == id)
                                {
                                    <button class="btn btn-danger btn-sm" @onclick="() => Delete(id)" disabled="@isBusy">Confirm</button>
                                    <button class="btn btn-secondary btn-sm" @onclick="() => confirmDeleteId = null" disabled="@isBusy">Cancel</button>
                                }
                                else
                                {
                                    <button class="btn btn-secondary btn-sm" @onclick="() => StartEdit(id)" disabled="@isBusy">Edit</button>
                                    <button class="btn btn-secondary btn-sm" @onclick="() => confirmDeleteId = id">Delete</button>
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>



<style>
    /* Fix card height issue */
    .card {
        height: auto !important;
    }

    .content-section {
        margin-top: 24px;
        padding: 24px;
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        border-radius: 16px;
        border: 1px solid #dee2e6;
    }

    .content-section h2 {
        color: #2c3e50;
        margin-bottom: 16px;
        font-size: 22px;
        display: flex;
        align-items: center;
        gap: 12px;
        padding-bottom: 12px;
        border-bottom: 2px solid #3498db;
    }

    .content-block {
        margin-bottom: 20px;
        padding: 16px;
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    }
    
    .content-block:last-child {
        margin-bottom: 0;
    }
    
    .content-block h3 {
        color: #34495e;
        margin-bottom: 12px;
        font-size: 18px;
        padding-left: 12px;
        border-left: 4px solid #3498db;
    }

    .content-block p {
        line-height: 1.7;
        color: #495057;
        text-align: justify;
        margin-bottom: 10px;
        font-size: 14px;
    }
    
    .content-block p:last-child {
        margin-bottom: 0;
    }
    
    .content-block strong {
        color: #2c3e50;
    }

    .data-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.9rem;
    }
    
    .data-table th,
    .data-table td {
        padding: 10px 12px;
        text-align: left;
        border-bottom: 1px solid #e9ecef;
    }
    
    .data-table th {
        background: #f8f9fa;
        font-weight: 600;
        color: #495057;
        position: sticky;
        top: 0;
    }
    
    .data-table tbody tr:hover {
        background: #f8f9fa;
    }
    
    .data-table td:first-child {
        color: #0d6efd;
    }
</style>

@code {
    private ModuleInfo moduleInfo = new();
    private string selectedType = "All";
    private double? filterBore = null;
    private string searchText = "";

    protected override async Task OnInitializedAsync()
    {
        // Load module metadata
        moduleInfo = Metadata.GetModule("bearings");

        // Set SEO metadata
        await SetSeoMetadata();

        // Set structured data
        await SetStructuredData();

        // Track page view
        await Analytics.TrackPageView("/bearings", moduleInfo.Name);
    }

    private async Task SetSeoMetadata()
    {
        var baseUrl = "https://mekanika.org";
        var seo = new SeoMetadata
        {
            Title = $"{moduleInfo.Name} - Free Engineering Reference | Mekanika",
            Description = moduleInfo.Description,
            Keywords = moduleInfo.Keywords,
            CanonicalUrl = $"{baseUrl}{moduleInfo.Route}",
            OgTitle = moduleInfo.Name,
            OgDescription = moduleInfo.Description,
            OgImage = $"{baseUrl}/logo.png",
            OgUrl = $"{baseUrl}{moduleInfo.Route}",
            TwitterCard = "summary",
            TwitterTitle = moduleInfo.Name,
            TwitterDescription = moduleInfo.Description,
            TwitterImage = $"{baseUrl}/logo.png"
        };

        await Seo.SetMetaTags(seo);
    }

    private async Task SetStructuredData()
    {
        var structuredData = new
        {
            context = "https://schema.org",
            type = "Dataset",
            name = moduleInfo.Name,
            description = moduleInfo.Description,
            keywords = moduleInfo.Keywords.Split(", "),
            license = "https://creativecommons.org/licenses/by/4.0/",
            creator = new
            {
                type = "Organization",
                name = "Mekanika",
                url = "https://mekanika.org"
            },
            spatialCoverage = "Worldwide",
            temporalCoverage = "2024/..",
            includedInDataCatalog = new
            {
                type = "DataCatalog",
                name = "Mekanika Engineering Reference Database"
            }
        };

        await Seo.SetStructuredData(structuredData);
    }

    // ============ USER-ADDED BEARINGS ============

    private CustomBearingDraft? draft;
    private string? confirmDeleteId;
    private string? formError;
    private bool isBusy;

    private void StartNew()
    {
        confirmDeleteId = null;
        formError = null;
        draft = new CustomBearingDraft();
    }

    /// <summary>
    /// Rebuilds the form from the stored bearing — as a COPY, so a half-typed or
    /// failed edit never reaches the calculators reading the live lists.
    /// </summary>
    private void StartEdit(string customId)
    {
        confirmDeleteId = null;
        formError = null;

        var ball = BearingService.DeepGrooveBallBearings.Concat(BearingService.CylindricalRollerBearings)
            .FirstOrDefault(b => b.CustomId == customId);
        if (ball != null) { draft = CustomBearingDraft.From(ball); return; }

        var tapered = BearingService.TaperedRollerBearings.FirstOrDefault(b => b.CustomId == customId);
        if (tapered != null) { draft = CustomBearingDraft.From(tapered); return; }

        var angular = BearingService.AngularContactBallBearings.FirstOrDefault(b => b.CustomId == customId);
        if (angular != null) draft = CustomBearingDraft.From(angular);
    }

    private void CancelDraft()
    {
        draft = null;
        formError = null;
    }

    private async Task SaveDraft()
    {
        if (draft == null) return;

        formError = draft.Validate();
        if (formError != null) return;

        isBusy = true;
        var (ok, error) = await Library.SaveBearingAsync(draft);
        isBusy = false;

        if (!ok)
        {
            formError = error ?? "Could not save. Please try again.";
            return;
        }

        draft = null;
    }

    private async Task Delete(string customId)
    {
        isBusy = true;
        var (ok, error) = await Library.DeleteBearingAsync(customId);
        isBusy = false;
        confirmDeleteId = null;

        if (!ok)
        {
            formError = error ?? "Could not delete. Please try again.";
            return;
        }

        // Deleting the bearing currently open in the form would leave an orphaned draft.
        if (draft?.CustomId == customId) CancelDraft();
    }

    private class BearingDisplayItem
    {
        public string Designation { get; set; } = "";
        public string Type { get; set; } = "";
        public double Bore { get; set; }
        public double Outer { get; set; }
        public double Width { get; set; }
        public double C { get; set; }
        public double C0 { get; set; }
        public string F0OrE { get; set; } = "";
        public string Y { get; set; } = "";
        public int LimitSpeed { get; set; }

        /// <summary>Non-null for a bearing the signed-in user added; drives the badge and row actions.</summary>
        public string? CustomId { get; set; }
    }

    private IEnumerable<BearingDisplayItem> FilteredBearingsWithDetails
    {
        get
        {
            var items = new List<BearingDisplayItem>();

            // Deep Groove Ball Bearings
            var ballBearings = BearingService.DeepGrooveBallBearings
                .Where(b => selectedType == "All" || selectedType == "Deep Groove Ball")
                .Where(b => !filterBore.HasValue || b.Bore == filterBore.Value)
                .Where(b => string.IsNullOrEmpty(searchText) ||
                            b.Designation.Contains(searchText, StringComparison.OrdinalIgnoreCase))
                .Select(b => new BearingDisplayItem
                {
                    Designation = b.Designation,
                    Type = b.Type,
                    Bore = b.Bore,
                    Outer = b.Outer,
                    Width = b.Width,
                    C = b.C,
                    C0 = b.C0,
                    F0OrE = b.f0.ToString("F1"),
                    Y = "-",
                    LimitSpeed = b.LimitSpeed,
                    CustomId = b.CustomId
                });
            items.AddRange(ballBearings);

            // Cylindrical Roller Bearings
            var rollerBearings = BearingService.CylindricalRollerBearings
                .Where(b => selectedType == "All" || selectedType == "Cylindrical Roller")
                .Where(b => !filterBore.HasValue || b.Bore == filterBore.Value)
                .Where(b => string.IsNullOrEmpty(searchText) ||
                            b.Designation.Contains(searchText, StringComparison.OrdinalIgnoreCase))
                .Select(b => new BearingDisplayItem
                {
                    Designation = b.Designation,
                    Type = b.Type,
                    Bore = b.Bore,
                    Outer = b.Outer,
                    Width = b.Width,
                    C = b.C,
                    C0 = b.C0,
                    F0OrE = "-",
                    Y = "-",
                    LimitSpeed = b.LimitSpeed,
                    CustomId = b.CustomId
                });
            items.AddRange(rollerBearings);

            // Tapered Roller Bearings
            var taperedBearings = BearingService.TaperedRollerBearings
                .Where(b => selectedType == "All" || selectedType == "Tapered Roller")
                .Where(b => !filterBore.HasValue || b.Bore == filterBore.Value)
                .Where(b => string.IsNullOrEmpty(searchText) ||
                            b.Designation.Contains(searchText, StringComparison.OrdinalIgnoreCase))
                .Select(b => new BearingDisplayItem
                {
                    Designation = b.Designation,
                    Type = b.Type,
                    Bore = b.Bore,
                    Outer = b.Outer,
                    Width = b.Width,
                    C = b.C,
                    C0 = b.C0,
                    F0OrE = b.e.ToString("F2"),
                    Y = b.Y.ToString("F1"),
                    LimitSpeed = b.LimitSpeed,
                    CustomId = b.CustomId
                });
            items.AddRange(taperedBearings);

            // Angular Contact Ball Bearings
            var angularBearings = BearingService.AngularContactBallBearings
                .Where(b => selectedType == "All" || selectedType == "Angular Contact Ball")
                .Where(b => !filterBore.HasValue || b.Bore == filterBore.Value)
                .Where(b => string.IsNullOrEmpty(searchText) ||
                            b.Designation.Contains(searchText, StringComparison.OrdinalIgnoreCase))
                .Select(b => new BearingDisplayItem
                {
                    Designation = b.Designation,
                    Type = b.Type,
                    Bore = b.Bore,
                    Outer = b.Outer,
                    Width = b.Width,
                    C = b.C,
                    C0 = b.C0,
                    F0OrE = b.e.ToString("F2"),
                    Y = b.Y.ToString("F2"),
                    LimitSpeed = b.LimitSpeed,
                    CustomId = b.CustomId
                });
            items.AddRange(angularBearings);

            return items.OrderBy(b => b.Type).ThenBy(b => b.Bore);
        }
    }
}
