@code {
    private SpringEngine engine = new();
    /// <summary>Why Calculate refused, shown by <see cref="ValidationAlert"/>.</summary>
    private List<string> validationMessages = new();
    private bool showResults = false;
    private bool isCalculating = false;
    private bool isSavingPdf = false;
    private string selectedMaterial = "SH";
    private string loadType = "Static"; // "Static" or "Dynamic"
    private bool openedFromSharedLink = false;

    // Modal visibility
    private bool showEndConditionInfo = false;
    private void ToggleEndConditionInfo() => showEndConditionInfo = !showEndConditionInfo;

    // Operating lengths
    private double assembledLength = 0;
    private double compressedLength = 0;

    /// <summary>
    /// Geometry handed to the 3D viewer. Keys must match the "compression-spring"
    /// builder in wwwroot/js/viewer3d.js. L1/L2 drive the compression states the
    /// user can step through; 0 means "not used in this calculation".
    /// </summary>
    private object Build3dParameters() => new
    {
        d = engine.WireDiameter,
        Dm = engine.MeanCoilDiameter,
        L0 = engine.FreeLength,
        nt = engine.TotalCoils,
        na = engine.ActiveCoils,
        Lc = engine.SolidLength,
        L1 = assembledLength,
        L2 = loadType == "Dynamic" ? compressedLength : 0
    };

    // Calculated working values
    private double deflection1 = 0;
    private double deflection2 = 0;
    private double force1 = 0;
    private double force2 = 0;
    private double shearStress1 = 0;
    private double shearStress2 = 0;

    // Safety factors
    private double staticSafetyFactor = 0;

    // Fatigue analysis
    private double meanStress = 0;
    private double stressAmplitude = 0;
    private double stressRatio = 0;
    private double fatigueSafetyFactor = 0;
    private double fatigueEnduranceLimit = 0;
    private double estimatedCycles = 0;

    // Module metadata for SEO and analytics
    private ModuleInfo moduleInfo = new();

    protected override async Task OnInitializedAsync()
    {
        engine.MaterialGrade = "SH";
        engine.ShearModulus = 81500;
        engine.TensileStrength = 1700;
        engine.EndType = "ClosedGround";
        engine.EndCondition = "BothFlat";
        engine.ShotPeened = false;

        // SEO and Analytics
        moduleInfo = Metadata.GetModule("compression-spring");
        await SetSeoMetadata();
        await SetStructuredData();
        await Analytics.TrackPageView("/compression-spring", moduleInfo.Name);
    }

    private void OnMaterialChanged()
    {
        if (SpringEngine.Materials.TryGetValue(selectedMaterial, out var mat))
        {
            engine.ShearModulus = mat.G;
            engine.TensileStrength = mat.Rm;
            engine.MaterialGrade = selectedMaterial;
            // Reset allowable shear stress so it will be recalculated with new Rm
            engine.AllowableShearStress = 0;
        }
    }

    private void OnLoadTypeChanged()
    {
        // Static: only L1 (single working position) — clear L2
        // Dynamic: L1 + L2 (oscillates between two positions) — clear both for clean start
        assembledLength = 0;
        compressedLength = 0;
    }

    private async Task Calculate()
    {
        // Name what is missing rather than returning in silence.
        validationMessages.Clear();
        if (engine.WireDiameter <= 0) validationMessages.Add("Select a wire diameter (d).");
        if (engine.MeanCoilDiameter <= 0) validationMessages.Add("Mean coil diameter (Dm) must be greater than 0.");
        if (engine.FreeLength <= 0) validationMessages.Add("Free length (L₀) must be greater than 0.");
        if (engine.ActiveCoils <= 0) validationMessages.Add("Active coils (n) must be greater than 0.");

        if (validationMessages.Count > 0)
        {
            await Analytics.TrackCalculationError("compression-spring", "validation_failed", string.Join("; ", validationMessages));
            return;
        }

        isCalculating = true;
        StateHasChanged();
        await Task.Delay(350); // let the spinner render + feel responsive

        engine.Calculate();

        double stressConstant = (8 * engine.MeanCoilDiameter) / (Math.PI * Math.Pow(engine.WireDiameter, 3));

        if (loadType == "Static")
        {
            // Static: user enters only L1 (the single working position)
            // L1 is the compressed/working length → stress is calculated here
            if (assembledLength > 0)
            {
                deflection1 = engine.FreeLength - assembledLength;
                force1 = engine.SpringRateCalculated * deflection1;
                shearStress1 = engine.WahlFactor * stressConstant * force1;
            }
            // L2 is not used in static mode — clear it
            compressedLength = 0;
            deflection2 = 0; force2 = 0; shearStress2 = 0;

            // Safety factor: against the working stress (L1), or solid length if L1 not given
            staticSafetyFactor = shearStress1 > 0
                ? engine.AllowableShearStress / shearStress1
                : engine.AllowableShearStress / engine.ShearStressMax;
        }
        else
        {
            // Dynamic: spring oscillates between L1 (preload) and L2 (max compression)
            if (assembledLength > 0)
            {
                deflection1 = engine.FreeLength - assembledLength;
                force1 = engine.SpringRateCalculated * deflection1;
                shearStress1 = engine.WahlFactor * stressConstant * force1;
            }
            if (compressedLength > 0)
            {
                deflection2 = engine.FreeLength - compressedLength;
                force2 = engine.SpringRateCalculated * deflection2;
                shearStress2 = engine.WahlFactor * stressConstant * force2;
            }

            // Safety factor: against max stress at L2
            staticSafetyFactor = shearStress2 > 0
                ? engine.AllowableShearStress / shearStress2
                : engine.AllowableShearStress / engine.ShearStressMax;

            // Fatigue analysis — both L1 and L2 required
            if (assembledLength > 0 && compressedLength > 0 && shearStress1 > 0 && shearStress2 > 0)
            {
                CalculateFatigue();
            }
        }

        isCalculating = false;
        showResults = true;

        // Analytics tracking
        await Analytics.TrackCalculationCompleted("compression-spring", new Dictionary<string, object>
        {
            { "wire_diameter", engine.WireDiameter },
            { "mean_coil_diameter", engine.MeanCoilDiameter },
            { "spring_rate", engine.SpringRateCalculated },
            { "load_type", loadType },
            { "shot_peened", engine.ShotPeened }
        });
    }
    
    private void CalculateFatigue()
    {
        // Mean stress and amplitude (Goodman diagram)
        meanStress = (shearStress1 + shearStress2) / 2;
        stressAmplitude = (shearStress2 - shearStress1) / 2;
        stressRatio = shearStress1 / shearStress2;

        // Endurance limit — factor set by engine based on shot peening state:
        //   Unpeened: τe = 0.30 × Rm   (EN 13906-1 conservative)
        //   Peened:   τe = 0.38 × Rm   (+27% improvement)
        fatigueEnduranceLimit = engine.FatigueEnduranceFactor * engine.TensileStrength;

        // Goodman criterion: τa/τe + τm/τu = 1/SF
        // where τu = 0.65 × Rm (ultimate shear strength)
        double ultimateShear = 0.65 * engine.TensileStrength;

        // Safety factor from Goodman equation
        if (stressAmplitude > 0)
        {
            double goodmanValue = (stressAmplitude / fatigueEnduranceLimit) + (meanStress / ultimateShear);
            fatigueSafetyFactor = 1.0 / goodmanValue;
        }
        else
        {
            fatigueSafetyFactor = 999;
        }

        // Estimate fatigue life using simplified S-N curve
        // Infinite life threshold: τa < 30% of τe
        if (stressAmplitude < fatigueEnduranceLimit * 0.3)
        {
            estimatedCycles = double.PositiveInfinity;
        }
        else if (stressAmplitude < fatigueEnduranceLimit)
        {
            // High cycle fatigue region (~10⁶–10⁷ cycles)
            double ratio = stressAmplitude / fatigueEnduranceLimit;
            estimatedCycles = Math.Pow(10, 7 - 3 * (ratio - 0.3) / 0.7);
        }
        else
        {
            // Low cycle fatigue region
            double ratio = stressAmplitude / fatigueEnduranceLimit;
            estimatedCycles = Math.Pow(10, 6 - 4 * (ratio - 1));
            if (estimatedCycles < 1000) estimatedCycles = 1000;
        }
    }
    
    private string GetFatigueLifeText()
    {
        if (double.IsPositiveInfinity(estimatedCycles))
            return "∞ (Infinite Life)";
        else if (estimatedCycles >= 1e7)
            return $">{estimatedCycles/1e6:F0}M cycles";
        else if (estimatedCycles >= 1e6)
            return $"~{estimatedCycles/1e6:F1}M cycles";
        else if (estimatedCycles >= 1e5)
            return $"~{estimatedCycles/1e3:F0}k cycles";
        else
            return $"~{estimatedCycles:F0} cycles";
    }
    
    private string GetFatigueLifeClass()
    {
        if (double.IsPositiveInfinity(estimatedCycles) || estimatedCycles >= 1e6)
            return "success";
        else if (estimatedCycles >= 1e5)
            return "";
        else
            return "warning";
    }
    
    private string GetSafetyColor(double safetyFactor)
    {
        if (safetyFactor < 1.0)
            return "#dc3545 0%, #a71d2a 100%";
        else if (safetyFactor < 1.5)
            return "#ffc107 0%, #d39e00 100%";
        else
            return "#28a745 0%, #1e7e34 100%";
    }

