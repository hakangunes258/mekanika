    /// <summary>
    /// The module's inputs in the neutral form used by shareable links (and, later,
    /// cloud-saved calculations). Inputs only — results are recomputed on restore.
    ///
    /// The material grade is stored by key, and the properties it drives (G, Rm) are
    /// stored alongside so a manual override survives the round-trip. End type,
    /// end condition and shot-peening bind straight to the engine. Keys are kept
    /// short because the whole state rides in a URL.
    /// </summary>
    private CalculationState BuildShareState() => new CalculationState("compression-spring")
        .Set("d", engine.WireDiameter)
        .Set("Dm", engine.MeanCoilDiameter)
        .Set("L0", engine.FreeLength)
        .Set("n", engine.ActiveCoils)
        .Set("end", engine.EndType)
        .Set("mat", selectedMaterial)
        .Set("G", engine.ShearModulus)
        .Set("Rm", engine.TensileStrength)
        .Set("peen", engine.ShotPeened)
        .Set("lt", loadType)
        .Set("ec", engine.EndCondition)
        .Set("aL", assembledLength)
        .Set("cL", compressedLength);

    /// <summary>
    /// Restores state produced by <see cref="BuildShareState"/>, then recalculates so
    /// the recipient lands straight on the results.
    ///
    /// Every read supplies the current value as its fallback, so a link written by an
    /// older build that lacked a field leaves that field at its default instead of
    /// zeroing it.
    /// </summary>
    private async Task ApplyShareState(CalculationState state)
    {
        engine.WireDiameter = state.GetDouble("d", engine.WireDiameter);
        engine.MeanCoilDiameter = state.GetDouble("Dm", engine.MeanCoilDiameter);
        engine.FreeLength = state.GetDouble("L0", engine.FreeLength);
        engine.ActiveCoils = state.GetDouble("n", engine.ActiveCoils);
        engine.EndType = state.GetString("end", engine.EndType);
        engine.EndCondition = state.GetString("ec", engine.EndCondition);
        engine.ShotPeened = state.GetBool("peen", engine.ShotPeened);

        // Material sets G/Rm from its grade; reapply the stored values afterwards so
        // a manual override is preserved.
        var mat = state.GetString("mat", selectedMaterial);
        selectedMaterial = SpringEngine.Materials.ContainsKey(mat) ? mat : selectedMaterial;
        OnMaterialChanged();
        engine.ShearModulus = state.GetDouble("G", engine.ShearModulus);
        engine.TensileStrength = state.GetDouble("Rm", engine.TensileStrength);

        // Load type first: its handler clears the length fields, so the stored working
        // lengths must be applied afterwards.
        loadType = state.GetString("lt", loadType);
        OnLoadTypeChanged();
        assembledLength = state.GetDouble("aL", assembledLength);
        compressedLength = state.GetDouble("cL", compressedLength);

        openedFromSharedLink = true;

        // Calculate() validates, so a damaged link just leaves the user on the form.
        await Calculate();
    }

    private async Task SaveAsPdf()
    {
        isSavingPdf = true;
        StateHasChanged();
        try
        {
            var filename = $"CompressionSpring-Report-{DateTime.Now:yyyyMMdd_HHmmss}.pdf";
            await JSRuntime.InvokeVoidAsync("generatePdf", "results-content", filename);
            await Analytics.TrackPdfDownload("compression-spring", filename);
        }
        catch (Exception ex)
        {
            await Analytics.TrackCalculationError("compression-spring", "pdf_generation_failed", ex.Message);
        }
    }

