@page "/spring"
@page "/compression-spring"
@using MechanicalCalculatorWeb.Services
@using MechanicalCalculatorWeb.Models
@inject IJSRuntime JSRuntime
@inject AnalyticsService Analytics
@inject SeoService Seo
@inject ModuleMetadataService Metadata

<PageTitle>Compression Spring Calculator - Mekanika</PageTitle>

<div class="page-header">
    <h1>
        <ModuleIcon Type="compression" Size="large" Style="transparent" CustomStyle="margin-right: 12px;" />
        Helical Compression Spring Calculator
    </h1>
    <p>Compression spring design according to EN 13906-1</p>
</div>

<SharedCalculationLoader Module="compression-spring" OnRestore="ApplyShareState" />

@if (!showResults)
{
    <!-- INPUT FORM -->
    <div class="form-grid">
        <!-- Geometry Card -->
        <div class="card">
            <div class="card-header">
                <ModuleIcon Type="geometry" Size="medium" Style="solid" />
                <h2>Spring Geometry</h2>
                <SchematicHelp Src="schematics/compression-spring/01-geometry.svg"
                               Width="520" Height="500"
                               Title="Spring Geometry — Symbol Reference">
                    <div><b>d</b> Wire diameter</div>
                    <div><b>D<sub>m</sub></b> Mean coil diameter</div>
                    <div><b>D<sub>e</sub></b> Outer diameter = D<sub>m</sub> + d</div>
                    <div><b>D<sub>i</sub></b> Inner diameter = D<sub>m</sub> &minus; d</div>
                    <div><b>L<sub>0</sub></b> Free length (unloaded)</div>
                    <div><b>p</b> Coil pitch, free state</div>
                    <div><b>α</b> Pitch angle = arctan(p / πD<sub>m</sub>)</div>
                </SchematicHelp>
            </div>

            <div class="form-group">
                <label>Wire Diameter (d)</label>
                <div class="input-group">
                    <select @bind="engine.WireDiameter" style="flex: 1; padding: 10px; border: 1px solid #ced4da; border-radius: 8px 0 0 8px;">
                        <option value="0">-- Select --</option>
                        @foreach (var d in SpringEngine.StandardWireDiameters)
                        {
                            <option value="@d">@d</option>
                        }
                    </select>
                    <span class="unit">mm</span>
                </div>
            </div>
            
            <div class="form-group">
                <label>Mean Coil Diameter (Dm)</label>
                <div class="input-group">
                    <input type="number" step="0.1" @bind="engine.MeanCoilDiameter" placeholder="e.g. 20" />
                    <span class="unit">mm</span>
                </div>
            </div>
            
            <div class="form-group">
                <label>Free Length (L₀)</label>
                <div class="input-group">
                    <input type="number" step="0.1" @bind="engine.FreeLength" placeholder="e.g. 50" />
                    <span class="unit">mm</span>
                </div>
            </div>
            
            <div class="form-group">
                <label>Active Coils (n)</label>
                <div class="input-group">
                    <input type="number" step="0.5" @bind="engine.ActiveCoils" placeholder="e.g. 8" />
                    <span class="unit">coils</span>
                </div>
            </div>
            
            <div class="form-group">
                <label>
                    End Type
                    <SchematicHelp Src="schematics/compression-spring/02-coils-end-types.svg"
                                   Width="1000" Height="470"
                                   Title="Coil Count and End Types">
                        <div><b>n</b> Active (working) coils — the value you enter</div>
                        <div><b>n<sub>t</sub></b> Total coils, including the dead end coils</div>
                        <div><b>L<sub>c</sub></b> Solid length — all coils touching</div>
                        <div><b>d</b> Wire diameter</div>
                        <div class="full">
                            Left to right: <strong>Closed &amp; ground</strong> · <strong>Closed, not ground</strong> · <strong>Open</strong>
                        </div>
                        <div class="full" style="color: #6c757d;">
                            The drawing marks d<sub>max</sub>, the toleranced maximum wire diameter.
                            This calculator uses the nominal d.
                        </div>
                    </SchematicHelp>
                </label>
                <select @bind="engine.EndType">
                    <option value="ClosedGround">Closed & Ground</option>
                    <option value="Closed">Closed (not ground)</option>
                    <option value="Open">Open</option>
                </select>
            </div>
        </div>

        <!-- Material Card -->
        <div class="card">
            <div class="card-header">
                <ModuleIcon Type="material" Size="medium" Style="solid" />
                <h2>Material</h2>
            </div>

            <div class="form-group">
                <label>Material Grade</label>
                <select @bind="selectedMaterial" @bind:after="OnMaterialChanged">
                    @foreach (var mat in SpringEngine.Materials)
                    {
                        <option value="@mat.Key">@mat.Value.Name</option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label>Shear Modulus (G)</label>
                <div class="input-group">
                    <input type="number" step="100" @bind="engine.ShearModulus" />
                    <span class="unit">MPa</span>
                </div>
            </div>

            <div class="form-group">
                <label>Tensile Strength (Rm)</label>
                <div class="input-group">
                    <input type="number" step="10" @bind="engine.TensileStrength" />
                    <span class="unit">MPa</span>
                </div>
            </div>

            <div class="form-group">
                <label>Shot Peening</label>
                <div class="toggle-row">
                    <label class="toggle-switch">
                        <input type="checkbox" @bind="engine.ShotPeened" />
                        <span class="toggle-slider"></span>
                    </label>
                    <span class="toggle-label">@(engine.ShotPeened ? "Yes — fatigue limit +27% (τe = 0.38 × Rm)" : "No — standard fatigue limit (τe = 0.30 × Rm)")</span>
                </div>
                <small style="color: #6c757d; font-size: 12px;">Shot peening increases surface compressive stress, improving fatigue life</small>
            </div>
        </div>

        <!-- Operating Conditions Card -->
        <div class="card">
            <div class="card-header">
                <ModuleIcon Type="loading" Size="medium" Style="solid" />
                <h2>Operating Conditions</h2>
            </div>

            <!-- Load Type -->
            <div class="form-group">
                <label>Load Type</label>
                <select @bind="loadType" @bind:after="OnLoadTypeChanged" class="form-select" style="padding: 10px; border: 1px solid #ced4da; border-radius: 8px;">
                    <option value="Static">Static: Constant or slowly varying load</option>
                    <option value="Dynamic">Dynamic: Cyclic / fluctuating load</option>
                </select>
            </div>

            <!-- End Support with info button -->
            <div class="form-group">
                <label>
                    Spring End Support
                    <button type="button" class="info-btn" @onclick="ToggleEndConditionInfo" title="Show support types diagram"><ModuleIcon Type="info" Size="button" Style="default" /></button>
                </label>
                <select @bind="engine.EndCondition">
                    <option value="BothFlat">Both ends on flat surfaces (ν = 1.0)</option>
                    <option value="OneFixedOneFlat">One end fixed, one end flat (ν = 0.7)</option>
                    <option value="BothFixed">Both ends fixed / guided rod (ν = 0.5)</option>
                    <option value="OneFixedOneFree">One end fixed, one end free (ν = 2.0)</option>
                </select>
                <small style="color: #6c757d; font-size: 12px;">Affects buckling threshold — guide sleeves/rods allow longer springs without buckling</small>
            </div>

            @if (loadType == "Static")
            {
                <!-- Static: single working position → L1 only -->
                <div class="form-group">
                    <label>
                        Working Length — L₁ <span style="color: #e74c3c;">*</span>
                        <SchematicHelp Src="schematics/compression-spring/03a-lengths-static.svg"
                                       Width="870" Height="460"
                                       Title="Lengths, Deflections and Forces — Static Load">
                            <div><b>L<sub>0</sub></b> Free length (unloaded)</div>
                            <div><b>L<sub>1</sub></b> Working length — the value you enter</div>
                            <div><b>L<sub>c</sub></b> Solid length — all coils touching</div>
                            <div><b>s<sub>1</sub></b> Deflection at L<sub>1</sub> = L<sub>0</sub> &minus; L<sub>1</sub></div>
                            <div><b>s<sub>c</sub></b> Deflection to solid = L<sub>0</sub> &minus; L<sub>c</sub></div>
                            <div><b>F<sub>1</sub></b> Force at L<sub>1</sub> — the working load</div>
                            <div><b>F<sub>c</sub></b> Force if compressed solid</div>
                        </SchematicHelp>
                    </label>
                    <div class="input-group">
                        <input type="number" step="0.1" @bind="assembledLength" placeholder="e.g. 40" />
                        <span class="unit">mm</span>
                    </div>
                    <small style="color: #6c757d; font-size: 12px;">Spring length at the static working position (under constant load)</small>
                </div>
            }
            else
            {
                <!-- Dynamic: oscillates between L1 (preload) and L2 (max compression) -->
                <div class="form-group">
                    <label>
                        Assembled Length — L₁ <span style="color: #e74c3c;">*</span>
                        <SchematicHelp Src="schematics/compression-spring/03b-lengths-dynamic.svg"
                                       Width="1040" Height="460"
                                       Title="Lengths, Deflections and Forces — Dynamic Load">
                            <div><b>L<sub>0</sub></b> Free length (unloaded)</div>
                            <div><b>L<sub>1</sub></b> Assembled length — preload position</div>
                            <div><b>L<sub>2</sub></b> Compressed length — max compression</div>
                            <div><b>L<sub>c</sub></b> Solid length — all coils touching</div>
                            <div><b>s<sub>1</sub>, s<sub>2</sub></b> Deflections at L<sub>1</sub> and L<sub>2</sub></div>
                            <div><b>s<sub>c</sub></b> Deflection to solid = L<sub>0</sub> &minus; L<sub>c</sub></div>
                            <div><b>F<sub>1</sub>, F<sub>2</sub></b> Forces at L<sub>1</sub> and L<sub>2</sub></div>
                            <div><b>F<sub>c</sub></b> Force if compressed solid</div>
                            <div class="full">
                                The spring cycles between L<sub>1</sub> and L<sub>2</sub>; the stroke
                                s<sub>h</sub> = L<sub>1</sub> &minus; L<sub>2</sub> drives the fatigue check.
                            </div>
                        </SchematicHelp>
                    </label>
                    <div class="input-group">
                        <input type="number" step="0.1" @bind="assembledLength" placeholder="e.g. 45" />
                        <span class="unit">mm</span>
                    </div>
                    <small style="color: #6c757d; font-size: 12px;">Spring length at preload / minimum compression position</small>
                </div>
                <div class="form-group">
                    <label>Compressed Length — L₂ <span style="color: #e74c3c;">*</span></label>
                    <div class="input-group">
                        <input type="number" step="0.1" @bind="compressedLength" placeholder="e.g. 35" />
                        <span class="unit">mm</span>
                    </div>
                    <small style="color: #6c757d; font-size: 12px;">Spring length at maximum compression position</small>
                </div>
            }

        </div>
    </div>

    <ValidationAlert Messages="validationMessages" />

    <div class="button-group">
        <button class="btn btn-success btn-lg @(isCalculating ? "btn-calculating" : "")"
                @onclick="Calculate" disabled="@isCalculating">
            @if (isCalculating)
            {
                <span class="spinner"></span>
                <span>Calculating...</span>
            }
            else
            {
                <ModuleIcon Type="calculate" Size="button" Style="default" />
                <span>Calculate</span>
            }
        </button>
        <button class="btn btn-secondary" @onclick="ClearForm" disabled="@isCalculating">
            <ModuleIcon Type="clear" Size="button" Style="default" /> Clear
        </button>
    </div>
}
else
{
    <!-- RESULTS -->
    <div class="button-group" style="margin-bottom: 24px;">
        <button class="btn btn-secondary" @onclick="BackToInput">
            <ModuleIcon Type="back" Size="button" Style="default" /> Back to Input
        </button>
        <button class="btn btn-secondary" @onclick="ClearForm">
            <ModuleIcon Type="new" Size="button" Style="default" /> New Calculation
        </button>
        <button class="btn btn-info @(isSavingPdf ? "btn-saving" : "")" @onclick="SaveAsPdf" disabled="@isSavingPdf">
            @if (isSavingPdf)
            {
                <span class="spinner"></span>
                <span>Generating PDF...</span>
            }
            else
            {
                <ModuleIcon Type="pdf" Size="button" Style="default" />
                <span>Save as PDF</span>
            }
        </button>
        <Viewer3D Module="compression-spring" Parameters="@Build3dParameters()" />
        <ShareCalculation Module="compression-spring" State="@BuildShareState()" />
        <SaveCalculation Module="compression-spring" State="@BuildShareState()" />
    </div>

    @if (openedFromSharedLink)
    {
        <div class="alert alert-info" style="margin-bottom: 24px;">
            <ModuleIcon Type="info" Size="small" Style="default" />
            <div>
                <strong>Opened from a shared link.</strong>
                The inputs below came from the link and were recalculated with the current engine.
            </div>
        </div>
    }

    <div id="results-content">

    <!-- Geometry Results -->
    <div class="card">
        <div class="card-header">
            <ModuleIcon Type="geometry" Size="medium" Style="solid" />
            <h2>Spring Geometry</h2>
        </div>
        <table class="results-table">
            <thead><tr><th>Description</th><th>Symbol</th><th>Value</th><th>Unit</th></tr></thead>
            <tbody>
                <tr><td>Wire Diameter</td><td>d</td><td>@engine.WireDiameter.ToString("F1")</td><td>mm</td></tr>
                <tr><td>Mean Coil Diameter</td><td>D<sub>m</sub></td><td>@engine.MeanCoilDiameter.ToString("F1")</td><td>mm</td></tr>
                <tr><td>Outer Diameter</td><td>D<sub>e</sub></td><td>@engine.OuterDiameter.ToString("F1")</td><td>mm</td></tr>
                <tr><td>Inner Diameter</td><td>D<sub>i</sub></td><td>@engine.InnerDiameter.ToString("F1")</td><td>mm</td></tr>
                <tr class="highlight"><td>Spring Index</td><td>w</td><td>@engine.SpringIndex.ToString("F2")</td><td>-</td></tr>
                <tr><td>Active Coils</td><td>n</td><td>@engine.ActiveCoils.ToString("F1")</td><td>coils</td></tr>
                <tr><td>Total Coils</td><td>n<sub>t</sub></td><td>@engine.TotalCoils.ToString("F1")</td><td>coils</td></tr>
                <tr><td>Free Length</td><td>L<sub>0</sub></td><td>@engine.FreeLength.ToString("F1")</td><td>mm</td></tr>
                <tr class="highlight"><td>Solid Length</td><td>L<sub>c</sub></td><td>@engine.SolidLength.ToString("F1")</td><td>mm</td></tr>
                <tr><td>Coil Pitch</td><td>p</td><td>@engine.CoilPitch.ToString("F2")</td><td>mm</td></tr>
                <tr><td>Wire Length</td><td>L<sub>d</sub></td><td>@engine.WireLength.ToString("F0")</td><td>mm</td></tr>
                <tr><td>Spring Mass</td><td>m</td><td>@engine.SpringMass.ToString("F1")</td><td>g</td></tr>
                <tr><td>Natural Frequency</td><td>f<sub>e</sub></td><td>@engine.NaturalFrequency.ToString("F0")</td><td>Hz</td></tr>
            </tbody>
        </table>
    </div>

    <!-- Mechanical Properties -->
    <div class="card">
        <div class="card-header">
            <ModuleIcon Type="gear" Size="medium" Style="solid" />
            <h2>Mechanical Properties</h2>
        </div>
        <table class="results-table">
            <thead><tr><th>Description</th><th>Symbol</th><th>Value</th><th>Unit</th></tr></thead>
            <tbody>
                <tr class="highlight"><td>Spring Rate</td><td>R</td><td>@engine.SpringRateCalculated.ToString("F2")</td><td>N/mm</td></tr>
                <tr><td>Deflection to Solid Length</td><td>s<sub>c</sub></td><td>@engine.MaxDeflection.ToString("F1")</td><td>mm</td></tr>
                <tr class="highlight"><td>Force at Solid Length</td><td>F<sub>c</sub></td><td>@engine.MaxForce.ToString("F1")</td><td>N</td></tr>
            </tbody>
        </table>

        @if (assembledLength > 0)
        {
            <h4 style="color: #34495e; margin: 20px 0 12px 0; padding-left: 8px; border-left: 3px solid #3498db;">Working Conditions</h4>
            <table class="results-table">
                <thead><tr><th>Description</th><th>Symbol</th><th>Value</th><th>Unit</th></tr></thead>
                <tbody>
                    @if (loadType == "Static")
                    {
                        <tr><td>Working Length</td><td>L<sub>1</sub></td><td>@assembledLength.ToString("F1")</td><td>mm</td></tr>
                        <tr><td>Deflection</td><td>s<sub>1</sub></td><td>@deflection1.ToString("F2")</td><td>mm</td></tr>
                        <tr class="highlight"><td>Working Force</td><td>F<sub>1</sub></td><td>@force1.ToString("F1")</td><td>N</td></tr>
                        <tr class="@((assembledLength - engine.SolidLength) < 0 ? "danger" : (assembledLength - engine.SolidLength) < 2 ? "warning" : "")">
                            <td>Clearance to Solid</td><td>-</td>
                            <td>@((assembledLength - engine.SolidLength).ToString("F1"))</td><td>mm</td>
                        </tr>
                    }
                    else
                    {
                        <tr><td>Assembled Length (preload)</td><td>L<sub>1</sub></td><td>@assembledLength.ToString("F1")</td><td>mm</td></tr>
                        <tr><td>Deflection at L₁</td><td>s<sub>1</sub></td><td>@deflection1.ToString("F2")</td><td>mm</td></tr>
                        <tr class="highlight"><td>Preload Force</td><td>F<sub>1</sub></td><td>@force1.ToString("F1")</td><td>N</td></tr>
                        @if (compressedLength > 0)
                        {
                            <tr><td>Compressed Length (max)</td><td>L<sub>2</sub></td><td>@compressedLength.ToString("F1")</td><td>mm</td></tr>
                            <tr><td>Deflection at L₂</td><td>s<sub>2</sub></td><td>@deflection2.ToString("F2")</td><td>mm</td></tr>
                            <tr class="highlight"><td>Working Force (max)</td><td>F<sub>2</sub></td><td>@force2.ToString("F1")</td><td>N</td></tr>
                            <tr><td>Working Stroke</td><td>s<sub>h</sub></td><td>@((assembledLength - compressedLength).ToString("F1"))</td><td>mm</td></tr>
                            <tr class="highlight"><td>Force Difference</td><td>ΔF</td><td>@((force2 - force1).ToString("F1"))</td><td>N</td></tr>
                        }
                    }
                </tbody>
            </table>

            @* Over-compression is reported by the "Solid Length Clearance" row in the
               Design Guidelines card, which covers both load types; no banner repeated
               here. (The static branch above also colours its own clearance row.) *@
        }
    </div>

    <!-- Stress Analysis -->
    <div class="card">
        <div class="card-header">
            <ModuleIcon Type="stress" Size="medium" Style="solid" />
            <h2>Stress Analysis</h2>
        </div>

        <h4 style="color: #34495e; margin-bottom: 12px; padding-left: 8px; border-left: 3px solid #3498db;">Shear Stress at Operating Positions</h4>
        <table class="results-table">
            <thead><tr><th>Description</th><th>Symbol</th><th>Value</th><th>Unit</th></tr></thead>
            <tbody>
                @if (loadType == "Static")
                {
                    @if (assembledLength > 0)
                    {
                        <tr class="@(shearStress1 > engine.AllowableShearStress ? "warning" : "highlight")">
                            <td>At Working Length L₁</td><td>τ<sub>1</sub></td><td>@shearStress1.ToString("F0")</td><td>MPa</td>
                        </tr>
                    }
                }
                else
                {
                    @if (assembledLength > 0)
                    {
                        <tr><td>At Assembled Length L₁ (min)</td><td>τ<sub>1</sub></td><td>@shearStress1.ToString("F0")</td><td>MPa</td></tr>
                    }
                    @if (compressedLength > 0)
                    {
                        <tr class="@(shearStress2 > engine.AllowableShearStress ? "warning" : "highlight")">
                            <td>At Compressed Length L₂ (max)</td><td>τ<sub>2</sub></td><td>@shearStress2.ToString("F0")</td><td>MPa</td>
                        </tr>
                    }
                }
                <tr class="@(engine.ShearStressMax > engine.AllowableShearStress ? "warning" : "")"><td>At Solid Length</td><td>τ<sub>c</sub></td><td>@engine.ShearStressMax.ToString("F0")</td><td>MPa</td></tr>
                <tr><td>Allowable Shear Stress (0.45×R<sub>m</sub>)</td><td>τ<sub>zul</sub></td><td>@engine.AllowableShearStress.ToString("F0")</td><td>MPa</td></tr>
            </tbody>
        </table>

        <h4 style="color: #34495e; margin: 20px 0 12px 0; padding-left: 8px; border-left: 3px solid #3498db;">Correction Factors</h4>
        <table class="results-table">
            <thead><tr><th>Description</th><th>Symbol</th><th>Value</th><th>Unit</th></tr></thead>
            <tbody>
                <tr class="highlight"><td>Wahl Correction Factor</td><td>k</td><td>@engine.WahlFactor.ToString("F3")</td><td>-</td></tr>
                <tr><td>Spring Index (D<sub>m</sub>/d)</td><td>w</td><td>@engine.SpringIndex.ToString("F2")</td><td>-</td></tr>
            </tbody>
        </table>
    </div>

    <!-- Safety & Stability -->
    <div class="card">
        <div class="card-header">
            <ModuleIcon Type="safety" Size="medium" Style="solid" />
            <h2>Safety Factors & Stability</h2>
        </div>
        <table class="results-table">
            <thead><tr><th>Description</th><th>Symbol</th><th>Value</th><th>Status</th></tr></thead>
            <tbody>
                <tr class="@(staticSafetyFactor < 1.0 ? "danger" : staticSafetyFactor < 1.2 ? "warning" : "success")">
                    <td>Static Safety Factor</td>
                    <td>SF<sub>static</sub></td>
                    <td>@staticSafetyFactor.ToString("F2")</td>
                    <td>@(staticSafetyFactor < 1.0 ? "❌ FAIL" : staticSafetyFactor < 1.2 ? "⚠️ Low" : "✓ OK")</td>
                </tr>
                @* EN 13906-1 requires the spring to survive being pressed solid without
                   taking a permanent set (τc ≤ τzul). The engine has always computed this
                   but the page never showed it, so a spring that would yield at block
                   read "✓ OK" purely on its working-point stress.

                   Kept as its OWN row rather than folded into SF_static: the two answer
                   different questions, and merging them is what made SF_static confusing
                   before it was moved to the operating point. *@
                <tr class="@(engine.SafetyFactorSolid < 1.0 ? "danger" : engine.SafetyFactorSolid < 1.2 ? "warning" : "success")">
                    <td>Solid Length Safety Factor (if fully compressed)</td>
                    <td>SF<sub>c</sub></td>
                    <td>@engine.SafetyFactorSolid.ToString("F2")</td>
                    <td>@(engine.SafetyFactorSolid < 1.0 ? "❌ FAIL" : engine.SafetyFactorSolid < 1.2 ? "⚠️ Low" : "✓ OK")</td>
                </tr>
                <tr>
                    <td>Load Type</td>
                    <td>-</td>
                    <td>@(loadType == "Dynamic" ? "Dynamic (fatigue)" : "Static")</td>
                    <td>-</td>
                </tr>
                <tr>
                    <td>Safety Based On</td>
                    <td>-</td>
                    <td>@(loadType == "Static" ? (assembledLength > 0 ? "τ₁ at L₁" : "τc at Solid") : (compressedLength > 0 ? "τ₂ at L₂" : "τc at Solid"))</td>
                    <td>-</td>
                </tr>
                <tr>
                    <td>End Condition Factor</td>
                    <td>ν</td>
                    <td>@engine.EndConditionFactor.ToString("F1")</td>
                    <td>-</td>
                </tr>
                <tr class="@(engine.SlendernessRatio > 4 ? "warning" : "")">
                    <td>Slenderness Ratio (L₀/D<sub>m</sub>)</td>
                    <td>λ</td>
                    <td>@engine.SlendernessRatio.ToString("F2")</td>
                    <td>-</td>
                </tr>
                <tr class="@(engine.EffectiveSlenderness > 2.62 ? "warning" : "")">
                    <td>Effective Slenderness (λ/ν)</td>
                    <td>λ<sub>eff</sub></td>
                    <td>@engine.EffectiveSlenderness.ToString("F2")</td>
                    <td>@(engine.EffectiveSlenderness > 2.62 ? "⚠️ > 2.62" : "✓ OK")</td>
                </tr>
                <tr class="@(engine.BucklingRisk ? "warning" : "success")">
                    <td>Buckling Risk</td>
                    <td>-</td>
                    <td>@(engine.BucklingRisk ? "Yes — Guide Required" : "No")</td>
                    <td>@(engine.BucklingRisk ? "⚠️ Warning" : "✓ OK")</td>
                </tr>
            </tbody>
        </table>

        @* Per-section warning banners removed: the Design Guidelines card at the
           bottom already reports the same checks with a status and a recommendation. *@
    </div>
    
    <!-- Fatigue Analysis -->
    @if (loadType == "Dynamic" && assembledLength > 0 && compressedLength > 0)
    {
        <div class="card">
            <div class="card-header">
                <ModuleIcon Type="loading" Size="medium" Style="solid" />
                <h2>Fatigue Analysis (Goodman)</h2>
            </div>

            <table class="results-table">
                <thead><tr><th>Description</th><th>Symbol</th><th>Value</th><th>Unit</th></tr></thead>
                <tbody>
                    <tr><td>Minimum Stress</td><td>τ<sub>1</sub></td><td>@shearStress1.ToString("F0")</td><td>MPa</td></tr>
                    <tr><td>Maximum Stress</td><td>τ<sub>2</sub></td><td>@shearStress2.ToString("F0")</td><td>MPa</td></tr>
                    <tr class="highlight"><td>Mean Stress</td><td>τ<sub>m</sub></td><td>@meanStress.ToString("F0")</td><td>MPa</td></tr>
                    <tr class="highlight"><td>Stress Amplitude</td><td>τ<sub>a</sub></td><td>@stressAmplitude.ToString("F0")</td><td>MPa</td></tr>
                    <tr><td>Stress Ratio (τ₁/τ₂)</td><td>R</td><td>@stressRatio.ToString("F2")</td><td>-</td></tr>
                    <tr><td>Endurance Limit (@(engine.ShotPeened ? "peened, 0.38×Rm" : "unpeened, 0.30×Rm"))</td><td>τ<sub>e</sub></td><td>@fatigueEnduranceLimit.ToString("F0")</td><td>MPa</td></tr>
                </tbody>
            </table>

            <h4 style="color: #34495e; margin: 20px 0 12px 0; padding-left: 8px; border-left: 3px solid #3498db;">Fatigue Safety</h4>
            <table class="results-table">
                <thead><tr><th>Description</th><th>Symbol</th><th>Value</th><th>Status</th></tr></thead>
                <tbody>
                    <tr class="@(fatigueSafetyFactor < 1.0 ? "danger" : fatigueSafetyFactor < 1.5 ? "warning" : "success")">
                        <td>Fatigue Safety Factor</td>
                        <td>SF<sub>fatigue</sub></td>
                        <td>@fatigueSafetyFactor.ToString("F2")</td>
                        <td>@(fatigueSafetyFactor < 1.0 ? "❌ FAIL" : fatigueSafetyFactor < 1.5 ? "⚠️ Low" : "✓ OK")</td>
                    </tr>
                    <tr class="@(GetFatigueLifeClass())">
                        <td>Expected Cycles</td>
                        <td>N</td>
                        <td>@GetFatigueLifeText()</td>
                        <td>-</td>
                    </tr>
                </tbody>
            </table>

        </div>
    }

    <!-- Design Guidelines -->
    <div class="card">
        <div class="card-header">
            <ModuleIcon Type="info" Size="medium" Style="solid" />
            <h2>Design Guidelines</h2>
        </div>
        <table class="results-table">
            <thead><tr><th>Design Parameter</th><th>Current Value</th><th>Status</th><th>Recommendation</th></tr></thead>
            <tbody>
                <tr class="@(engine.SpringIndex < 4 || engine.SpringIndex > 12 ? "warning" : "success")">
                    <td>Spring Index (w)</td>
                    <td>@engine.SpringIndex.ToString("F1")</td>
                    <td>@(engine.SpringIndex < 4 ? "⚠️ Too Low" : engine.SpringIndex > 12 ? "⚠️ Too High" : "✓ OK")</td>
                    <td>@(engine.SpringIndex < 4 ? "Difficult to manufacture, high stress" : engine.SpringIndex > 12 ? "May tangle, prone to buckling" : "Recommended range 4-12")</td>
                </tr>
                <tr class="@(engine.ActiveCoils < 3 ? "warning" : "success")">
                    <td>Active Coils (n)</td>
                    <td>@engine.ActiveCoils.ToString("F1")</td>
                    <td>@(engine.ActiveCoils < 3 ? "⚠️ Low" : "✓ OK")</td>
                    <td>@(engine.ActiveCoils < 3 ? "Minimum 3 coils recommended" : "Adequate")</td>
                </tr>
                <tr class="@(engine.BucklingRisk ? "warning" : "success")">
                    <td>Buckling (λ/ν)</td>
                    <td>@engine.EffectiveSlenderness.ToString("F2")</td>
                    <td>@(engine.BucklingRisk ? "⚠️ Risk" : "✓ OK")</td>
                    @* λ/ν > 2.62 only makes buckling *possible*; it actually happens once the
                       deflection passes the critical value. Keep the three cases apart — the
                       middle one used to claim "λ/ν ≤ 2.62" while λ/ν was above it. *@
                    <td>
                        @(engine.BucklingRisk
                            ? "λ/ν > 2.62 and the deflection reaches the critical value - use a guide"
                            : engine.EffectiveSlenderness > 2.62
                                ? "λ/ν > 2.62, but the deflection stays below the critical value"
                                : "No buckling concern (λ/ν ≤ 2.62)")
                    </td>
                </tr>
                @{
                    // Clearance check: Static → against L1, Dynamic → against L2
                    double checkLength = loadType == "Static" ? assembledLength : compressedLength;
                    string checkLabel = loadType == "Static" ? "Enter L₁ to check" : "Enter L₂ to check";
                }
                @if (checkLength > 0)
                {
                    var clearance = checkLength - engine.SolidLength;
                    <tr class="@(clearance < 0 ? "danger" : clearance < 2 ? "warning" : "success")">
                        <td>Solid Length Clearance</td>
                        <td>@clearance.ToString("F1") mm</td>
                        <td>@(clearance < 0 ? "❌ FAIL" : clearance < 2 ? "⚠️ Tight" : "✓ OK")</td>
                        <td>@(clearance < 0 ? "Over-compressed!" : clearance < 2 ? "Very tight clearance" : "Adequate clearance")</td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td>Solid Length Clearance</td>
                        <td>-</td>
                        <td>-</td>
                        <td>@checkLabel</td>
                    </tr>
                }
                @* The clearance row above says whether the spring REACHES solid; this one
                   says whether it would survive getting there. Both matter: a spring with
                   generous clearance today still yields the first time anything
                   over-travels, and EN 13906-1 asks for τc ≤ τzul regardless. *@
                <tr class="@(engine.ShearStressMax > engine.AllowableShearStress ? "danger" : engine.SafetyFactorSolid < 1.2 ? "warning" : "success")">
                    <td>Stress at Solid Length (τ<sub>c</sub> vs τ<sub>zul</sub>)</td>
                    <td>@engine.ShearStressMax.ToString("F0") / @engine.AllowableShearStress.ToString("F0") MPa</td>
                    <td>@(engine.ShearStressMax > engine.AllowableShearStress ? "❌ FAIL" : engine.SafetyFactorSolid < 1.2 ? "⚠️ Tight" : "✓ OK")</td>
                    <td>
                        @(engine.ShearStressMax > engine.AllowableShearStress
                            ? "Spring takes a permanent set if pressed solid — increase d, reduce Dm, or add coils"
                            : engine.SafetyFactorSolid < 1.2
                                ? "Little margin against being pressed solid"
                                : "Safe to compress to solid length (EN 13906-1)")
                    </td>
                </tr>
                <tr class="@(Math.Atan(engine.CoilPitch / (Math.PI * engine.MeanCoilDiameter)) * 180 / Math.PI > 12 ? "warning" : "success")">
                    <td>Pitch Angle</td>
                    <td>@((Math.Atan(engine.CoilPitch / (Math.PI * engine.MeanCoilDiameter)) * 180 / Math.PI).ToString("F1"))°</td>
                    <td>@(Math.Atan(engine.CoilPitch / (Math.PI * engine.MeanCoilDiameter)) * 180 / Math.PI > 12 ? "⚠️ High" : "✓ OK")</td>
                    <td>@(Math.Atan(engine.CoilPitch / (Math.PI * engine.MeanCoilDiameter)) * 180 / Math.PI > 12 ? "> 12° may affect spring rate accuracy" : "Within acceptable range")</td>
                </tr>
            </tbody>
        </table>
    </div>

    </div>
}


