<ModuleContent Module="clamp-connection" />

@code {
    private ClampConnectionEngine engine = new();
    /// <summary>Why Calculate refused, shown by <see cref="ValidationAlert"/>.</summary>
    private List<string> validationMessages = new();
    private List<Material> materials = new();
    private ModuleInfo moduleInfo = new();
    private bool showResults = false;
    private bool isCalculating = false;
    private bool isSavingPdf = false;
    private ClampDimension? recommendedClamp = null;

    private string selectedLoadFactor = "1.0";
    private string selectedFriction = "0.15";
    private string selectedBoltSize = "8";
    private string selectedBoltClass = "8.8";
    private double recommendedTorque = 0;

    private int selectedShaftMaterialIndex = 2;
    private int selectedHubMaterialIndex = 2;
    private bool openedFromSharedLink = false;

    /// <summary>Load factors offered by the dropdown. A shared link carrying anything else falls back to 1.0.</summary>
    private static readonly string[] LoadFactorOptions = { "1.0", "1.25", "1.5", "1.75", "2.0" };

    protected override async Task OnInitializedAsync()
    {
        // Load materials
        materials = MaterialService.GetMaterials();
        engine.LoadFactor = 1.0;
        engine.NumberOfBolts = 1;
        engine.FrictionCoefficientInterface = 0.15;
        engine.BoltDiameter = 8;
        engine.BoltYieldStrength = 640; // 8.8 class
        UpdateRecommendedTorque();

        // Load module metadata
        moduleInfo = Metadata.GetModule("clamp-connection");

        // Set SEO metadata
        await SetSeoMetadata();

        // Set structured data
        await SetStructuredData();

        // Track page view
        await Analytics.TrackPageView("/clamp-connection", moduleInfo.Name);
    }

    private async Task SetSeoMetadata()
    {
        var baseUrl = "https://mekanika.org";
        var seo = new SeoMetadata
        {
            Title = $"{moduleInfo.Name} - Free Online Tool | Mekanika",
            Description = moduleInfo.Description,
            Keywords = moduleInfo.Keywords,
            CanonicalUrl = $"{baseUrl}{moduleInfo.Route}",
            OgTitle = moduleInfo.Name,
            OgDescription = moduleInfo.Description,
            OgImage = $"{baseUrl}/logo.png",
            OgUrl = $"{baseUrl}{moduleInfo.Route}",
            TwitterCard = "summary",
            TwitterTitle = moduleInfo.Name,
            TwitterDescription = moduleInfo.Description,
            TwitterImage = $"{baseUrl}/logo.png"
        };

        await Seo.SetMetaTags(seo);
    }

    private async Task SetStructuredData()
    {
        try
        {
            var structuredData = new
            {
                context = "https://schema.org",
                type = "SoftwareApplication",
                name = moduleInfo.Name,
                description = moduleInfo.Description,
                applicationCategory = "EngineeringApplication",
                operatingSystem = "Web Browser",
                browserRequirements = "Requires JavaScript, WebAssembly support",
                offers = new
                {
                    type = "Offer",
                    price = "0",
                    priceCurrency = "USD"
                },
                featureList = new[]
                {
                    "Standards-based calculations",
                    "PDF export",
                    "No registration required",
                    "Privacy-focused (client-side)"
                },
                screenshot = $"https://mekanika.org/screenshots/{moduleInfo.Key}.png"
            };

            await JSRuntime.InvokeVoidAsync("setStructuredData", structuredData);
        }
        catch
        {
            // Fail silently - structured data is not critical
        }
    }

    private void OnShaftDiameterChanged()
    {
        recommendedClamp = ClampConnectionEngine.GetStandardClamp(engine.ShaftDiameter);
    }

    private void ApplyRecommendedClamp()
    {
        if (recommendedClamp != null)
        {
            engine.ClampOuterDiameter = recommendedClamp.OuterDia;
            engine.ClampLength = recommendedClamp.Length;
            engine.SlitWidth = recommendedClamp.SlitWidth;
            selectedBoltSize = recommendedClamp.BoltSize.ToString();
            engine.BoltDiameter = recommendedClamp.BoltSize;
            UpdateRecommendedTorque();
        }
    }

    private void OnLoadFactorChanged()
    {
        if (double.TryParse(selectedLoadFactor, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out double factor))
            engine.LoadFactor = factor;
    }

    private void OnFrictionChanged()
    {
        if (double.TryParse(selectedFriction, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out double mu))
            engine.FrictionCoefficientInterface = mu;
    }

    private void OnBoltSizeChanged()
    {
        if (double.TryParse(selectedBoltSize, out double size))
        {
            engine.BoltDiameter = size;
            UpdateRecommendedTorque();
        }
    }

    private void OnBoltClassChanged()
    {
        engine.BoltYieldStrength = selectedBoltClass switch
        {
            "8.8" => 640,
            "10.9" => 900,
            "12.9" => 1080,
            _ => 640
        };
        UpdateRecommendedTorque();
    }

    private void UpdateRecommendedTorque()
    {
        // Recommended tightening torque at 70% of yield
        if (ClampConnectionEngine.BoltData.TryGetValue(engine.BoltDiameter, out var boltInfo))
        {
            double stressArea = boltInfo.StressArea;
            double targetPreload = 0.7 * engine.BoltYieldStrength * stressArea; // N
            // MA ≈ 0.2 × d × F for standard steel-steel contact
            recommendedTorque = 0.2 * engine.BoltDiameter * targetPreload / 1000; // Nm
        }
    }

    private string GetSafetyRowClass(double sf) => sf < 1.0 ? "danger" : sf < 1.5 ? "warning" : "success";
    private string GetSafetyStatus(double sf) => sf < 1.0 ? "❌ FAIL" : sf < 1.5 ? "⚠️ Marginal" : "✓ OK";

    private async Task Calculate()
    {
        isCalculating = true;
        StateHasChanged();
        await Task.Delay(350);
        try
        {
            // Input validation - name what is missing rather than returning in silence.
            validationMessages.Clear();
            if (engine.ShaftDiameter <= 0) validationMessages.Add("Shaft diameter (d) must be greater than 0.");
            if (engine.ClampOuterDiameter <= 0) validationMessages.Add("Hub outer diameter (Da) must be greater than 0.");
            if (engine.ClampLength <= 0) validationMessages.Add("Hub length (L) must be greater than 0.");
            if (engine.BoltTighteningTorque <= 0) validationMessages.Add("Bolt tightening torque (MA) must be greater than 0.");
            if (engine.ClampOuterDiameter > 0 && engine.ShaftDiameter > 0 && engine.ClampOuterDiameter <= engine.ShaftDiameter)
                validationMessages.Add($"Hub outer diameter (Da) must be larger than the shaft diameter ({engine.ShaftDiameter:F1} mm) — the clamp needs a wall.");
            if (engine.SlitWidth < 0)
                validationMessages.Add("Slit width (b) cannot be negative.");
            else if (engine.ShaftDiameter > 0 && engine.SlitWidth >= engine.ShaftDiameter)
                validationMessages.Add($"Slit width (b) must be well below the shaft diameter ({engine.ShaftDiameter:F1} mm). At b = d the clamp wraps only half the shaft; in practice b is a few millimetres.");
            if (engine.BoltDiameter <= 0) validationMessages.Add("Bolt diameter must be greater than 0.");
            if (engine.BoltYieldStrength <= 0) validationMessages.Add("Bolt yield strength must be greater than 0.");
            if (engine.FrictionCoefficientInterface <= 0) validationMessages.Add("The interface friction coefficient must be greater than 0.");
            if (engine.FrictionCoefficientThread <= 0) validationMessages.Add("The thread friction coefficient must be greater than 0.");
            if (engine.NumberOfBolts <= 0) validationMessages.Add("At least one bolt is needed.");

            // Room for the bolt itself. These are practical minima, not a standard:
            // the module models neither the bolt hole nor the wall around it, so a
            // geometry it cannot physically accommodate has to be refused here.
            if (engine.BoltDiameter > 0 && engine.ClampOuterDiameter > engine.ShaftDiameter && engine.ShaftDiameter > 0)
            {
                double wall = (engine.ClampOuterDiameter - engine.ShaftDiameter) / 2.0;
                if (wall < engine.BoltDiameter)
                    validationMessages.Add($"The clamp wall is only {wall:F1} mm thick, which cannot house an M{engine.BoltDiameter:F0} bolt. Increase Da to at least {engine.ShaftDiameter + 2 * engine.BoltDiameter:F0} mm.");
            }
            if (engine.BoltDiameter > 0 && engine.ClampLength > 0 && engine.ClampLength < 2 * engine.BoltDiameter)
                validationMessages.Add($"A clamp {engine.ClampLength:F1} mm long has no room for an M{engine.BoltDiameter:F0} bolt hole and its edge distance. Use at least {2 * engine.BoltDiameter:F0} mm.");

            if (validationMessages.Count > 0)
            {
                await Analytics.TrackCalculationError("clamp-connection", "validation_error", string.Join("; ", validationMessages));
                return;
            }

            // Perform calculation
            engine.ShaftMaterial = materials[selectedShaftMaterialIndex];
            engine.HubMaterial = materials[selectedHubMaterialIndex];
            engine.Calculate();
            showResults = true;

            // Track successful calculation
            await Analytics.TrackCalculationCompleted("clamp-connection", new Dictionary<string, object>
            {
                { "shaft_diameter", engine.ShaftDiameter },
                { "clamp_outer_diameter", engine.ClampOuterDiameter },
                { "number_of_bolts", engine.NumberOfBolts },
                { "safety_factor_min", engine.SafetyFactorMin }
            });
        }
        catch (Exception ex)
        {
            await Analytics.TrackCalculationError("clamp-connection", "calculation_failed", ex.Message);
            throw;
        }
        finally
        {
            isCalculating = false;
        }
    }

    private void BackToInput() => showResults = false;

    private void ClearForm()
    {
        validationMessages.Clear();
        engine = new ClampConnectionEngine
        {
            LoadFactor = 1.0,
            NumberOfBolts = 1,
            FrictionCoefficientInterface = 0.15,
            BoltDiameter = 8,
            BoltYieldStrength = 640
        };
        recommendedClamp = null;
        selectedLoadFactor = "1.0";
        selectedFriction = "0.15";
        selectedBoltSize = "8";
        selectedBoltClass = "8.8";
        showResults = false;
        openedFromSharedLink = false;
        UpdateRecommendedTorque();
    }

    // Option sets a shared link is validated against, so a hand-edited or stale link
    // cannot leave a dropdown rendering blank.
    private static readonly string[] FrictionOptions = { "0.12", "0.15", "0.18", "0.20" };
    private static readonly string[] BoltSizeOptions = { "5", "6", "8", "10", "12", "14", "16", "18", "20" };
    private static readonly string[] BoltClassOptions = { "8.8", "10.9", "12.9" };

    /// <summary>
    /// The module's inputs in the neutral form used by shareable links (and, later,
    /// cloud-saved calculations). Inputs only — results are recomputed on restore.
    ///
    /// Materials go in by name rather than by their index in MaterialService, so
    /// adding a material to that list cannot repoint existing links at the wrong
    /// steel. Keys are kept short because the whole state rides in a URL.
    /// </summary>
    private CalculationState BuildShareState() => new CalculationState("clamp-connection")
        .Set("d", engine.ShaftDiameter)
        .Set("Da", engine.ClampOuterDiameter)
        .Set("L", engine.ClampLength)
        .Set("b", engine.SlitWidth)
        .Set("bs", selectedBoltSize)
        .Set("nb", engine.NumberOfBolts)
        .Set("MA", engine.BoltTighteningTorque)
        .Set("bc", selectedBoltClass)
        .Set("T", engine.AppliedTorque)
        .Set("Fa", engine.AppliedAxialForce)
        .Set("phi", selectedLoadFactor)
        .Set("mu", selectedFriction)
        .Set("ms", MaterialNameAt(selectedShaftMaterialIndex))
        .Set("mh", MaterialNameAt(selectedHubMaterialIndex));

    /// <summary>
    /// Restores state produced by <see cref="BuildShareState"/>, then recalculates so
    /// the recipient lands straight on the results.
    ///
    /// Every read supplies the current value as its fallback, so a link written by an
    /// older build that lacked a field leaves that field at its default instead of
    /// zeroing it.
    /// </summary>
    private async Task ApplyShareState(CalculationState state)
    {
        engine.ShaftDiameter = state.GetDouble("d", engine.ShaftDiameter);
        engine.ClampOuterDiameter = state.GetDouble("Da", engine.ClampOuterDiameter);
        engine.ClampLength = state.GetDouble("L", engine.ClampLength);
        engine.SlitWidth = state.GetDouble("b", engine.SlitWidth);
        engine.NumberOfBolts = state.GetInt("nb", engine.NumberOfBolts);
        engine.BoltTighteningTorque = state.GetDouble("MA", engine.BoltTighteningTorque);
        engine.AppliedTorque = state.GetDouble("T", engine.AppliedTorque);
        engine.AppliedAxialForce = state.GetDouble("Fa", engine.AppliedAxialForce);

        // Driven selects: set the field, then run its handler so the derived engine
        // value follows. Each is validated against its option set so an unknown value
        // cannot leave the dropdown blank.
        var bs = state.GetString("bs", selectedBoltSize);
        selectedBoltSize = BoltSizeOptions.Contains(bs) ? bs : selectedBoltSize;
        OnBoltSizeChanged();

        var bc = state.GetString("bc", selectedBoltClass);
        selectedBoltClass = BoltClassOptions.Contains(bc) ? bc : selectedBoltClass;
        OnBoltClassChanged();

        var phi = state.GetString("phi", selectedLoadFactor);
        selectedLoadFactor = LoadFactorOptions.Contains(phi) ? phi : "1.0";
        OnLoadFactorChanged();

        var mu = state.GetString("mu", selectedFriction);
        selectedFriction = FrictionOptions.Contains(mu) ? mu : selectedFriction;
        OnFrictionChanged();

        selectedShaftMaterialIndex = MaterialIndexByName(state.GetString("ms"), selectedShaftMaterialIndex);
        selectedHubMaterialIndex = MaterialIndexByName(state.GetString("mh"), selectedHubMaterialIndex);

        // Keep the "recommended clamp" hint consistent with the restored diameter.
        OnShaftDiameterChanged();

        openedFromSharedLink = true;

        // Calculate() validates, so a damaged link just leaves the user on the form.
        await Calculate();
    }

    private string MaterialNameAt(int index)
        => index >= 0 && index < materials.Count ? materials[index].Name : "";

    /// <summary>Resolves a material name to its current index, falling back when it is unknown.</summary>
    private int MaterialIndexByName(string name, int fallback)
    {
        if (string.IsNullOrEmpty(name)) return fallback;

        var index = materials.FindIndex(m => string.Equals(m.Name, name, StringComparison.OrdinalIgnoreCase));
        return index >= 0 ? index : fallback;
    }

    private async Task SaveAsPdf()
    {
        isSavingPdf = true;
        StateHasChanged();
        try
        {
            await JSRuntime.InvokeVoidAsync("generatePdf", "results-content", $"ClampConnection-Report-{DateTime.Now:yyyyMMdd_HHmmss}.pdf");
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("console.error", $"PDF generation error: {ex.Message}");
        }
        finally
        {
            isSavingPdf = false;
        }
    }
}
