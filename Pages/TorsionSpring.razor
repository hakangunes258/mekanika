@page "/torsion-spring"
@using MechanicalCalculatorWeb.Services
@inject AnalyticsService Analytics
@inject SeoService Seo
@inject ModuleMetadataService Metadata
@inject IJSRuntime JSRuntime

<PageTitle>Torsion Spring Calculator - Mekanika</PageTitle>

<div class="page-header">
    <h1><ModuleIcon Type="torsion-spring" Size="large" Style="transparent" CustomStyle="margin-right: 12px;" /> Helical Torsion Spring Calculator</h1>
    <p>Torsion spring design according to EN 13906-3</p>
</div>

<SharedCalculationLoader Module="torsion-spring" OnRestore="ApplyShareState" />

@if (!showResults)
{
    <!-- INPUT FORM -->
    <div class="form-grid">
        <!-- Geometry Card -->
        <div class="card">
            <div class="card-header">
                <ModuleIcon Type="geometry" Size="medium" Style="solid" />
                <h2>Spring Geometry</h2>
            </div>

            <div class="form-group">
                <label>Wire Diameter (d)</label>
                <div class="input-group">
                    <select @bind="engine.WireDiameter" style="flex: 1; padding: 10px; border: 1px solid #ced4da; border-radius: 8px 0 0 8px;">
                        <option value="0">-- Select --</option>
                        @foreach (var d in TorsionSpringEngine.StandardWireDiameters)
                        {
                            <option value="@d">@d</option>
                        }
                    </select>
                    <span class="unit">mm</span>
                </div>
            </div>

            <div class="form-group">
                <label>Mean Coil Diameter (Dm)</label>
                <div class="input-group">
                    <input type="number" step="0.1" @bind="engine.MeanCoilDiameter" placeholder="e.g. 15" />
                    <span class="unit">mm</span>
                </div>
            </div>

            <div class="form-group">
                <label>Active Coils (n)</label>
                <div class="input-group">
                    <input type="number" step="0.5" @bind="engine.ActiveCoils" placeholder="e.g. 5" />
                    <span class="unit">coils</span>
                </div>
            </div>

            <div class="form-group">
                <label>Winding Direction</label>
                <select @bind="engine.WindingDirection">
                    <option value="Right">Right-hand (clockwise)</option>
                    <option value="Left">Left-hand (counter-clockwise)</option>
                </select>
                <small style="color: #6c757d; font-size: 12px;">Wind in direction of applied torque for closing spring</small>
            </div>
        </div>

        <!-- Legs Card -->
        <div class="card">
            <div class="card-header">
                <ModuleIcon Type="dimensions" Size="medium" Style="solid" />
                <h2>Leg Configuration</h2>
            </div>

            <div class="form-group">
                <label>Leg Type</label>
                <select @bind="engine.LegType">
                    @foreach (var leg in TorsionSpringEngine.LegTypes)
                    {
                        <option value="@leg.Key">@leg.Value.Description</option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label>Leg 1 Length (L₁)</label>
                <div class="input-group">
                    <input type="number" step="0.1" @bind="engine.Leg1Length" placeholder="e.g. 20" />
                    <span class="unit">mm</span>
                </div>
            </div>

            <div class="form-group">
                <label>Leg 2 Length (L₂)</label>
                <div class="input-group">
                    <input type="number" step="0.1" @bind="engine.Leg2Length" placeholder="e.g. 20" />
                    <span class="unit">mm</span>
                </div>
            </div>
        </div>

        <!-- Material Card -->
        <div class="card">
            <div class="card-header">
                <ModuleIcon Type="material" Size="medium" Style="solid" />
                <h2>Material</h2>
            </div>

            <div class="form-group">
                <label>Material Grade</label>
                <select @bind="selectedMaterial" @bind:after="OnMaterialChanged">
                    @foreach (var mat in TorsionSpringEngine.Materials)
                    {
                        <option value="@mat.Key">@mat.Value.Name</option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label>Elastic Modulus (E)</label>
                <div class="input-group">
                    <input type="number" step="1000" @bind="engine.ElasticModulus" />
                    <span class="unit">MPa</span>
                </div>
            </div>

            <div class="form-group">
                <label>Tensile Strength (Rm)</label>
                <div class="input-group">
                    <input type="number" step="10" @bind="engine.TensileStrength" />
                    <span class="unit">MPa</span>
                </div>
            </div>
        </div>

        <!-- Operating Conditions Card -->
        <div class="card">
            <div class="card-header">
                <ModuleIcon Type="force" Size="medium" Style="solid" />
                <h2>Operating Conditions</h2>
            </div>

            <p style="font-size: 13px; color: #6c757d; margin-bottom: 16px;">
                Enter angular deflections to calculate torques and stresses at each position.
            </p>

            <div class="form-group">
                <label>Position 1 - Deflection Angle (α₁)</label>
                <div class="input-group">
                    <input type="number" step="1" @bind="engine.Angle1Input" placeholder="e.g. 30" />
                    <span class="unit">°</span>
                </div>
                <small style="color: #6c757d; font-size: 12px;">Preload position (minimum operating angle)</small>
            </div>

            <div class="form-group">
                <label>Position 2 - Deflection Angle (α₂)</label>
                <div class="input-group">
                    <input type="number" step="1" @bind="engine.Angle2Input" placeholder="e.g. 90" />
                    <span class="unit">°</span>
                </div>
                <small style="color: #6c757d; font-size: 12px;">Maximum operating angle</small>
            </div>

            @if (engine.MeanCoilDiameter > 0 && engine.WireDiameter > 0 && engine.ActiveCoils > 0)
            {
                var tempRate = (engine.ElasticModulus * Math.Pow(engine.WireDiameter, 4)) /
                               (3667 * engine.MeanCoilDiameter * engine.ActiveCoils);
                <div class="info-box" style="padding: 12px; background: #e8f4fc; border-radius: 8px; font-size: 13px;">
                    <strong>Estimated values:</strong><br />
                    @if (engine.Angle1Input > 0)
                    {
                        <text>M₁ ≈ @((tempRate * engine.Angle1Input).ToString("F1")) Nmm (@((tempRate * engine.Angle1Input / 1000).ToString("F3")) Nm)<br /></text>
                    }
                    @if (engine.Angle2Input > 0)
                    {
                        <text>M₂ ≈ @((tempRate * engine.Angle2Input).ToString("F1")) Nmm (@((tempRate * engine.Angle2Input / 1000).ToString("F3")) Nm)</text>
                    }
                </div>
            }
        </div>
    </div>

    <ValidationAlert Messages="validationMessages" />

    <div class="button-group">
        <button class="btn btn-success btn-lg @(isCalculating ? "btn-calculating" : "")" @onclick="Calculate" disabled="@isCalculating">
            @if (isCalculating)
            {
                <span class="spinner"></span>
                <span>Calculating...</span>
            }
            else
            {
                <ModuleIcon Type="calculate" Size="button" Style="default" />
                <span>Calculate</span>
            }
        </button>
        <button class="btn btn-secondary" @onclick="ClearForm" disabled="@isCalculating">
            <ModuleIcon Type="clear" Size="button" Style="default" /> Clear
        </button>
    </div>
}
else
{
    <!-- RESULTS -->
    <div class="button-group" style="margin-bottom: 24px;">
        <button class="btn btn-secondary" @onclick="BackToInput">
            <ModuleIcon Type="back" Size="button" Style="default" /> Back to Input
        </button>
        <button class="btn btn-secondary" @onclick="ClearForm">
            <ModuleIcon Type="new" Size="button" Style="default" /> New Calculation
        </button>
        <button class="btn btn-info @(isSavingPdf ? "btn-saving" : "")" @onclick="SaveAsPdf" disabled="@isSavingPdf">
            @if (isSavingPdf)
            {
                <span class="spinner"></span>
                <span>Generating PDF...</span>
            }
            else
            {
                <ModuleIcon Type="pdf" Size="button" Style="default" />
                <span>Save as PDF</span>
            }
        </button>
        <ShareCalculation Module="torsion-spring" State="@BuildShareState()" />
        <SaveCalculation Module="torsion-spring" State="@BuildShareState()" />
    </div>

    @if (openedFromSharedLink)
    {
        <div class="alert alert-info" style="margin-bottom: 24px;">
            <ModuleIcon Type="info" Size="small" Style="default" />
            <div>
                <strong>Opened from a shared link.</strong>
                The inputs below came from the link and were recalculated with the current engine.
            </div>
        </div>
    }

    <!-- Validation Warnings -->
    @if (validationErrors.Any())
    {
        <div class="alert alert-warning" style="margin-bottom: 24px;">
            <ModuleIcon Type="safety" Size="small" Style="default" />
            <div>
                <strong>Design Warnings:</strong>
                <ul style="margin: 8px 0 0 0; padding-left: 20px;">
                    @foreach (var error in validationErrors)
                    {
                        <li>@error</li>
                    }
                </ul>
            </div>
        </div>
    }

    <div id="results-content">
        <!-- Geometry Results -->
        <div class="card">
            <div class="card-header">
                <ModuleIcon Type="geometry" Size="medium" Style="solid" />
                <h2>Spring Geometry</h2>
            </div>
            <table class="results-table">
                <thead><tr><th>Description</th><th>Symbol</th><th>Value</th><th>Unit</th></tr></thead>
                <tbody>
                    <tr><td>Wire Diameter</td><td>d</td><td>@engine.WireDiameter.ToString("F2")</td><td>mm</td></tr>
                    <tr><td>Mean Coil Diameter</td><td>D<sub>m</sub></td><td>@engine.MeanCoilDiameter.ToString("F1")</td><td>mm</td></tr>
                    <tr><td>Outer Diameter</td><td>D<sub>e</sub></td><td>@engine.OuterDiameter.ToString("F1")</td><td>mm</td></tr>
                    <tr><td>Inner Diameter (free)</td><td>D<sub>i</sub></td><td>@engine.InnerDiameter.ToString("F1")</td><td>mm</td></tr>
                    <tr class="highlight"><td>Spring Index</td><td>w</td><td>@engine.SpringIndex.ToString("F2")</td><td>-</td></tr>
                    <tr><td>Active Coils</td><td>n</td><td>@engine.ActiveCoils.ToString("F1")</td><td>coils</td></tr>
                    <tr><td>Total Coils</td><td>n<sub>t</sub></td><td>@engine.TotalCoils.ToString("F1")</td><td>coils</td></tr>
                    <tr><td>Body Length</td><td>L<sub>k</sub></td><td>@engine.BodyLength.ToString("F1")</td><td>mm</td></tr>
                    <tr><td>Leg 1 Length</td><td>L<sub>1</sub></td><td>@engine.Leg1Length.ToString("F1")</td><td>mm</td></tr>
                    <tr><td>Leg 2 Length</td><td>L<sub>2</sub></td><td>@engine.Leg2Length.ToString("F1")</td><td>mm</td></tr>
                    <tr><td>Wire Length</td><td>L<sub>d</sub></td><td>@engine.WireLength.ToString("F0")</td><td>mm</td></tr>
                    <tr><td>Spring Mass</td><td>m</td><td>@engine.SpringMass.ToString("F1")</td><td>g</td></tr>
                    @* Natural frequency removed: EN 13906-3 standardises no surge
                       frequency for torsion springs, and the formula in use was a
                       compression-spring one adapted by hand. It produced values
                       (~4.5 kHz on a typical spring) that nobody could check, sitting
                       in a table where every other row is verifiable. An unverifiable
                       number next to verified ones costs more trust than it adds.
                       See EquivalentCoils in TorsionSpringEngine for the rate fix. *@
                    <tr><td>Equivalent Coils (incl. legs)</td><td>n<sub>e</sub></td><td>@engine.EquivalentCoils.ToString("F2")</td><td>-</td></tr>
                </tbody>
            </table>
        </div>

        <!-- Diameter Change with Deflection -->
        @if (engine.Angle1Input > 0 || engine.Angle2Input > 0)
        {
            <div class="card">
                <div class="card-header">
                    <ModuleIcon Type="dimensions" Size="medium" Style="solid" />
                    <h2>Diameter Change with Deflection</h2>
                </div>
                <table class="results-table">
                    <thead><tr><th>Description</th><th>Symbol</th><th>Value</th><th>Unit</th></tr></thead>
                    <tbody>
                        <tr><td>Inner Diameter (free)</td><td>D<sub>i,0</sub></td><td>@engine.InnerDiameter.ToString("F2")</td><td>mm</td></tr>
                        @if (engine.Angle1Input > 0)
                        {
                            <tr><td>Inner Diameter at α₁</td><td>D<sub>i,1</sub></td><td>@engine.InnerDiameterAtAngle1.ToString("F2")</td><td>mm</td></tr>
                        }
                        @if (engine.Angle2Input > 0)
                        {
                            <tr class="@(engine.InnerDiameterAtAngle2 < engine.WireDiameter * 3 ? "warning" : "")"><td>Inner Diameter at α₂</td><td>D<sub>i,2</sub></td><td>@engine.InnerDiameterAtAngle2.ToString("F2")</td><td>mm</td></tr>
                        }
                        <tr><td>Inner Diameter at Max</td><td>D<sub>i,max</sub></td><td>@engine.InnerDiameterAtMax.ToString("F2")</td><td>mm</td></tr>
                    </tbody>
                </table>
                <div class="info-box" style="margin-top: 16px; padding: 12px; background: #fff8e1; border-radius: 8px; font-size: 13px;">
                    <strong>Note:</strong> For a closing spring (wound in direction of load), the inner diameter decreases with deflection.
                    Ensure adequate mandrel clearance to prevent binding.
                </div>
            </div>
        }

        <!-- Mechanical Properties -->
        <div class="card">
            <div class="card-header">
                <ModuleIcon Type="geometry" Size="medium" Style="solid" />
                <h2>Mechanical Properties</h2>
            </div>
            <table class="results-table">
                <thead><tr><th>Description</th><th>Symbol</th><th>Value</th><th>Unit</th></tr></thead>
                <tbody>
                    <tr class="highlight"><td>Spring Rate</td><td>R</td><td>@engine.SpringRate.ToString("F3")</td><td>Nmm/°</td></tr>
                    <tr><td>Spring Rate (per radian)</td><td>R</td><td>@engine.SpringRatePerRadian.ToString("F2")</td><td>Nmm/rad</td></tr>
                    <tr><td>Stress Correction Factor</td><td>q</td><td>@engine.StressCorrectionFactor.ToString("F3")</td><td>-</td></tr>
                    <tr><td>Max Deflection (allowable)</td><td>α<sub>max</sub></td><td>@engine.MaxDeflection.ToString("F1")</td><td>°</td></tr>
                    <tr><td>Max Torque (allowable)</td><td>M<sub>max</sub></td><td>@engine.MaxTorque.ToString("F1")</td><td>Nmm</td></tr>
                </tbody>
            </table>
        </div>

        <!-- Operating Conditions -->
        @if (engine.Angle1Input > 0 || engine.Angle2Input > 0)
        {
            <div class="card">
                <div class="card-header">
                    <ModuleIcon Type="force" Size="medium" Style="solid" />
                    <h2>Operating Conditions</h2>
                </div>
                <table class="results-table">
                    <thead><tr><th>Description</th><th>Symbol</th><th>Value</th><th>Unit</th></tr></thead>
                    <tbody>
                        @if (engine.Angle1Input > 0)
                        {
                            <tr><td>Position 1 - Angle</td><td>α<sub>1</sub></td><td>@engine.Angle1.ToString("F1")</td><td>°</td></tr>
                            <tr><td>Position 1 - Torque</td><td>M<sub>1</sub></td><td>@engine.Torque1.ToString("F1")</td><td>Nmm</td></tr>
                            <tr><td>Position 1 - Torque</td><td>M<sub>1</sub></td><td>@((engine.Torque1/1000).ToString("F3"))</td><td>Nm</td></tr>
                        }
                        @if (engine.Angle2Input > 0)
                        {
                            <tr><td>Position 2 - Angle</td><td>α<sub>2</sub></td><td>@engine.Angle2.ToString("F1")</td><td>°</td></tr>
                            <tr class="highlight"><td>Position 2 - Torque</td><td>M<sub>2</sub></td><td>@engine.Torque2.ToString("F1")</td><td>Nmm</td></tr>
                            <tr><td>Position 2 - Torque</td><td>M<sub>2</sub></td><td>@((engine.Torque2/1000).ToString("F3"))</td><td>Nm</td></tr>
                        }
                        @if (engine.Angle1Input > 0 && engine.Angle2Input > 0)
                        {
                            <tr><td>Working Angle</td><td>Δα</td><td>@engine.WorkingAngle.ToString("F1")</td><td>°</td></tr>
                            <tr class="highlight"><td>Working Torque</td><td>ΔM</td><td>@engine.WorkingTorque.ToString("F1")</td><td>Nmm</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <!-- Stress Analysis -->
        <div class="card">
            <div class="card-header">
                <ModuleIcon Type="force" Size="medium" Style="solid" />
                <h2>Stress Analysis</h2>
            </div>
            <table class="results-table">
                <thead><tr><th>Description</th><th>Symbol</th><th>Value</th><th>Unit</th></tr></thead>
                <tbody>
                    @if (engine.Angle1Input > 0)
                    {
                        <tr><td>Bending Stress at α₁</td><td>σ<sub>1</sub></td><td>@engine.BendingStress1.ToString("F0")</td><td>MPa</td></tr>
                    }
                    @if (engine.Angle2Input > 0)
                    {
                        <tr class="@(engine.BendingStress2 > engine.AllowableBendingStress ? "danger" : engine.BendingStress2 > engine.AllowableBendingStress * 0.9 ? "warning" : "highlight")"><td>Bending Stress at α₂</td><td>σ<sub>2</sub></td><td>@engine.BendingStress2.ToString("F0")</td><td>MPa</td></tr>
                    }
                    <tr><td>Max Bending Stress (allowable)</td><td>σ<sub>max</sub></td><td>@engine.MaxBendingStress.ToString("F0")</td><td>MPa</td></tr>
                    <tr><td>Allowable Bending Stress (0.70×R<sub>m</sub>)</td><td>σ<sub>zul</sub></td><td>@engine.AllowableBendingStress.ToString("F0")</td><td>MPa</td></tr>
                </tbody>
            </table>
        </div>

        <!-- Safety Factors -->
        <div class="card">
            <div class="card-header">
                <ModuleIcon Type="safety" Size="medium" Style="solid" />
                <h2>Safety Factors</h2>
            </div>
            <table class="results-table">
                <thead><tr><th>Description</th><th>Symbol</th><th>Value</th><th>Status</th></tr></thead>
                <tbody>
                    @if (engine.Angle1Input > 0)
                    {
                        <tr class="@GetSafetyRowClass(engine.SafetyFactorPosition1)"><td>Safety Factor at Position 1</td><td>SF<sub>1</sub></td><td>@engine.SafetyFactorPosition1.ToString("F2")</td><td>@GetSafetyStatus(engine.SafetyFactorPosition1)</td></tr>
                    }
                    @if (engine.Angle2Input > 0)
                    {
                        <tr class="@GetSafetyRowClass(engine.SafetyFactorPosition2)"><td>Safety Factor at Position 2</td><td>SF<sub>2</sub></td><td>@engine.SafetyFactorPosition2.ToString("F2")</td><td>@GetSafetyStatus(engine.SafetyFactorPosition2)</td></tr>
                    }
                    <tr class="@GetSafetyRowClass(engine.SafetyFactorStatic)"><td>Static Safety Factor (min)</td><td>SF<sub>static</sub></td><td>@engine.SafetyFactorStatic.ToString("F2")</td><td>@GetSafetyStatus(engine.SafetyFactorStatic)</td></tr>
                </tbody>
            </table>

            @if (engine.SafetyFactorStatic < 1.2)
            {
                <div class="alert alert-warning" style="margin-top: 16px;">
                    <ModuleIcon Type="safety" Size="small" Style="default" /> <strong>Warning:</strong> Static safety factor is below 1.2. Consider using thicker wire or reducing deflection.
                </div>
            }
        </div>

        <!-- Fatigue Analysis -->
        @if (engine.Angle1Input > 0 && engine.Angle2Input > 0 && Math.Abs(engine.Angle1Input - engine.Angle2Input) > 0.1)
        {
            <div class="card">
                <div class="card-header">
                    <ModuleIcon Type="force" Size="medium" Style="solid" />
                    <h2>Fatigue Analysis (Goodman)</h2>
                </div>
                <table class="results-table">
                    <thead><tr><th>Description</th><th>Symbol</th><th>Value</th><th>Unit</th></tr></thead>
                    <tbody>
                        <tr><td>Minimum Stress</td><td>σ<sub>1</sub></td><td>@engine.BendingStress1.ToString("F0")</td><td>MPa</td></tr>
                        <tr><td>Maximum Stress</td><td>σ<sub>2</sub></td><td>@engine.BendingStress2.ToString("F0")</td><td>MPa</td></tr>
                        <tr class="highlight"><td>Mean Stress</td><td>σ<sub>m</sub></td><td>@engine.FatigueMeanStress.ToString("F0")</td><td>MPa</td></tr>
                        <tr class="highlight"><td>Stress Amplitude</td><td>σ<sub>a</sub></td><td>@engine.FatigueStressAmplitude.ToString("F0")</td><td>MPa</td></tr>
                        <tr><td>Stress Ratio (σ₁/σ₂)</td><td>R</td><td>@engine.FatigueStressRatio.ToString("F2")</td><td>-</td></tr>
                        <tr><td>Endurance Limit</td><td>σ<sub>e</sub></td><td>@engine.FatigueEnduranceLimit.ToString("F0")</td><td>MPa</td></tr>
                    </tbody>
                </table>

                <h4 style="color: #34495e; margin: 20px 0 12px 0; padding-left: 8px; border-left: 3px solid #3498db;">Fatigue Safety</h4>
                <table class="results-table">
                    <thead><tr><th>Description</th><th>Symbol</th><th>Value</th><th>Status</th></tr></thead>
                    <tbody>
                        <tr class="@(engine.FatigueSafetyFactor < 1.0 ? "danger" : engine.FatigueSafetyFactor < 1.5 ? "warning" : "success")">
                            <td>Fatigue Safety Factor</td>
                            <td>SF<sub>fatigue</sub></td>
                            <td>@engine.FatigueSafetyFactor.ToString("F2")</td>
                            <td>@(engine.FatigueSafetyFactor < 1.0 ? "❌ FAIL" : engine.FatigueSafetyFactor < 1.5 ? "⚠️ Low" : "✓ OK")</td>
                        </tr>
                        <tr class="@GetFatigueLifeClass()">
                            <td>Expected Cycles</td>
                            <td>N</td>
                            <td>@GetFatigueLifeText()</td>
                            <td>-</td>
                        </tr>
                    </tbody>
                </table>

                @if (engine.FatigueSafetyFactor < 1.5)
                {
                    <div class="alert alert-warning" style="margin-top: 16px;">
                        <ModuleIcon Type="safety" Size="small" Style="default" /> <strong>Low Fatigue Safety:</strong> Consider shot peening, reducing stroke, or using higher grade material (DH or VDSiCr).
                    </div>
                }
            </div>
        }

        <!-- Design Guidelines -->
        <div class="card">
            <div class="card-header">
                <ModuleIcon Type="info" Size="medium" Style="solid" />
                <h2>Design Guidelines</h2>
            </div>
            <table class="results-table">
                <thead><tr><th>Design Parameter</th><th>Current Value</th><th>Status</th><th>Recommendation</th></tr></thead>
                <tbody>
                    <tr class="@(engine.SpringIndex < 4 || engine.SpringIndex > 14 ? "warning" : "success")">
                        <td>Spring Index (w)</td>
                        <td>@engine.SpringIndex.ToString("F1")</td>
                        <td>@(engine.SpringIndex < 4 ? "⚠️ Too Low" : engine.SpringIndex > 14 ? "⚠️ Too High" : "✓ OK")</td>
                        <td>@(engine.SpringIndex < 4 ? "Difficult to manufacture, high stress" : engine.SpringIndex > 14 ? "Low torque capacity" : "Recommended range 4-14")</td>
                    </tr>
                    <tr class="@(engine.ActiveCoils < 3 ? "warning" : "success")">
                        <td>Active Coils (n)</td>
                        <td>@engine.ActiveCoils.ToString("F1")</td>
                        <td>@(engine.ActiveCoils < 3 ? "⚠️ Low" : "✓ OK")</td>
                        <td>@(engine.ActiveCoils < 3 ? "Minimum 3 coils recommended" : "Adequate")</td>
                    </tr>
                    @if (engine.Angle2Input > 0)
                    {
                        <tr class="@(engine.Angle2 > engine.MaxDeflection * 0.9 ? "warning" : "success")">
                            <td>Deflection Utilization</td>
                            <td>@((engine.Angle2 / engine.MaxDeflection * 100).ToString("F0"))%</td>
                            <td>@(engine.Angle2 > engine.MaxDeflection * 0.9 ? "⚠️ High" : "✓ OK")</td>
                            <td>@(engine.Angle2 > engine.MaxDeflection * 0.9 ? "Close to maximum - consider margin" : "Adequate margin")</td>
                        </tr>
                        <tr class="@(engine.InnerDiameterAtAngle2 < engine.WireDiameter * 3 ? "warning" : "success")">
                            <td>Mandrel Clearance at α₂</td>
                            <td>@(engine.InnerDiameterAtAngle2.ToString("F1")) mm</td>
                            <td>@(engine.InnerDiameterAtAngle2 < engine.WireDiameter * 3 ? "⚠️ Tight" : "✓ OK")</td>
                            <td>@(engine.InnerDiameterAtAngle2 < engine.WireDiameter * 3 ? "Risk of binding - increase Di or reduce α" : "Adequate clearance")</td>
                        </tr>
                    }
                    <tr>
                        <td>Leg Type</td>
                        <td>@engine.LegType</td>
                        <td>-</td>
                        <td>@(TorsionSpringEngine.LegTypes.GetValueOrDefault(engine.LegType).Description)</td>
                    </tr>
                    <tr>
                        <td>Winding Direction</td>
                        <td>@engine.WindingDirection</td>
                        <td>-</td>
                        <td>@(engine.WindingDirection == "Right" ? "Right-hand: load closes spring" : "Left-hand: load opens spring")</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

}

