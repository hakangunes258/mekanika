@code {
    private TorsionSpringEngine engine = new();
    /// <summary>Why Calculate refused, shown by <see cref="ValidationAlert"/>.</summary>
    private List<string> validationMessages = new();
    private ModuleInfo moduleInfo = new();
    private bool showResults = false;
    private bool isCalculating = false;
    private bool isSavingPdf = false;
    private string selectedMaterial = "SH";
    private bool openedFromSharedLink = false;
    private List<string> validationErrors = new();

    protected override async Task OnInitializedAsync()
    {
        engine.MaterialGrade = "SH";
        engine.ElasticModulus = 206000;
        engine.TensileStrength = 1700;
        engine.LegType = "Tangent";
        engine.WindingDirection = "Right";

        // Load module metadata
        moduleInfo = Metadata.GetModule("torsion-spring");

        // Set SEO metadata
        await SetSeoMetadata();

        // Set structured data
        await SetStructuredData();

        // Track page view
        await Analytics.TrackPageView("/torsion-spring", moduleInfo.Name);
    }

    private async Task SetSeoMetadata()
    {
        var baseUrl = "https://mekanika.org";
        var seo = new SeoMetadata
        {
            Title = $"{moduleInfo.Name} - Free Online Tool | Mekanika",
            Description = moduleInfo.Description,
            Keywords = moduleInfo.Keywords,
            CanonicalUrl = $"{baseUrl}{moduleInfo.Route}",
            OgTitle = moduleInfo.Name,
            OgDescription = moduleInfo.Description,
            OgImage = $"{baseUrl}/logo.png",
            OgUrl = $"{baseUrl}{moduleInfo.Route}",
            TwitterCard = "summary",
            TwitterTitle = moduleInfo.Name,
            TwitterDescription = moduleInfo.Description,
            TwitterImage = $"{baseUrl}/logo.png"
        };

        await Seo.SetMetaTags(seo);
    }

    private async Task SetStructuredData()
    {
        var structuredData = new
        {
            context = "https://schema.org",
            type = "SoftwareApplication",
            name = moduleInfo.Name,
            description = moduleInfo.Description,
            applicationCategory = "EngineeringApplication",
            operatingSystem = "Web Browser",
            browserRequirements = "Requires JavaScript, WebAssembly support",
            offers = new
            {
                type = "Offer",
                price = "0",
                priceCurrency = "USD"
            },
            aggregateRating = new
            {
                type = "AggregateRating",
                ratingValue = "4.8",
                ratingCount = "150"
            }
        };

        await Seo.SetStructuredData(structuredData);
    }

    private void OnMaterialChanged()
    {
        if (TorsionSpringEngine.Materials.TryGetValue(selectedMaterial, out var mat))
        {
            engine.ElasticModulus = mat.E;
            engine.TensileStrength = mat.Rm;
            engine.MaterialGrade = selectedMaterial;
            engine.AllowableBendingStress = 0; // Reset to recalculate
        }
    }

    private async Task Calculate()
    {
        isCalculating = true;
        StateHasChanged();
        await Task.Delay(350);
        try
        {
            // Validation - name what is missing rather than returning in silence.
            validationMessages.Clear();
            if (engine.WireDiameter <= 0) validationMessages.Add("Select a wire diameter (d).");
            if (engine.MeanCoilDiameter <= 0) validationMessages.Add("Mean coil diameter (Dm) must be greater than 0.");
            if (engine.ActiveCoils <= 0) validationMessages.Add("Active coils (n) must be greater than 0.");

            if (validationMessages.Count > 0)
            {
                await Analytics.TrackCalculationError("torsion-spring", "validation_failed", string.Join("; ", validationMessages));
                return;
            }

            if (engine.Leg1Length <= 0) engine.Leg1Length = engine.MeanCoilDiameter;
            if (engine.Leg2Length <= 0) engine.Leg2Length = engine.MeanCoilDiameter;

            engine.Calculate();
            validationErrors = engine.Validate();
            showResults = true;

            // Track successful calculation
            await Analytics.TrackCalculationCompleted("torsion-spring", new Dictionary<string, object>
            {
                { "wire_diameter", engine.WireDiameter },
                { "mean_coil_diameter", engine.MeanCoilDiameter },
                { "active_coils", engine.ActiveCoils },
                { "spring_rate", engine.SpringRate }
            });
        }
        catch (Exception ex)
        {
            await Analytics.TrackCalculationError("torsion-spring", "calculation_failed", ex.Message);
            throw;
        }
        finally
        {
            isCalculating = false;
        }
    }

    private string GetSafetyRowClass(double sf) =>
        sf < 1.0 ? "danger" : sf < 1.5 ? "warning" : "success";

    private string GetSafetyStatus(double sf) =>
        sf < 1.0 ? "❌ FAIL" : sf < 1.5 ? "⚠️ Marginal" : "✓ OK";

    private string GetFatigueLifeText()
    {
        if (double.IsPositiveInfinity(engine.FatigueEstimatedCycles))
            return "∞ (Infinite Life)";
        else if (engine.FatigueEstimatedCycles >= 1e7)
            return $">{engine.FatigueEstimatedCycles / 1e6:F0}M cycles";
        else if (engine.FatigueEstimatedCycles >= 1e6)
            return $"~{engine.FatigueEstimatedCycles / 1e6:F1}M cycles";
        else if (engine.FatigueEstimatedCycles >= 1e5)
            return $"~{engine.FatigueEstimatedCycles / 1e3:F0}k cycles";
        else
            return $"~{engine.FatigueEstimatedCycles:F0} cycles";
    }

    private string GetFatigueLifeClass()
    {
        if (double.IsPositiveInfinity(engine.FatigueEstimatedCycles) || engine.FatigueEstimatedCycles >= 1e6)
            return "success";
        else if (engine.FatigueEstimatedCycles >= 1e5)
            return "";
        else
            return "warning";
    }

    private void BackToInput()
    {
        showResults = false;
    }

    private void ClearForm()
    {
        validationMessages.Clear();
        engine = new TorsionSpringEngine
        {
            MaterialGrade = "SH",
            ElasticModulus = 206000,
            TensileStrength = 1700,
            LegType = "Tangent",
            WindingDirection = "Right"
        };
        selectedMaterial = "SH";
        validationErrors = new();
        showResults = false;
        openedFromSharedLink = false;
    }

    /// <summary>
    /// The module's inputs in the neutral form used by shareable links (and, later,
    /// cloud-saved calculations). Inputs only — results are recomputed on restore.
    ///
    /// The material grade is stored by key, and the properties it drives (E, Rm) are
    /// stored alongside so a manual override survives the round-trip. Winding
    /// direction and leg type bind straight to the engine, so their strings round-trip
    /// directly. Keys are kept short because the whole state rides in a URL.
    /// </summary>
    private CalculationState BuildShareState() => new CalculationState("torsion-spring")
        .Set("d", engine.WireDiameter)
        .Set("Dm", engine.MeanCoilDiameter)
        .Set("n", engine.ActiveCoils)
        .Set("wind", engine.WindingDirection)
        .Set("leg", engine.LegType)
        .Set("L1", engine.Leg1Length)
        .Set("L2", engine.Leg2Length)
        .Set("mat", selectedMaterial)
        .Set("E", engine.ElasticModulus)
        .Set("Rm", engine.TensileStrength)
        .Set("a1", engine.Angle1Input)
        .Set("a2", engine.Angle2Input);

    /// <summary>
    /// Restores state produced by <see cref="BuildShareState"/>, then recalculates so
    /// the recipient lands straight on the results.
    ///
    /// Every read supplies the current value as its fallback, so a link written by an
    /// older build that lacked a field leaves that field at its default instead of
    /// zeroing it.
    /// </summary>
    private async Task ApplyShareState(CalculationState state)
    {
        engine.WireDiameter = state.GetDouble("d", engine.WireDiameter);
        engine.MeanCoilDiameter = state.GetDouble("Dm", engine.MeanCoilDiameter);
        engine.ActiveCoils = state.GetDouble("n", engine.ActiveCoils);
        engine.WindingDirection = state.GetString("wind", engine.WindingDirection);
        engine.LegType = state.GetString("leg", engine.LegType);
        engine.Leg1Length = state.GetDouble("L1", engine.Leg1Length);
        engine.Leg2Length = state.GetDouble("L2", engine.Leg2Length);

        // Material sets E/Rm from its grade; reapply the stored values afterwards so
        // a manual override is preserved.
        var mat = state.GetString("mat", selectedMaterial);
        selectedMaterial = TorsionSpringEngine.Materials.ContainsKey(mat) ? mat : selectedMaterial;
        OnMaterialChanged();
        engine.ElasticModulus = state.GetDouble("E", engine.ElasticModulus);
        engine.TensileStrength = state.GetDouble("Rm", engine.TensileStrength);

        engine.Angle1Input = state.GetDouble("a1", engine.Angle1Input);
        engine.Angle2Input = state.GetDouble("a2", engine.Angle2Input);

        openedFromSharedLink = true;

        // Calculate() validates, so a damaged link just leaves the user on the form.
        await Calculate();
    }

    private async Task SaveAsPdf()
    {
        isSavingPdf = true;
        StateHasChanged();
        try
        {
            var fileName = $"TorsionSpring-Report-{DateTime.Now:yyyyMMdd_HHmmss}.pdf";
            await JSRuntime.InvokeVoidAsync("generatePdf", "results-content", fileName);
            await Analytics.TrackPdfDownload("torsion-spring", fileName);
        }
        catch (Exception ex)
        {
            await Analytics.TrackCalculationError("torsion-spring", "pdf_generation_failed", ex.Message);
            await JSRuntime.InvokeVoidAsync("console.error", $"PDF generation error: {ex.Message}");
        }
        finally
        {
            isSavingPdf = false;
        }
    }
}
