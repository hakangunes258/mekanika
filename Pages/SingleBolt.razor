@page "/single-bolt"
@using MechanicalCalculatorWeb.Services
@using MechanicalCalculatorWeb.Models
@using static MechanicalCalculatorWeb.Services.BoltService
@inject MaterialService MaterialService
@inject AnalyticsService Analytics
@inject SeoService Seo
@inject ModuleMetadataService Metadata
@inject FeedbackService Feedback
@inject IJSRuntime JSRuntime

@* Note: BoltService is used via static using directive above *@

<PageTitle>Single Bolt Calculator - Mekanika</PageTitle>

<div class="page-header">
    <h1>
        <ModuleIcon Type="bolt" Size="large" Style="transparent" CustomStyle="margin-right: 12px;" />
        Single Bolt Calculator
    </h1>
    <p>VDI 2230 systematic calculation of preloaded bolted joints</p>
</div>

@if (!showResults)
{
    <div class="form-grid">
        <!-- Bolt Specification Card -->
        <div class="card">
            <div class="card-header">
                <ModuleIcon Type="bolt" Size="medium" Style="solid" />
                <h2>Bolt Specification</h2>
            </div>

            <div class="form-group">
                <label>Bolt Type (DIN Standard)</label>
                <select @bind="boltStandard" @bind:after="OnBoltStandardChanged">
                    <option value="ISO4014">ISO 4014 / DIN 931 (Hex Head, Partial Thread)</option>
                    <option value="DIN912">DIN 912 / ISO 4762 (Socket Head Cap Screw)</option>
                </select>
            </div>

            <div class="form-group">
                <label>Bolt Size</label>
                <div class="input-group">
                    <select @bind="input.BoltSize" @bind:after="OnBoltSizeChanged" style="flex: 1;">
                        @foreach (var bolt in MetricBolts)
                        {
                            <option value="@bolt.Size">@bolt.Size</option>
                        }
                    </select>
                    <button class="btn btn-sm btn-secondary" @onclick="PreSizeBolt" style="margin-left: 8px;" title="Pre-size bolt based on VDI 2230 Table A7">
                        <ModuleIcon Type="gear" Size="small" Style="default" />
                    </button>
                </div>
                <small class="hint">Click <ModuleIcon Type="gear" Size="button" Style="default" CustomStyle="vertical-align:middle;" /> to auto-size based on applied load (VDI 2230)</small>
            </div>



            <div class="form-group">
                <label>Strength Class</label>
                <select @bind="input.StrengthClass" @bind:after="OnStrengthClassChanged">
                    @foreach (var cls in StrengthClasses)
                    {
                        <option value="@cls.Class">@cls.Class</option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label>Thread Configuration</label>
                <select @bind="threadConfig" @bind:after="OnThreadConfigChanged">
                    <option value="Full">Fully Threaded</option>
                    <option value="Partial">Partially Threaded</option>
                </select>
            </div>

            @if (threadConfig == "Partial")
            {
                <div class="form-group">
                    <label>Unthreaded Shank Length</label>
                    <div class="input-group">
                        <input type="number" step="0.5" @bind="input.ShankLength" />
                        <span class="unit">mm</span>
                    </div>
                </div>
            }

            <div class="form-group">
                <label>Bolt Length</label>
                <div class="input-group">
                    <input type="number" step="1" min="10" @bind="boltLength" />
                    <span class="unit">mm</span>
                    <button class="btn btn-sm btn-secondary" @onclick="AutoSizeBoltLength" style="margin-left: 8px;">
                        <ModuleIcon Type="gear" Size="small" Style="default" />
                    </button>
                </div>
                <small class="hint">Click <ModuleIcon Type="gear" Size="button" Style="default" CustomStyle="vertical-align:middle;" /> to auto-size based on clamped parts, washers and nuts</small>
            </div>

            @if (selectedBolt != null)
            {
                <div class="info-box small" style="margin-top: 12px;">
                    <div style="font-weight: 600; margin-bottom: 6px; color: #1565c0;">Bolt Dimensions</div>
                    <div class="info-row">
                        <span>Nominal Diameter (d):</span>
                        <strong>@selectedBolt.d.ToString("F1") mm</strong>
                    </div>
                    <div class="info-row">
                        <span>Thread Pitch (P):</span>
                        <strong>@selectedBolt.P_coarse.ToString("F2") mm</strong>
                    </div>
                    <div class="info-row">
                        <span>Head Height (k):</span>
                        <strong>@selectedBolt.k.ToString("F1") mm</strong>
                    </div>
                    <div class="info-row">
                        <span>Head Diameter (dw):</span>
                        <strong>@selectedBolt.dw.ToString("F1") mm</strong>
                    </div>
                    @if (selectedStrength != null)
                    {
                        <div class="info-row">
                            <span>Yield Strength (Rp0.2):</span>
                            <strong>@selectedStrength.Rp02 MPa</strong>
                        </div>
                        <div class="info-row">
                            <span>Tensile Strength (Rm):</span>
                            <strong>@selectedStrength.Rm MPa</strong>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Joint Configuration Card -->
        <div class="card">
            <div class="card-header">
                <ModuleIcon Type="geometry" Size="medium" Style="solid" />
                <h2>Joint Configuration</h2>
            </div>

            <div class="form-group">
                <label>Joint Type</label>
                <select @bind="input.JointType" @bind:after="OnJointTypeChanged">
                    <option value="@JointType.ThroughHole">Through Hole (with Nut)</option>
                    <option value="@JointType.TappedHole">Blind Hole (Tapped)</option>
                </select>
            </div>

            <div class="form-group">
                <label>Washers</label>
                <div class="checkbox-row">
                    <label class="checkbox-label">
                        <input type="checkbox" @bind="input.UseWasherUnderHead" />
                        <span>Under Head</span>
                    </label>
                    @if (input.JointType == JointType.ThroughHole)
                    {
                        <label class="checkbox-label">
                            <input type="checkbox" @bind="input.UseWasherUnderNut" />
                            <span>Under Nut</span>
                        </label>
                    }
                </div>
                @if ((input.UseWasherUnderHead || input.UseWasherUnderNut) && selectedWasher != null)
                {
                    <div style="margin-top: 8px; display: flex; align-items: center; justify-content: space-between;">
                        <small class="hint" style="flex: 1;">
                            @if (isCustomWasher)
                            {
                                <span style="color: #ff9800; font-weight: 500;"><ModuleIcon Type="settings" Size="button" Style="default" CustomStyle="color:inherit;vertical-align:middle;" /> Custom:</span>
                            }
                            d₁=@selectedWasher.d1.ToString("F2") mm, d₂=@selectedWasher.d2.ToString("F2") mm, h=@selectedWasher.h.ToString("F1") mm
                        </small>
                        <button type="button" class="btn btn-sm btn-outline" @onclick="OpenWasherCustomize" style="padding: 4px 8px; font-size: 11px;">
                            <ModuleIcon Type="settings" Size="button" Style="default" /> Customize
                        </button>
                    </div>
                }
            </div>

            <div class="form-group">
                <label>Hole Diameter (dh)</label>
                <div class="input-group">
                    <input type="number" step="0.1" @bind="holeDiameter" @bind:after="OnHoleDiameterChanged" />
                    <span class="unit">mm</span>
                    <button class="btn btn-sm btn-secondary" @onclick="AutoSizeHoleDiameter" style="margin-left: 8px;">
                        <ModuleIcon Type="gear" Size="small" Style="default" />
                    </button>
                </div>
                <small class="hint">Clearance hole through clamped parts</small>
            </div>

            <div class="form-group">
                <label>Chamfer Diameter (dc)</label>
                <div class="input-group">
                    <input type="number" step="0.1" min="0" @bind="chamferDepth" />
                    <span class="unit">mm</span>
                </div>
                <small class="hint">Diameter at chamfer surface (typically hole dia + 1-2mm)</small>
            </div>

            <div class="form-group">
                <label>Outer Diameter of Clamped Parts (DA)</label>
                <div class="input-group">
                    <input type="number" step="1" min="0" @bind="clampedPartsOuterDiameter" />
                    <span class="unit">mm</span>
                </div>
                <small class="hint">Outer diameter of clamped assembly (0 = auto calculate from cone angle)</small>
            </div>

            <div class="form-group">
                <label>Clamped Parts</label>
                @for (int i = 0; i < clampedParts.Count; i++)
                {
                    var index = i;
                    <div class="part-row">
                        <span class="part-num">@(index + 1)</span>
                        <input type="text" inputmode="decimal" class="thickness-input"
                               value="@clampedParts[index].Thickness.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)"
                               @onchange="@(e => OnThicknessChanged(index, e))" />
                        <span class="unit-small">mm</span>
                        <select class="material-select" value="@clampedParts[index].MaterialName"
                                @onchange="@(e => OnMaterialChanged(index, e))">
                            @foreach (var mat in materials)
                            {
                                <option value="@mat.Name">@mat.ToString()</option>
                            }
                        </select>
                        @if (clampedParts.Count > 1)
                        {
                            <button class="btn-remove" @onclick="@(() => RemovePart(index))">✕</button>
                        }
                    </div>
                }
                @if (clampedParts.Count < 5)
                {
                    <button class="btn btn-sm btn-outline" @onclick="AddPart" style="margin-top: 8px;">+ Add Part</button>
                }
            </div>

            <div class="info-highlight">
                <span>Clamping Length (lK):</span>
                <strong>@CalculateClampLength().ToString("F1") mm</strong>
            </div>
        </div>

        <!-- Surface & Friction & Assembly Card -->
        <div class="card">
            <div class="card-header">
                <ModuleIcon Type="surface" Size="medium" Style="solid" />
                <h2>Surface & Friction</h2>
            </div>

            <div class="form-group">
                <label>Surface Roughness (Rz)
                    <button type="button" class="info-btn" @onclick="ToggleRoughnessInfo" title="Show roughness values table"><ModuleIcon Type="info" Size="button" Style="default" /></button>
                </label>
                <div class="input-group">
                    <input type="number" step="0.5" min="1" max="40" @bind="roughnessThread" />
                    <span class="unit">μm</span>
                </div>
                <small class="hint">Thread roughness (typical: 6.3 μm for rolled threads)</small>
            </div>

            <div class="form-group">
                <label>Head/Nut Roughness</label>
                <div class="input-group">
                    <input type="number" step="0.5" min="1" max="40" @bind="roughnessHead" />
                    <span class="unit">μm</span>
                </div>
            </div>

            <div class="form-group">
                <label>Clamped Parts Roughness</label>
                <div class="input-group">
                    <input type="number" step="0.5" min="1" max="40" @bind="roughnessParts" />
                    <span class="unit">μm</span>
                </div>
            </div>

            <div class="form-group" style="margin-top: 20px;">
                <label>Bolt Friction Coefficients
                    <button type="button" class="info-btn" @onclick="ToggleFrictionInfo" title="Show friction values table"><ModuleIcon Type="info" Size="button" Style="default" /></button>
                </label>
            </div>

            <div class="form-group">
                <label>Thread (μG)</label>
                <div class="input-group">
                    <input type="number" step="0.01" min="0.04" max="0.40" @bind="frictionThread" class="no-spinner" />
                </div>
            </div>

            <div class="form-group">
                <label>Head/Nut (μK)</label>
                <div class="input-group">
                    <input type="number" step="0.01" min="0.04" max="0.40" @bind="frictionHead" class="no-spinner" />
                </div>
            </div>

            <div class="form-group">
                <label>Interface Friction (Clamped Parts)</label>
                <div class="input-group">
                    <input type="number" step="0.01" min="0.05" max="0.50" @bind="input.InterfaceFriction" class="no-spinner" />
                </div>
            </div>
        </div>

        <!-- Assembly Card -->
        <div class="card">
            <div class="card-header">
                <ModuleIcon Type="gear" Size="medium" Style="solid" />
                <h2>Assembly</h2>
            </div>

            <div class="form-group">
                <label>Tightening Method</label>
                <select @bind="input.TighteningMethod" @bind:after="OnTighteningMethodChanged">
                    @foreach (var method in TighteningMethods)
                    {
                        <option value="@method.Method">@method.Method</option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label>Yield Strength Utilization Limit</label>
                <div class="input-group">
                    <input type="number" step="1" min="50" max="100" @bind="yieldUtilizationLimit" />
                    <span class="unit">%</span>
                </div>
                <small class="hint">Maximum allowable utilization of bolt yield strength (typical: 90%)</small>
            </div>

            <div class="form-group">
                <label>Bolting Type (VDI 2230)
                    <button type="button" class="info-btn" @onclick="ToggleBoltingTypeInfo" title="Show bolting type info"><ModuleIcon Type="info" Size="button" Style="default" /></button>
                </label>
                <select @bind="selectedBoltingType" @bind:after="OnBoltingTypeChanged">
                    @if (input.JointType == JointType.ThroughHole)
                    {
                        <option value="SV1">SV 1 - Load at bolt head</option>
                        <option value="SV2">SV 2 - Load at nut</option>
                        <option value="SV3">SV 3 - Load in middle</option>
                    }
                    else
                    {
                        <option value="SV4">SV 4 - Load at head (tapped)</option>
                        <option value="SV5">SV 5 - Load in middle (tapped)</option>
                        <option value="SV6">SV 6 - Load at thread (tapped)</option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label>Load Eccentricity (e)</label>
                <div class="input-group">
                    <input type="number" step="0.5" min="0" @bind="input.Eccentricity" />
                    <span class="unit">mm</span>
                </div>
                <small class="hint">Distance from bolt axis to load point (0 = concentric)</small>
            </div>

            <div class="form-group">
                <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 8px;">
                    <label style="margin: 0;">Load Factor (n)</label>
                    <label class="checkbox-label" style="margin: 0;">
                        <input type="checkbox" @bind="autoLoadFactor" @bind:after="OnAutoLoadFactorChanged" />
                        <span>Auto (Table 5.2/1)</span>
                    </label>
                </div>
                @if (!autoLoadFactor)
                {
                    <div class="input-group">
                        <input type="number" step="0.01" min="0" max="1" @bind="input.LoadIntroductionFactor" />
                        <span class="unit">-</span>
                    </div>
                }
                <small class="hint">From VDI 2230 Table 5.2/1 based on bolting type and geometry</small>
            </div>
        </div>

        <!-- Loading Card (VDI 2230 / KISSsoft Style) -->
        <div class="card">
            <div class="card-header">
                <ModuleIcon Type="force" Size="medium" Style="solid" />
                <h2>Loading</h2>
            </div>

            <!-- Axial Force Input -->
            <div class="load-section">
                <span class="section-label">Axial & Transverse Loads</span>
                <div class="form-group">
                    <label>Min Axial Force (FA,min)</label>
                    <div class="input-group">
                        <input type="number" step="100" @bind="input.AxialForceMin" />
                        <span class="unit">N</span>
                    </div>
                </div>
                <div class="form-group">
                    <label>Max Axial Force (FA,max)</label>
                    <div class="input-group">
                        <input type="number" step="100" @bind="input.AxialForceMax" />
                        <span class="unit">N</span>
                    </div>
                </div>
                <div class="form-group">
                    <label>Transverse Force (FQ)</label>
                    <div class="input-group">
                        <input type="number" step="100" @bind="input.ShearForce" />
                        <span class="unit">N</span>
                    </div>
                    <small class="hint">Shear force perpendicular to bolt axis</small>
                </div>

                <div class="form-group">
                    <label>Bending Moment (MB)</label>
                    <div class="input-group">
                        <input type="number" step="100" @bind="input.BendingMoment" />
                        <span class="unit">Nmm</span>
                    </div>
                    <small class="hint">Working moment at the joint</small>
                </div>
                
                <div class="form-group">
                    <label>Required Residual Clamp Force (F<sub>Kerf</sub>)</label>
                    <div class="input-group">
                        <input type="number" step="100" min="0" @bind="input.RequiredResidualClampForce" />
                        <span class="unit">N</span>
                    </div>
                    <small class="hint">Clamp force that must remain in service for sealing or to keep the interface closed. Leave 0 if only slip resistance matters.</small>
                </div>

                <div class="form-group">
                    <label>Number of Load Cycles (N)</label>
                    <div class="input-group">
                        <input type="number" step="1000000" min="1000" @bind="input.DesignLoadCycles" />
                        <span class="unit">cycles</span>
                    </div>
                    <small class="hint">Design life in load cycles (typical: 10⁶ - 10⁷). Only used when FA,min and FA,max differ.</small>
                </div>
            </div>

        </div>
    </div>

    <ValidationAlert Messages="validationMessages" />

    <div class="button-group">
        <button class="btn btn-success btn-lg @(isCalculating ? "btn-calculating" : "")" @onclick="Calculate" disabled="@isCalculating">
            @if (isCalculating)
            {
                <span class="spinner"></span>
                <span>Calculating...</span>
            }
            else
            {
                <ModuleIcon Type="calculate" Size="button" Style="default" />
                <span>Calculate</span>
            }
        </button>
        <button class="btn btn-secondary" @onclick="ClearForm" disabled="@isCalculating">
            <ModuleIcon Type="clear" Size="button" Style="default" />
            Clear
        </button>
    </div>

    <!-- Roughness Info Modal -->
    @if (showRoughnessInfo)
    {
        <div class="modal-overlay" @onclick="ToggleRoughnessInfo">
            <div class="modal-content" @onclick:stopPropagation="true">
                <div class="modal-header">
                    <h3>Surface Roughness (Rz) by Manufacturing Method</h3>
                    <button class="close-btn" @onclick="ToggleRoughnessInfo">×</button>
                </div>
                <div class="modal-body">
                    <table class="roughness-table">
                        <thead>
                            <tr>
                                <th>Manufacturing Method</th>
                                <th>Typical Rz (μm)</th>
                                <th>Range (μm)</th>
                                <th>Application</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><strong>Ground</strong></td>
                                <td>2.5</td>
                                <td>1-4</td>
                                <td>Precision surfaces, tight tolerances</td>
                            </tr>
                            <tr>
                                <td><strong>Rolled (Thread)</strong></td>
                                <td>6.3</td>
                                <td>4-10</td>
                                <td>Standard thread rolling, good finish</td>
                            </tr>
                            <tr>
                                <td><strong>Machined / Milled</strong></td>
                                <td>6.3-10</td>
                                <td>4-16</td>
                                <td>Machined heads, milled surfaces</td>
                            </tr>
                            <tr>
                                <td><strong>Turned</strong></td>
                                <td>12</td>
                                <td>8-20</td>
                                <td>Turned shafts, general machining</td>
                            </tr>
                            <tr>
                                <td><strong>Cut (Thread)</strong></td>
                                <td>16</td>
                                <td>10-25</td>
                                <td>Cut threads, conventional machining</td>
                            </tr>
                            <tr>
                                <td><strong>Forged</strong></td>
                                <td>16</td>
                                <td>10-25</td>
                                <td>Forged bolt heads, as-forged surfaces</td>
                            </tr>
                        </tbody>
                    </table>
                    <div class="roughness-note">
                        <p><strong>Note:</strong> These are typical values. Actual roughness depends on tooling condition, cutting parameters, and material properties.</p>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Bolting Type Info Modal -->
    @if (showBoltingTypeInfo)
    {
        <div class="modal-overlay" @onclick="ToggleBoltingTypeInfo">
            <div class="modal-content" @onclick:stopPropagation="true" style="max-width: 950px;">
                <div class="modal-header">
                    <h3>VDI 2230 - Bolting Types & Load Introduction Factor</h3>
                    <button class="close-btn" @onclick="ToggleBoltingTypeInfo">×</button>
                </div>
                <div class="modal-body">
                    <p style="margin-bottom: 16px; color: #495057;">
                        The bolting type (SV 1 - SV 6) defines where the external load enters the joint. The load introduction factor <strong>n</strong> is calculated from <strong>Table 5.2/1</strong> based on:
                    </p>
                    <ul style="margin-bottom: 16px; padding-left: 24px;">
                        <li><strong>lA/h</strong> - Ratio of load eccentricity to clamping length</li>
                        <li><strong>ak/h</strong> - Ratio of edge distance to clamping length, where ak = (DA - dW)/2</li>
                    </ul>

                    <div style="background: #e3f2fd; padding: 16px; border-radius: 8px; margin-bottom: 20px;">
                        <h4 style="margin-top: 0; color: #1565c0;">Through-Bolt Connections (DSV)</h4>
                        <table style="width: 100%; border-collapse: collapse; margin-top: 12px;">
                            <tr style="background: #bbdefb;">
                                <th style="padding: 8px; text-align: left; border: 1px solid #90caf9;">Type</th>
                                <th style="padding: 8px; text-align: left; border: 1px solid #90caf9;">Description</th>
                                <th style="padding: 8px; text-align: center; border: 1px solid #90caf9;">Load Point</th>
                            </tr>
                            <tr>
                                <td style="padding: 8px; border: 1px solid #e0e0e0;"><strong>SV 1</strong></td>
                                <td style="padding: 8px; border: 1px solid #e0e0e0;">Load introduced at bolt head side</td>
                                <td style="padding: 8px; border: 1px solid #e0e0e0; text-align: center;">Top (head)</td>
                            </tr>
                            <tr>
                                <td style="padding: 8px; border: 1px solid #e0e0e0;"><strong>SV 2</strong></td>
                                <td style="padding: 8px; border: 1px solid #e0e0e0;">Load introduced at nut side</td>
                                <td style="padding: 8px; border: 1px solid #e0e0e0; text-align: center;">Bottom (nut)</td>
                            </tr>
                            <tr>
                                <td style="padding: 8px; border: 1px solid #e0e0e0;"><strong>SV 3</strong></td>
                                <td style="padding: 8px; border: 1px solid #e0e0e0;">Load introduced in the middle of clamped parts</td>
                                <td style="padding: 8px; border: 1px solid #e0e0e0; text-align: center;">Middle</td>
                            </tr>
                        </table>
                    </div>

                    <div style="background: #fff3e0; padding: 16px; border-radius: 8px; margin-bottom: 20px;">
                        <h4 style="margin-top: 0; color: #e65100;">Tapped Hole Connections (ESV)</h4>
                        <table style="width: 100%; border-collapse: collapse; margin-top: 12px;">
                            <tr style="background: #ffe0b2;">
                                <th style="padding: 8px; text-align: left; border: 1px solid #ffcc80;">Type</th>
                                <th style="padding: 8px; text-align: left; border: 1px solid #ffcc80;">Description</th>
                                <th style="padding: 8px; text-align: center; border: 1px solid #ffcc80;">Load Point</th>
                            </tr>
                            <tr>
                                <td style="padding: 8px; border: 1px solid #e0e0e0;"><strong>SV 4</strong></td>
                                <td style="padding: 8px; border: 1px solid #e0e0e0;">Load introduced at bolt head side</td>
                                <td style="padding: 8px; border: 1px solid #e0e0e0; text-align: center;">Top (head)</td>
                            </tr>
                            <tr>
                                <td style="padding: 8px; border: 1px solid #e0e0e0;"><strong>SV 5</strong></td>
                                <td style="padding: 8px; border: 1px solid #e0e0e0;">Load introduced in the middle</td>
                                <td style="padding: 8px; border: 1px solid #e0e0e0; text-align: center;">Middle</td>
                            </tr>
                            <tr>
                                <td style="padding: 8px; border: 1px solid #e0e0e0;"><strong>SV 6</strong></td>
                                <td style="padding: 8px; border: 1px solid #e0e0e0;">Load introduced at thread engagement</td>
                                <td style="padding: 8px; border: 1px solid #e0e0e0; text-align: center;">Bottom (thread)</td>
                            </tr>
                        </table>
                    </div>

                    <div style="background: #e8f5e9; padding: 16px; border-radius: 8px;">
                        <h4 style="margin-top: 0; color: #2e7d32;">Table 5.2/1 - Load Introduction Factor n</h4>
                        <p style="margin: 8px 0; font-size: 13px;">The factor <strong>n</strong> is determined by interpolation from the table based on:</p>
                        <ul style="margin: 8px 0; padding-left: 24px; font-size: 13px;">
                            <li><strong>Bolting type</strong> (SV 1 - SV 6)</li>
                            <li><strong>lA/h ratio</strong> = Eccentricity / Clamping length (0 to ≥0.30)</li>
                            <li><strong>ak/h ratio</strong> = Edge distance / Clamping length (0 to ≥0.50)</li>
                        </ul>
                        <p style="margin: 8px 0; font-size: 13px; color: #1b5e20;">
                            <strong>Effective force ratio:</strong> Φn = n × Φ<br/>
                            Lower n → More load relief of clamped parts<br/>
                            Higher n → More additional bolt force
                        </p>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Friction Info Modal -->
    @if (showFrictionInfo)
    {
        <div class="modal-overlay" @onclick="ToggleFrictionInfo">
            <div class="modal-content" @onclick:stopPropagation="true">
                <div class="modal-header">
                    <h3>Friction Coefficients (acc. to VDI 2230)</h3>
                    <button class="close-btn" @onclick="ToggleFrictionInfo">×</button>
                </div>
                <div class="modal-body">
                    <table class="roughness-table">
                        <thead>
                            <tr>
                                <th>Material / Surface Combination</th>
                                <th>Lubricant</th>
                                <th>Friction Range (μ)</th>
                                <th>Typical μ</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Steel (non-coated, degreased)</td>
                                <td>None</td>
                                <td>0.18 - 0.25</td>
                                <td>0.20</td>
                            </tr>
                            <tr>
                                <td>Steel (manganese phosphated)</td>
                                <td>Oiled</td>
                                <td>0.12 - 0.18</td>
                                <td>0.14</td>
                            </tr>
                             <tr>
                                <td>Steel (zinc phosphated)</td>
                                <td>Oiled</td>
                                <td>0.10 - 0.18</td>
                                <td>0.12</td>
                            </tr>
                            <tr>
                                <td>Steel (electro-galvanized)</td>
                                <td>None (passivated)</td>
                                <td>0.14 - 0.24</td>
                                <td>0.18</td>
                            </tr>
                            <tr>
                                <td>Steel (hot-dip galvanized)</td>
                                <td>None</td>
                                <td>0.16 - 0.25</td>
                                <td>0.20</td>
                            </tr>
                             <tr>
                                <td>Steel (cadmium plated)</td>
                                <td>None (passivated)</td>
                                <td>0.10 - 0.18</td>
                                <td>0.14</td>
                            </tr>
                            <tr>
                                <td>Steel (Dacromet/Geomet)</td>
                                <td>None</td>
                                <td>0.08 - 0.14</td>
                                <td>0.11</td>
                            </tr>
                             <tr>
                                <td>Steel (with MoS₂ lubricant)</td>
                                <td>Solid</td>
                                <td>0.05 - 0.12</td>
                                <td>0.08</td>
                            </tr>
                             <tr>
                                <td>Stainless Steel A2/A4 (non-coated)</td>
                                <td>Clean</td>
                                <td>0.18 - 0.30</td>
                                <td>0.24</td>
                            </tr>
                            <tr>
                                <td>Stainless Steel A2/A4 (lubricated)</td>
                                <td>Wax/solid lubricant</td>
                                <td>0.12 - 0.18</td>
                                <td>0.15</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <!-- Washer Customize Modal -->
    @if (showWasherCustomize)
    {
        <div class="modal-overlay" @onclick="CloseWasherCustomize">
            <div class="modal-content" @onclick:stopPropagation="true" style="max-width: 500px;">
                <div class="modal-header">
                    <h3><ModuleIcon Type="settings" Size="small" Style="default" CustomStyle="vertical-align:middle;margin-right:6px;" /> Customize Washer Dimensions</h3>
                    <button class="close-btn" @onclick="CloseWasherCustomize">×</button>
                </div>
                <div class="modal-body">
                    <p style="margin-bottom: 16px; color: #495057; font-size: 14px;">
                        Adjust washer dimensions to match your specific requirements. Default values are from DIN 125A standard.
                    </p>

                    <div class="form-group">
                        <label>Inner Diameter (d₁)</label>
                        <div class="input-group">
                            <input type="number" step="0.01" min="1" @bind="customWasher.d1" />
                            <span class="unit">mm</span>
                        </div>
                        <small class="hint">Washer inner diameter (clearance for bolt)</small>
                    </div>

                    <div class="form-group">
                        <label>Outer Diameter (d₂)</label>
                        <div class="input-group">
                            <input type="number" step="0.01" min="1" @bind="customWasher.d2" />
                            <span class="unit">mm</span>
                        </div>
                        <small class="hint">Washer outer diameter (bearing surface)</small>
                    </div>

                    <div class="form-group">
                        <label>Thickness (h)</label>
                        <div class="input-group">
                            <input type="number" step="0.1" min="0.1" @bind="customWasher.h" />
                            <span class="unit">mm</span>
                        </div>
                        <small class="hint">Washer thickness</small>
                    </div>

                    <div class="form-group">
                        <label>Washer Material</label>
                        <select @bind="input.WasherMaterial" class="form-control" style="width: 100%; padding: 8px; border: 1px solid #dee2e6; border-radius: 4px;">
                            @foreach (var mat in materials)
                            {
                                <option value="@mat.Name">@mat.ToString()</option>
                            }
                        </select>
                        <small class="hint">Select the washer material from the library.</small>
                    </div>


                    <div style="display: flex; gap: 12px; margin-top: 20px;">
                        <button class="btn btn-primary" @onclick="ApplyCustomWasher" style="flex: 1;">
                            ✓ Apply
                        </button>
                        <button class="btn btn-secondary" @onclick="ResetToStandardWasher" style="flex: 1;">
                            <ModuleIcon Type="new" Size="button" Style="default" /> Reset to Standard
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
}
else
{
    <!-- RESULTS -->
    <div class="button-group" style="margin-bottom: 24px;">
        <button class="btn btn-secondary" @onclick="BackToInput">
            <ModuleIcon Type="back" Size="button" Style="default" />
            Back to Input
        </button>
        <button class="btn btn-secondary" @onclick="ClearForm">
            <ModuleIcon Type="new" Size="button" Style="default" />
            New Calculation
        </button>
        <button class="btn btn-info @(isSavingPdf ? "btn-saving" : "")" @onclick="SaveAsPdf" disabled="@isSavingPdf">
            @if (isSavingPdf)
            {
                <span class="spinner"></span>
                <span>Generating PDF...</span>
            }
            else
            {
                <ModuleIcon Type="pdf" Size="button" Style="default" />
                <span>Save as PDF</span>
            }
        </button>
    </div>

    <div id="results-content">

        @if (result.Errors.Any())
        {
            <div class="alert alert-danger"><ModuleIcon Type="error" Size="small" Style="default" /> @string.Join(", ", result.Errors)</div>
        }
        @if (result.Warnings.Any())
        {
            <div class="alert alert-warning"><ModuleIcon Type="warning" Size="small" Style="default" /> @string.Join(", ", result.Warnings)</div>
        }
    
        <div class="card">
            <div class="card-header"><ModuleIcon Type="bolt" Size="medium" Style="solid" /><h2>Bolt Specifications</h2></div>
            <table class="results-table">
                <thead><tr><th>Description</th><th>Symbol</th><th>Value</th><th>Unit</th></tr></thead>
                <tbody>
                    <tr><td>Bolt Size</td><td>-</td><td>@input.BoltSize</td><td>-</td></tr>
                    <tr><td>Bolt Type</td><td>-</td><td>@result.BoltType</td><td>-</td></tr>
                    <tr><td>Strength Class</td><td>-</td><td>@input.StrengthClass</td><td>-</td></tr>
                    <tr><td>Nominal Diameter</td><td>d</td><td>@result.d.ToString("F2")</td><td>mm</td></tr>
                    <tr><td>Pitch Diameter</td><td>d<sub>2</sub></td><td>@result.d2.ToString("F2")</td><td>mm</td></tr>
                    <tr><td>Minor Diameter</td><td>d<sub>3</sub></td><td>@result.d3.ToString("F2")</td><td>mm</td></tr>
                    <tr><td>Pitch</td><td>P</td><td>@result.P.ToString("F2")</td><td>mm</td></tr>
                    <tr><td>Flank Angle</td><td>β</td><td>@result.FlankAngle.ToString("F0")</td><td>°</td></tr>
                    <tr><td>Head Diameter</td><td>d<sub>w</sub></td><td>@result.HeadDiameter.ToString("F2")</td><td>mm</td></tr>
                    <tr><td>Head Thickness</td><td>k</td><td>@result.HeadThickness.ToString("F1")</td><td>mm</td></tr>
                    <tr><td>Head Friction Factor</td><td>μ<sub>K</sub></td><td>@result.FrictionHead.ToString("F2")</td><td>-</td></tr>
                    <tr><td>Shank Diameter</td><td>d<sub>s</sub></td><td>@result.ShankDiameter.ToString("F2")</td><td>mm</td></tr>
                    <tr><td>Shank Length</td><td>l<sub>s</sub></td><td>@result.ShankLength.ToString("F1")</td><td>mm</td></tr>
                    <tr><td>Thread Surface Roughness</td><td>R<sub>z</sub></td><td>@result.ThreadRoughness.ToString("F1")</td><td>μm</td></tr>
                    <tr><td>Thread Friction Factor</td><td>μ<sub>G</sub></td><td>@result.FrictionThread.ToString("F2")</td><td>-</td></tr>
                    <tr><td>Tensile Strength</td><td>R<sub>m</sub></td><td>@result.Rm.ToString("F0")</td><td>MPa</td></tr>
                    <tr><td>Yield Strength</td><td>R<sub>p0.2</sub></td><td>@result.Rp02.ToString("F0")</td><td>MPa</td></tr>
                    <tr><td>Young's Modulus</td><td>E<sub>bolt</sub></td><td>@((result.YoungModulusBolt/1000).ToString("F0"))</td><td>GPa</td></tr>
                    <tr class="highlight"><td>Stress Area</td><td>A<sub>s</sub></td><td>@result.As.ToString("F1")</td><td>mm²</td></tr>
                    <tr><td>Required Bolt Length</td><td>L<sub>req</sub></td><td>@result.BoltLength.ToString("F0")</td><td>mm</td></tr>
                </tbody>
            </table>
        </div>

        <div class="card">
            <div class="card-header"><ModuleIcon Type="gear" Size="medium" Style="solid" /><h2>Bolt Assembly</h2></div>
            <table class="results-table">
                <thead><tr><th>Description</th><th>Symbol</th><th>Value</th><th>Unit</th></tr></thead>
                <tbody>
                    <tr><td>Bolting Type</td><td>-</td><td>@GetBoltingTypeName()</td><td>-</td></tr>
                    @* Read n from the RESULT, not from the input. With "Auto (Table 5.2/1)"
                       on - the default - input.LoadIntroductionFactor is just an unused
                       manual override sitting at 0, so this table used to contradict the
                       Compliance table a few cards down. *@
                    <tr><td>Load Factor</td><td>n</td><td>@result.LoadIntroductionFactor.ToString("F2")</td><td>-</td></tr>
                    <tr><td>Force Application Height</td><td>h<sub>n</sub></td><td>@((result.LoadIntroductionFactor * result.ClampLength).ToString("F2"))</td><td>mm</td></tr>
                    <tr><td>Tightening Technique</td><td>-</td><td>@input.TighteningMethod</td><td>-</td></tr>
                    <tr><td>Tightening Factor</td><td>α<sub>A</sub></td><td>@result.AlphaA.ToString("F2")</td><td>-</td></tr>
                </tbody>
            </table>
        </div>

        @if (input.JointType == JointType.ThroughHole)
        {
            <div class="card">
                <div class="card-header"><ModuleIcon Type="bolt" Size="medium" Style="solid" /><h2>Nut Specifications</h2></div>
                <table class="results-table">
                    <thead><tr><th>Description</th><th>Symbol</th><th>Value</th><th>Unit</th></tr></thead>
                    <tbody>
                        <tr><td>Nut Material</td><td>-</td><td>@result.NutMaterial</td><td>-</td></tr>
                        <tr><td>Nut Thickness</td><td>m</td><td>@result.NutThickness.ToString("F1")</td><td>mm</td></tr>
                        <tr><td>Nut Diameter</td><td>d<sub>w,nut</sub></td><td>@result.NutDiameter.ToString("F1")</td><td>mm</td></tr>
                        <tr><td>Nut Surface Roughness</td><td>R<sub>z</sub></td><td>@result.NutRoughness.ToString("F1")</td><td>μm</td></tr>
                    </tbody>
                </table>
            </div>
        }

        <div class="card">
            <div class="card-header"><ModuleIcon Type="dimensions" Size="medium" Style="solid" /><h2>Clamped Parts</h2></div>
            <table class="results-table">
                <thead><tr><th>Description</th><th>Symbol</th><th>Value</th><th>Unit</th></tr></thead>
                <tbody>
                    @foreach (var part in input.ClampedParts)
                    {
                        <tr><td>Part Material</td><td>-</td><td>@part.MaterialName</td><td>-</td></tr>
                        <tr><td>Part Thickness</td><td>t</td><td>@part.Thickness.ToString("F1")</td><td>mm</td></tr>
                        <tr><td>Young's Modulus</td><td>E<sub>p</sub></td><td>@((part.ElasticModulus/1000).ToString("F0"))</td><td>GPa</td></tr>
                        <tr><td colspan="4" style="border-bottom: 2px solid #dee2e6;"></td></tr>
                    }
                    <tr class="highlight"><td>Total Clamping Length</td><td>l<sub>K</sub></td><td>@result.ClampLength.ToString("F1")</td><td>mm</td></tr>
                    <tr><td>Parts Friction Factor</td><td>μ<sub>T</sub></td><td>@result.FrictionParts.ToString("F2")</td><td>-</td></tr>
                    <tr><td>Hole Diameter</td><td>d<sub>h</sub></td><td>@result.HoleDiameter.ToString("F1")</td><td>mm</td></tr>
                    @if (result.ChamferDiameter > 0)
                    {
                        <tr><td>Chamfer Diameter</td><td>d<sub>c</sub></td><td>@result.ChamferDiameter.ToString("F1")</td><td>mm</td></tr>
                    }
                </tbody>
            </table>
        </div>

        @if (input.UseWasherUnderHead || input.UseWasherUnderNut)
        {
            <div class="card">
                <div class="card-header"><ModuleIcon Type="diameter" Size="medium" Style="solid" /><h2>Washer Specifications</h2></div>
                <table class="results-table">
                    <thead><tr><th>Description</th><th>Symbol</th><th>Value</th><th>Unit</th></tr></thead>
                    <tbody>
                        <tr><td>Washer Material</td><td>-</td><td>@result.WasherMaterial</td><td>-</td></tr>
                        <tr><td>Washer Thickness</td><td>h</td><td>@result.WasherThickness.ToString("F2")</td><td>mm</td></tr>
                        <tr><td>Inner Diameter</td><td>d<sub>1</sub></td><td>@result.WasherDiameterInner.ToString("F2")</td><td>mm</td></tr>
                        <tr><td>Outer Diameter</td><td>d<sub>2</sub></td><td>@result.WasherDiameterOuter.ToString("F2")</td><td>mm</td></tr>
                        <tr><td>Washer Surface Roughness</td><td>R<sub>z</sub></td><td>@result.WasherRoughness.ToString("F1")</td><td>μm</td></tr>
                        @if (input.UseWasherUnderHead)
                        {
                            <tr><td>Location</td><td>-</td><td colspan="2">Under Head</td></tr>
                        }
                        @if (input.UseWasherUnderNut && input.JointType == JointType.ThroughHole)
                        {
                            <tr><td>Location</td><td>-</td><td colspan="2">Under Nut</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <div class="card">
            <div class="card-header"><ModuleIcon Type="force" Size="medium" Style="solid" /><h2>Compliance & Force Distribution</h2></div>
            <table class="results-table">
                 <thead><tr><th>Description</th><th>Symbol</th><th>Value</th><th>Unit</th></tr></thead>
                 <tbody>
                    <tr><td>Substitutional Diameter (Interface)</td><td>D<sub>A</sub></td><td>@result.DA.ToString("F2")</td><td>mm</td></tr>
                    <tr><td>Substitutional Diameter (Solid)</td><td>D<sub>An</sub></td><td>@result.DAn.ToString("F2")</td><td>mm</td></tr>
                    <tr><td>Limiting Diameter (Max Cone)</td><td>D<sub>A,Gr</sub></td><td>@result.DA_Gr.ToString("F2")</td><td>mm</td></tr>
                    <tr><td>Cone Angle</td><td>φ</td><td>@result.ConeAngle.ToString("F2")</td><td>°</td></tr>
                    <tr><td>Elastic Resilience (Bolt)</td><td>δ<sub>S</sub></td><td>@((result.DeltaS).ToString("0.0000000e+00"))</td><td>mm/N</td></tr>
                    <tr><td>Elastic Resilience (Parts)</td><td>δ<sub>P</sub></td><td>@((result.DeltaP).ToString("0.0000000e+00"))</td><td>mm/N</td></tr>
                    @if (result.DeltaPWasher > 0)
                    {
                        <tr><td>Elastic Resilience (Washer)</td><td>δ<sub>Pzu</sub></td><td>@((result.DeltaPWasher).ToString("0.0000000e+00"))</td><td>mm/N</td></tr>
                    }
                    <tr><td>Load Factor (Φ)</td><td>Φ</td><td>@result.Phi.ToString("F3")</td><td>-</td></tr>
                    <tr class="highlight"><td>Load Introduction Factor (Table 5.2/1)</td><td>n</td><td>@result.LoadIntroductionFactor.ToString("F3")</td><td>-</td></tr>
                    <tr><td>Ratio ak/h</td><td>a<sub>k</sub>/h</td><td>@result.AkOverH.ToString("F2")</td><td>-</td></tr>
                    <tr><td>Ratio lA/h</td><td>l<sub>A</sub>/h</td><td>@result.LAOverH.ToString("F2")</td><td>-</td></tr>
                    <tr><td>Effective Load Factor</td><td>Φ<sub>n</sub></td><td>@result.PhiN.ToString("F4")</td><td>-</td></tr>
                    <tr><td>Embedding (Total)</td><td>f<sub>Z</sub></td><td>@result.FZ_total_um.ToString("F1")</td><td>μm</td></tr>
                    <tr><td>Preload Loss (Settling)</td><td>F<sub>Z</sub></td><td>@result.FZ.ToString("F0")</td><td>N</td></tr>
                    @* FKR is the clamp force the joint must still carry in SERVICE - the
                       larger of the slip requirement and the residual clamp force the user
                       asked for. It is genuinely 0 for a purely axial, concentric joint
                       with neither, which is why this can legitimately read 0.00. The
                       preload needed to assemble it is FM,min, further down. *@
                    <tr>
                        <td>Required Clamp Force in Service</td>
                        <td>F<sub>KR</sub></td>
                        <td>@((result.FKR_min / 1000).ToString("F2"))</td>
                        <td>kN</td>
                    </tr>
                    @if (result.FKR_min <= 0)
                    {
                        <tr>
                            <td colspan="4" style="font-size: 12px; color: #666; font-style: italic;">
                                No shear load and no residual clamp force requested, so nothing has to
                                remain clamped in service. The assembly preload is still sized by
                                embedding and the external load — see F<sub>M,min</sub> below.
                            </td>
                        </tr>
                    }
                    <tr><td>Additional Bolt Force</td><td>F<sub>SA</sub></td><td>@((result.FSA / 1000).ToString("F2"))</td><td>kN</td></tr>
                    <tr><td>Clamp Force Reduction</td><td>F<sub>PA</sub></td><td>@((result.FPA / 1000).ToString("F2"))</td><td>kN</td></tr>
                 </tbody>
            </table>
        </div>

        <!-- Three Force Scenarios Section -->
        <div class="card">
            <div class="card-header"><ModuleIcon Type="gear" Size="medium" Style="solid" /><h2>Assembly Preload Analysis</h2></div>
            <p style="padding: 0 16px; color: #666; font-size: 13px; margin-bottom: 16px;">
                Results calculated for three critical force scenarios according to VDI 2230
            </p>

            <!-- Scenario 1: Maximum Pretension Force -->
            <div class="scenario-section">
                <h3 class="scenario-title">1. Maximum Pretension Force (F<sub>0.9,max</sub>)</h3>
                <p class="scenario-desc">Maximum preload achievable at 90% yield strength utilization</p>
                <table class="results-table">
                    <thead><tr><th>Description</th><th>Symbol</th><th>Value</th><th>Unit</th></tr></thead>
                    <tbody>
                        <tr class="highlight"><td>Maximum Pretension Force</td><td>F<sub>0.9,max</sub></td><td>@((result.F09_max / 1000).ToString("F2"))</td><td>kN</td></tr>
                        <tr><td>Working Bolt Force</td><td>F<sub>S</sub></td><td>@((result.FS_at_F09max / 1000).ToString("F2"))</td><td>kN</td></tr>
                        <tr><td>Working Clamp Force</td><td>F<sub>K</sub></td><td>@((result.FK_at_F09max / 1000).ToString("F2"))</td><td>kN</td></tr>
                        <tr><td>Additional Plate Force</td><td>F<sub>PA</sub></td><td>@((result.AdditionalPlateForce / 1000).ToString("F2"))</td><td>kN</td></tr>
                        <tr><td>Bolt Extension</td><td>f<sub>S</sub></td><td>@result.BoltExtension_at_F09max.ToString("F1")</td><td>μm</td></tr>
                        <tr><td>Part Compression</td><td>f<sub>P</sub></td><td>@result.PartExtension_at_F09max.ToString("F1")</td><td>μm</td></tr>
                        <tr><td>Surface Pressure (Head)</td><td>p<sub>head</sub></td><td>@result.PressureHead_at_F09max.ToString("F1")</td><td>MPa</td></tr>
                        @if (input.JointType == JointType.ThroughHole)
                        {
                            <tr><td>Surface Pressure (Nut)</td><td>p<sub>nut</sub></td><td>@result.PressureNut_at_F09max.ToString("F1")</td><td>MPa</td></tr>
                        }
                        <tr><td>Tensile Stress</td><td>σ<sub>z</sub></td><td>@result.SigmaZ_at_F09max.ToString("F0")</td><td>MPa</td></tr>
                        <tr><td>Torsional Stress</td><td>τ</td><td>@result.Tau_at_F09max.ToString("F0")</td><td>MPa</td></tr>
                        <tr><td>Equivalent Stress</td><td>σ<sub>red</sub></td><td>@result.SigmaRed_at_F09max.ToString("F0")</td><td>MPa</td></tr>
                        <tr class="@(result.Utilization_at_F09max > 90 ? "warning" : "success")"><td>Yield Utilization</td><td>f<sub>y</sub></td><td>@result.Utilization_at_F09max.ToString("F1")</td><td>%</td></tr>
                        <tr><td>Embedding (Settling)</td><td>f<sub>Z</sub></td><td>@result.FZ_um_at_F09max.ToString("F1")</td><td>μm</td></tr>
                        <tr><td>Preload Loss (Settling)</td><td>F<sub>Z</sub></td><td>@((result.FZ_at_F09max / 1000).ToString("F2"))</td><td>kN</td></tr>
                        <tr class="highlight"><td>Tightening Torque (Total)</td><td>M<sub>A</sub></td><td>@result.MA_at_F09max.ToString("F1")</td><td>Nm</td></tr>
                        <tr><td>Thread Friction Torque</td><td>M<sub>G</sub></td><td>@result.MG_at_F09max.ToString("F1")</td><td>Nm</td></tr>
                        <tr><td>Head Friction Torque</td><td>M<sub>K</sub></td><td>@result.MK_at_F09max.ToString("F1")</td><td>Nm</td></tr>
                    </tbody>
                </table>
            </div>

            <!-- Scenario 2: Minimum Required Assembly Preload -->
            <div class="scenario-section">
                <h3 class="scenario-title">2. Minimum Required Assembly Preload (F<sub>M,min</sub>)</h3>
                <p class="scenario-desc">Minimum preload required to maintain clamp force under service conditions</p>
                <table class="results-table">
                    <thead><tr><th>Description</th><th>Symbol</th><th>Value</th><th>Unit</th></tr></thead>
                    <tbody>
                        <tr class="highlight"><td>Minimum Required Preload</td><td>F<sub>M,min</sub></td><td>@((result.FM_min / 1000).ToString("F2"))</td><td>kN</td></tr>
                        <tr><td>Working Bolt Force</td><td>F<sub>S</sub></td><td>@((result.FS_at_FMmin / 1000).ToString("F2"))</td><td>kN</td></tr>
                        <tr><td>Working Clamp Force</td><td>F<sub>K</sub></td><td>@((result.FK_at_FMmin / 1000).ToString("F2"))</td><td>kN</td></tr>
                        <tr><td>Additional Plate Force</td><td>F<sub>PA</sub></td><td>@((result.AdditionalPlateForce / 1000).ToString("F2"))</td><td>kN</td></tr>
                        <tr><td>Bolt Extension</td><td>f<sub>S</sub></td><td>@result.BoltExtension_at_FMmin.ToString("F1")</td><td>μm</td></tr>
                        <tr><td>Part Compression</td><td>f<sub>P</sub></td><td>@result.PartExtension_at_FMmin.ToString("F1")</td><td>μm</td></tr>
                        <tr><td>Surface Pressure (Head)</td><td>p<sub>head</sub></td><td>@result.PressureHead_at_FMmin.ToString("F1")</td><td>MPa</td></tr>
                        @if (input.JointType == JointType.ThroughHole)
                        {
                            <tr><td>Surface Pressure (Nut)</td><td>p<sub>nut</sub></td><td>@result.PressureNut_at_FMmin.ToString("F1")</td><td>MPa</td></tr>
                        }
                        <tr><td>Tensile Stress</td><td>σ<sub>z</sub></td><td>@result.SigmaZ_at_FMmin.ToString("F0")</td><td>MPa</td></tr>
                        <tr><td>Torsional Stress</td><td>τ</td><td>@result.Tau_at_FMmin.ToString("F0")</td><td>MPa</td></tr>
                        <tr><td>Equivalent Stress</td><td>σ<sub>red</sub></td><td>@result.SigmaRed_at_FMmin.ToString("F0")</td><td>MPa</td></tr>
                        <tr class="@(result.Utilization_at_FMmin > 90 ? "warning" : "success")"><td>Yield Utilization</td><td>f<sub>y</sub></td><td>@result.Utilization_at_FMmin.ToString("F1")</td><td>%</td></tr>
                        <tr><td>Embedding (Settling)</td><td>f<sub>Z</sub></td><td>@result.FZ_um_at_FMmin.ToString("F1")</td><td>μm</td></tr>
                        <tr><td>Preload Loss (Settling)</td><td>F<sub>Z</sub></td><td>@((result.FZ_at_FMmin / 1000).ToString("F2"))</td><td>kN</td></tr>
                        <tr class="highlight"><td>Tightening Torque (Total)</td><td>M<sub>A</sub></td><td>@result.MA_at_FMmin.ToString("F1")</td><td>Nm</td></tr>
                        <tr><td>Thread Friction Torque</td><td>M<sub>G</sub></td><td>@result.MG_at_FMmin.ToString("F1")</td><td>Nm</td></tr>
                        <tr><td>Head Friction Torque</td><td>M<sub>K</sub></td><td>@result.MK_at_FMmin.ToString("F1")</td><td>Nm</td></tr>
                    </tbody>
                </table>
            </div>

            <!-- Scenario 3: Maximum Required Assembly Preload -->
            <div class="scenario-section">
                <h3 class="scenario-title">3. Maximum Required Assembly Preload (F<sub>M,max</sub>)</h3>
                <p class="scenario-desc">Maximum preload considering tightening factor (α<sub>A</sub> = @result.AlphaA.ToString("F2"))</p>
                <table class="results-table">
                    <thead><tr><th>Description</th><th>Symbol</th><th>Value</th><th>Unit</th></tr></thead>
                    <tbody>
                        <tr class="highlight"><td>Maximum Required Preload</td><td>F<sub>M,max</sub></td><td>@((result.FM_max / 1000).ToString("F2"))</td><td>kN</td></tr>
                        <tr><td>Working Bolt Force</td><td>F<sub>S,max</sub></td><td>@((result.FS_max / 1000).ToString("F2"))</td><td>kN</td></tr>
                        <tr><td>Working Clamp Force</td><td>F<sub>K,min</sub></td><td>@((result.FK_min / 1000).ToString("F2"))</td><td>kN</td></tr>
                        <tr><td>Additional Plate Force</td><td>F<sub>PA</sub></td><td>@((result.AdditionalPlateForce / 1000).ToString("F2"))</td><td>kN</td></tr>
                        <tr><td>Bolt Extension</td><td>f<sub>S</sub></td><td>@((result.BoltExtension * 1000).ToString("F1"))</td><td>μm</td></tr>
                        <tr><td>Part Compression</td><td>f<sub>P</sub></td><td>@((result.PartsExtension * 1000).ToString("F1"))</td><td>μm</td></tr>
                        <tr><td>Surface Pressure (Head)</td><td>p<sub>head</sub></td><td>@result.PressureHead_at_FMmax.ToString("F1")</td><td>MPa</td></tr>
                        @if (input.JointType == JointType.ThroughHole)
                        {
                            <tr><td>Surface Pressure (Nut)</td><td>p<sub>nut</sub></td><td>@result.PressureNut_at_FMmax.ToString("F1")</td><td>MPa</td></tr>
                        }
                        <tr><td>Tensile Stress</td><td>σ<sub>z</sub></td><td>@result.SigmaZ_assembly.ToString("F0")</td><td>MPa</td></tr>
                        <tr><td>Torsional Stress</td><td>τ</td><td>@result.Tau_assembly.ToString("F0")</td><td>MPa</td></tr>
                        <tr><td>Equivalent Stress</td><td>σ<sub>red</sub></td><td>@result.SigmaRed_assembly.ToString("F0")</td><td>MPa</td></tr>
                        <tr class="@(result.Utilization > 90 ? "warning" : "success")"><td>Yield Utilization</td><td>f<sub>y</sub></td><td>@result.Utilization.ToString("F1")</td><td>%</td></tr>
                        <tr><td>Embedding (Settling)</td><td>f<sub>Z</sub></td><td>@result.FZ_um_at_FMmax.ToString("F1")</td><td>μm</td></tr>
                        <tr><td>Preload Loss (Settling)</td><td>F<sub>Z</sub></td><td>@((result.FZ_at_FMmax / 1000).ToString("F2"))</td><td>kN</td></tr>
                        <tr class="highlight"><td>Tightening Torque (Total)</td><td>M<sub>A</sub></td><td>@result.MA.ToString("F1")</td><td>Nm</td></tr>
                        <tr><td>Thread Friction Torque</td><td>M<sub>G</sub></td><td>@result.MG_at_FMmax.ToString("F1")</td><td>Nm</td></tr>
                        <tr><td>Head Friction Torque</td><td>M<sub>K</sub></td><td>@result.MK_at_FMmax.ToString("F1")</td><td>Nm</td></tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Allowable Values Card -->
        <div class="card">
            <div class="card-header"><ModuleIcon Type="info" Size="medium" Style="solid" /><h2>Allowable Values</h2></div>
            <table class="results-table">
                 <thead><tr><th>Description</th><th>Symbol</th><th>Value</th><th>Unit</th></tr></thead>
                 <tbody>
                    <tr><td>Allowable Surface Pressure</td><td>p<sub>allow</sub></td><td>@result.PressureAllowable.ToString("F1")</td><td>MPa</td></tr>
                    <tr><td>Yield Strength</td><td>R<sub>p0.2</sub></td><td>@result.Rp02.ToString("F0")</td><td>MPa</td></tr>
                    <tr><td>Tensile Strength</td><td>R<sub>m</sub></td><td>@result.Rm.ToString("F0")</td><td>MPa</td></tr>
                    <tr><td>Loosening Torque</td><td>M<sub>L</sub></td><td>@result.ML.ToString("F1")</td><td>Nm</td></tr>
                 </tbody>
            </table>
        </div>

        <div class="card">
            <div class="card-header"><ModuleIcon Type="safety" Size="medium" Style="solid" /><h2>Safety Factors</h2></div>
            <table class="results-table">
                 <thead><tr><th>Description</th><th>Symbol</th><th>Value</th><th>Status</th></tr></thead>
                 <tbody>
                    <tr class="@(GetSafetyRowClass(result.SF_yield, 1.1))">
                        <td>Yielding (Assembly)</td>
                        <td>SF<sub>yield</sub></td>
                        <td>@result.SF_yield.ToString("F2")</td>
                        <td>@GetStatus(result.SF_yield, 1.1)</td>
                    </tr>
                    @* With no residual clamp force required and no shear load, FKR_min is
                       legitimately 0 - there is no requirement to fall short of. Say that,
                       rather than printing an infinity that reads as a divide-by-zero. *@
                    <tr class="@(result.FKR_min > 0 ? GetSafetyRowClass(result.SF_clamp, 1.2) : "")">
                        <td>Loss of Clamp</td>
                        <td>SF<sub>clamp</sub></td>
                        <td>@(result.FKR_min > 0 ? result.SF_clamp.ToString("F2") : "n/a")</td>
                        <td>@(result.FKR_min > 0 ? GetStatus(result.SF_clamp, 1.2) : "no clamp force required")</td>
                    </tr>
                    @if (input.ShearForce > 0)
                    {
                        <tr class="@(GetSafetyRowClass(result.SF_slip, 1.1))">
                            <td>Slipping</td>
                            <td>SF<sub>slip</sub></td>
                            <td>@result.SF_slip.ToString("F2")</td>
                             <td>@GetStatus(result.SF_slip, 1.1)</td>
                        </tr>
                    }
                    <tr class="@(GetSafetyRowClass(result.SF_pressure, 1.0))">
                        <td>Surface Pressure</td>
                        <td>SF<sub>p</sub></td>
                        <td>@result.SF_pressure.ToString("F2")</td>
                        <td>@GetStatus(result.SF_pressure, 1.0)</td>
                    </tr>
                    @* Gate on the engine's own verdict, not on the cycle count: a cycle
                       count means nothing if the load does not actually swing. *@
                    @if (result.FatigueRelevant)
                    {
                         <tr class="@(GetSafetyRowClass(result.SF_fatigue, 1.2))">
                            <td>Fatigue Failure</td>
                            <td>SF<sub>fatigue</sub></td>
                            <td>@result.SF_fatigue.ToString("F2")</td>
                            <td>@GetStatus(result.SF_fatigue, 1.2)</td>
                        </tr>
                    }
                    else
                    {
                        <tr>
                            <td>Fatigue Failure</td>
                            <td>SF<sub>fatigue</sub></td>
                            <td>n/a</td>
                            <td>static load, no amplitude</td>
                        </tr>
                    }
                 </tbody>
            </table>
        </div>

        @if (result.FatigueRelevant)
        {
            <div class="card">
                <div class="card-header"><ModuleIcon Type="loading" Size="medium" Style="solid" /><h2>Fatigue Analysis</h2></div>
                 <table class="results-table">
                     <thead><tr><th>Description</th><th>Symbol</th><th>Value</th><th>Unit</th></tr></thead>
                     <tbody>
                        <tr><td>Load Type (from FA range)</td><td>-</td><td colspan="2">@DescribeLoadType(result.LoadTypeUsed)</td></tr>
                        <tr class="highlight"><td>Fatigue Load (Amplitude)</td><td>F<sub>a</sub></td><td>@((result.FatigueLoad / 1000).ToString("F2"))</td><td>kN</td></tr>
                        <tr><td>Stress Amplitude</td><td>σ<sub>a</sub></td><td>@result.SigmaA.ToString("F1")</td><td>MPa</td></tr>
                        <tr><td>Mean Stress</td><td>σ<sub>m</sub></td><td>@result.SigmaM.ToString("F1")</td><td>MPa</td></tr>
                        <tr class="highlight"><td>Allowable Stress Amplitude</td><td>σ<sub>ASV</sub></td><td>@result.SigmaASV.ToString("F1")</td><td>MPa</td></tr>
                        <tr><td>Design Load Cycles</td><td>N<sub>design</sub></td><td>@FormatCycles(result.NumberOfLoadCycles)</td><td>cycles</td></tr>
                        <tr class="highlight"><td>Estimated Fatigue Life</td><td>N<sub>f</sub></td><td>@FormatCycles(result.FatigueLife)</td><td>cycles</td></tr>
                        <tr class="@(result.FatigueDamage > 1 ? "danger" : result.FatigueDamage > 0.5 ? "warning" : "success")"><td>Fatigue Damage</td><td>D</td><td>@result.FatigueDamage.ToString("F3")</td><td>-</td></tr>
                        <tr class="@(GetSafetyRowClass(result.SF_fatigue, 1.2))"><td>Fatigue Safety Factor</td><td>SF<sub>fatigue</sub></td><td>@result.SF_fatigue.ToString("F2")</td><td>-</td></tr>
                     </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="card">
                <div class="card-header"><ModuleIcon Type="loading" Size="medium" Style="solid" /><h2>Fatigue Analysis</h2></div>
                <div class="alert alert-info" style="margin: 16px;">
                    <ModuleIcon Type="info" Size="small" Style="default" />
                    <div>
                        <strong>Not applicable — the axial load does not cycle.</strong>
                        F<sub>A,min</sub> and F<sub>A,max</sub> are both @input.AxialForceMax.ToString("F0") N, so the
                        stress amplitude is zero and fatigue cannot govern. Enter a different
                        minimum axial force (0 N for a load that is fully released) to run the
                        VDI 2230 R12 check.
                    </div>
                </div>
            </div>
        }
    </div>

}

<style>

    /* Grid layout follows global form-grid (2-column default) */


    /* PDF Results - prevent empty first page */

    #results-content {

        display: block;

    }


    #results-content > .card:first-child {

        margin-top: 0;

        padding-top: 0;

    }


    #results-content .results-table {

        width: 100%;

        table-layout: fixed;

    }



    .info-box { margin-top: 12px; padding: 10px; background: #e8f4fc; border-radius: 8px; border: 1px solid #b8daef; }

    .info-box.small { padding: 8px; }

    .info-row { display: flex; justify-content: space-between; font-size: 13px; margin-bottom: 4px; }

    .info-row:last-child { margin-bottom: 0; }

    .info-row strong { color: #1565c0; }

    .info-highlight { margin-top: 12px; padding: 10px; background: #e3f2fd; border-radius: 6px; display: flex; justify-content: space-between; font-size: 14px; }

    .info-highlight strong { color: #1565c0; font-size: 16px; }



    .checkbox-row { display: flex; gap: 20px; }

    .checkbox-label { display: flex; align-items: center; gap: 6px; cursor: pointer; font-size: 14px; }



    /* Form row for side-by-side inputs */

    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }

    @@media (max-width: 768px) { .form-row { grid-template-columns: 1fr; } }



    .part-row { display: flex; gap: 8px; align-items: center; margin-bottom: 8px; }

    .part-num { width: 22px; height: 22px; background: #3498db; color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: bold; }

    .thickness-input { width: 80px; padding: 6px; border: 1px solid #dee2e6; border-radius: 4px; font-size: 14px; text-align: right; }

    /* Remove spinner arrows from number input */

    .thickness-input::-webkit-outer-spin-button,

    .thickness-input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }

    .thickness-input[type=number] { -moz-appearance: textfield; }



    /* Remove spinner arrows from friction coefficient inputs */

    .no-spinner::-webkit-outer-spin-button,

    .no-spinner::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }

    .no-spinner[type=number] { -moz-appearance: textfield; }

    .unit-small { font-size: 12px; color: #666; }

    .material-select { flex: 1; min-width: 90px; max-width: 110px; padding: 6px; border: 1px solid #dee2e6; border-radius: 4px; font-size: 12px; }

    .btn-remove { width: 26px; height: 26px; border: none; background: #fee; color: #c00; border-radius: 4px; cursor: pointer; }

    .btn-outline { background: transparent; border: 1px dashed #3498db; color: #3498db; }

    .hint { display: block; font-size: 11px; color: #888; margin-top: 4px; }



    .friction-section { margin-top: 16px; padding-top: 16px; border-top: 1px solid #e0e0e0; }

    .section-label { display: block; font-weight: 600; color: #2c3e50; margin-bottom: 10px; font-size: 14px; }



    /* Load section styling */

