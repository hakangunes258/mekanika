    /// <summary>
    /// VDI 2230 load type, derived from the axial load range:
    ///   Static      - the load never changes, so there is no stress amplitude.
    ///   Alternating - the load reverses sign (FA,min &lt; 0 &lt; FA,max).
    ///   Pulsating   - the load swings but keeps its sign (the usual case, e.g.
    ///                 1 kN to 5 kN, or a load applied and fully released).
    /// </summary>
    /// <summary>Why Calculate refused, shown by <see cref="ValidationAlert"/>.</summary>
    private List<string> validationMessages = new();

    private LoadType DetermineLoadType()
    {
        if (Math.Abs(input.AxialForceMax - input.AxialForceMin) < 1e-6)
            return LoadType.Static;

        return (input.AxialForceMin < 0 && input.AxialForceMax > 0)
            ? LoadType.Alternating
            : LoadType.Pulsating;
    }

    private string DescribeLoadType(LoadType t) => t switch
    {
        LoadType.Alternating => "Alternating (load reverses)",
        LoadType.Pulsating => "Pulsating (load swings, keeps sign)",
        _ => "Static (no load swing)"
    };

    private string GetSafetyRowClass(double sf, double min) => sf < min ? "danger" : sf < min * 1.2 ? "warning" : "success";

    private string GetStatus(double sf, double min) => sf < min ? "❌ FAIL" : sf < min * 1.2 ? "⚠️ Low" : "✓ OK";



    private string FormatCycles(double cycles)

    {

        if (cycles >= 1e10) return "∞ (Infinite)";

        if (cycles >= 1e9) return $"{cycles / 1e9:F1} × 10⁹";

        if (cycles >= 1e6) return $"{cycles / 1e6:F1} × 10⁶";

        if (cycles >= 1e3) return $"{cycles / 1e3:F1} × 10³";

        return cycles.ToString("F0");

    }

