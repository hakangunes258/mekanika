    .comparison-table td:nth-child(4) {

        background: rgba(155, 89, 182, 0.1);

    }



</style>


@code {

    private SingleBoltInput input = new();
    private ModuleInfo moduleInfo = new();

    private SingleBoltResult result = new();

    private bool showResults = false;
    private bool isCalculating = false;
    private bool isSavingPdf = false;

    private bool showRoughnessInfo = false;

    private bool showFrictionInfo = false;

    private bool showBoltingTypeInfo = false;

    private List<Material> materials = new();

    private List<ClampedPartUI> clampedParts = new();



    private string boltStandard = "ISO4014";

    private string threadConfig = "Full";

    private string selectedBoltingType = "SV1";

    private double frictionThread = 0.12;

