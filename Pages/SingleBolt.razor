    private void PreSizeBolt()

    {

        // Pre-size bolt based on VDI 2230 Table A7

        if (input.AxialForceMax <= 0)

        {

            // No load specified, can't pre-size

            return;

        }



        double loadKN = input.AxialForceMax / 1000.0;

        // Basic bolt size estimation based on load

        // Assumes stress ~50% of proof stress for safety

        var strengthClass = BoltService.GetStrengthClass(input.StrengthClass);

        if (strengthClass != null)

        {

            double allowableStress = strengthClass.Rp02 * 0.5; // 50% of proof stress

            double requiredAs = (loadKN * 1000) / allowableStress; // mm²



            // Find smallest bolt with sufficient stress area

            foreach (var bolt in BoltService.MetricBolts)

            {

                double As = Math.PI / 4.0 * Math.Pow((bolt.d2_coarse + bolt.d3_coarse) / 2.0, 2);

                if (As >= requiredAs)

                {

                    input.BoltSize = bolt.Size;

                    OnBoltSizeChanged();

                    break;

                }

            }

        }

    }



    private async Task Calculate()
    {
        isCalculating = true;
        StateHasChanged();
        await Task.Delay(350); // let the spinner render + feel responsive

        try
        {
            // Validation - name what is missing rather than returning in silence.
            validationMessages.Clear();
            if (string.IsNullOrEmpty(input.BoltSize)) validationMessages.Add("Select a bolt size.");
            if (input.AxialForceMax <= 0) validationMessages.Add("Max axial force (FA,max) must be greater than 0.");
            if (clampedParts.Count == 0) validationMessages.Add("Add at least one clamped part.");
            else if (clampedParts.Any(p => p.Thickness <= 0)) validationMessages.Add("Every clamped part needs a thickness greater than 0.");

            if (validationMessages.Count > 0)
            {
                await Analytics.TrackCalculationError("single-bolt", "validation_failed", string.Join("; ", validationMessages));
                return;
            }

            input.ClampedParts.Clear();

            foreach (var p in clampedParts)

            {

                input.ClampedParts.Add(new ClampedPart

                {

                    Thickness = p.Thickness,

                    MaterialName = p.MaterialName,

                    ElasticModulus = p.ElasticModulus,

                    ThermalExpansion = p.ThermalExpansion,

                    HoleDiameter = holeDiameter, // Use same hole diameter for all parts

                    SurfaceFinish = GetSurfaceFinishFromRoughness(roughnessParts)

                });

            }



            input.SurfaceCondition = "Custom";

            input.FrictionThread = frictionThread;

            input.FrictionHead = frictionHead;



            // Add roughness and other parameters

            input.ThreadRoughness = roughnessThread;

            input.HeadRoughness = roughnessHead;

            input.PartsRoughness = roughnessParts;

            input.ChamferDiameter = chamferDepth;

            // Set outer diameter for first clamped part (used for DA calculation)
            if (input.ClampedParts.Count > 0 && clampedPartsOuterDiameter > 0)
            {
                input.ClampedParts[0].OuterDiameter = clampedPartsOuterDiameter;
            }

            // Note: Eccentricity is used as lA for Table 5.2/1 calculation in the engine

            input.AutoCalculateLoadIntroductionFactor = autoLoadFactor;

            input.BoltStandard = boltStandard;

            input.BoltLength = boltLength;



            if (input.LoadCase == LoadCaseType.AxialOnly)

            {

                input.ShearForce = 0;

                input.BendingMoment = 0;

            }



            // Pass custom washer data if used

            if (isCustomWasher)

            {

                input.IsCustomWasher = true;

                input.CustomWasherD1 = customWasher.d1;

                input.CustomWasherD2 = customWasher.d2;

                input.CustomWasherH = customWasher.h;

            }

            else

            {

                input.IsCustomWasher = false;

            }



            // Always use load application factor = 1.0

            input.LoadApplicationFactorValue = 1.0;

            // The engine's R12 fatigue branch keys off LoadType. Nothing on this page
            // ever set it, so it stayed Static and the whole fatigue card rendered as
            // zeros - a false FAIL on perfectly sound dynamically loaded joints.
            // Derive it from the load range rather than adding a separate selector,
            // which could contradict FA,min / FA,max.
            input.LoadType = DetermineLoadType();

            result = new BoltCalculationEngine().Calculate(input);

            showResults = true;

            // Track successful calculation
            await Analytics.TrackCalculationCompleted("single-bolt", new Dictionary<string, object>
            {
                { "bolt_size", input.BoltSize },
                { "strength_class", input.StrengthClass },
                { "axial_force_max", input.AxialForceMax },
                { "load_case", input.LoadCase.ToString() }
            });
        }
        catch (Exception ex)
        {
            await Analytics.TrackCalculationError("single-bolt", "calculation_failed", ex.Message);
            throw;
        }
        finally
        {
            isCalculating = false;
        }
    }



    private string GetSurfaceFinishFromRoughness(double ra)

    {

        // Convert Ra (μm) to surface finish category for settling calculation

        if (ra <= 1.6) return "Ground";

        if (ra <= 10) return "Machined";

        if (ra <= 40) return "Rolled";

        return "As-cast";

    }



