    private void OnMaterialChanged(int index, ChangeEventArgs e)

    {

        var matName = e.Value?.ToString() ?? "S235JR";

        clampedParts[index].MaterialName = matName;

        var mat = materials.FirstOrDefault(m => m.Name == matName);

        if (mat != null) { clampedParts[index].ElasticModulus = mat.ElasticModulus * 1000; clampedParts[index].ThermalExpansion = mat.ThermalExpansion * 1e-6; }

    }



    private double CalculateClampLength()

    {

        double lK = clampedParts.Sum(p => p.Thickness);

        if (selectedWasher != null)

        {

            if (input.UseWasherUnderHead) lK += selectedWasher.h;

            if (input.UseWasherUnderNut && input.JointType == JointType.ThroughHole) lK += selectedWasher.h;

        }

        return lK;

    }



    private void AddPart()

    {

        if (clampedParts.Count < 5)

        {

            var mat = materials.FirstOrDefault(m => m.Name == "S235JR") ?? materials.FirstOrDefault();

            clampedParts.Add(new ClampedPartUI { Thickness = 10, MaterialName = mat?.Name ?? "S235JR", ElasticModulus = (mat?.ElasticModulus ?? 210) * 1000, ThermalExpansion = (mat?.ThermalExpansion ?? 12) * 1e-6 });

        }

    }



    private void RemovePart(int index) { if (clampedParts.Count > 1) clampedParts.RemoveAt(index); }



    private void AutoSizeBoltLength()
    {
        // Calculate required bolt length based on clamped parts + nut/engagement
        double lK = CalculateClampLength();
        double threadEngagement;

        if (input.JointType == JointType.ThroughHole)
        {
            // Through hole: nut height + 2 pitches protrusion
            threadEngagement = (selectedBolt?.m_nut ?? 0) + 2 * (selectedBolt?.P_coarse ?? 1.5);
        }
        else
        {
            // Blind hole (tapped): thread engagement into last part
            double d = selectedBolt?.d ?? 10;
            double P = selectedBolt?.P_coarse ?? 1.5;
            var lastPart = clampedParts.LastOrDefault();
            double lastPartThickness = lastPart?.Thickness ?? 0;

            // Thread engagement factor based on last part material
            string lastPartMat = lastPart?.MaterialName?.ToLower() ?? "steel";
            double engagementFactor = (lastPartMat.Contains("alumin") ||
                                       lastPartMat.Contains("cast") ||
                                       lastPartMat.Contains("gj") ||
                                       lastPartMat.Contains("al")) ? 1.5 : 1.0;

            double minEngagement = engagementFactor * d;

            if (lastPartThickness >= minEngagement)
                threadEngagement = 0;
            else
                threadEngagement = minEngagement - lastPartThickness;

            threadEngagement += 2 * P; // Safety margin
        }

        boltLength = Math.Ceiling((lK + threadEngagement) / 5.0) * 5.0;
    }



