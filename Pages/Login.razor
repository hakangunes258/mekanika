@page "/login"
@inject SupabaseAuthService Auth
@inject SupabaseConfig Config
@inject NavigationManager Navigation

<PageTitle>Sign In - Mekanika</PageTitle>

<div class="page-header">
    <h1>Sign in to Mekanika</h1>
    <p>Save your calculations and reopen them from any device. Free — the calculators stay open to everyone.</p>
</div>

<div class="auth-card">
    @if (!Config.IsConfigured)
    {
        <div class="alert alert-warning">
            <div>Sign-in is not configured yet. Please check back soon.</div>
        </div>
    }
    else
    {
        <button class="btn btn-google" @onclick="SignInWithGoogle">
            <span class="g-mark">G</span>
            <span>Continue with Google</span>
        </button>

        <div class="auth-divider"><span>or</span></div>

        @if (magicLinkSent)
        {
            <div class="alert alert-success">
                <div>
                    <strong>Check your email.</strong> We sent a sign-in link to
                    <strong>@email</strong>. Open it on this device to finish signing in.
                </div>
            </div>
        }
        else
        {
            <div class="form-group">
                <label>Email address</label>
                <input type="email" class="auth-input" @bind="email" @bind:event="oninput"
                       placeholder="you@@company.com" @onkeydown="OnKeyDown" />
            </div>

            @if (error != null)
            {
                <div class="alert alert-danger"><div>@error</div></div>
            }

            <button class="btn btn-success btn-block @(isSending ? "btn-calculating" : "")"
                    @onclick="SendMagicLink" disabled="@(isSending || !IsEmailValid)">
                @if (isSending)
                {
                    <span class="spinner"></span>
                    <span>Sending…</span>
                }
                else
                {
                    <span>Email me a sign-in link</span>
                }
            </button>
        }

        <p class="auth-fineprint">
            By continuing you agree to our <a href="/privacy">Privacy Policy</a>.
            No password required.
        </p>
    }
</div>

<style>
    .auth-card {
        max-width: 420px;
        margin: 0 auto;
        background: white;
        border: 1px solid #dee2e6;
        border-radius: 16px;
        padding: 32px;
        box-shadow: 0 4px 16px rgba(0,0,0,0.06);
    }

    .btn-block { width: 100%; justify-content: center; }

    .btn-google {
        width: 100%;
        justify-content: center;
        gap: 10px;
        background: white;
        color: #2c3e50;
        border: 1px solid #ced4da;
        font-weight: 600;
    }
    .btn-google:hover { background: #f8f9fa; }
    .g-mark {
        font-weight: 700;
        color: #4285F4;
        font-family: Arial, sans-serif;
        font-size: 18px;
    }

    .auth-divider {
        display: flex;
        align-items: center;
        text-align: center;
        color: #adb5bd;
        font-size: 13px;
        margin: 20px 0;
    }
    .auth-divider::before, .auth-divider::after {
        content: "";
        flex: 1;
        border-bottom: 1px solid #e9ecef;
    }
    .auth-divider span { padding: 0 12px; }

    .auth-input {
        width: 100%;
        padding: 11px 12px;
        border: 1px solid #ced4da;
        border-radius: 8px;
        font-size: 15px;
    }

    .auth-fineprint {
        margin-top: 18px;
        font-size: 12px;
        color: #6c757d;
        text-align: center;
    }
    .auth-fineprint a { color: #0077be; text-decoration: none; font-weight: 600; }
</style>

@code {
    private string email = "";
    private bool isSending = false;
    private bool magicLinkSent = false;
    private string? error = null;

    private bool IsEmailValid =>
        !string.IsNullOrWhiteSpace(email) && email.Contains('@') && email.Contains('.');

    protected override async Task OnInitializedAsync()
    {
        // Someone already signed in has no business on the login page.
        var session = await Auth.InitializeAsync();
        if (session != null && !session.IsExpired)
            Navigation.NavigateTo("/my-calculations");
    }

    private void SignInWithGoogle() => Auth.SignInWithGoogle();

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && IsEmailValid && !isSending)
            await SendMagicLink();
    }

    private async Task SendMagicLink()
    {
        if (!IsEmailValid) return;

        isSending = true;
        error = null;
        StateHasChanged();

        var (ok, err) = await Auth.SendMagicLinkAsync(email.Trim());

        isSending = false;
        if (ok) magicLinkSent = true;
        else error = err ?? "Could not send the link. Please try again.";
    }
}
