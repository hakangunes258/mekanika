<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MechanicalCalculatorWeb</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Authentication" Version="8.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="AnalyticsProxy\**" />
    <Content Remove="AnalyticsProxy\**" />
    <EmbeddedResource Remove="AnalyticsProxy\**" />
    <None Remove="AnalyticsProxy\**" />
  </ItemGroup>

  <!--
    Local editing backups live alongside the real assets in wwwroot. They are
    excluded from git, but publish copies everything under wwwroot, which was
    putting stale copies of the site's scripts on the public server.
  -->
  <ItemGroup>
    <Content Remove="wwwroot\**\*.bak" />
    <Content Remove="wwwroot\**\*.backup" />
    <Content Remove="wwwroot\**\*.orig" />
  </ItemGroup>

</Project>
