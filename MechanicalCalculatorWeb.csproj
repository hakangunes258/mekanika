<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MechanicalCalculatorWeb</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Authentication" Version="8.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="8.0.0" />
  </ItemGroup>

  <!--
    This project sits at the repo root, so the SDK's default glob would sweep in
    every .cs file under it - including the test project. Without this the test
    sources are compiled into the web app, which fails because it has no xunit
    reference, and the error is reported against this project rather than against
    Tests. (The AnalyticsProxy excludes that used to be here were removed with the
    folder itself; they had outlived it by some time.)
  -->
  <ItemGroup>
    <Compile Remove="Tests\**" />
    <Content Remove="Tests\**" />
    <EmbeddedResource Remove="Tests\**" />
    <None Remove="Tests\**" />
  </ItemGroup>

  <!--
    The build stamp, as a compiled constant.

    The deploy workflow passes -p:BuildStamp=<date>-<short sha>; anything built
    without it is stamped "dev", which is what a local run is. It reaches the PDF
    report, the sidebar, the About page and the cache key on the reference content
    files.

    Why it is generated rather than hand-maintained: this repo already carries two
    records of a hand-kept number drifting - the paired ?v= query strings on the two
    stylesheets, where one was bumped and the other was not, and the .results-table
    column rules duplicated across eleven pages. A third number that someone has to
    remember to bump on every deploy would be the same trap. A short SHA written by
    the runner cannot be forgotten, and it maps a saved report straight back to a
    commit.

    Why a const and not an assembly attribute: a const survives trimming with
    nothing to configure, and it is readable during host startup - which is when
    Program.cs hands it to the PDF generator, before the first render.

    RequireBuildStamp is the guard for the one failure that would otherwise ship
    silently: the workflow forgetting to pass the stamp and the site going live
    saying "dev".
  -->
  <Target Name="StampBuildInfo" BeforeTargets="BeforeCompile">
    <PropertyGroup>
      <BuildStamp Condition="'$(BuildStamp)' == ''">dev</BuildStamp>
      <BuildInfoFile>$(IntermediateOutputPath)BuildInfo.g.cs</BuildInfoFile>
    </PropertyGroup>

    <Error Condition="'$(RequireBuildStamp)' == 'true' AND '$(BuildStamp)' == 'dev'"
           Text="RequireBuildStamp is set but no BuildStamp was supplied, so this build would go out stamped 'dev'. Pass -p:BuildStamp=&lt;date&gt;-&lt;sha&gt;." />

    <WriteLinesToFile File="$(BuildInfoFile)"
                      Lines="// Generated by the StampBuildInfo target in MechanicalCalculatorWeb.csproj. Do not edit.;namespace MechanicalCalculatorWeb.Services%3B;public static class BuildInfo { public const string Stamp = &quot;$(BuildStamp)&quot;%3B }"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />

    <ItemGroup>
      <Compile Include="$(BuildInfoFile)" />
    </ItemGroup>
  </Target>

  <!--
    Local editing backups live alongside the real assets in wwwroot. They are
    excluded from git, but publish copies everything under wwwroot, which was
    putting stale copies of the site's scripts on the public server.
  -->
  <ItemGroup>
    <Content Remove="wwwroot\**\*.bak" />
    <Content Remove="wwwroot\**\*.backup" />
    <Content Remove="wwwroot\**\*.orig" />
  </ItemGroup>

</Project>
