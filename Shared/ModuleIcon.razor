@*
    Mekanika icon set — inline single-line SVGs (1.6px, 24px grid), all currentColor
    so an icon takes the text/button colour of wherever it sits. Source of truth:
    the "İkon Seti" design handoff.

    Rendering inline (not <img src>) means: no per-icon HTTP request, colour follows
    currentColor with no CSS filter hacks, and — importantly — the component no longer
    ships a <style> block on every use (that used to leak raw CSS into button text and
    the accessibility tree). All styling now lives in wwwroot/css/modern-icons.css.

    The Type/Size/Style parameter API is unchanged, so existing call sites keep working.
*@

<span class="module-icon @SizeClass @StyleClass" style="@CustomStyle" role="img" aria-label="@Type">
    @if (Inner is not null)
    {
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"
             stroke-linecap="round" stroke-linejoin="round">
            @Inner
        </svg>
    }
</span>

@code {
    [Parameter] public string Type { get; set; } = "default";
    [Parameter] public string Size { get; set; } = "medium";  // small, medium, large, xlarge, button
    [Parameter] public string Style { get; set; } = "default"; // default, gradient, solid, outline, transparent
    [Parameter] public string CustomStyle { get; set; } = "";

    private MarkupString? Inner => Icons.TryGetValue(Resolve(Type), out var svg)
        ? (MarkupString)svg
        : (MarkupString?)null;

    // Aliases → canonical icon key.
    private static string Resolve(string type) => type switch
    {
        "gear-pair"                    => "gear",
        "bearing"                      => "ball-bearing",
        "compression"                  => "spring",
        "compression-spring"           => "spring",
        "extension-spring"             => "tension",
        "torsion-spring"               => "torque",
        "dimension"                    => "dimensions",
        "inertia"                      => "moment-inertia",
        "force"                        => "loading",
        "lifetime"                     => "life-time",
        "life"                         => "life-time",
        "help"                         => "info",
        "about"                        => "info",
        "warning"                      => "warning",
        "clear"                        => "new",
        "design"                       => "operation-conditions",
        "materials"                    => "material",
        _                              => type
    };

    private string SizeClass => Size switch
    {
        "small"  => "icon-sm",
        "button" => "icon-btn",
        "medium" => "icon-md",
        "large"  => "icon-lg",
        "xlarge" => "icon-xl",
        _        => "icon-md"
    };

    private string StyleClass => Style switch
    {
        "gradient"    => "icon-gradient",
        "solid"       => "icon-solid",
        "outline"     => "icon-outline",
        "transparent" => "icon-transparent",
        _             => "icon-default"
    };

