@implements IDisposable
@inject SupabaseAuthService Auth
@inject NavigationManager Navigation

@*
    Categorised, collapsible navigation. The category list is the one agreed in the
    Joplin spec ("Kategorili, açılır kapanır navigasyon menüsü"), in that order:
    Shaft & Hub, Bearings, Gears, Springs, Fasteners, General, Libraries.

    Two rules the spec names explicitly and the code below implements:
      - the active module's category is open when the page loads, so the visitor
        never loses their place;
      - the mobile drawer behaviour is unchanged - MainLayout still owns `Open`.

    Only modules that actually exist are listed. Planned ones (Woodruff, Spline,
    bevel/rack/worm gears, disc springs, power transmission, tolerance analysis)
    are deliberately NOT shown as greyed "coming soon" rows: a nav row that cannot
    be clicked is a dead end, and the roadmap belongs on the About page.
*@

<nav class="sidebar @(Open ? "open" : "")" id="main-nav">
    <div class="sidebar-header">
        <a href="/">
            <img src="brand/wordmark-on-dark.svg" alt="Mekanika" class="sidebar-logo" width="200" height="35" />
        </a>
    </div>

    <div class="nav-account">
        <AuthorizeView>
            <Authorized>
                <NavLink class="nav-account-user" href="account">
                    <span class="nav-account-avatar">@AvatarLetter(context)</span>
                    <span class="nav-account-email">@context.User.Identity?.Name</span>
                </NavLink>
                <NavLink class="nav-account-link" href="my-calculations">
                    <ModuleIcon Type="my-calculations" Size="button" Style="transparent" /> My Calculations
                </NavLink>
                <button class="nav-account-signout" @onclick="SignOut">
                    <ModuleIcon Type="sign-out" Size="button" Style="transparent" /> Sign out
                </button>
            </Authorized>
            <NotAuthorized>
                <NavLink class="nav-account-signin" href="login">
                    <ModuleIcon Type="account" Size="button" Style="transparent" /> Sign In
                </NavLink>
            </NotAuthorized>
        </AuthorizeView>
    </div>

    <div class="nav-menu">
        <NavLink class="nav-item nav-item-flush" href="" Match="NavLinkMatch.All">
            <ModuleIcon Type="home" Size="medium" Style="default" /> Home
        </NavLink>

        @foreach (var group in Groups)
        {
            var isOpen = expanded.Contains(group.Title);
            var panelId = PanelId(group.Title);
            <div class="nav-group @(isOpen ? "open" : "")">
                <button type="button" class="nav-group-toggle @(HoldsActive(group) ? "has-active" : "")"
                        @onclick="() => Toggle(group.Title)"
                        aria-expanded="@(isOpen ? "true" : "false")"
                        aria-controls="@panelId">
                    <ModuleIcon Type="@group.Icon" Size="medium" Style="default" />
                    <span class="nav-group-title">@group.Title</span>
                    <svg class="nav-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2.2" stroke-linecap="round"
                         stroke-linejoin="round" aria-hidden="true">
                        <path d="M9 6 L15 12 L9 18" />
                    </svg>
                </button>
                <div class="nav-group-items" id="@panelId">
                    <div class="nav-group-inner">
                        @foreach (var item in group.Items)
                        {
                            <NavLink class="nav-item" href="@item.Href">
                                <ModuleIcon Type="@item.Icon" Size="medium" Style="default" /> @item.Label
                            </NavLink>
                        }
                    </div>
                </div>
            </div>
        }

        <hr class="nav-separator" />

        <NavLink class="nav-item nav-item-minor" href="about">
            <ModuleIcon Type="info" Size="medium" Style="default" /> About
        </NavLink>
        <NavLink class="nav-item nav-item-minor" href="contact">
            <ModuleIcon Type="contact" Size="medium" Style="default" /> Contact Us
        </NavLink>
        <NavLink class="nav-item nav-item-minor" href="privacy">
            <ModuleIcon Type="safety" Size="medium" Style="default" /> Privacy Policy
        </NavLink>
    </div>
</nav>

@code {
    /// <summary>Drives `.sidebar.open` - the mobile drawer state, owned by MainLayout.</summary>
    [Parameter] public bool Open { get; set; }

    private sealed record NavEntry(string Href, string Label, string Icon);
    private sealed record NavGroup(string Title, string Icon, NavEntry[] Items);

    private static readonly NavGroup[] Groups =
    {
        new("Shaft & Hub", "shaft&hub", new NavEntry[]
        {
            new("interference-fit", "Interference Fit", "interference-fit"),
            new("taper-fit",        "Taper Fit",        "taper-fit"),
            new("key-connection",   "Parallel Key",     "key-connection"),
            new("clamp-connection", "Clamp Connection", "clamp-connection"),
        }),
        new("Bearings", "ball-bearing", new NavEntry[]
        {
            new("ball-bearing",   "Ball Bearing Life",   "ball-bearing"),
            new("roller-bearing", "Roller Bearing Life", "roller-bearing"),
        }),
        new("Gears", "gear", new NavEntry[]
        {
            new("gear-pair",     "Cylindrical Gear Pair", "gear"),
            new("internal-gear", "Internal Gear Pair",    "internal-gear"),
        }),
        new("Springs", "spring", new NavEntry[]
        {
            new("compression-spring", "Compression Spring", "spring"),
            new("extension-spring",   "Extension Spring",   "tension"),
            new("torsion-spring",     "Torsion Spring",     "torque"),
        }),
        new("Fasteners", "bolt", new NavEntry[]
        {
            new("single-bolt", "Single Bolt", "bolt"),
        }),
        new("General", "geometry", new NavEntry[]
        {
            new("moment-of-inertia", "Moment of Inertia", "moment-inertia"),
        }),
        new("Libraries", "table", new NavEntry[]
        {
            new("materials",     "Material Database", "material"),
            new("bearings",      "Bearing Database",  "bearing-database"),
            new("boltdatabase",  "Bolt Database",     "bolt-database"),
        }),
    };

    /// <summary>
    /// Open categories. Several may be open at once - collapsing the one the visitor
    /// just opened in order to open another is the behaviour accordions are disliked
    /// for. The set survives in-app navigation because NavMenu lives in MainLayout
    /// and is never re-created.
    /// </summary>
    private readonly HashSet<string> expanded = new(StringComparer.Ordinal);

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
        OpenActiveGroup();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        OpenActiveGroup();
        StateHasChanged();
    }

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;

    private void Toggle(string title)
    {
        if (!expanded.Remove(title)) expanded.Add(title);
    }

    private void OpenActiveGroup()
    {
        var group = Groups.FirstOrDefault(HoldsActive);
        if (group is not null) expanded.Add(group.Title);
    }

    private bool HoldsActive(NavGroup group)
        => group.Items.Any(i => string.Equals(i.Href, CurrentRoute, StringComparison.OrdinalIgnoreCase));

    /// <summary>
    /// The current route with query, fragment and any trailing slash removed. The
    /// fragment matters: a shared calculation arrives as `key-connection#s=&lt;payload&gt;`,
    /// and the trailing slash matters because the generated static pages redirect
    /// through `/key-connection/`. Either one left in place would stop the active
    /// module's category from opening.
    /// </summary>
    private string CurrentRoute
    {
        get
        {
            var path = Navigation.ToBaseRelativePath(Navigation.Uri);
            var cut = path.IndexOfAny(new[] { '?', '#' });
            if (cut >= 0) path = path[..cut];
            return path.Trim('/');
        }
    }

    private static string PanelId(string title)
        => "nav-group-" + new string(title.Where(char.IsLetterOrDigit).ToArray()).ToLowerInvariant();

    private async Task SignOut()
    {
        await Auth.SignOutAsync();
        Navigation.NavigateTo("/", forceLoad: false);
    }

    private static string AvatarLetter(AuthenticationState context)
    {
        var name = context.User.Identity?.Name;
        return string.IsNullOrEmpty(name) ? "?" : name[..1].ToUpperInvariant();
    }
}
