@inject SupabaseAuthService Auth
@inject NavigationManager Navigation

<nav class="sidebar">
    <div class="sidebar-header">
        <a href="/">
            <img src="logo.png" alt="Mekanika" class="sidebar-logo" />
        </a>
    </div>

    <div class="nav-account">
        <AuthorizeView>
            <Authorized>
                <NavLink class="nav-account-user" href="account">
                    <span class="nav-account-avatar">@AvatarLetter(context)</span>
                    <span class="nav-account-email">@context.User.Identity?.Name</span>
                </NavLink>
                <button class="nav-account-signout" @onclick="SignOut">Sign out</button>
            </Authorized>
            <NotAuthorized>
                <NavLink class="nav-account-signin" href="login">
                    <ModuleIcon Type="contact" Size="medium" Style="default" /> Sign In
                </NavLink>
            </NotAuthorized>
        </AuthorizeView>
    </div>

    <div class="nav-menu">
        <div class="nav-section">General</div>
        <hr class="nav-separator">
        <NavLink class="nav-item" href="" Match="NavLinkMatch.All">
            <ModuleIcon Type="home" Size="medium" Style="default" /> Home
        </NavLink>

        <div class="nav-section">Shaft-Hub Connections</div>
        <hr class="nav-separator">
        <NavLink class="nav-item" href="interference-fit">
            <ModuleIcon Type="interference-fit" Size="medium" Style="default" /> Interference Fit
        </NavLink>
        <NavLink class="nav-item" href="taper-fit">
            <ModuleIcon Type="taper-fit" Size="medium" Style="default" /> Taper Fit
        </NavLink>
        <NavLink class="nav-item" href="key-connection">
            <ModuleIcon Type="key-connection" Size="medium" Style="default" /> Parallel Key
        </NavLink>
        <NavLink class="nav-item" href="clamp-connection">
            <ModuleIcon Type="clamp-connection" Size="medium" Style="default" /> Clamp Connection
        </NavLink>

        <div class="nav-section">Gears</div>
        <hr class="nav-separator">
        <NavLink class="nav-item" href="gear-pair">
            <ModuleIcon Type="gear-pair" Size="medium" Style="default" /> Cylindrical Gear Pair
        </NavLink>

        <div class="nav-section">Fasteners</div>
        <hr class="nav-separator">
        <NavLink class="nav-item" href="single-bolt">
            <ModuleIcon Type="bolt" Size="medium" Style="default" /> Single Bolt
        </NavLink>

        <div class="nav-section">Bearings</div>
        <hr class="nav-separator">
        <NavLink class="nav-item" href="ball-bearing">
            <ModuleIcon Type="ball-bearing" Size="medium" Style="default" /> Ball Bearing Life
        </NavLink>
        <NavLink class="nav-item" href="roller-bearing">
            <ModuleIcon Type="roller-bearing" Size="medium" Style="default" /> Roller Bearing Life
        </NavLink>

        <div class="nav-section">Springs</div>
        <hr class="nav-separator">
        <NavLink class="nav-item" href="compression-spring">
            <ModuleIcon Type="compression" Size="medium" Style="default" /> Compression Spring
        </NavLink>

	<NavLink class="nav-item" href="extension-spring">
    	    <ModuleIcon Type="tension" Size="medium" Style="default" /> Extension Spring
	</NavLink>
        <NavLink class="nav-item" href="torsion-spring">
            <ModuleIcon Type="torque" Size="medium" Style="default" /> Torsion Spring
        </NavLink>

        <div class="nav-section">Section Properties</div>
        <hr class="nav-separator">
        <NavLink class="nav-item" href="moment-of-inertia">
            <ModuleIcon Type="moment-inertia" Size="medium" Style="default" /> Moment of Inertia
        </NavLink>

        <div class="nav-section">Resources</div>
        <hr class="nav-separator">
        <NavLink class="nav-item" href="materials">
            <ModuleIcon Type="material" Size="medium" Style="default" /> Material Database
        </NavLink>
        <NavLink class="nav-item" href="bearings">
            <ModuleIcon Type="bearing-database" Size="medium" Style="default" /> Bearing Database
        </NavLink>
        <NavLink class="nav-item" href="boltdatabase">
            <ModuleIcon Type="bolt-database" Size="medium" Style="default" /> Bolt Database
        </NavLink>
        <NavLink class="nav-item" href="about">
            <ModuleIcon Type="info" Size="medium" Style="default" /> About
        </NavLink>
        <NavLink class="nav-item" href="contact">
            <ModuleIcon Type="contact" Size="medium" Style="default" /> Contact Us
        </NavLink>
        <NavLink class="nav-item" href="privacy">
            <ModuleIcon Type="info" Size="medium" Style="default" /> Privacy Policy
        </NavLink>
    </div>
</nav>

<style>
    .nav-account {
        padding: 12px 16px;
        border-bottom: 1px solid rgba(255,255,255,0.08);
        margin-bottom: 8px;
    }

    .nav-account-signin {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 8px 10px;
        border-radius: 8px;
        color: inherit;
        text-decoration: none;
        font-weight: 600;
        font-size: 14px;
    }
    .nav-account-signin:hover { background: rgba(255,255,255,0.08); }

    .nav-account-user {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 6px 8px;
        border-radius: 8px;
        text-decoration: none;
        color: inherit;
    }
    .nav-account-user:hover { background: rgba(255,255,255,0.08); }

    .nav-account-avatar {
        flex-shrink: 0;
        width: 30px;
        height: 30px;
        border-radius: 50%;
        background: linear-gradient(135deg, #0077be 0%, #005a91 100%);
        color: white;
        font-weight: 700;
        font-size: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .nav-account-email {
        font-size: 13px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .nav-account-signout {
        margin-top: 6px;
        width: 100%;
        text-align: left;
        background: none;
        border: none;
        color: inherit;
        opacity: 0.7;
        font-size: 12px;
        padding: 4px 8px;
        cursor: pointer;
        border-radius: 6px;
    }
    .nav-account-signout:hover { opacity: 1; background: rgba(255,255,255,0.08); }
</style>

@code {
    private async Task SignOut()
    {
        await Auth.SignOutAsync();
        Navigation.NavigateTo("/", forceLoad: false);
    }

    private static string AvatarLetter(AuthenticationState context)
    {
        var name = context.User.Identity?.Name;
        return string.IsNullOrEmpty(name) ? "?" : name[..1].ToUpperInvariant();
    }
}
