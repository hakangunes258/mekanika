@*
    A small button next to a label or card header, and the modal it opens.

    This is the module's one dialog primitive, following the pattern CompressionSpring
    established: an unobtrusive "i" button, and a modal carrying a real table rather than a
    wall of prose. It holds two kinds of content, and the icon says which:

      Icon="info"     reference data - a standard's table, read-only. The field itself stays
                      where it is; the dialog explains what to put in it.
      Icon="open-options-dialog" a panel of further inputs that belong to this card but would crowd it.

    It replaces an earlier collapsible-section experiment. Disclosure that pushes the rest of
    the form up and down as it opens made the page feel unstable; a modal leaves the form
    where it is.

    Styles live in wwwroot/css/modern-icons.css rather than a <style> block here: a Razor
    <style> only reaches the DOM once that component's page has rendered, so a user
    deep-linking straight into a calculator would get an unstyled dialog.

    CALL SITES: never place this inside a <label>. The browser forwards a click from anywhere
    in a label to that label's control, and the dialog renders as a sibling of the button - so
    clicking inside the dialog got re-dispatched to the button and reopened it on the spot.
    Use the .label-row wrapper:

        <div class="label-row">
            <label>Application Factor (K<sub>A</sub>)</label>
            <DialogButton Title="..." >...</DialogButton>
        </div>
*@

<button type="button" class="schematic-btn" title="@(ButtonTitle ?? Title)"
        aria-label="@(ButtonTitle ?? Title)" disabled="@Disabled" @onclick="Open">
    <ModuleIcon Type="@Icon" Size="button" Style="default" />
</button>

@if (isOpen)
{
    <div class="schematic-overlay" @onclick="Close">
        <div class="schematic-dialog" style="@(MaxWidth > 0 ? $"max-width: {MaxWidth}px;" : null)"
             role="dialog" aria-modal="true" aria-label="@Title" @onclick:stopPropagation="true">
            <div class="schematic-head">
                <h3>@Title</h3>
                <button type="button" class="schematic-close" aria-label="Close" @onclick="Close">&times;</button>
            </div>
            <div class="schematic-body">
                @if (Intro is not null)
                {
                    <div class="dialog-intro">@Intro</div>
                }

                @ChildContent

                @if (Footer is not null)
                {
                    <div class="schematic-note">@Footer</div>
                }

                @if (ConfirmLabel is not null)
                {
                    <div class="dialog-action">
                        <button type="button" class="btn btn-success" @onclick="Confirm">@ConfirmLabel</button>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";

    /// <summary>"info" for reference data, "settings" for a panel of further inputs.</summary>
    [Parameter] public string Icon { get; set; } = "info";

    /// <summary>Tooltip, when it should differ from the title.</summary>
    [Parameter] public string? ButtonTitle { get; set; }

    /// <summary>0 keeps the shared dialog width.</summary>
    [Parameter] public int MaxWidth { get; set; }

    /// <summary>Set when the content cannot be produced yet, e.g. a live table with no geometry.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Text above the content: what the table is and how to read it.</summary>
    [Parameter] public RenderFragment? Intro { get; set; }

    /// <summary>Small print below: edition, scope, caveats.</summary>
    [Parameter] public RenderFragment? Footer { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Label for a confirm button at the foot of the dialog; null for none. A dialog that
    /// computes something the card then uses needs one: it applies the result and closes, which
    /// is one act rather than "press this, then find the X".
    /// </summary>
    [Parameter] public string? ConfirmLabel { get; set; }

    /// <summary>Runs before the dialog closes. Leave unset for a plain acknowledge-and-close.</summary>
    [Parameter] public EventCallback OnConfirm { get; set; }

    private bool isOpen;

    private async Task Confirm()
    {
        if (OnConfirm.HasDelegate) await OnConfirm.InvokeAsync();
        isOpen = false;
    }

    private void Open() => isOpen = true;

    private void Close() => isOpen = false;
}
