@*
    "Show diagram" button that sits next to an input label, plus the modal it opens.

    The drawings in wwwroot/schematics/ are a *symbol reference* — they explain which
    dimension a field means, they are not a picture of the user's own numbers. The 3D
    viewer is what shows this calculation. Keep any caption text saying so.

    Styles live in wwwroot/css/modern-icons.css rather than a <style> block here: a
    Razor <style> only reaches the DOM once that component's page has rendered, so a
    user deep-linking straight into a calculator would get an unstyled modal.
*@

<button type="button" class="schematic-btn" title="@Title" aria-label="@Title" @onclick="Toggle">
    <ModuleIcon Type="info" Size="button" Style="default" />
</button>

@if (isOpen)
{
    <div class="schematic-overlay" @onclick="Toggle">
        <div class="schematic-dialog" @onclick:stopPropagation="true">
            <div class="schematic-head">
                <h3>@Title</h3>
                <button type="button" class="schematic-close" aria-label="Close" @onclick="Toggle">&times;</button>
            </div>
            <div class="schematic-body">
                <div class="schematic-figure">
                    <img src="@Src" alt="@Title" />
                </div>
                @if (ChildContent is not null)
                {
                    <div class="schematic-legend">@ChildContent</div>
                }
                <p class="schematic-note">
                    Representative drawing — it explains the symbols, not the proportions of your spring.
                    Use the 3D view on the results page to see this calculation.
                </p>
            </div>
        </div>
    </div>
}

@code {
    /// <summary>Path under wwwroot, e.g. "schematics/compression-spring/01-geometry.svg".</summary>
    [Parameter, EditorRequired] public string Src { get; set; } = "";

    [Parameter, EditorRequired] public string Title { get; set; } = "";

    /// <summary>Symbol legend rendered under the drawing.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool isOpen;

    private void Toggle() => isOpen = !isOpen;
}
